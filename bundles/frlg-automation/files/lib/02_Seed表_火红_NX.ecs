FUNC 取SeedHEX_火红($idx: INT, $mode: INT): STRING
    IF $idx < 0 or $idx > 2310
        RETURN ""
    ENDIF
    IF $mode == 0
        RETURN $Seed_HEX_火红_m0[$idx]
    ELIF $mode == 1
        RETURN $Seed_HEX_火红_m1[$idx]
    ELIF $mode == 2
        RETURN $Seed_HEX_火红_m2[$idx]
    ELIF $mode == 3
        RETURN $Seed_HEX_火红_m3[$idx]
    ELIF $mode == 4
        RETURN $Seed_HEX_火红_m4[$idx]
    ELIF $mode == 5
        RETURN $Seed_HEX_火红_m5[$idx]
    ELIF $mode == 6
        RETURN $Seed_HEX_火红_m6[$idx]
    ELIF $mode == 7
        RETURN $Seed_HEX_火红_m7[$idx]
    ELIF $mode == 8
        RETURN $Seed_HEX_火红_m8[$idx]
    ELIF $mode == 9
        RETURN $Seed_HEX_火红_m9[$idx]
    ELIF $mode == 10
        RETURN $Seed_HEX_火红_m10[$idx]
    ENDIF
    RETURN ""
ENDFUNC
