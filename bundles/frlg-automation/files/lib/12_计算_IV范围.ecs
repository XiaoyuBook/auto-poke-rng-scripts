# ==================================================
# lib/12_计算_IV范围.ecs
#
# 性格影响项目编号：
#   0 = ATK
#   1 = DEF
#   2 = SPE
#   3 = SPA
#   4 = SPD
#
# 函数：
#   取性格倍率($性格, $性格项)
#   计算HP能力值(...)
#   计算非HP能力值(...)
#   计算HP_IV最小(...)
#   计算HP_IV最大(...)
#   计算非HP_IV最小(...)
#   计算非HP_IV最大(...)
# ==================================================

FUNC 取性格倍率($性格: INT, $性格项: INT): INT
    $上升项 = $性格 / 5
    $下降项 = $性格 % 5

    IF $上升项 != $下降项
        IF $性格项 == $上升项
            RETURN 110
        ELIF $性格项 == $下降项
            RETURN 90
        ENDIF
    ENDIF

    RETURN 100
ENDFUNC


FUNC 计算HP能力值($基础: INT, $努力: INT, $等级: INT, $IV: INT): INT
    $计算值 = ((2 * $基础 + $IV + $努力 / 4) * $等级) / 100
    RETURN $计算值 + $等级 + 10
ENDFUNC


FUNC 计算非HP能力值($基础: INT, $努力: INT, $等级: INT, $IV: INT, $性格: INT, $性格项: INT): INT
    $倍率 = 取性格倍率($性格, $性格项)
    $计算值 = ((2 * $基础 + $IV + $努力 / 4) * $等级) / 100
    $计算值 = $计算值 + 5
    RETURN ($计算值 * $倍率) / 100
ENDFUNC


FUNC 计算HP_IV最小($基础: INT, $努力: INT, $等级: INT, $实数: INT): INT
    $结果 = -1

    FOR $IV = 0 TO 31
        $计算值 = ((2 * $基础 + $IV + $努力 / 4) * $等级) / 100
        $计算值 = $计算值 + $等级 + 10

        IF $计算值 == $实数
            RETURN $IV
        ENDIF
    NEXT

    RETURN $结果
ENDFUNC


FUNC 计算HP_IV最大($基础: INT, $努力: INT, $等级: INT, $实数: INT): INT
    $结果 = -1

    FOR $IV = 0 TO 31
        $计算值 = ((2 * $基础 + $IV + $努力 / 4) * $等级) / 100
        $计算值 = $计算值 + $等级 + 10

        IF $计算值 == $实数
            $结果 = $IV
        ENDIF
    NEXT

    RETURN $结果
ENDFUNC


FUNC 计算非HP_IV最小($基础: INT, $努力: INT, $等级: INT, $实数: INT, $性格: INT, $性格项: INT): INT
    $倍率 = 取性格倍率($性格, $性格项)

    FOR $IV = 0 TO 31
        $计算值 = ((2 * $基础 + $IV + $努力 / 4) * $等级) / 100
        $计算值 = $计算值 + 5
        $计算值 = ($计算值 * $倍率) / 100

        IF $计算值 == $实数
            RETURN $IV
        ENDIF
    NEXT

    RETURN -1
ENDFUNC


FUNC 计算非HP_IV最大($基础: INT, $努力: INT, $等级: INT, $实数: INT, $性格: INT, $性格项: INT): INT
    $倍率 = 取性格倍率($性格, $性格项)
    $结果 = -1

    FOR $IV = 0 TO 31
        $计算值 = ((2 * $基础 + $IV + $努力 / 4) * $等级) / 100
        $计算值 = $计算值 + 5
        $计算值 = ($计算值 * $倍率) / 100

        IF $计算值 == $实数
            $结果 = $IV
        ENDIF
    NEXT

    RETURN $结果
ENDFUNC
