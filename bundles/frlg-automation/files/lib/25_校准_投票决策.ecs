$C_sortwidth = 0
$C_sortbase = 0
$C_sortmid = 0
$C_sortstop = 0
$C_sortleft = 0
$C_sortright = 0
$C_sortout = 0
$C_sortchoose = 0
$C_sortlID = 0
$C_sortrID = 0

FUNC 共同区重置
    $C_轮数 = 0
    $C_写轮 = 0
    $C_重复数 = 0
    $C_最佳覆盖 = 0
    $C_可用 = 0
    $C_坏轮 = 0
    $C_最近评分生效 = 0
    $C_本数 = 0
    $C_本坏 = 0
    $C_本提交 = 0
    FOR $C_i = 0 TO 11
        $C_轮长度[$C_i] = 0
    NEXT
ENDFUNC

FUNC 共同区开始扫描
    IF $C_御三家启用 == 0
        RETURN
    ENDIF
    $C_本数 = 0
    $C_本坏 = 0
    $C_本提交 = 0
ENDFUNC

FUNC 共同区设置严格模式($启用: INT): INT
    IF $启用 == 1
        $C_御三家启用 = 1
        $C_严格 = 1
        RETURN 1
    ENDIF
    $C_御三家启用 = 0
    $C_严格 = 0
    CALL 共同区重置
    RETURN 1
ENDFUNC

# 返回真实配对槽；共同区内仍有多个本轮候选时继续观察，不猜最近者。
FUNC 共同区选择本轮配对(): INT
    IF $C_御三家启用 == 0 or $C_本坏 == 1 or $C_本数 == 0
        RETURN -1
    ENDIF
    IF $C_本数 == 1
        RETURN 0
    ENDIF
    IF $C_可用 == 0 or $C_坏轮 == 1 or $C_超限 == 1
        RETURN -1
    ENDIF
    $C_选择 = 0 - 1
    $C_选择末 = $C_本数 - 1
    FOR $C_选择槽 = 0 TO $C_选择末
        IF $C_本Seed[$C_选择槽] < $C_最佳Seed低 or $C_本Seed[$C_选择槽] > $C_最佳Seed高
            CONTINUE
        ENDIF
        IF $C_本ADV[$C_选择槽] < $C_最佳ADV低 or $C_本ADV[$C_选择槽] > $C_最佳ADV高
            CONTINUE
        ENDIF
        IF $C_选择 >= 0
            RETURN -1
        ENDIF
        $C_选择 = $C_选择槽
    NEXT
    RETURN $C_选择
ENDFUNC

FUNC 共同区取本轮索引($槽: INT): INT
    RETURN $C_本索引[$槽]
ENDFUNC

FUNC 共同区取本轮ADV($槽: INT): INT
    RETURN $C_本ADV[$槽]
ENDFUNC

FUNC 共同区预测ADV($默认ADV: INT, $累计修正: INT): INT
    IF $C_御三家启用 == 1 and $C_可用 == 1 and $C_坏轮 == 0 and $C_超限 == 0
        $C_tmp = $C_最佳ADV低 + $C_最佳ADV高
        $C_tmp = ($C_tmp - $C_tmp % 2) / 2
        RETURN $C_tmp - $累计修正
    ENDIF
    RETURN $默认ADV - $累计修正
ENDFUNC

# 容量只限制诊断缓存，不限制原反查；越界整轮不参与，绝不截掉后冒充完整结果。
FUNC 共同区收集($游戏: INT, $实际索引: INT, $Seed累计: INT, $实际ADV: INT, $帧累计: INT, $平台MS: INT): INT
    IF $C_御三家启用 == 0
        RETURN 0
    ENDIF
    $C_tmp = $实际索引 + $Seed累计
    $C_end = 取Seed最大索引($游戏)
    IF $C_tmp < 0 or $C_tmp > $C_end
        $C_本坏 = 1
        RETURN 0
    ENDIF
    $C_m = 取MS($游戏, $C_tmp) + $平台MS
    $C_t = $实际ADV + $帧累计
    RETURN 共同区收集配对($C_m, $C_t, $C_tmp)
ENDFUNC

FUNC 共同区收集配对($MS: INT, $ADV: INT, $索引: INT): INT
    IF $C_御三家启用 == 0
        RETURN 0
    ENDIF
    $C_末 = $C_本数 - 1
    FOR $C_i = 0 TO $C_末
        IF $C_本Seed[$C_i] == $MS and $C_本ADV[$C_i] == $ADV and $C_本索引[$C_i] == $索引
            RETURN 1
        ENDIF
    NEXT
    IF $C_本数 >= 200
        $C_本坏 = 1
        RETURN 0
    ENDIF
    # 按 Seed/ADV/索引排序，完整内容比较不依赖输入顺序或弱签名。
    $C_j = $C_本数
    FOR
        IF $C_j <= 0
            BREAK
        ENDIF
        $C_k = $C_j - 1
        IF $C_本Seed[$C_k] < $MS
            BREAK
        ENDIF
        IF $C_本Seed[$C_k] == $MS and $C_本ADV[$C_k] < $ADV
            BREAK
        ENDIF
        IF $C_本Seed[$C_k] == $MS and $C_本ADV[$C_k] == $ADV and $C_本索引[$C_k] <= $索引
            BREAK
        ENDIF
        $C_本Seed[$C_j] = $C_本Seed[$C_k]
        $C_本ADV[$C_j] = $C_本ADV[$C_k]
        $C_本索引[$C_j] = $C_本索引[$C_k]
        $C_j = $C_k
    NEXT
    $C_本Seed[$C_j] = $MS
    $C_本ADV[$C_j] = $ADV
    $C_本索引[$C_j] = $索引
    $C_本数 = $C_本数 + 1
    RETURN 1
ENDFUNC

# 主脚本只在一只宝可梦的吃糖细分结束后提交最终扫描，扩窗/同只吃糖不是新一轮。
FUNC 共同区提交(): INT
    IF $C_御三家启用 == 0
        $C_本数 = 0
        $C_本坏 = 0
        $C_本提交 = 0
        $C_可用 = 0
        RETURN 0
    ENDIF
    IF $C_本提交 == 1
        RETURN 0
    ENDIF
    $C_本提交 = 1
    IF $C_本坏 == 1 or $C_本数 == 0
        $C_坏轮 = 1
        $C_可用 = 0
        PRINT 共同紧密区: 本轮候选不完整或为空，仅诊断，不参与排序
        RETURN 0
    ENDIF
    FOR $C_r = 0 TO 11
        IF $C_轮长度[$C_r] != $C_本数
            CONTINUE
        ENDIF
        $C_same = 1
        $C_末 = $C_本数 - 1
        FOR $C_i = 0 TO $C_末
            $C_p = $C_r * 200 + $C_i
            IF $C_史Seed[$C_p] != $C_本Seed[$C_i] or $C_史ADV[$C_p] != $C_本ADV[$C_i] or $C_史索引[$C_p] != $C_本索引[$C_i]
                $C_same = 0
                BREAK
            ENDIF
        NEXT
        IF $C_same == 1
            $C_重复数 = $C_重复数 + 1
            PRINT 共同紧密区: 完全相同的配对集合，不增加覆盖轮数
            IF $C_严格 == 1 and $C_坏轮 == 1
                $C_坏轮 = 0
                CALL 共同区重算
            ENDIF
            RETURN 0
        ENDIF
    NEXT
    $C_末 = $C_本数 - 1
    FOR $C_i = 0 TO $C_末
        $C_p = $C_写轮 * 200 + $C_i
        $C_史Seed[$C_p] = $C_本Seed[$C_i]
        $C_史ADV[$C_p] = $C_本ADV[$C_i]
        $C_史索引[$C_p] = $C_本索引[$C_i]
        IF $共同区输出配对 == 1
            $C_tmp = $C_本Seed[$C_i]
            $C_m = $C_本ADV[$C_i]
            $C_t = $C_本索引[$C_i]
            PRINT COMMON_PAIR|SLOT= & $C_写轮 & |SEED_MS= & $C_tmp & |ADV= & $C_m & |INDEX= & $C_t
        ENDIF
    NEXT
    $C_轮长度[$C_写轮] = $C_本数
    $C_写轮 = ($C_写轮 + 1) % 12
    IF $C_轮数 < 12
        $C_轮数 = $C_轮数 + 1
    ENDIF
    $C_坏轮 = 0
    CALL 共同区重算
    CALL 共同区打印
    RETURN 1
ENDFUNC

# 以两个排序视图扫描矩形。不是连通分量，不把两轮范围先压成各轴的独立区间。
FUNC 共同区重算
    $C_点数 = 0
    $C_最佳覆盖 = 0
    $C_最佳Seed跨度 = 0
    $C_最佳ADV跨度 = 0
    $C_歧义 = 0
    $C_可用 = 0
    $C_工作量 = 0
    $C_超限 = 0
    IF $C_御三家启用 == 0
        RETURN
    ENDIF
    IF $共同区Seed总跨度 < 0 or $共同区ADV总跨度 < 0
        RETURN
    ENDIF
    FOR $C_r = 0 TO 11
        $C_末 = $C_轮长度[$C_r] - 1
        FOR $C_i = 0 TO $C_末
            $C_p = $C_r * 200 + $C_i
            $C_X序[$C_点数] = $C_p
            $C_Y序[$C_点数] = $C_p
            $C_点数 = $C_点数 + 1
        NEXT
    NEXT
    $C_忽略 = 共同区排序(0)
    $C_忽略 = 共同区排序(1)
    $C_end = $C_点数 - 1
    FOR $C_anchor = 0 TO $C_end
        $C_p = $C_X序[$C_anchor]
        $C_xlow = $C_史Seed[$C_p]
        IF $C_anchor > 0
            $C_k = $C_anchor - 1
            $C_q = $C_X序[$C_k]
            IF $C_xlow == $C_史Seed[$C_q]
                CONTINUE
            ENDIF
        ENDIF
        $C_xhigh = $C_xlow + $共同区Seed总跨度
        $C_count = 0
        $C_left = 0
        $C_cover = 0
        FOR $C_r = 0 TO 11
            $C_Y票[$C_r] = 0
        NEXT
        FOR $C_n = 0 TO $C_end
            $C_p = $C_Y序[$C_n]
            IF $C_史Seed[$C_p] < $C_xlow or $C_史Seed[$C_p] > $C_xhigh
                CONTINUE
            ENDIF
            $C_Y窗[$C_count] = $C_p
            $C_count = $C_count + 1
            # 整除不能依赖运行器的四舍五入策略。
            $C_r = ($C_p - $C_p % 200) / 200
            IF $C_Y票[$C_r] == 0
                $C_cover = $C_cover + 1
            ENDIF
            $C_Y票[$C_r] = $C_Y票[$C_r] + 1
            $C_yhigh = $C_史ADV[$C_p]
            FOR
                $C_q = $C_Y窗[$C_left]
                $C_r = ($C_q - $C_q % 200) / 200
                IF $C_yhigh - $C_史ADV[$C_q] <= $共同区ADV总跨度 and $C_Y票[$C_r] <= 1
                    BREAK
                ENDIF
                $C_Y票[$C_r] = $C_Y票[$C_r] - 1
                IF $C_Y票[$C_r] == 0
                    $C_cover = $C_cover - 1
                ENDIF
                $C_left = $C_left + 1
            NEXT
            $C_ylow = $C_史ADV[$C_q]
            IF $C_cover < $C_最佳覆盖
                CONTINUE
            ENDIF
            $C_span = $C_yhigh - $C_ylow
            CALL 共同区评价矩形
            IF $C_超限 == 1
                RETURN
            ENDIF
        NEXT
    NEXT
    IF $C_包络Seed高 - $C_包络Seed低 > $共同区Seed总跨度 or $C_包络ADV高 - $C_包络ADV低 > $共同区ADV总跨度
        $C_歧义 = 1
    ENDIF
    # 严格筛选不以平票包络填补二维空隙，也不按Seed下界任取平票窗口。
    IF $C_严格 == 1 and ($C_包络Seed高 - $C_包络Seed低 > $C_最佳Seed跨度 or $C_包络ADV高 - $C_包络ADV低 > $C_最佳ADV跨度)
        $C_歧义 = 1
    ENDIF
    # 至少三轮、严格多数、无分离解释；只给后续候选加距离，不替代任何校准公式。
    IF $共同区参与排序 == 1 and $C_最佳覆盖 >= 3 and $C_最佳覆盖 * 2 > $C_轮数 and $C_歧义 == 0
        $C_可用 = 1
    ENDIF
ENDFUNC

# 底向上归并排序，2400 个候选也不做全表插入排序。
FUNC 共同区排序($轴: INT): INT
    $C_sortwidth = 1
    FOR
        IF $C_sortwidth >= $C_点数
            BREAK
        ENDIF
        $C_sortbase = 0
        FOR
            IF $C_sortbase >= $C_点数
                BREAK
            ENDIF
            $C_sortmid = $C_sortbase + $C_sortwidth
            $C_sortstop = $C_sortmid + $C_sortwidth
            IF $C_sortmid > $C_点数
                $C_sortmid = $C_点数
            ENDIF
            IF $C_sortstop > $C_点数
                $C_sortstop = $C_点数
            ENDIF
            $C_sortleft = $C_sortbase
            $C_sortright = $C_sortmid
            $C_sortout = $C_sortbase
            FOR
                IF $C_sortout >= $C_sortstop
                    BREAK
                ENDIF
                $C_sortchoose = 0
                IF $C_sortright >= $C_sortstop
                    $C_sortchoose = 1
                ELIF $C_sortleft < $C_sortmid
                    IF $轴 == 0
                        $C_sortlID = $C_X序[$C_sortleft]
                        $C_sortrID = $C_X序[$C_sortright]
                        IF $C_史Seed[$C_sortlID] <= $C_史Seed[$C_sortrID]
                            $C_sortchoose = 1
                        ENDIF
                    ELSE
                        $C_sortlID = $C_Y序[$C_sortleft]
                        $C_sortrID = $C_Y序[$C_sortright]
                        IF $C_史ADV[$C_sortlID] <= $C_史ADV[$C_sortrID]
                            $C_sortchoose = 1
                        ENDIF
                    ENDIF
                ENDIF
                IF $C_sortchoose == 1
                    IF $轴 == 0
                        $C_排序缓冲[$C_sortout] = $C_X序[$C_sortleft]
                    ELSE
                        $C_排序缓冲[$C_sortout] = $C_Y序[$C_sortleft]
                    ENDIF
                    $C_sortleft = $C_sortleft + 1
                ELSE
                    IF $轴 == 0
                        $C_排序缓冲[$C_sortout] = $C_X序[$C_sortright]
                    ELSE
                        $C_排序缓冲[$C_sortout] = $C_Y序[$C_sortright]
                    ENDIF
                    $C_sortright = $C_sortright + 1
                ENDIF
                $C_sortout = $C_sortout + 1
            NEXT
            $C_sortbase = $C_sortstop
        NEXT
        $C_末 = $C_点数 - 1
        FOR $C_i = 0 TO $C_末
            IF $轴 == 0
                $C_X序[$C_i] = $C_排序缓冲[$C_i]
            ELSE
                $C_Y序[$C_i] = $C_排序缓冲[$C_i]
            ENDIF
        NEXT
        $C_sortwidth = $C_sortwidth * 2
    NEXT
    RETURN 1
ENDFUNC

FUNC 共同区记录解释包络
    IF $C_cover > $C_最佳覆盖 or ($C_严格 == 1 and ($C_span < $C_最佳ADV跨度 or ($C_span == $C_最佳ADV跨度 and $C_xmax - $C_xmin < $C_最佳Seed跨度)))
        $C_包络Seed低 = $C_xmin
        $C_包络Seed高 = $C_xmax
        $C_包络索引低 = $C_imin
        $C_包络索引高 = $C_imax
        $C_包络ADV低 = $C_ylow
        $C_包络ADV高 = $C_yhigh
    ELSE
        IF $C_xmin < $C_包络Seed低
            $C_包络Seed低 = $C_xmin
            $C_包络索引低 = $C_imin
        ENDIF
        IF $C_xmax > $C_包络Seed高
            $C_包络Seed高 = $C_xmax
            $C_包络索引高 = $C_imax
        ENDIF
        IF $C_ylow < $C_包络ADV低
            $C_包络ADV低 = $C_ylow
        ENDIF
        IF $C_yhigh > $C_包络ADV高
            $C_包络ADV高 = $C_yhigh
        ENDIF
    ENDIF
ENDFUNC

# 对给定 ADV 窗，找能覆盖同样轮数的最窄 Seed 窗。
# 每轮可能有多个配对，但覆盖只计一次；输出窗口必须包含真实配对。
FUNC 共同区评价矩形
    # 二分定位 ADV 下界，只遍历本矩形的真实配对。
    # 包括与左右边界同 ADV 的全部配对，不能丢掉同一轮更窄的 Seed 选择。
    $C_start = 0
    $C_right = $C_点数
    FOR
        IF $C_start >= $C_right
            BREAK
        ENDIF
        $C_mid = $C_start + $C_right
        $C_mid = ($C_mid - $C_mid % 2) / 2
        $C_p = $C_Y序[$C_mid]
        IF $C_史ADV[$C_p] < $C_ylow
            $C_start = $C_mid + 1
        ELSE
            $C_right = $C_mid
        ENDIF
    NEXT
    $C_xcount = 0
    $C_xmin = 2147483647
    $C_xmax = 0 - 2147483647
    $C_imin = 2147483647
    $C_imax = 0 - 2147483647
    FOR $C_m = $C_start TO $C_end
        $C_工作量 = $C_工作量 + 1
        IF $C_工作量 > 2000000
            $C_超限 = 1
            $C_可用 = 0
            RETURN
        ENDIF
        $C_p = $C_Y序[$C_m]
        IF $C_史ADV[$C_p] > $C_yhigh
            BREAK
        ENDIF
        IF $C_史Seed[$C_p] < $C_xlow or $C_史Seed[$C_p] > $C_xhigh
            CONTINUE
        ENDIF
        $C_X窗[$C_xcount] = $C_p
        $C_xcount = $C_xcount + 1
        IF $C_史Seed[$C_p] < $C_xmin
            $C_xmin = $C_史Seed[$C_p]
        ENDIF
        IF $C_史Seed[$C_p] > $C_xmax
            $C_xmax = $C_史Seed[$C_p]
        ENDIF
        IF $C_史索引[$C_p] < $C_imin
            $C_imin = $C_史索引[$C_p]
        ENDIF
        IF $C_史索引[$C_p] > $C_imax
            $C_imax = $C_史索引[$C_p]
        ENDIF
    NEXT
    IF $C_严格 == 0
        CALL 共同区记录解释包络
    ENDIF
    IF $C_cover == $C_最佳覆盖 and $C_span > $C_最佳ADV跨度
        RETURN
    ENDIF
    IF $C_xcount == $C_cover
        CALL 共同区记录最优窗口
        RETURN
    ENDIF
    # 对给定 ADV 窗，用第二个滑窗找同覆盖的最小 Seed 总跨度。
    $C_末 = $C_xcount - 1
    FOR $C_i = 1 TO $C_末
        $C_p = $C_X窗[$C_i]
        $C_j = $C_i
        FOR
            IF $C_j <= 0
                BREAK
            ENDIF
            $C_k = $C_j - 1
            $C_q = $C_X窗[$C_k]
            IF $C_史Seed[$C_q] <= $C_史Seed[$C_p]
                BREAK
            ENDIF
            $C_X窗[$C_j] = $C_q
            $C_j = $C_k
        NEXT
        $C_X窗[$C_j] = $C_p
    NEXT
    $C_xleft = 0
    $C_xcover = 0
    FOR $C_r = 0 TO 11
        $C_X票[$C_r] = 0
    NEXT
    FOR $C_i = 0 TO $C_末
        $C_p = $C_X窗[$C_i]
        $C_r = ($C_p - $C_p % 200) / 200
        IF $C_X票[$C_r] == 0
            $C_xcover = $C_xcover + 1
        ENDIF
        $C_X票[$C_r] = $C_X票[$C_r] + 1
        FOR
            $C_q = $C_X窗[$C_xleft]
            $C_r = ($C_q - $C_q % 200) / 200
            IF $C_X票[$C_r] <= 1
                BREAK
            ENDIF
            $C_X票[$C_r] = $C_X票[$C_r] - 1
            $C_xleft = $C_xleft + 1
        NEXT
        IF $C_xcover != $C_cover
            CONTINUE
        ENDIF
        $C_xmin = $C_史Seed[$C_q]
        $C_xmax = $C_史Seed[$C_p]
        CALL 共同区记录最优窗口
    NEXT
ENDFUNC

FUNC 共同区记录最优窗口
    # 御三家只把完整排名相同的解释判为歧义；更散的帧簇不能否决紧密簇。
    IF $C_严格 == 1
        IF $C_cover == $C_最佳覆盖 and $C_span > $C_最佳ADV跨度
            RETURN
        ENDIF
        IF $C_cover == $C_最佳覆盖 and $C_span == $C_最佳ADV跨度 and $C_xmax - $C_xmin > $C_最佳Seed跨度
            RETURN
        ENDIF
        CALL 共同区记录解释包络
    ENDIF
    $C_found = 0
    IF $C_cover > $C_最佳覆盖
        $C_found = 1
    ELIF $C_span < $C_最佳ADV跨度
        $C_found = 1
    ELIF $C_span == $C_最佳ADV跨度 and $C_xmax - $C_xmin < $C_最佳Seed跨度
        $C_found = 1
    ELIF $C_span == $C_最佳ADV跨度 and $C_xmax - $C_xmin == $C_最佳Seed跨度 and $C_xmin < $C_最佳Seed低
        $C_found = 1
    ENDIF
    IF $C_found == 1
        $C_最佳覆盖 = $C_cover
        $C_最佳Seed跨度 = $C_xmax - $C_xmin
        $C_最佳ADV跨度 = $C_span
        $C_最佳Seed低 = $C_xmin
        $C_最佳Seed高 = $C_xmax
        $C_最佳ADV低 = $C_ylow
        $C_最佳ADV高 = $C_yhigh
    ENDIF
ENDFUNC

FUNC 共同区候选加权距离($基准索引: INT, $基准ADV: INT, $Seed权重: INT, $ADV权重: INT): INT
    $C_最近评分生效 = 0
    IF $C_御三家启用 == 0 or $C_可用 == 0 or $C_坏轮 == 1
        RETURN 0
    ENDIF
    $C_最近评分生效 = 1
    $C_dx = 0
    $C_dy = 0
    IF $基准索引 < $C_包络索引低
        $C_dx = $C_包络索引低 - $基准索引
    ELIF $基准索引 > $C_包络索引高
        $C_dx = $基准索引 - $C_包络索引高
    ENDIF
    IF $基准ADV < $C_包络ADV低
        $C_dy = $C_包络ADV低 - $基准ADV
    ELIF $基准ADV > $C_包络ADV高
        $C_dy = $基准ADV - $C_包络ADV高
    ENDIF
    RETURN 候选MSE评分($C_dx, $C_dy, $Seed权重, $ADV权重)
ENDFUNC

FUNC 共同区打印
    PRINT 共同紧密区|独立轮= & $C_轮数 & /12|重复集= & $C_重复数 & |Seed总跨度上限= & $共同区Seed总跨度 & ms|ADV总跨度上限= & $共同区ADV总跨度
    IF $C_超限 == 1 or $C_坏轮 == 1
        PRINT 共同紧密区: 候选缓存或计算不完整，不参与排序
        RETURN
    ENDIF
    IF $C_最佳覆盖 == 0
        PRINT 共同紧密区: 暂无完整候选
        RETURN
    ENDIF
    PRINT 排名首位共同紧密区|覆盖= & $C_最佳覆盖 & / & $C_轮数 & |归一SeedMS= & $C_最佳Seed低 & - & $C_最佳Seed高 & |归一ADV= & $C_最佳ADV低 & - & $C_最佳ADV高
    # 中心/半跨度用 .0/.5 无损表示，避免 INT 除法吞掉半帧。
    $C_中心Seed2 = $C_最佳Seed低 + $C_最佳Seed高
    $C_中心ADV2 = $C_最佳ADV低 + $C_最佳ADV高
    $C_Seed中心整 = ($C_中心Seed2 - $C_中心Seed2 % 2) / 2
    $C_Seed中心小数 = ($C_中心Seed2 % 2) * 5
    $C_tmp = $C_中心ADV2
    IF $C_tmp < 0
        $C_tmp = 0 - $C_tmp
    ENDIF
    $C_ADV中心整 = ($C_tmp - $C_tmp % 2) / 2
    $C_ADV中心小数 = ($C_tmp % 2) * 5
    $C_Seed半跨度整 = ($C_最佳Seed跨度 - $C_最佳Seed跨度 % 2) / 2
    $C_Seed半跨度小数 = ($C_最佳Seed跨度 % 2) * 5
    $C_ADV半跨度整 = ($C_最佳ADV跨度 - $C_最佳ADV跨度 % 2) / 2
    $C_ADV半跨度小数 = ($C_最佳ADV跨度 % 2) * 5
    PRINT Seed中心= & $C_Seed中心整 & . & $C_Seed中心小数 & ms|最大偏差=± & $C_Seed半跨度整 & . & $C_Seed半跨度小数 & ms
    IF $C_中心ADV2 < 0
        PRINT ADV中心=- & $C_ADV中心整 & . & $C_ADV中心小数 & |最大偏差=± & $C_ADV半跨度整 & . & $C_ADV半跨度小数
    ELSE
        PRINT ADV中心= & $C_ADV中心整 & . & $C_ADV中心小数 & |最大偏差=± & $C_ADV半跨度整 & . & $C_ADV半跨度小数
    ENDIF
    PRINT 共同紧密区判定|存在分离解释= & $C_歧义 & |下轮参与排序= & $C_可用 & |本轮扫描使用= & $C_最近评分生效
    PRINT 注意: 全部为撤销累计修正后的共同坐标；排名首位不是最终真值，不直接生成Seed或帧修正
ENDFUNC
# SEED_COMMON_REGION_V1_END

FUNC 投票设置配置($相位半宽: INT, $相位槽数: INT, $圈数半宽: INT, $圈数槽数: INT, $周期: INT, $票堆帧窗: INT, $票堆Seed窗: INT, $Seed半宽: INT, $Seed槽数: INT, $停糖领先阈值: INT, $停糖稳定轮数: INT): INT
    IF $相位半宽 > 157
        $相位半宽 = 157
    ENDIF
    IF $相位半宽 < 1
        $相位半宽 = 1
    ENDIF
    IF $圈数半宽 > 6
        $圈数半宽 = 6
    ENDIF
    IF $圈数半宽 < 0
        $圈数半宽 = 0
    ENDIF
    IF $Seed半宽 > 20
        $Seed半宽 = 20
    ENDIF
    IF $Seed半宽 < 1
        $Seed半宽 = 1
    ENDIF
    $V_相位半宽 = $相位半宽
    $V_相位槽数 = $相位半宽 * 2 + 1
    $V_圈数半宽 = $圈数半宽
    $V_圈数槽数 = $圈数半宽 * 2 + 1
    $V_周期 = $周期
    $V_票堆帧窗 = $票堆帧窗
    $V_票堆Seed窗 = $票堆Seed窗
    $V_Seed半宽 = $Seed半宽
    $V_Seed槽数 = $Seed半宽 * 2 + 1
    $V_停糖领先阈值 = $停糖领先阈值
    $V_停糖稳定轮数 = $停糖稳定轮数
    RETURN 1
ENDFUNC

# 清零全部表与停糖稳定状态（每个目标/任务开始时调用）
FUNC 投票重置
    FOR $V_重置i = 0 TO 314
        $V_相位表[$V_重置i] = 0
    NEXT
    FOR $V_重置j = 0 TO 12
        $V_圈数表[$V_重置j] = 0
    NEXT
    FOR $V_重置k = 0 TO 40
        $V_Seed表[$V_重置k] = 0
    NEXT
    FOR $V_重置m = 0 TO 255
        $V_联合键表[$V_重置m] = 0
        $V_联合票表[$V_重置m] = 0
    NEXT
    $V_联合长度 = 0
    $V_上次帧最优槽 = 0 - 1
    $V_稳定计数 = 0
    $V_停糖标志 = 0
    $V_真值解连续 = 0
    $V_停糖原因 = 0
    # 清动态窗样本与峰值偏差(每个目标开始/真路径切换重置时，旧路径散布与峰值作废)
    $V_样本指针 = 0
    $V_样本数 = 0
    $V_峰值偏差 = 0
    $V_样本均值 = 0
    FOR $V_重置s = 0 TO 5
        $V_命中样本[$V_重置s] = 0
    NEXT
    # 清 Seed 滑动窗簇
    $V_Seed样本指针 = 0
    $V_Seed样本数 = 0
    $V_Seed峰值偏差 = 0
    $V_Seed样本均值 = 0
    $V_Seed票堆窗 = 2
    FOR $V_重置s = 0 TO 5
        $V_Seed命中样本[$V_重置s] = 0
    NEXT
    # 清 圈 滑动窗簇
    $V_圈样本指针 = 0
    $V_圈样本数 = 0
    $V_圈样本均值 = 0
    $V_圈票堆窗 = 2
    FOR $V_重置s = 0 TO 5
        $V_圈命中样本[$V_重置s] = 0
    NEXT
    IF $C_严格 == 0
        CALL 共同区重置
    ENDIF
ENDFUNC

# Seed校准众数只在新任务开始时清零。普通路径重锚不得调用。
FUNC 投票重置Seed校准
    $V_Seed校准样本指针 = 0
    $V_Seed校准样本数 = 0
    $V_Seed校准目标 = 0
    $V_Seed校准目标票数 = 0
    FOR $V_重置s = 0 TO 11
        $V_Seed校准样本[$V_重置s] = 0
    NEXT
ENDFUNC

# 投一个候选（反查每候选调一次）。$帧残差原始 = 原始帧误差(当前消耗帧-目标消耗帧，未折叠)。
# 帧绝对 = 帧残差原始 + 帧累计修正 → 对真路径跨轮恒定；TV 分解圈/相位后分别投表。
FUNC 投票投候选($seed残差: INT, $帧残差原始: INT, $seed累计: INT, $帧累计: INT, $同seed: INT, $进入TV: INT, $TV周期: INT): INT
    $V_帧绝对 = $帧残差原始 + $帧累计
    IF $进入TV == 1 and $V_周期 > 0
        $V_投k = 带符号整除四舍五入($V_帧绝对, $V_周期)
        $V_投r = $V_帧绝对 - $V_投k * $V_周期
        # 相位边界闭合：-相位半宽 与 +相位半宽 同相位 → 收口(-157,157]，半圈附近不分裂(圈k不变、由圈表区分)
        IF $V_投r == 0 - $V_相位半宽
            $V_投r = $V_相位半宽
        ENDIF
    ELSE
        $V_投k = 0
        $V_投r = $V_帧绝对
    ENDIF
    # 相位帧槽（越界跳过，等价阶段1-3）
    $V_相位槽 = $V_投r + $V_相位半宽
    $V_相位有效 = 0
    IF $V_相位槽 >= 0 and $V_相位槽 < $V_相位槽数
        $V_相位表[$V_相位槽] = $V_相位表[$V_相位槽] + 1
        $V_相位有效 = 1
    ENDIF
    # 圈数槽
    $V_圈槽 = $V_投k + $V_圈数半宽
    IF $V_圈槽 >= 0 and $V_圈槽 < $V_圈数槽数
        $V_圈数表[$V_圈槽] = $V_圈数表[$V_圈槽] + 1
    ENDIF
    # Seed 槽（绝对偏差 = seed残差 + seed累计修正）
    $V_seed绝对 = $seed残差 + $seed累计
    $V_seed槽 = $V_seed绝对 + $V_Seed半宽
    $V_seed有效 = 0
    IF $V_seed槽 >= 0 and $V_seed槽 < $V_Seed槽数
        $V_Seed表[$V_seed槽] = $V_Seed表[$V_seed槽] + 1
        $V_seed有效 = 1
    ENDIF
    # 联合稀疏表：key 随同seed切换。仅当相位槽有效时入表。
    IF $V_相位有效 == 1
        IF $同seed == 1
            $V_联合key = $V_相位槽
        ELIF $V_seed有效 == 1
            $V_联合key = $V_seed槽 * $V_相位槽数 + $V_相位槽
        ELSE
            $V_联合key = 0 - 1
        ENDIF
        IF $V_联合key >= 0
            $V_找到 = 0
            $V_扫尾 = $V_联合长度 - 1
            FOR $V_li = 0 TO $V_扫尾
                IF $V_找到 == 0 and $V_联合键表[$V_li] == $V_联合key
                    $V_联合票表[$V_li] = $V_联合票表[$V_li] + 1
                    $V_找到 = 1
                ENDIF
            NEXT
            IF $V_找到 == 0 and $V_联合长度 < 256
                $V_联合键表[$V_联合长度] = $V_联合key
                $V_联合票表[$V_联合长度] = 1
                $V_联合长度 = $V_联合长度 + 1
            ENDIF
        ENDIF
    ENDIF
    RETURN 1
ENDFUNC

# 决策：相位表票堆众数(权威帧路径) + 圈数表众数 → 真帧中心；Seed表众数 → Seed中心；联合表 → 领先(异seed交叉验证)。
# 空相位表(无候选)→ 不改中心，RETURN 0。
FUNC 投票决策($进入TV: INT, $帧累计: INT, $seed累计: INT): INT
    # ---- 相位表众数（票堆窗聚合，平票取离目标近）----
    $V_帧最高堆 = 0
    $V_帧总票 = 0
    $V_相位最优槽 = 0 - 1
    $V_相位最优距 = 2147483647
    $V_决策尾 = $V_相位槽数 - 1
    FOR $V_ci = 0 TO $V_决策尾
        IF $V_相位表[$V_ci] > 0
            $V_帧总票 = $V_帧总票 + $V_相位表[$V_ci]
            $V_帧堆 = 0
            $V_窗低 = $V_ci - $V_票堆帧窗
            $V_窗高 = $V_ci + $V_票堆帧窗
            FOR $V_nj = $V_窗低 TO $V_窗高
                IF $V_nj >= 0 and $V_nj < $V_相位槽数
                    $V_帧堆 = $V_帧堆 + $V_相位表[$V_nj]
                ENDIF
            NEXT
            $V_ci偏 = $V_ci - $V_相位半宽
            IF $V_ci偏 < 0
                $V_ci偏 = 0 - $V_ci偏
            ENDIF
            $V_更新 = 0
            IF $V_帧堆 > $V_帧最高堆
                $V_更新 = 1
            ELIF $V_帧堆 == $V_帧最高堆 and $V_ci偏 < $V_相位最优距
                $V_更新 = 1
            ENDIF
            IF $V_更新 == 1
                $V_帧最高堆 = $V_帧堆
                $V_相位最优槽 = $V_ci
                $V_相位最优距 = $V_ci偏
            ENDIF
        ENDIF
    NEXT
    IF $V_相位最优槽 < 0
        RETURN 0
    ENDIF
    $V_众数相位 = $V_相位最优槽 - $V_相位半宽
    # 峰值偏差(离群判据基准) = 滑动窗重心($V_样本均值)，连续跟随、不被高堆众数钉死；投票设置帧窗每轮也同步更新
    $V_峰值偏差 = $V_样本均值
    # 相位次高堆（排除最优窗邻域）→ 帧领先
    $V_帧次高 = 0
    FOR $V_si = 0 TO $V_决策尾
        IF $V_相位表[$V_si] > 0
            $V_sd = $V_si - $V_相位最优槽
            IF $V_sd < 0
                $V_sd = 0 - $V_sd
            ENDIF
            IF $V_sd > $V_票堆帧窗
                $V_s堆 = 0
                $V_s低 = $V_si - $V_票堆帧窗
                $V_s高 = $V_si + $V_票堆帧窗
                FOR $V_snj = $V_s低 TO $V_s高
                    IF $V_snj >= 0 and $V_snj < $V_相位槽数
                        $V_s堆 = $V_s堆 + $V_相位表[$V_snj]
                    ENDIF
                NEXT
                IF $V_s堆 > $V_帧次高
                    $V_帧次高 = $V_s堆
                ENDIF
            ENDIF
        ENDIF
    NEXT
    $V_帧领先 = $V_帧最高堆 - $V_帧次高
    # ---- 圈数表众数（普通模式 圈半宽=0 → 恒槽0、圈数=0）----
    $V_众数圈数 = 0
    $V_圈最高 = 0
    $V_圈最优槽 = 0 - 1
    $V_圈最优距 = 2147483647
    $V_圈尾 = $V_圈数槽数 - 1
    FOR $V_ki = 0 TO $V_圈尾
        IF $V_圈数表[$V_ki] > 0
            $V_ki偏 = $V_ki - $V_圈数半宽
            IF $V_ki偏 < 0
                $V_ki偏 = 0 - $V_ki偏
            ENDIF
            $V_圈更新 = 0
            IF $V_圈数表[$V_ki] > $V_圈最高
                $V_圈更新 = 1
            ELIF $V_圈数表[$V_ki] == $V_圈最高 and $V_ki偏 < $V_圈最优距
                $V_圈更新 = 1
            ENDIF
            IF $V_圈更新 == 1
                $V_圈最高 = $V_圈数表[$V_ki]
                $V_圈最优槽 = $V_ki
                $V_圈最优距 = $V_ki偏
            ENDIF
        ENDIF
    NEXT
    IF $V_圈最优槽 >= 0
        $V_众数圈数 = $V_圈最优槽 - $V_圈数半宽
    ENDIF
    # 帧中心(候选选择/离群用) = 滑动窗重心(最近6轮命中均值) − 帧累计，相位空间(与归一化误差/候选距离同空间)。
    # 改用重心(取代众数)：连续跟随系统偏移/漂移，不被"高堆惯性+窗聚合+平票"钉死冻结。修正不再用它(改本轮命中半量)。
    $V_帧中心 = $V_样本均值 - $帧累计
    # 合成真帧(含圈,绝对残差空间)=圈簇均值×周期+众数相位-帧累计，供诊断/TV等待。圈样本<2(首轮簇未建)时 fallback 用众数圈。
    IF $进入TV == 1 and $V_周期 > 0
        IF $V_圈样本数 >= 2
            $V_真帧 = ($V_圈样本均值 * $V_周期 + $V_众数相位) - $帧累计
        ELSE
            $V_真帧 = ($V_众数圈数 * $V_周期 + $V_众数相位) - $帧累计
        ENDIF
    ELSE
        $V_真帧 = $V_帧中心
    ENDIF
    # 停糖用帧最优槽 = 圈×相位槽数 + 相位槽（普通模式圈=0 → 等价相位最优槽）
    $V_帧最优槽 = $V_众数圈数 * $V_相位槽数 + $V_相位最优槽
    # ---- Seed表众数（票堆Seed窗聚合）→ Seed中心（残差空间）----
    $V_Seed最高 = 0
    $V_Seed最优槽 = 0 - 1
    $V_Seed最优距 = 2147483647
    $V_Seed尾 = $V_Seed槽数 - 1
    FOR $V_di = 0 TO $V_Seed尾
        IF $V_Seed表[$V_di] > 0
            $V_Seed堆 = 0
            $V_d低 = $V_di - $V_票堆Seed窗
            $V_d高 = $V_di + $V_票堆Seed窗
            FOR $V_dnj = $V_d低 TO $V_d高
                IF $V_dnj >= 0 and $V_dnj < $V_Seed槽数
                    $V_Seed堆 = $V_Seed堆 + $V_Seed表[$V_dnj]
                ENDIF
            NEXT
            $V_di偏 = $V_di - $V_Seed半宽
            IF $V_di偏 < 0
                $V_di偏 = 0 - $V_di偏
            ENDIF
            $V_Seed更新 = 0
            IF $V_Seed堆 > $V_Seed最高
                $V_Seed更新 = 1
            ELIF $V_Seed堆 == $V_Seed最高 and $V_di偏 < $V_Seed最优距
                $V_Seed更新 = 1
            ENDIF
            IF $V_Seed更新 == 1
                $V_Seed最高 = $V_Seed堆
                $V_Seed最优槽 = $V_di
                $V_Seed最优距 = $V_di偏
            ENDIF
        ENDIF
    NEXT
    IF $V_Seed最优槽 >= 0
        $V_Seed中心 = ($V_Seed最优槽 - $V_Seed半宽) - $seed累计
    ENDIF
    # Seed中心改用最聚集簇均值(取代众数；旧众数/直方图仍算、留作联合表/诊断)。簇均值是绝对偏差→减累计回残差空间(同帧中心)
    $V_Seed中心 = $V_Seed样本均值 - $seed累计
    # ---- 联合稀疏表 最高/次高 → 联合领先（异seed交叉验证；同seed时退化为相位分布）----
    $V_联合最高 = 0
    $V_联合次高 = 0
    $V_联尾 = $V_联合长度 - 1
    FOR $V_ui = 0 TO $V_联尾
        IF $V_联合票表[$V_ui] > $V_联合最高
            $V_联合次高 = $V_联合最高
            $V_联合最高 = $V_联合票表[$V_ui]
        ELIF $V_联合票表[$V_ui] > $V_联合次高
            $V_联合次高 = $V_联合票表[$V_ui]
        ENDIF
    NEXT
    $V_联合领先 = $V_联合最高 - $V_联合次高
    RETURN 1
ENDFUNC

# 吃糖循环调用(每次迭代,投票决策后)：三条任一成立即停糖(返回1,可撤销)。
#   ② 真值解直通：跨轮连续≥2次独立真值解(候选塌缩=1且落重心附近,见 投票记真值解) → 独立铁证,最省糖。
#   ①③ 占比+自适应轮数：峰值堆占总票≥占比阈值 且 最优槽稳定,连续≥自适应轮数(=clamp(动态窗/系数,2,4)) → 停。
FUNC 投票更新停糖(): INT
    # ② 真值解直通(跨轮历史铁证,优先级最高)
    IF $V_真值解连续 >= 2
        $V_停糖原因 = 1
        $V_停糖标志 = 1
        RETURN 1
    ENDIF
    # ③ 自适应稳定轮数 = clamp(动态窗 / 系数, 2, 4)：抖动小少盯(快)、抖动大多盯(防偶然领先)
    $V_动态稳定轮数 = 带符号整除四舍五入($V_票堆帧窗, $V_停糖窗系数)
    IF $V_动态稳定轮数 < 2
        $V_动态稳定轮数 = 2
    ENDIF
    IF $V_动态稳定轮数 > 4
        $V_动态稳定轮数 = 4
    ENDIF
    # ① 占比：峰值堆 / (峰值堆+次高堆)，即峰值压过最近对手的比例。分母改用"峰值+次高"(=最高堆*2-领先)，
    #    不再用全局总票(跨轮陈散票会把占比永久稀释、致此判据永不触发)。只问主堆对第二堆的领先，与远处陈票无关。
    $V_占比 = 0
    IF $V_帧最高堆 > 0
        $V_占比 = $V_帧最高堆 * 100 / ($V_帧最高堆 * 2 - $V_帧领先)
    ENDIF
    IF $V_帧最优槽 == $V_上次帧最优槽 and $V_占比 >= $V_停糖占比阈值
        $V_稳定计数 = $V_稳定计数 + 1
    ELSE
        $V_稳定计数 = 1
        $V_上次帧最优槽 = $V_帧最优槽
    ENDIF
    IF $V_稳定计数 >= $V_动态稳定轮数
        $V_停糖原因 = 2
        $V_停糖标志 = 1
        RETURN 1
    ENDIF
    $V_停糖标志 = 0
    RETURN 0
ENDFUNC

# 校准末调(每大轮一次,本轮命中已定)：本轮真值解(候选塌缩=1) 且 命中落投票重心±动态窗内 → 跨轮连续数+1；
# 真值解但偏离远(疑新路径) → 重置为1(新起点)；非真值解 → 清0(连续性断)。供 投票更新停糖 ② 直通判定。
FUNC 投票记真值解($本轮真值解: INT, $命中偏离重心: INT): INT
    IF $本轮真值解 == 1
        IF $命中偏离重心 <= $V_票堆帧窗
            $V_真值解连续 = $V_真值解连续 + 1
        ELSE
            $V_真值解连续 = 1
        ENDIF
    ELSE
        $V_真值解连续 = 0
    ENDIF
    RETURN 1
ENDFUNC

# 停糖原因(0=未停,1=真值解直通,2=占比稳定)，供主脚本日志
FUNC 投票取停糖原因(): INT
    RETURN $V_停糖原因
ENDFUNC

# ===== 取结果（返回标量给主脚本）=====
FUNC 投票取帧中心(): INT
    RETURN $V_样本均值
ENDFUNC
FUNC 投票取剩余帧中心(): INT
    IF $V_周期 > 0
        $V_取剩余帧中心 = $V_样本均值 % $V_周期
        IF $V_取剩余帧中心 < 0
            $V_取剩余帧中心 = $V_取剩余帧中心 + $V_周期
        ENDIF
        RETURN $V_取剩余帧中心
    ENDIF
    RETURN $V_样本均值
ENDFUNC
# 当前动态堆范围(命中散布估窗)，供主脚本帧轴半量/全量边界判定
FUNC 投票取动态窗(): INT
    RETURN $V_票堆帧窗
ENDFUNC
FUNC 投票取剩余帧动态窗(): INT
    RETURN $V_票堆帧窗
ENDFUNC
FUNC 投票取剩余帧样本数(): INT
    RETURN $V_样本数
ENDFUNC
# Seed 轴动态窗(Seed主簇散布)，供主脚本 Seed 半量/全量边界 + 离群阈值
FUNC 投票取Seed动态窗(): INT
    RETURN $V_Seed票堆窗
ENDFUNC
FUNC 投票取Seed样本数(): INT
    RETURN $V_Seed样本数
ENDFUNC
# 圈轴动态窗(圈滑动窗簇散布=动态测得的圈抖动范围,非写死±1)，供主脚本判圈是否在自然抖动内/离群门控
FUNC 投票取圈动态窗(): INT
    RETURN $V_圈票堆窗
ENDFUNC
FUNC 投票取TV帧中心(): INT
    RETURN $V_圈样本均值
ENDFUNC
FUNC 投票取TV帧动态窗(): INT
    RETURN $V_圈票堆窗
ENDFUNC
FUNC 投票取TV帧样本数(): INT
    RETURN $V_圈样本数
ENDFUNC
# TV合成真帧(含圈,绝对残差空间)；普通模式=帧中心。供诊断/TV等待用，不参与相位空间候选选择。
FUNC 投票取真帧(): INT
    RETURN $V_真帧
ENDFUNC
FUNC 投票取帧领先(): INT
    RETURN $V_帧领先
ENDFUNC
FUNC 投票取帧最高堆(): INT
    RETURN $V_帧最高堆
ENDFUNC
FUNC 投票取稳定计数(): INT
    RETURN $V_稳定计数
ENDFUNC
FUNC 投票取Seed中心(): INT
    RETURN $V_Seed中心
ENDFUNC
FUNC 投票取Seed绝对中心(): INT
    RETURN $V_Seed样本均值
ENDFUNC
FUNC 投票取Seed校准目标(): INT
    RETURN $V_Seed校准目标
ENDFUNC
FUNC 投票取Seed校准目标票数(): INT
    RETURN $V_Seed校准目标票数
ENDFUNC
FUNC 投票取Seed校准样本数(): INT
    RETURN $V_Seed校准样本数
ENDFUNC
FUNC 投票取联合领先(): INT
    RETURN $V_联合领先
ENDFUNC

# ===== 票堆驱动候选选择 + NPC离群过滤 + 动态窗 =====
# 把帧残差原始(+累计)分解到相位绝对偏差(与投票投候选一致)；普通模式=帧绝对，TV模式=模周期相位 r。
FUNC 算相位绝对($帧残差原始: INT, $帧累计: INT, $进入TV: INT): INT
    $V_帧绝对 = $帧残差原始 + $帧累计
    IF $进入TV == 1 and $V_周期 > 0
        $V_临k = 带符号整除四舍五入($V_帧绝对, $V_周期)
        $V_临r = $V_帧绝对 - $V_临k * $V_周期
        # 相位边界闭合：-相位半宽 收口到 +相位半宽(同相位)，与投票投候选一致
        IF $V_临r == 0 - $V_相位半宽
            $V_临r = $V_相位半宽
        ENDIF
        RETURN $V_临r
    ENDIF
    RETURN $V_帧绝对
ENDFUNC

# 查某候选落点的累积票堆高度(该相位槽 ±动态窗 票数和)。供候选选择"选落在最高票堆者"。
FUNC 投票查候选票堆($帧残差原始: INT, $帧累计: INT, $进入TV: INT): INT
    $V_查投r = 算相位绝对($帧残差原始, $帧累计, $进入TV)
    $V_查槽 = $V_查投r + $V_相位半宽
    $V_查堆 = 0
    $V_查低 = $V_查槽 - $V_票堆帧窗
    $V_查高 = $V_查槽 + $V_票堆帧窗
    FOR $V_qi = $V_查低 TO $V_查高
        IF $V_qi >= 0 and $V_qi < $V_相位槽数
            $V_查堆 = $V_查堆 + $V_相位表[$V_qi]
        ENDIF
    NEXT
    RETURN $V_查堆
ENDFUNC

# 离群孤票判定：离峰值偏差 > 窗×离群K 且 该处票堆 < 峰值堆/离群票比 → 1(NPC级离群)。历史不足(峰值堆≤1)→0。
FUNC 投票候选是否离群($帧残差原始: INT, $帧累计: INT, $进入TV: INT): INT
    IF $V_帧最高堆 <= 1
        RETURN 0
    ENDIF
    # 冷启动保护：样本未攒够 → 基准(重心/峰值)不可信，不判离群(让开局命中喂样本、中心自由收敛，破首轮偏中心死锁)
    IF $V_样本数 < $V_离群启用样本数
        RETURN 0
    ENDIF
    $V_离投r = 算相位绝对($帧残差原始, $帧累计, $进入TV)
    $V_离距 = $V_离投r - $V_峰值偏差
    IF $V_离距 < 0
        $V_离距 = 0 - $V_离距
    ENDIF
    # 纯相对判据：偏离峰值 > 动态窗×K 即离群。动态窗已自适应反映真路径抖动幅度(抖动大→窗大→不误杀)，
    # 且早期(堆高未攒够)也有效。原"票堆<峰值堆/离群票比"条件因整数除归零(峰值堆<离群票比时=0)+早期堆小而失效，已弃用。
    $V_离阈 = $V_票堆帧窗 * $V_离群K
    IF $V_离距 > $V_离阈
        RETURN 1
    ENDIF
    RETURN 0
ENDFUNC

FUNC 投票TV帧候选是否离群($帧残差原始: INT, $帧累计: INT, $进入TV: INT): INT
    IF $进入TV == 0 or $V_周期 <= 0
        RETURN 0
    ENDIF
    IF $V_圈样本数 < $V_离群启用样本数
        RETURN 0
    ENDIF
    $V_TV离投k = 带符号整除四舍五入($帧残差原始 + $帧累计, $V_周期)
    $V_TV离距 = $V_TV离投k - $V_圈样本均值
    IF $V_TV离距 < 0
        $V_TV离距 = 0 - $V_TV离距
    ENDIF
    $V_TV离阈 = $V_圈票堆窗 * $V_离群K
    IF $V_TV离距 > $V_TV离阈
        RETURN 1
    ENDIF
    RETURN 0
ENDFUNC

# 喂一个命中样本(离群/非离群都喂，滑动窗连续跟随)→ 求最聚集簇：中心=主簇均值、动态窗=主簇中心半径(抗离群)。
FUNC 投票设置帧窗($帧残差原始: INT, $帧累计: INT, $进入TV: INT): INT
    $V_新样本 = 算相位绝对($帧残差原始, $帧累计, $进入TV)
    $V_命中样本[$V_样本指针] = $V_新样本
    $V_样本指针 = $V_样本指针 + 1
    IF $V_样本指针 >= 6
        $V_样本指针 = 0
    ENDIF
    IF $V_样本数 < 6
        $V_样本数 = $V_样本数 + 1
    ENDIF
    $V_样尾 = $V_样本数 - 1
    # 样本<2：中心未定(第1轮不设中心=0，候选按离目标最近选)；动态窗给初始2
    IF $V_样本数 < 2
        $V_样本均值 = 0
        $V_峰值偏差 = 0
        $V_票堆帧窗 = 2
        RETURN 1
    ENDIF
    # 最聚集簇：每个样本作核，数 ±建簇窗 内邻居(含自己)；邻居最多=主簇。
    # 建簇窗至少3，避免早期 -13/-16 这类连续命中因初始窗2接不上，平票误选靠0孤点。
    $V_建簇窗 = $V_票堆帧窗
    IF $V_建簇窗 < 3
        $V_建簇窗 = 3
    ENDIF
    $V_最佳簇数 = 0
    $V_最佳簇和 = 0
    $V_最佳簇核值 = 0
    $V_最佳簇最大 = 0
    $V_最佳簇最小 = 0
    FOR $V_ci2 = 0 TO $V_样尾
        $V_核值 = $V_命中样本[$V_ci2]
        $V_簇数 = 0
        $V_簇和 = 0
        $V_簇最大 = 0 - 2147483647
        $V_簇最小 = 2147483647
        FOR $V_cj2 = 0 TO $V_样尾
            $V_簇距 = $V_命中样本[$V_cj2] - $V_核值
            IF $V_簇距 < 0
                $V_簇距 = 0 - $V_簇距
            ENDIF
            IF $V_簇距 <= $V_建簇窗
                $V_簇数 = $V_簇数 + 1
                $V_簇和 = $V_簇和 + $V_命中样本[$V_cj2]
                IF $V_命中样本[$V_cj2] > $V_簇最大
                    $V_簇最大 = $V_命中样本[$V_cj2]
                ENDIF
                IF $V_命中样本[$V_cj2] < $V_簇最小
                    $V_簇最小 = $V_命中样本[$V_cj2]
                ENDIF
            ENDIF
        NEXT
        $V_簇更新 = 0
        IF $V_簇数 > $V_最佳簇数
            $V_簇更新 = 1
        ELIF $V_簇数 == $V_最佳簇数
            $V_核绝 = $V_核值
            IF $V_核绝 < 0
                $V_核绝 = 0 - $V_核绝
            ENDIF
            $V_佳绝 = $V_最佳簇核值
            IF $V_佳绝 < 0
                $V_佳绝 = 0 - $V_佳绝
            ENDIF
            IF $V_核绝 < $V_佳绝
                $V_簇更新 = 1
            ENDIF
        ENDIF
        IF $V_簇更新 == 1
            $V_最佳簇数 = $V_簇数
            $V_最佳簇和 = $V_簇和
            $V_最佳簇核值 = $V_核值
            $V_最佳簇最大 = $V_簇最大
            $V_最佳簇最小 = $V_簇最小
        ENDIF
    NEXT
    # 中心=主簇均值；动态窗=主簇内样本到中心的最大距离 clamp[2,上限]。离群点不进主簇→中心/窗都不被带偏
    $V_样本均值 = 带符号整除四舍五入($V_最佳簇和, $V_最佳簇数)
    $V_峰值偏差 = $V_样本均值
    $V_散布 = 0
    FOR $V_cj2 = 0 TO $V_样尾
        $V_簇距 = $V_命中样本[$V_cj2] - $V_最佳簇核值
        IF $V_簇距 < 0
            $V_簇距 = 0 - $V_簇距
        ENDIF
        IF $V_簇距 <= $V_建簇窗
            $V_簇距 = $V_命中样本[$V_cj2] - $V_样本均值
            IF $V_簇距 < 0
                $V_簇距 = 0 - $V_簇距
            ENDIF
            IF $V_簇距 > $V_散布
                $V_散布 = $V_簇距
            ENDIF
        ENDIF
    NEXT
    IF $V_散布 < 2
        $V_散布 = 2
    ENDIF
    IF $V_散布 > $V_窗上限
        $V_散布 = $V_窗上限
    ENDIF
    $V_票堆帧窗 = $V_散布
    RETURN 1
ENDFUNC

# 喂一个Seed命中样本(绝对偏差=差索引+累计，离群/非离群都喂)→ 最聚集簇：Seed簇均值(绝对) + Seed动态窗=主簇中心半径。聚类阈值=上轮Seed动态窗；样本<2不设中心(=0)。
FUNC 投票设置Seed窗($Seed残差原始: INT, $seed累计: INT): INT
    $V_Seed新样本 = $Seed残差原始 + $seed累计
    $V_Seed命中样本[$V_Seed样本指针] = $V_Seed新样本
    $V_Seed样本指针 = $V_Seed样本指针 + 1
    IF $V_Seed样本指针 >= 6
        $V_Seed样本指针 = 0
    ENDIF
    IF $V_Seed样本数 < 6
        $V_Seed样本数 = $V_Seed样本数 + 1
    ENDIF
    $V_Seed样尾 = $V_Seed样本数 - 1
    IF $V_Seed样本数 < 2
        $V_Seed样本均值 = 0
        $V_Seed峰值偏差 = 0
        $V_Seed票堆窗 = 2
        RETURN 1
    ENDIF
    $V_Seed最佳簇数 = 0
    $V_Seed最佳簇和 = 0
    $V_Seed最佳簇核值 = 0
    $V_Seed最佳簇最大 = 0
    $V_Seed最佳簇最小 = 0
    FOR $V_Sci = 0 TO $V_Seed样尾
        $V_Seed核值 = $V_Seed命中样本[$V_Sci]
        $V_Seed簇数 = 0
        $V_Seed簇和 = 0
        $V_Seed簇最大 = 0 - 2147483647
        $V_Seed簇最小 = 2147483647
        FOR $V_Scj = 0 TO $V_Seed样尾
            $V_Seed簇距 = $V_Seed命中样本[$V_Scj] - $V_Seed核值
            IF $V_Seed簇距 < 0
                $V_Seed簇距 = 0 - $V_Seed簇距
            ENDIF
            IF $V_Seed簇距 <= $V_Seed票堆窗
                $V_Seed簇数 = $V_Seed簇数 + 1
                $V_Seed簇和 = $V_Seed簇和 + $V_Seed命中样本[$V_Scj]
                IF $V_Seed命中样本[$V_Scj] > $V_Seed簇最大
                    $V_Seed簇最大 = $V_Seed命中样本[$V_Scj]
                ENDIF
                IF $V_Seed命中样本[$V_Scj] < $V_Seed簇最小
                    $V_Seed簇最小 = $V_Seed命中样本[$V_Scj]
                ENDIF
            ENDIF
        NEXT
        $V_Seed簇更新 = 0
        IF $V_Seed簇数 > $V_Seed最佳簇数
            $V_Seed簇更新 = 1
        ELIF $V_Seed簇数 == $V_Seed最佳簇数
            $V_Seed核绝 = $V_Seed核值
            IF $V_Seed核绝 < 0
                $V_Seed核绝 = 0 - $V_Seed核绝
            ENDIF
            $V_Seed佳绝 = $V_Seed最佳簇核值
            IF $V_Seed佳绝 < 0
                $V_Seed佳绝 = 0 - $V_Seed佳绝
            ENDIF
            IF $V_Seed核绝 < $V_Seed佳绝
                $V_Seed簇更新 = 1
            ENDIF
        ENDIF
        IF $V_Seed簇更新 == 1
            $V_Seed最佳簇数 = $V_Seed簇数
            $V_Seed最佳簇和 = $V_Seed簇和
            $V_Seed最佳簇核值 = $V_Seed核值
            $V_Seed最佳簇最大 = $V_Seed簇最大
            $V_Seed最佳簇最小 = $V_Seed簇最小
        ENDIF
    NEXT
    $V_Seed样本均值 = 带符号整除四舍五入($V_Seed最佳簇和, $V_Seed最佳簇数)
    $V_Seed峰值偏差 = $V_Seed样本均值
    $V_Seed散布 = 0
    FOR $V_Scj = 0 TO $V_Seed样尾
        $V_Seed簇距 = $V_Seed命中样本[$V_Scj] - $V_Seed最佳簇核值
        IF $V_Seed簇距 < 0
            $V_Seed簇距 = 0 - $V_Seed簇距
        ENDIF
        IF $V_Seed簇距 <= $V_Seed票堆窗
            $V_Seed簇距 = $V_Seed命中样本[$V_Scj] - $V_Seed样本均值
            IF $V_Seed簇距 < 0
                $V_Seed簇距 = 0 - $V_Seed簇距
            ENDIF
            IF $V_Seed簇距 > $V_Seed散布
                $V_Seed散布 = $V_Seed簇距
            ENDIF
        ENDIF
    NEXT
    IF $V_Seed散布 < 2
        $V_Seed散布 = 2
    ENDIF
    IF $V_Seed散布 > $V_窗上限
        $V_Seed散布 = $V_窗上限
    ENDIF
    $V_Seed票堆窗 = $V_Seed散布
    RETURN 1
ENDFUNC

# 记录最终命中的Seed绝对落点，并取最近12轮的“精确众数”作为校准目标。
# 平票依次取：更靠近6轮鲁棒簇中心、上轮校准目标、目标0。这样首轮异常不会长期锁死。
FUNC 投票设置Seed校准样本($Seed残差原始: INT, $seed累计: INT): INT
    $V_Seed校准新样本 = $Seed残差原始 + $seed累计
    $V_Seed校准样本[$V_Seed校准样本指针] = $V_Seed校准新样本
    $V_Seed校准样本指针 = $V_Seed校准样本指针 + 1
    IF $V_Seed校准样本指针 >= 12
        $V_Seed校准样本指针 = 0
    ENDIF
    IF $V_Seed校准样本数 < 12
        $V_Seed校准样本数 = $V_Seed校准样本数 + 1
    ENDIF

    $V_Seed校准旧目标 = $V_Seed校准目标
    $V_Seed校准目标票数 = 0
    $V_Seed校准尾 = $V_Seed校准样本数 - 1
    FOR $V_Seed校准i = 0 TO $V_Seed校准尾
        $V_Seed校准候选 = $V_Seed校准样本[$V_Seed校准i]
        $V_Seed校准候选票 = 0
        FOR $V_Seed校准j = 0 TO $V_Seed校准尾
            IF $V_Seed校准样本[$V_Seed校准j] == $V_Seed校准候选
                $V_Seed校准候选票 = $V_Seed校准候选票 + 1
            ENDIF
        NEXT

        $V_Seed校准更新 = 0
        IF $V_Seed校准候选票 > $V_Seed校准目标票数
            $V_Seed校准更新 = 1
        ELIF $V_Seed校准候选票 == $V_Seed校准目标票数
            $V_Seed校准候选簇距 = $V_Seed校准候选 - $V_Seed样本均值
            IF $V_Seed校准候选簇距 < 0
                $V_Seed校准候选簇距 = 0 - $V_Seed校准候选簇距
            ENDIF
            $V_Seed校准目标簇距 = $V_Seed校准目标 - $V_Seed样本均值
            IF $V_Seed校准目标簇距 < 0
                $V_Seed校准目标簇距 = 0 - $V_Seed校准目标簇距
            ENDIF
            IF $V_Seed校准候选簇距 < $V_Seed校准目标簇距
                $V_Seed校准更新 = 1
            ELIF $V_Seed校准候选簇距 == $V_Seed校准目标簇距
                $V_Seed校准候选旧距 = $V_Seed校准候选 - $V_Seed校准旧目标
                IF $V_Seed校准候选旧距 < 0
                    $V_Seed校准候选旧距 = 0 - $V_Seed校准候选旧距
                ENDIF
                $V_Seed校准目标旧距 = $V_Seed校准目标 - $V_Seed校准旧目标
                IF $V_Seed校准目标旧距 < 0
                    $V_Seed校准目标旧距 = 0 - $V_Seed校准目标旧距
                ENDIF
                IF $V_Seed校准候选旧距 < $V_Seed校准目标旧距
                    $V_Seed校准更新 = 1
                ELIF $V_Seed校准候选旧距 == $V_Seed校准目标旧距
                    $V_Seed校准候选零距 = $V_Seed校准候选
                    IF $V_Seed校准候选零距 < 0
                        $V_Seed校准候选零距 = 0 - $V_Seed校准候选零距
                    ENDIF
                    $V_Seed校准目标零距 = $V_Seed校准目标
                    IF $V_Seed校准目标零距 < 0
                        $V_Seed校准目标零距 = 0 - $V_Seed校准目标零距
                    ENDIF
                    IF $V_Seed校准候选零距 < $V_Seed校准目标零距
                        $V_Seed校准更新 = 1
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
        IF $V_Seed校准更新 == 1
            $V_Seed校准目标 = $V_Seed校准候选
            $V_Seed校准目标票数 = $V_Seed校准候选票
        ENDIF
    NEXT
    RETURN 1
ENDFUNC

# Seed候选是否离群：Seed绝对偏差(差索引+累计) 偏离 Seed簇中心 > Seed动态窗×离群K → 离群。冷启动(样本<启用数)不判。
FUNC 投票Seed候选是否离群($Seed残差原始: INT, $seed累计: INT): INT
    IF $V_Seed样本数 < $V_离群启用样本数
        RETURN 0
    ENDIF
    $V_Seed离距 = ($Seed残差原始 + $seed累计) - $V_Seed峰值偏差
    IF $V_Seed离距 < 0
        $V_Seed离距 = 0 - $V_Seed离距
    ENDIF
    $V_Seed离阈 = $V_Seed票堆窗 * $V_离群K
    IF $V_Seed离距 > $V_Seed离阈
        RETURN 1
    ENDIF
    RETURN 0
ENDFUNC

# 喂一个圈数样本(帧绝对÷周期，仅TV)→ 最聚集簇：圈簇均值(真帧合成用) + 圈动态窗=主簇中心半径。普通模式(周期0)跳过。聚类阈值=上轮圈动态窗。
FUNC 投票设置圈窗($帧残差原始: INT, $帧累计: INT, $进入TV: INT): INT
    IF $进入TV == 0 or $V_周期 <= 0
        RETURN 1
    ENDIF
    $V_圈新样本 = 带符号整除四舍五入($帧残差原始 + $帧累计, $V_周期)
    $V_圈命中样本[$V_圈样本指针] = $V_圈新样本
    $V_圈样本指针 = $V_圈样本指针 + 1
    IF $V_圈样本指针 >= 6
        $V_圈样本指针 = 0
    ENDIF
    IF $V_圈样本数 < 6
        $V_圈样本数 = $V_圈样本数 + 1
    ENDIF
    $V_圈样尾 = $V_圈样本数 - 1
    IF $V_圈样本数 < 2
        $V_圈样本均值 = $V_圈新样本
        $V_圈票堆窗 = 2
        RETURN 1
    ENDIF
    $V_圈最佳簇数 = 0
    $V_圈最佳簇和 = 0
    $V_圈最佳簇核值 = 0
    $V_圈最佳簇最大 = 0
    $V_圈最佳簇最小 = 0
    FOR $V_圈ci = 0 TO $V_圈样尾
        $V_圈核值 = $V_圈命中样本[$V_圈ci]
        $V_圈簇数 = 0
        $V_圈簇和 = 0
        $V_圈簇最大 = 0 - 2147483647
        $V_圈簇最小 = 2147483647
        FOR $V_圈cj = 0 TO $V_圈样尾
            $V_圈簇距 = $V_圈命中样本[$V_圈cj] - $V_圈核值
            IF $V_圈簇距 < 0
                $V_圈簇距 = 0 - $V_圈簇距
            ENDIF
            IF $V_圈簇距 <= $V_圈票堆窗
                $V_圈簇数 = $V_圈簇数 + 1
                $V_圈簇和 = $V_圈簇和 + $V_圈命中样本[$V_圈cj]
                IF $V_圈命中样本[$V_圈cj] > $V_圈簇最大
                    $V_圈簇最大 = $V_圈命中样本[$V_圈cj]
                ENDIF
                IF $V_圈命中样本[$V_圈cj] < $V_圈簇最小
                    $V_圈簇最小 = $V_圈命中样本[$V_圈cj]
                ENDIF
            ENDIF
        NEXT
        $V_圈簇更新 = 0
        IF $V_圈簇数 > $V_圈最佳簇数
            $V_圈簇更新 = 1
        ELIF $V_圈簇数 == $V_圈最佳簇数
            $V_圈核绝 = $V_圈核值
            IF $V_圈核绝 < 0
                $V_圈核绝 = 0 - $V_圈核绝
            ENDIF
            $V_圈佳绝 = $V_圈最佳簇核值
            IF $V_圈佳绝 < 0
                $V_圈佳绝 = 0 - $V_圈佳绝
            ENDIF
            IF $V_圈核绝 < $V_圈佳绝
                $V_圈簇更新 = 1
            ENDIF
        ENDIF
        IF $V_圈簇更新 == 1
            $V_圈最佳簇数 = $V_圈簇数
            $V_圈最佳簇和 = $V_圈簇和
            $V_圈最佳簇核值 = $V_圈核值
            $V_圈最佳簇最大 = $V_圈簇最大
            $V_圈最佳簇最小 = $V_圈簇最小
        ENDIF
    NEXT
    $V_圈样本均值 = 带符号整除四舍五入($V_圈最佳簇和, $V_圈最佳簇数)
    $V_圈散布 = 0
    FOR $V_圈cj = 0 TO $V_圈样尾
        $V_圈簇距 = $V_圈命中样本[$V_圈cj] - $V_圈最佳簇核值
        IF $V_圈簇距 < 0
            $V_圈簇距 = 0 - $V_圈簇距
        ENDIF
        IF $V_圈簇距 <= $V_圈票堆窗
            $V_圈簇距 = $V_圈命中样本[$V_圈cj] - $V_圈样本均值
            IF $V_圈簇距 < 0
                $V_圈簇距 = 0 - $V_圈簇距
            ENDIF
            IF $V_圈簇距 > $V_圈散布
                $V_圈散布 = $V_圈簇距
            ENDIF
        ENDIF
    NEXT
    IF $V_圈散布 < 2
        $V_圈散布 = 2
    ENDIF
    IF $V_圈散布 > $V_窗上限
        $V_圈散布 = $V_窗上限
    ENDIF
    $V_圈票堆窗 = $V_圈散布
    RETURN 1
ENDFUNC

FUNC 投票设置TV帧窗($帧残差原始: INT, $帧累计: INT, $进入TV: INT): INT
    $V_TV帧窗返回 = 投票设置圈窗($帧残差原始, $帧累计, $进入TV)
    RETURN $V_TV帧窗返回
ENDFUNC

# 诊断：打印直方图票表(各表非零槽)+滑动窗命中样本(簇原料)，供分析多堆/多簇实际分布。每轮校准末调一次。
# 直方图=跨轮累计全体候选票(相位/Seed/圈/联合)；滑动窗=最近6轮命中(中心/动态窗的原料)，两者来源不同。
FUNC 投票打印直方图($进入TV: INT): INT
    PRINT ""
    PRINT 【候选票表诊断】
    PRINT 说明: 本区块是跨轮候选票/距离诊断；路径簇以【命中滑窗簇】为准，每轮每轴只写入最终命中样本
    # 剩余帧误差表(带符号误差，TV下为周期内最近误差；剩余帧落点本身在日志中转为非负显示)
    $V_打印行 = "剩余帧误差表(误差:票): "
    $V_打印尾 = $V_相位槽数 - 1
    FOR $V_打印i = 0 TO $V_打印尾
        IF $V_相位表[$V_打印i] > 0
            $V_打印偏 = $V_打印i - $V_相位半宽
            $V_打印值 = $V_相位表[$V_打印i]
            $V_打印行 = $V_打印行 & "误差" & $V_打印偏 & ":" & $V_打印值 & "  "
        ENDIF
    NEXT
    PRINT $V_打印行
    PRINT 剩余帧误差最高堆: & $V_帧最高堆 & " 总票 " & $V_帧总票 & " 领先 " & $V_帧领先 & " 误差中心 " & $V_样本均值 & " 窗 " & $V_票堆帧窗
    # Seed表(seed绝对偏差直方图，偏差=槽-Seed半宽)，全段拼一行
    $V_打印行 = "Seed表(seed偏差:票): "
    $V_打印尾 = $V_Seed槽数 - 1
    FOR $V_打印i = 0 TO $V_打印尾
        IF $V_Seed表[$V_打印i] > 0
            $V_打印偏 = $V_打印i - $V_Seed半宽
            $V_打印值 = $V_Seed表[$V_打印i]
            $V_打印行 = $V_打印行 & "seed" & $V_打印偏 & ":" & $V_打印值 & "  "
        ENDIF
    NEXT
    PRINT $V_打印行
    PRINT Seed簇中心: & $V_Seed样本均值 & " 窗 " & $V_Seed票堆窗
    # TV帧表(仅TV，偏差=槽-TV帧半宽)，全段拼一行
    IF $进入TV == 1 and $V_周期 > 0
        $V_打印行 = "TV帧表(TV帧:票): "
        $V_打印尾 = $V_圈数槽数 - 1
        FOR $V_打印i = 0 TO $V_打印尾
            IF $V_圈数表[$V_打印i] > 0
                $V_打印偏 = $V_打印i - $V_圈数半宽
                $V_打印值 = $V_圈数表[$V_打印i]
                $V_打印行 = $V_打印行 & "TV帧" & $V_打印偏 & ":" & $V_打印值 & "  "
            ENDIF
        NEXT
        PRINT $V_打印行
        PRINT TV帧簇中心: & $V_圈样本均值 & " 窗 " & $V_圈票堆窗
    ENDIF
    # 联合稀疏表(key:票)，异seed交叉验证，全段拼一行
    $V_打印行 = "联合表(key:票) 长度" & $V_联合长度 & ": "
    $V_打印尾 = $V_联合长度 - 1
    FOR $V_打印i = 0 TO $V_打印尾
        IF $V_联合票表[$V_打印i] > 0
            $V_打印偏 = $V_联合键表[$V_打印i]
            $V_打印值 = $V_联合票表[$V_打印i]
            $V_打印行 = $V_打印行 & "key" & $V_打印偏 & ":" & $V_打印值 & "  "
        ENDIF
    NEXT
    PRINT $V_打印行
    # 剩余帧误差滑动窗命中样本(最近6轮命中=簇原料；指针指向下一个写入位)，全段拼一行
    $V_打印行 = "剩余帧误差命中样本(滑动窗) 样本数" & $V_样本数 & " 指针" & $V_样本指针 & ": "
    FOR $V_打印i = 0 TO 5
        $V_打印值 = $V_命中样本[$V_打印i]
        $V_打印行 = $V_打印行 & "[" & $V_打印i & "]" & $V_打印值 & "  "
    NEXT
    PRINT $V_打印行
    IF $进入TV == 1 and $V_周期 > 0
        $V_打印行 = "TV帧命中样本(滑动窗) 样本数" & $V_圈样本数 & " 指针" & $V_圈样本指针 & ": "
        FOR $V_打印i = 0 TO 5
            $V_打印值 = $V_圈命中样本[$V_打印i]
            $V_打印行 = $V_打印行 & "[" & $V_打印i & "]" & $V_打印值 & "  "
        NEXT
        PRINT $V_打印行
    ENDIF
    $V_打印行 = "Seed命中样本(滑动窗) 样本数" & $V_Seed样本数 & " 指针" & $V_Seed样本指针 & ": "
    FOR $V_打印i = 0 TO 5
        $V_打印值 = $V_Seed命中样本[$V_打印i]
        $V_打印行 = $V_打印行 & "[" & $V_打印i & "]" & $V_打印值 & "  "
    NEXT
    PRINT $V_打印行
    RETURN 1
ENDFUNC
