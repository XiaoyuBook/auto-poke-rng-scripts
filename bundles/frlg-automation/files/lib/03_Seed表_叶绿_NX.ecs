FUNC 取SeedHEX_叶绿($idx: INT, $mode: INT): STRING
    IF $idx < 0 or $idx > 2437
        RETURN ""
    ENDIF
    IF $mode == 0
        RETURN $Seed_HEX_叶绿_m0[$idx]
    ELIF $mode == 1
        RETURN $Seed_HEX_叶绿_m1[$idx]
    ELIF $mode == 2
        RETURN $Seed_HEX_叶绿_m2[$idx]
    ELIF $mode == 3
        RETURN $Seed_HEX_叶绿_m3[$idx]
    ELIF $mode == 4
        RETURN $Seed_HEX_叶绿_m4[$idx]
    ELIF $mode == 5
        RETURN $Seed_HEX_叶绿_m5[$idx]
    ELIF $mode == 6
        RETURN $Seed_HEX_叶绿_m6[$idx]
    ELIF $mode == 7
        RETURN $Seed_HEX_叶绿_m7[$idx]
    ELIF $mode == 8
        RETURN $Seed_HEX_叶绿_m8[$idx]
    ELIF $mode == 9
        RETURN $Seed_HEX_叶绿_m9[$idx]
    ELIF $mode == 10
        RETURN $Seed_HEX_叶绿_m10[$idx]
    ENDIF
    RETURN ""
ENDFUNC
