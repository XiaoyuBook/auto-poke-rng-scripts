# 游戏角奖品
FUNC 获取游戏角($F2: INT, $目标全国图鉴编号: INT, $游戏版本: INT): INT
    $F2执行 = $F2
    A
    WAIT 1500
    A
    WAIT 1500

    IF $目标全国图鉴编号 == 63
        # 凯西 / Abra
    ELIF $目标全国图鉴编号 == 35
        # 皮皮 / Clefairy
        DOWN
        WAIT 500
    ELIF ($目标全国图鉴编号 == 147 and $游戏版本 == 1) or (($目标全国图鉴编号 == 123 or $目标全国图鉴编号 == 127) and $游戏版本 == 2)
        # 迷你龙 / Dratini
        DOWN
        WAIT 500
        DOWN
        WAIT 500
    ELIF (($目标全国图鉴编号 == 123 or $目标全国图鉴编号 == 127) and $游戏版本 == 1) or ($目标全国图鉴编号 == 147 and $游戏版本 == 2)
        # 飞天螳螂 / Scyther
        # 凯罗斯 / Pinsir
        DOWN
        WAIT 500
        DOWN
        WAIT 500
        DOWN
        WAIT 500
    ELIF $目标全国图鉴编号 == 137
        # 多边兽 / Porygon
        UP
        WAIT 500
        UP
        WAIT 500
    ENDIF

    A
    WAIT 1500
    IF $计数 == 0
        $计数 = 1
        $time_F2 = TIME()
        RETURN $time_F2
    ENDIF
    $静态目标时间轴超时 = 静态目标等待F2($F2执行)
    A# 获取POKEMON RNG流程结束
    WAIT 3000
    B
    WAIT 500
    RETURN 1
ENDFUNC

# 97: 引梦貘人 / Hypno
# 101: 顽皮雷弹 / Electrode
# 143: 卡比兽 / Snorlax
FUNC 获取定点($F2: INT, $目标全国图鉴编号: INT, $识图阈值: INT, $出闪后继续抓捕: INT): INT
    $F2执行 = $F2
    IF $目标全国图鉴编号 == 97
        A
        WAIT 1000
        B
        WAIT 1500
        B
        WAIT 1000
        B
        WAIT 1500
        B
        WAIT 2000
        B
        WAIT 1000
        IF $计数 == 0
            $计数 = 1
            $time_F2 = TIME()
            RETURN $time_F2
        ENDIF
        $静态目标时间轴超时 = 静态目标等待F2($F2执行)
        A# 获取POKEMON RNG流程结束
        WAIT 7000
        B
        4500
    ELIF $目标全国图鉴编号 == 101
        IF $计数 == 0
            $计数 = 1
            $time_F2 = TIME()
            RETURN $time_F2
        ENDIF
        $静态目标时间轴超时 = 静态目标等待F2($F2执行)
        A# 获取POKEMON RNG流程结束
        WAIT 7000
        B
        WAIT 3500
    ELIF $目标全国图鉴编号 == 143
        A
        1000
        A
        9000
        B
        1000
        IF $计数 == 0
            $计数 = 1
            $time_F2 = TIME()
            RETURN $time_F2
        ENDIF
        $静态目标时间轴超时 = 静态目标等待F2($F2执行)
        A# 获取POKEMON RNG流程结束
        6500
        B
        4500
    ENDIF

    $出闪检测结果 = CheckCaptureShiny($目标全国图鉴编号, $识图阈值)
    IF $出闪检测结果 == 1 and $出闪后继续抓捕 == 0
        RETURN -1
    ENDIF
    $抓捕结果 = 扔球抓捕($目标全国图鉴编号, $出闪后继续抓捕, $出闪检测结果)

    IF $目标全国图鉴编号 == 97
        B
        WAIT 1000
        B
        WAIT 1000
        B
        WAIT 1500
        B
        WAIT 1500
        B
        WAIT 1000
        B
        WAIT 1500
        B
        WAIT 1000
        B
        WAIT 2500
        B
        WAIT 1500
        B
        WAIT 1500
        B
        WAIT 1500
        B
        WAIT 1500
        B
        WAIT 1500
        FOR
            IF @引梦游戏厅 > 95
                BREAK
            ENDIF
            B
            1500
        NEXT
    ENDIF

    RETURN $抓捕结果
ENDFUNC

