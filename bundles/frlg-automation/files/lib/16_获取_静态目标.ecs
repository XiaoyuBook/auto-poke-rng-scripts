# 144: 急冻鸟 / Articuno
# 145: 闪电鸟 / Zapdos
# 146: 火焰鸟 / Moltres
FUNC 获取三圣鸟($F2: INT, $目标全国图鉴编号: INT, $识图阈值: INT, $出闪后继续抓捕: INT): INT
    $F2执行 = $F2
    IF $计数 == 0
        $计数 = 1
        $time_F2 = TIME()
        RETURN $time_F2
    ENDIF
    $静态目标时间轴超时 = 静态目标等待F2($F2执行)
    A# 获取POKEMON RNG流程结束
    WAIT 2500
    A
    WAIT 5000
    B
    WAIT 3000

    $出闪检测结果 = CheckCaptureShiny($目标全国图鉴编号, $识图阈值)
    IF $出闪检测结果 == 1 and $出闪后继续抓捕 == 0
        RETURN -1
    ENDIF

    $抓捕结果 = 扔球抓捕($目标全国图鉴编号, $出闪后继续抓捕, $出闪检测结果)

    RETURN $抓捕结果
ENDFUNC

