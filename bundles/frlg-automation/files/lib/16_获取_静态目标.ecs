# ==================================================
# lib/16_获取_静态目标.ecs
# ==================================================
$计数 = 0
$time_F2 = -1
$静态目标时间轴模式 = 0
$静态目标时间轴截止 = 0
$静态目标时间轴尾段MS = 50
$静态目标时间轴当前 = 0
$静态目标时间轴剩余 = 0
$静态目标时间轴超时 = 0

FUNC 设置静态目标时间轴($模式: INT, $截止: INT, $尾段MS: INT): INT
    $静态目标时间轴模式 = $模式
    $静态目标时间轴截止 = $截止
    $静态目标时间轴尾段MS = $尾段MS
    RETURN 1
ENDFUNC

FUNC 静态目标等待F2($普通等待MS: INT): INT
    IF $静态目标时间轴模式 == 0
        WAIT $普通等待MS
        RETURN 0
    ENDIF

    $静态目标时间轴当前 = TIME()
    $静态目标时间轴剩余 = $静态目标时间轴截止 - $静态目标时间轴当前
    IF $静态目标时间轴剩余 > $静态目标时间轴尾段MS
        $静态目标时间轴剩余 = $静态目标时间轴剩余 - $静态目标时间轴尾段MS
        WAIT $静态目标时间轴剩余
    ENDIF

    FOR
        $静态目标时间轴当前 = TIME()
        IF $静态目标时间轴当前 >= $静态目标时间轴截止
            BREAK
        ENDIF
    NEXT

    $静态目标时间轴超时 = $静态目标时间轴当前 - $静态目标时间轴截止
    PRINT F2绝对时间轴(静态): 超时 & $静态目标时间轴超时 & " ms"
    RETURN $静态目标时间轴超时
ENDFUNC
# 1: 妙蛙种子 / Bulbasaur
# 4: 小火龙 / Charmander
# 7: 杰尼龟 / Squirtle
FUNC 获取御三家($F2: INT): INT
    $F2执行 = $F2
    A
    WAIT 1500
    A
    WAIT 1500
    A
    WAIT 1000
    IF $计数 == 0
        $计数 = 1
        $time_F2 = TIME()
        RETURN $time_F2
    ENDIF
    $静态目标时间轴超时 = 静态目标等待F2($F2执行)
    A# 获取POKEMON RNG流程结束
    WAIT 5000
    B
    WAIT 3000
    A
    WAIT 4000# 劲敌收到宝可梦
    RETURN 1
ENDFUNC

