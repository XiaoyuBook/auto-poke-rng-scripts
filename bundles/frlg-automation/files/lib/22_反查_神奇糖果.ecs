FUNC 使用神奇糖果(): INT
    PRINT "正在使用神奇糖果..."
    B#退出状态页面
    1500
    B
    500
    B
    1500
    DOWN
    500
    A#进入背包
    1500
    LEFT
    500
    LEFT
    500
    UP
    500
    UP
    500

    IF @神奇糖果 <= 95
        PRINT 没有神奇糖果了
        RETURN 0
    ENDIF

    A
    500
    A#使用神奇糖果
    1500
    UP
    500
    UP
    500
    A
    500
    B#退动画
    2500
    B#第一句
    500
    B#能力值变化
    500
    B#能力值
    2000
    IF @学习招式 > 95
        PRINT 取消学习招式
        B
        1500
    ELIF @想要学习招式 > 95
        PRINT 取消替换招式
        B
        1500
        B
        1500
        B
        1500
        A
        2000
        B
        1500
    ENDIF
    500
    IF @正在进化 > 95
        PRINT 取消进化
        7500
        B
        3000
        B
        2000
    ENDIF
    B
    1500

    RETURN 1
ENDFUNC
