FUNC 野生遇敌表编码($游戏版本: INT, $遭遇方法: INT, $遭遇地点: INT): INT
    RETURN ($游戏版本 * 256 + $遭遇方法) * 256 + $遭遇地点
ENDFUNC

FUNC 查找野生遇敌表索引($游戏版本: INT, $遭遇方法: INT, $遭遇地点: INT): INT
    $野生遇敌查找键 = 野生遇敌表编码($游戏版本, $遭遇方法, $遭遇地点)
    FOR $野生遇敌查找索引 = 0 TO 629
        IF $野生遇敌表键[$野生遇敌查找索引] == $野生遇敌查找键
            RETURN $野生遇敌查找索引
        ENDIF
    NEXT
    RETURN -1
ENDFUNC

FUNC 取野生遇敌槽打包值($野生遇敌表索引: INT, $野生遇敌槽: INT): INT
    IF $野生遇敌表索引 < 0 or $野生遇敌槽 < 0 or $野生遇敌槽 >= 12
        RETURN 0
    ENDIF
    $野生遇敌平面索引 = $野生遇敌表索引 * 12 + $野生遇敌槽
    IF $野生遇敌平面索引 < 900
        $野生遇敌分块索引 = $野生遇敌平面索引 - 0
        RETURN $野生遇敌槽打包表0[$野生遇敌分块索引]
    ELIF $野生遇敌平面索引 < 1800
        $野生遇敌分块索引 = $野生遇敌平面索引 - 900
        RETURN $野生遇敌槽打包表1[$野生遇敌分块索引]
    ELIF $野生遇敌平面索引 < 2700
        $野生遇敌分块索引 = $野生遇敌平面索引 - 1800
        RETURN $野生遇敌槽打包表2[$野生遇敌分块索引]
    ELIF $野生遇敌平面索引 < 3600
        $野生遇敌分块索引 = $野生遇敌平面索引 - 2700
        RETURN $野生遇敌槽打包表3[$野生遇敌分块索引]
    ELIF $野生遇敌平面索引 < 4500
        $野生遇敌分块索引 = $野生遇敌平面索引 - 3600
        RETURN $野生遇敌槽打包表4[$野生遇敌分块索引]
    ELIF $野生遇敌平面索引 < 5400
        $野生遇敌分块索引 = $野生遇敌平面索引 - 4500
        RETURN $野生遇敌槽打包表5[$野生遇敌分块索引]
    ELIF $野生遇敌平面索引 < 6300
        $野生遇敌分块索引 = $野生遇敌平面索引 - 5400
        RETURN $野生遇敌槽打包表6[$野生遇敌分块索引]
    ELIF $野生遇敌平面索引 < 7200
        $野生遇敌分块索引 = $野生遇敌平面索引 - 6300
        RETURN $野生遇敌槽打包表7[$野生遇敌分块索引]
    ELIF $野生遇敌平面索引 < 7560
        $野生遇敌分块索引 = $野生遇敌平面索引 - 7200
        RETURN $野生遇敌槽打包表8[$野生遇敌分块索引]
    ENDIF
    RETURN 0
ENDFUNC

FUNC 野生遇敌槽编号($遭遇方法: INT, $野生遇敌值: INT): INT
    $野生遇敌百分值 = $野生遇敌值 % 100
    IF $遭遇方法 == 101
        IF $野生遇敌百分值 < 20
            RETURN 0
        ELIF $野生遇敌百分值 < 40
            RETURN 1
        ELIF $野生遇敌百分值 < 50
            RETURN 2
        ELIF $野生遇敌百分值 < 60
            RETURN 3
        ELIF $野生遇敌百分值 < 70
            RETURN 4
        ELIF $野生遇敌百分值 < 80
            RETURN 5
        ELIF $野生遇敌百分值 < 85
            RETURN 6
        ELIF $野生遇敌百分值 < 90
            RETURN 7
        ELIF $野生遇敌百分值 < 94
            RETURN 8
        ELIF $野生遇敌百分值 < 98
            RETURN 9
        ELIF $野生遇敌百分值 < 99
            RETURN 10
        ELSE
            RETURN 11
        ENDIF
    ELIF $遭遇方法 == 102 or $遭遇方法 == 103
        IF $野生遇敌百分值 < 60
            RETURN 0
        ELIF $野生遇敌百分值 < 90
            RETURN 1
        ELIF $野生遇敌百分值 < 95
            RETURN 2
        ELIF $野生遇敌百分值 < 99
            RETURN 3
        ELSE
            RETURN 4
        ENDIF
    ELIF $遭遇方法 == 201
        IF $野生遇敌百分值 < 70
            RETURN 0
        ELSE
            RETURN 1
        ENDIF
    ELIF $遭遇方法 == 202
        IF $野生遇敌百分值 < 60
            RETURN 0
        ELIF $野生遇敌百分值 < 80
            RETURN 1
        ELSE
            RETURN 2
        ENDIF
    ELIF $遭遇方法 == 203
        IF $野生遇敌百分值 < 40
            RETURN 0
        ELIF $野生遇敌百分值 < 80
            RETURN 1
        ELIF $野生遇敌百分值 < 95
            RETURN 2
        ELIF $野生遇敌百分值 < 99
            RETURN 3
        ELSE
            RETURN 4
        ENDIF
    ENDIF
    RETURN -1
ENDFUNC
