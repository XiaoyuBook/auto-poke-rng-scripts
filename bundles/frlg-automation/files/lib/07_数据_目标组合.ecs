#
# 组合键编码：
#   (((游戏版本 * 400) + 图鉴编号) * 256 + 遭遇方法) * 256 + 遭遇地点
# 地点 0 表示原始条件不限制地点。
#
# 本文件把旧版重复七次的超长 ELIF 链压缩为共享数组查询。
# 对外函数名、参数、返回值保持不变。
# ==================================================

FUNC 是否游戏角目标($游戏版本: INT, $目标全国图鉴编号: INT, $遭遇方法: INT): INT
    IF $遭遇方法 != 4
        RETURN 0
    ENDIF
    IF $目标全国图鉴编号 == 35
        RETURN 1
    ELIF $目标全国图鉴编号 == 63
        RETURN 1
    ELIF $目标全国图鉴编号 == 137
        RETURN 1
    ELIF $目标全国图鉴编号 == 147
        RETURN 1
    ENDIF

    IF $游戏版本 == 1 and $目标全国图鉴编号 == 123
        RETURN 1
    ELIF $游戏版本 == 2 and $目标全国图鉴编号 == 127
        RETURN 1
    ENDIF

    RETURN 0
ENDFUNC

FUNC 游戏角目标等级($游戏版本: INT, $目标全国图鉴编号: INT): INT
    IF $游戏版本 == 1 and $目标全国图鉴编号 == 35
        RETURN 8
    ELIF $游戏版本 == 1 and $目标全国图鉴编号 == 63
        RETURN 9
    ELIF $游戏版本 == 1 and $目标全国图鉴编号 == 123
        RETURN 25
    ELIF $游戏版本 == 1 and $目标全国图鉴编号 == 137
        RETURN 26
    ELIF $游戏版本 == 1 and $目标全国图鉴编号 == 147
        RETURN 18
    ELIF $游戏版本 == 2 and $目标全国图鉴编号 == 35
        RETURN 12
    ELIF $游戏版本 == 2 and $目标全国图鉴编号 == 63
        RETURN 7
    ELIF $游戏版本 == 2 and $目标全国图鉴编号 == 127
        RETURN 18
    ELIF $游戏版本 == 2 and $目标全国图鉴编号 == 137
        RETURN 18
    ELIF $游戏版本 == 2 and $目标全国图鉴编号 == 147
        RETURN 24
    ENDIF

    RETURN -1
ENDFUNC

