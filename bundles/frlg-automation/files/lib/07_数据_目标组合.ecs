FUNC 查找目标组合索引($游戏版本: INT, $目标全国图鉴编号: INT, $遭遇方法: INT, $遭遇地点: INT): INT
    $目标组合精确键 = 目标组合编码($游戏版本, $目标全国图鉴编号, $遭遇方法, $遭遇地点)
    $目标组合通配键 = 目标组合编码($游戏版本, $目标全国图鉴编号, $遭遇方法, 0)
    FOR $目标组合查找索引 = 0 TO 1999
        IF $目标组合键表[$目标组合查找索引] == $目标组合精确键 or $目标组合键表[$目标组合查找索引] == $目标组合通配键
            RETURN $目标组合查找索引
        ENDIF
    NEXT
    RETURN -1
ENDFUNC

FUNC 目标是否支持($游戏版本: INT, $目标全国图鉴编号: INT, $遭遇方法: INT, $遭遇地点: INT): INT
    IF 是否游戏角目标($游戏版本, $目标全国图鉴编号, $遭遇方法) == 1
        RETURN 1
    ENDIF
    IF 查找目标组合索引($游戏版本, $目标全国图鉴编号, $遭遇方法, $遭遇地点) >= 0
        RETURN 1
    ENDIF
    RETURN 0
ENDFUNC

FUNC 目标默认等级($游戏版本: INT, $目标全国图鉴编号: INT, $遭遇方法: INT, $遭遇地点: INT): INT
    IF 是否游戏角目标($游戏版本, $目标全国图鉴编号, $遭遇方法) == 1
        RETURN 游戏角目标等级($游戏版本, $目标全国图鉴编号)
    ENDIF
    $目标组合结果索引 = 查找目标组合索引($游戏版本, $目标全国图鉴编号, $遭遇方法, $遭遇地点)
    IF $目标组合结果索引 < 0
        RETURN -1
    ENDIF
    RETURN $目标组合默认等级表[$目标组合结果索引]
ENDFUNC

FUNC 目标最低等级($游戏版本: INT, $目标全国图鉴编号: INT, $遭遇方法: INT, $遭遇地点: INT): INT
    IF 是否游戏角目标($游戏版本, $目标全国图鉴编号, $遭遇方法) == 1
        RETURN 游戏角目标等级($游戏版本, $目标全国图鉴编号)
    ENDIF
    $目标组合结果索引 = 查找目标组合索引($游戏版本, $目标全国图鉴编号, $遭遇方法, $遭遇地点)
    IF $目标组合结果索引 < 0
        RETURN -1
    ENDIF
    RETURN $目标组合最低等级表[$目标组合结果索引]
ENDFUNC

FUNC 目标最高等级($游戏版本: INT, $目标全国图鉴编号: INT, $遭遇方法: INT, $遭遇地点: INT): INT
    IF 是否游戏角目标($游戏版本, $目标全国图鉴编号, $遭遇方法) == 1
        RETURN 游戏角目标等级($游戏版本, $目标全国图鉴编号)
    ENDIF
    $目标组合结果索引 = 查找目标组合索引($游戏版本, $目标全国图鉴编号, $遭遇方法, $遭遇地点)
    IF $目标组合结果索引 < 0
        RETURN -1
    ENDIF
    RETURN $目标组合最高等级表[$目标组合结果索引]
ENDFUNC

FUNC 目标出现率($游戏版本: INT, $目标全国图鉴编号: INT, $遭遇方法: INT, $遭遇地点: INT): INT
    IF 是否游戏角目标($游戏版本, $目标全国图鉴编号, $遭遇方法) == 1
        RETURN 100
    ENDIF
    $目标组合结果索引 = 查找目标组合索引($游戏版本, $目标全国图鉴编号, $遭遇方法, $遭遇地点)
    IF $目标组合结果索引 < 0
        RETURN -1
    ENDIF
    RETURN $目标组合出现率表[$目标组合结果索引]
ENDFUNC

FUNC 目标默认计算方法($游戏版本: INT, $目标全国图鉴编号: INT, $遭遇方法: INT, $遭遇地点: INT): INT
    IF 是否游戏角目标($游戏版本, $目标全国图鉴编号, $遭遇方法) == 1
        RETURN 1
    ENDIF
    $目标组合结果索引 = 查找目标组合索引($游戏版本, $目标全国图鉴编号, $遭遇方法, $遭遇地点)
    IF $目标组合结果索引 < 0
        RETURN -1
    ENDIF
    RETURN $目标组合计算方法表[$目标组合结果索引]
ENDFUNC

FUNC 调试_目标组合存在($游戏版本: INT, $目标全国图鉴编号: INT, $遭遇方法: INT, $遭遇地点: INT): INT
    RETURN 目标是否支持($游戏版本, $目标全国图鉴编号, $遭遇方法, $遭遇地点)
ENDFUNC
