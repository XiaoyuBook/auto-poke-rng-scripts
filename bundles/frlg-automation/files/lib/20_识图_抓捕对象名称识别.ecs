FUNC 识别抓捕对象名称优先OCR($识图阈值: INT): STRING
    $OCR抓捕对象名称结果 = OCR识别抓捕对象名称()
    $OCR抓捕对象图鉴编号 = 英文名称查图鉴编号($OCR抓捕对象名称结果)

    IF $OCR抓捕对象图鉴编号 <= 0
        PRINT ""
        PRINT 【OCR名称识别】
        PRINT OCR结果不在名称表，回到单字识别
        RETURN 识别抓捕对象名称($识图阈值)
    ENDIF

    $OCR匹配确认 = OCR名称闪光匹配度确认($OCR抓捕对象图鉴编号, $识图阈值)
    IF $OCR匹配确认 == 0
        PRINT ""
        PRINT 【OCR名称识别】
        PRINT OCR结果匹配度不足，回到单字识别: & $OCR抓捕对象名称结果
        RETURN 识别抓捕对象名称($识图阈值)
    ENDIF

    RETURN $OCR抓捕对象名称结果
ENDFUNC

# ==================================================
# 抓捕对象闪光检测
# 根据识别出的图鉴编号，比较普通标签与闪光标签匹配度。
# 闪光匹配度更高时，返回 1。
# ==================================================

$normalScore = -1
$shinyScore = -1
$shinyCheckAvailable = 0
$未知图腾形态最高匹配度 = -1
$未知图腾形态最佳编号 = -1
$未知图腾普通形态最高匹配度 = -1
$未知图腾普通形态最佳编号 = -1
$未知图腾闪光形态最高匹配度 = -1
$未知图腾闪光形态最佳编号 = -1
$识别未知图腾形态编号 = -1

FUNC 更新未知图腾普通形态最佳($匹配度: INT, $形态编号: INT): INT
    IF $匹配度 > $未知图腾普通形态最高匹配度
        $未知图腾普通形态最高匹配度 = $匹配度
        $未知图腾普通形态最佳编号 = $形态编号
    ENDIF

    RETURN 0
ENDFUNC

FUNC 更新未知图腾闪光形态最佳($匹配度: INT, $形态编号: INT): INT
    IF $匹配度 > $未知图腾闪光形态最高匹配度
        $未知图腾闪光形态最高匹配度 = $匹配度
        $未知图腾闪光形态最佳编号 = $形态编号
    ENDIF

    RETURN 0
ENDFUNC

FUNC 未知图腾形态文本($形态编号: INT): STRING
    IF $形态编号 == 0
        RETURN "A"
    ELIF $形态编号 == 1
        RETURN "B"
    ELIF $形态编号 == 2
        RETURN "C"
    ELIF $形态编号 == 3
        RETURN "D"
    ELIF $形态编号 == 4
        RETURN "E"
    ELIF $形态编号 == 5
        RETURN "F"
    ELIF $形态编号 == 6
        RETURN "G"
    ELIF $形态编号 == 7
        RETURN "H"
    ELIF $形态编号 == 8
        RETURN "I"
    ELIF $形态编号 == 9
        RETURN "J"
    ELIF $形态编号 == 10
        RETURN "K"
    ELIF $形态编号 == 11
        RETURN "L"
    ELIF $形态编号 == 12
        RETURN "M"
    ELIF $形态编号 == 13
        RETURN "N"
    ELIF $形态编号 == 14
        RETURN "O"
    ELIF $形态编号 == 15
        RETURN "P"
    ELIF $形态编号 == 16
        RETURN "Q"
    ELIF $形态编号 == 17
        RETURN "R"
    ELIF $形态编号 == 18
        RETURN "S"
    ELIF $形态编号 == 19
        RETURN "T"
    ELIF $形态编号 == 20
        RETURN "U"
    ELIF $形态编号 == 21
        RETURN "V"
    ELIF $形态编号 == 22
        RETURN "W"
    ELIF $形态编号 == 23
        RETURN "X"
    ELIF $形态编号 == 24
        RETURN "Y"
    ELIF $形态编号 == 25
        RETURN "Z"
    ELIF $形态编号 == 26
        RETURN "?"
    ELIF $形态编号 == 27
        RETURN "!"
    ENDIF

    RETURN "未知"
ENDFUNC

FUNC 识别未知图腾形态($识图阈值: INT): INT
    $未知图腾普通形态最高匹配度 = -1
    $未知图腾普通形态最佳编号 = -1
    $未知图腾闪光形态最高匹配度 = -1
    $未知图腾闪光形态最佳编号 = -1
