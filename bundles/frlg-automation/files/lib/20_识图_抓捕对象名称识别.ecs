# ==================================================
# 抓捕对象名称识别.ecs
# 逐位比较 A-Z 与 空 的匹配度，取最高项。
#
# 规则：
#   1. 从第 01 位开始识别。
#   2. 每一位取 A-Z/空 中匹配度最高者。
#   3. 若最高匹配度 < 阈值，报错并停止。
#   4. 若第 01 位最高为 空，报错并停止。
#   5. 若第 02 位之后最高为 空，停止，并打印此前拼出的字符串。
# ==================================================

$抓捕对象名称最高匹配度 = -1
$抓捕对象名称最佳字符 = ""
$名称匹配输出结果 = 0
$识图调试日志输出 = 0
$最近出闪检测结果 = 0
$最近出闪检测图鉴编号 = 0
$普通闪光目标图鉴编号 = 0
$普通非目标闪光停止 = 0
$普通出闪录像 = 0
$普通出闪录像长按MS = 1000

FUNC 设置识图调试日志($启用: INT): INT
    $识图调试日志输出 = $启用
    RETURN 0
ENDFUNC

FUNC 清空最近出闪检测
    $最近出闪检测结果 = 0
    $最近出闪检测图鉴编号 = 0
ENDFUNC

FUNC 记录最近出闪检测($dex: INT): INT
    $最近出闪检测结果 = 1
    $最近出闪检测图鉴编号 = $dex
    RETURN 0
ENDFUNC

FUNC 设置普通闪光策略($目标图鉴编号: INT, $非目标停止: INT, $出闪录像: INT, $录像长按MS: INT): INT
    IF $目标图鉴编号 < 1 or $目标图鉴编号 > 386
        PRINT 普通闪光策略目标图鉴编号无效: & $目标图鉴编号
        RETURN 0
    ENDIF
    IF $非目标停止 != 0 and $非目标停止 != 1
        PRINT 非目标闪光停止开关无效: & $非目标停止
        RETURN 0
    ENDIF
    IF $出闪录像 != 0 and $出闪录像 != 1
        PRINT 出闪录像开关无效: & $出闪录像
        RETURN 0
    ENDIF
    IF $录像长按MS <= 0
        PRINT 出闪录像长按时间无效: & $录像长按MS
        RETURN 0
    ENDIF
    $普通闪光目标图鉴编号 = $目标图鉴编号
    $普通非目标闪光停止 = $非目标停止
    $普通出闪录像 = $出闪录像
    $普通出闪录像长按MS = $录像长按MS
    RETURN 1
ENDFUNC

FUNC 应用普通闪光策略($dex: INT): INT
    IF $普通出闪录像 == 1
        PRINT 闪光录像：长按CAPTURE保存最近约30秒录像
        CAPTURE $普通出闪录像长按MS
        WAIT 500
    ENDIF
    IF $普通非目标闪光停止 == 1 and $普通闪光目标图鉴编号 > 0 and $dex != $普通闪光目标图鉴编号
        PRINT 遇到非目标闪光：图鉴 & $dex & "，目标 " & $普通闪光目标图鉴编号 & "；按配置停止脚本"
        RETURN 2
    ENDIF
    RETURN 1
ENDFUNC

FUNC 读取最近出闪检测结果(): INT
    RETURN $最近出闪检测结果
ENDFUNC

FUNC 读取最近出闪检测图鉴编号(): INT
    RETURN $最近出闪检测图鉴编号
ENDFUNC

FUNC 抓捕对象名称更新最佳($匹配度: INT, $字符: STRING): INT
    IF $匹配度 > $抓捕对象名称最高匹配度
        $抓捕对象名称最高匹配度 = $匹配度
        $抓捕对象名称最佳字符 = $字符
    ENDIF
    RETURN 0
ENDFUNC

FUNC 输出名称位匹配度($位: STRING, $字符: STRING, $匹配度: INT): INT
    IF $识图调试日志输出 == 1
        PRINT $位 & "最高: " & $字符 & " / " & $匹配度
    ENDIF
    RETURN 0
ENDFUNC

FUNC 识别抓捕对象名称($识图阈值: INT): STRING
    PRINT ""
    PRINT ========================
    PRINT 抓捕对象名称识别
    PRINT ========================

    $名称 = ""
    $位索引 = 0

    PRINT ""

    PRINT "FRLG_STAGE|BEGIN|wild.name.char01|wild.name.fallback|0|lib/20_识图_抓捕对象名称识别.ecs|识别抓捕对象名称|lib20.wild.name.char01|manual_prepare_then_restart|OR;抓捕名称第01位_A.IL:>=:" & $识图阈值 & ",抓捕名称第01位_B.IL:>=:" & $识图阈值 & ",抓捕名称第01位_C.IL:>=:" & $识图阈值 & ",抓捕名称第01位_D.IL:>=:" & $识图阈值 & ",抓捕名称第01位_E.IL:>=:" & $识图阈值 & ",抓捕名称第01位_F.IL:>=:" & $识图阈值 & ",抓捕名称第01位_G.IL:>=:" & $识图阈值 & ",抓捕名称第01位_H.IL:>=:" & $识图阈值 & ",抓捕名称第01位_I.IL:>=:" & $识图阈值 & ",抓捕名称第01位_J.IL:>=:" & $识图阈值 & ",抓捕名称第01位_K.IL:>=:" & $识图阈值 & ",抓捕名称第01位_L.IL:>=:" & $识图阈值 & ",抓捕名称第01位_M.IL:>=:" & $识图阈值 & ",抓捕名称第01位_N.IL:>=:" & $识图阈值 & ",抓捕名称第01位_O.IL:>=:" & $识图阈值 & ",抓捕名称第01位_P.IL:>=:" & $识图阈值 & ",抓捕名称第01位_Q.IL:>=:" & $识图阈值 & ",抓捕名称第01位_R.IL:>=:" & $识图阈值 & ",抓捕名称第01位_S.IL:>=:" & $识图阈值 & ",抓捕名称第01位_T.IL:>=:" & $识图阈值 & ",抓捕名称第01位_U.IL:>=:" & $识图阈值 & ",抓捕名称第01位_V.IL:>=:" & $识图阈值 & ",抓捕名称第01位_W.IL:>=:" & $识图阈值 & ",抓捕名称第01位_X.IL:>=:" & $识图阈值 & ",抓捕名称第01位_Y.IL:>=:" & $识图阈值 & ",抓捕名称第01位_Z.IL:>=:" & $识图阈值 & ",抓捕名称第01位_空.IL:>=:" & $识图阈值 & "|!"
    $第01位 = 识别抓捕对象名称第01位()
    $名称匹配输出结果 = 输出名称位匹配度("第01位", $第01位, $抓捕对象名称最高匹配度)

    IF $抓捕对象名称最高匹配度 < $识图阈值
    PRINT "FRLG_STAGE|FAIL|wild.name.char01|第01位名称候选全部低于阈值|!"
        PRINT 抓捕对象名称识别失败：第01位全部低于阈值，最高匹配度: & $抓捕对象名称最高匹配度
        RETURN ""
    ENDIF

    IF $第01位 == "空"
    PRINT "FRLG_STAGE|FAIL|wild.name.char01|名称首位识别为空|!"
        PRINT ""
        PRINT 抓捕对象名称识别失败：第01位最高为 空，名称为空
        RETURN ""
    ENDIF



    PRINT "FRLG_STAGE|END|wild.name.char01|!"
    $名称 = $名称 & $第01位
    $位索引 += 1

    PRINT "FRLG_STAGE|BEGIN|wild.name.char02|wild.name.fallback|0|lib/20_识图_抓捕对象名称识别.ecs|识别抓捕对象名称|lib20.wild.name.char02|manual_prepare_then_restart|OR;抓捕名称第02位_A.IL:>=:" & $识图阈值 & ",抓捕名称第02位_B.IL:>=:" & $识图阈值 & ",抓捕名称第02位_C.IL:>=:" & $识图阈值 & ",抓捕名称第02位_D.IL:>=:" & $识图阈值 & ",抓捕名称第02位_E.IL:>=:" & $识图阈值 & ",抓捕名称第02位_F.IL:>=:" & $识图阈值 & ",抓捕名称第02位_G.IL:>=:" & $识图阈值 & ",抓捕名称第02位_H.IL:>=:" & $识图阈值 & ",抓捕名称第02位_I.IL:>=:" & $识图阈值 & ",抓捕名称第02位_J.IL:>=:" & $识图阈值 & ",抓捕名称第02位_K.IL:>=:" & $识图阈值 & ",抓捕名称第02位_L.IL:>=:" & $识图阈值 & ",抓捕名称第02位_M.IL:>=:" & $识图阈值 & ",抓捕名称第02位_N.IL:>=:" & $识图阈值 & ",抓捕名称第02位_O.IL:>=:" & $识图阈值 & ",抓捕名称第02位_P.IL:>=:" & $识图阈值 & ",抓捕名称第02位_Q.IL:>=:" & $识图阈值 & ",抓捕名称第02位_R.IL:>=:" & $识图阈值 & ",抓捕名称第02位_S.IL:>=:" & $识图阈值 & ",抓捕名称第02位_T.IL:>=:" & $识图阈值 & ",抓捕名称第02位_U.IL:>=:" & $识图阈值 & ",抓捕名称第02位_V.IL:>=:" & $识图阈值 & ",抓捕名称第02位_W.IL:>=:" & $识图阈值 & ",抓捕名称第02位_X.IL:>=:" & $识图阈值 & ",抓捕名称第02位_Y.IL:>=:" & $识图阈值 & ",抓捕名称第02位_Z.IL:>=:" & $识图阈值 & ",抓捕名称第02位_空.IL:>=:" & $识图阈值 & "|!"
    $第02位 = 识别抓捕对象名称第02位()
    $名称匹配输出结果 = 输出名称位匹配度("第02位", $第02位, $抓捕对象名称最高匹配度)

    IF $抓捕对象名称最高匹配度 < $识图阈值
    PRINT "FRLG_STAGE|FAIL|wild.name.char02|第02位名称候选全部低于阈值|!"
        PRINT 抓捕对象名称识别失败：第02位全部低于阈值，最高匹配度: & $抓捕对象名称最高匹配度
        RETURN ""
    ENDIF

    IF $第02位 == "空"
    PRINT "FRLG_STAGE|END|wild.name.char02|!"
        PRINT ""
        PRINT 名称识别结果: & $名称
        RETURN $名称
    ENDIF

    PRINT "FRLG_STAGE|END|wild.name.char02|!"
    $名称 = $名称 & $第02位
    $位索引 += 1

    PRINT "FRLG_STAGE|BEGIN|wild.name.char03|wild.name.fallback|0|lib/20_识图_抓捕对象名称识别.ecs|识别抓捕对象名称|lib20.wild.name.char03|manual_prepare_then_restart|OR;抓捕名称第03位_A.IL:>=:" & $识图阈值 & ",抓捕名称第03位_B.IL:>=:" & $识图阈值 & ",抓捕名称第03位_C.IL:>=:" & $识图阈值 & ",抓捕名称第03位_D.IL:>=:" & $识图阈值 & ",抓捕名称第03位_E.IL:>=:" & $识图阈值 & ",抓捕名称第03位_F.IL:>=:" & $识图阈值 & ",抓捕名称第03位_G.IL:>=:" & $识图阈值 & ",抓捕名称第03位_H.IL:>=:" & $识图阈值 & ",抓捕名称第03位_I.IL:>=:" & $识图阈值 & ",抓捕名称第03位_J.IL:>=:" & $识图阈值 & ",抓捕名称第03位_K.IL:>=:" & $识图阈值 & ",抓捕名称第03位_L.IL:>=:" & $识图阈值 & ",抓捕名称第03位_M.IL:>=:" & $识图阈值 & ",抓捕名称第03位_N.IL:>=:" & $识图阈值 & ",抓捕名称第03位_O.IL:>=:" & $识图阈值 & ",抓捕名称第03位_P.IL:>=:" & $识图阈值 & ",抓捕名称第03位_Q.IL:>=:" & $识图阈值 & ",抓捕名称第03位_R.IL:>=:" & $识图阈值 & ",抓捕名称第03位_S.IL:>=:" & $识图阈值 & ",抓捕名称第03位_T.IL:>=:" & $识图阈值 & ",抓捕名称第03位_U.IL:>=:" & $识图阈值 & ",抓捕名称第03位_V.IL:>=:" & $识图阈值 & ",抓捕名称第03位_W.IL:>=:" & $识图阈值 & ",抓捕名称第03位_X.IL:>=:" & $识图阈值 & ",抓捕名称第03位_Y.IL:>=:" & $识图阈值 & ",抓捕名称第03位_Z.IL:>=:" & $识图阈值 & ",抓捕名称第03位_空.IL:>=:" & $识图阈值 & "|!"
    $第03位 = 识别抓捕对象名称第03位()
    $名称匹配输出结果 = 输出名称位匹配度("第03位", $第03位, $抓捕对象名称最高匹配度)

    IF $抓捕对象名称最高匹配度 < $识图阈值
    PRINT "FRLG_STAGE|FAIL|wild.name.char03|第03位名称候选全部低于阈值|!"
        PRINT 抓捕对象名称识别失败：第03位全部低于阈值，最高匹配度: & $抓捕对象名称最高匹配度
        RETURN ""
    ENDIF

    IF $第03位 == "空"
    PRINT "FRLG_STAGE|END|wild.name.char03|!"
        PRINT ""
        PRINT 名称识别结果: & $名称
        RETURN $名称
    ENDIF

    PRINT "FRLG_STAGE|END|wild.name.char03|!"
    $名称 = $名称 & $第03位
    $位索引 += 1

    PRINT "FRLG_STAGE|BEGIN|wild.name.char04|wild.name.fallback|0|lib/20_识图_抓捕对象名称识别.ecs|识别抓捕对象名称|lib20.wild.name.char04|manual_prepare_then_restart|OR;抓捕名称第04位_A.IL:>=:" & $识图阈值 & ",抓捕名称第04位_B.IL:>=:" & $识图阈值 & ",抓捕名称第04位_C.IL:>=:" & $识图阈值 & ",抓捕名称第04位_D.IL:>=:" & $识图阈值 & ",抓捕名称第04位_E.IL:>=:" & $识图阈值 & ",抓捕名称第04位_F.IL:>=:" & $识图阈值 & ",抓捕名称第04位_G.IL:>=:" & $识图阈值 & ",抓捕名称第04位_H.IL:>=:" & $识图阈值 & ",抓捕名称第04位_I.IL:>=:" & $识图阈值 & ",抓捕名称第04位_J.IL:>=:" & $识图阈值 & ",抓捕名称第04位_K.IL:>=:" & $识图阈值 & ",抓捕名称第04位_L.IL:>=:" & $识图阈值 & ",抓捕名称第04位_M.IL:>=:" & $识图阈值 & ",抓捕名称第04位_N.IL:>=:" & $识图阈值 & ",抓捕名称第04位_O.IL:>=:" & $识图阈值 & ",抓捕名称第04位_P.IL:>=:" & $识图阈值 & ",抓捕名称第04位_Q.IL:>=:" & $识图阈值 & ",抓捕名称第04位_R.IL:>=:" & $识图阈值 & ",抓捕名称第04位_S.IL:>=:" & $识图阈值 & ",抓捕名称第04位_T.IL:>=:" & $识图阈值 & ",抓捕名称第04位_U.IL:>=:" & $识图阈值 & ",抓捕名称第04位_V.IL:>=:" & $识图阈值 & ",抓捕名称第04位_W.IL:>=:" & $识图阈值 & ",抓捕名称第04位_X.IL:>=:" & $识图阈值 & ",抓捕名称第04位_Y.IL:>=:" & $识图阈值 & ",抓捕名称第04位_Z.IL:>=:" & $识图阈值 & ",抓捕名称第04位_空.IL:>=:" & $识图阈值 & "|!"
    $第04位 = 识别抓捕对象名称第04位()
    $名称匹配输出结果 = 输出名称位匹配度("第04位", $第04位, $抓捕对象名称最高匹配度)

    IF $抓捕对象名称最高匹配度 < $识图阈值
    PRINT "FRLG_STAGE|FAIL|wild.name.char04|第04位名称候选全部低于阈值|!"
        PRINT 抓捕对象名称识别失败：第04位全部低于阈值，最高匹配度: & $抓捕对象名称最高匹配度
        RETURN ""
    ENDIF

    IF $第04位 == "空"
    PRINT "FRLG_STAGE|END|wild.name.char04|!"
        PRINT ""
        PRINT 名称识别结果: & $名称
        RETURN $名称
    ENDIF

    PRINT "FRLG_STAGE|END|wild.name.char04|!"
    $名称 = $名称 & $第04位
    $位索引 += 1

    PRINT "FRLG_STAGE|BEGIN|wild.name.char05|wild.name.fallback|0|lib/20_识图_抓捕对象名称识别.ecs|识别抓捕对象名称|lib20.wild.name.char05|manual_prepare_then_restart|OR;抓捕名称第05位_A.IL:>=:" & $识图阈值 & ",抓捕名称第05位_B.IL:>=:" & $识图阈值 & ",抓捕名称第05位_C.IL:>=:" & $识图阈值 & ",抓捕名称第05位_D.IL:>=:" & $识图阈值 & ",抓捕名称第05位_E.IL:>=:" & $识图阈值 & ",抓捕名称第05位_F.IL:>=:" & $识图阈值 & ",抓捕名称第05位_G.IL:>=:" & $识图阈值 & ",抓捕名称第05位_H.IL:>=:" & $识图阈值 & ",抓捕名称第05位_I.IL:>=:" & $识图阈值 & ",抓捕名称第05位_J.IL:>=:" & $识图阈值 & ",抓捕名称第05位_K.IL:>=:" & $识图阈值 & ",抓捕名称第05位_L.IL:>=:" & $识图阈值 & ",抓捕名称第05位_M.IL:>=:" & $识图阈值 & ",抓捕名称第05位_N.IL:>=:" & $识图阈值 & ",抓捕名称第05位_O.IL:>=:" & $识图阈值 & ",抓捕名称第05位_P.IL:>=:" & $识图阈值 & ",抓捕名称第05位_Q.IL:>=:" & $识图阈值 & ",抓捕名称第05位_R.IL:>=:" & $识图阈值 & ",抓捕名称第05位_S.IL:>=:" & $识图阈值 & ",抓捕名称第05位_T.IL:>=:" & $识图阈值 & ",抓捕名称第05位_U.IL:>=:" & $识图阈值 & ",抓捕名称第05位_V.IL:>=:" & $识图阈值 & ",抓捕名称第05位_W.IL:>=:" & $识图阈值 & ",抓捕名称第05位_X.IL:>=:" & $识图阈值 & ",抓捕名称第05位_Y.IL:>=:" & $识图阈值 & ",抓捕名称第05位_Z.IL:>=:" & $识图阈值 & ",抓捕名称第05位_空.IL:>=:" & $识图阈值 & "|!"
    $第05位 = 识别抓捕对象名称第05位()
    $名称匹配输出结果 = 输出名称位匹配度("第05位", $第05位, $抓捕对象名称最高匹配度)

    IF $抓捕对象名称最高匹配度 < $识图阈值
    PRINT "FRLG_STAGE|FAIL|wild.name.char05|第05位名称候选全部低于阈值|!"
        PRINT 抓捕对象名称识别失败：第05位全部低于阈值，最高匹配度: & $抓捕对象名称最高匹配度
        RETURN ""
    ENDIF

    IF $第05位 == "空"
    PRINT "FRLG_STAGE|END|wild.name.char05|!"
        PRINT ""
        PRINT 名称识别结果: & $名称
        RETURN $名称
    ENDIF

    PRINT "FRLG_STAGE|END|wild.name.char05|!"
