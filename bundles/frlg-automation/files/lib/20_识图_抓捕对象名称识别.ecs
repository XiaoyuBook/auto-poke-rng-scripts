FUNC OCR名称闪光匹配度确认($dex: INT, $识图阈值: INT): INT
    IF $dex == 201
        $OCR未知图腾形态编号 = 识别未知图腾形态($识图阈值)
        IF $OCR未知图腾形态编号 >= 0
            RETURN 1
        ENDIF
        RETURN 0
    ENDIF

    $shinyCheckAvailable = SetCaptureShinyScores($dex)
    IF $shinyCheckAvailable == 0
        PRINT ""
        PRINT 【OCR名称确认】
        PRINT 未找到对应普通/闪光标签，图鉴编号: & $dex
        RETURN 0
    ENDIF

    PRINT ""
    PRINT 【OCR名称确认】

    IF $normalScore < $识图阈值 and $shinyScore < $识图阈值
        PRINT OCR名称错误
        RETURN 0
    ENDIF

    PRINT Sprite标签与OCR名称一致
    RETURN 1
ENDFUNC

FUNC CheckCaptureShiny($dex: INT, $识图阈值: INT): INT
    IF $dex == 201
        IF $识别未知图腾形态编号 < 0
            $未知图腾形态编号 = 识别未知图腾形态($识图阈值)
        ENDIF

        IF $识别未知图腾形态编号 >= 0 and $未知图腾闪光形态最高匹配度 > $未知图腾普通形态最高匹配度
            $记录出闪检测结果 = 记录最近出闪检测($dex)
            PRINT 已识别到闪光未知图腾
            RETURN 应用普通闪光策略($dex)
        ENDIF

        RETURN 0
    ENDIF

    $shinyCheckAvailable = SetCaptureShinyScores($dex)
    IF $shinyCheckAvailable == 0
        PRINT ""
        PRINT 【出闪检测】
        PRINT 未找到对应普通/闪光标签，图鉴编号: & $dex
        RETURN 0
    ENDIF

    IF $识图调试日志输出 == 1
        PRINT ""
        PRINT 【出闪检测】
        PRINT 普通匹配度: & $normalScore
        PRINT 闪光匹配度: & $shinyScore
    ENDIF

    IF $shinyScore > $normalScore
        $记录出闪检测结果 = 记录最近出闪检测($dex)
        IF $识图调试日志输出 == 0
            PRINT ""
            PRINT 【出闪检测】
        ENDIF
        PRINT 已识别到闪光个体
        RETURN 应用普通闪光策略($dex)
    ENDIF

    RETURN 0
ENDFUNC

