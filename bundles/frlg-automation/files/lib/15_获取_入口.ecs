# ==================================================
# lib/15_获取_入口.ecs
# ==================================================

FUNC 执行目标获取($目标全国图鉴编号: INT, $遭遇方法: INT, $遭遇地点: INT, $F2: INT, $TV等待: INT, $钓鱼最长时间: INT, $进入TV: INT, $识图阈值: INT, $循环计数: INT, $出闪后继续抓捕: INT, $游戏版本: INT, $TV时间轴模式: INT): INT

    IF 是否狩猎地带($遭遇地点) == 1
        RETURN 狩猎地带目标获取($目标全国图鉴编号, $遭遇方法, $遭遇地点, $F2, $TV等待, $钓鱼最长时间, $识图阈值, $循环计数, $出闪后继续抓捕, $进入TV, $TV时间轴模式)
    ENDIF

    IF $遭遇方法 == 101 or $遭遇方法 == 102
        # 草丛
        # 冲浪
        RETURN 甜甜香气($F2, $目标全国图鉴编号, $识图阈值, $循环计数, $出闪后继续抓捕)

    ELIF $遭遇方法 == 103
        # 碎岩
        RETURN 碎岩($F2, $目标全国图鉴编号, $识图阈值, $循环计数, $出闪后继续抓捕)

    ELIF $遭遇方法 == 201 or $遭遇方法 == 202 or $遭遇方法 == 203
        # 破旧钓竿
        # 好钓竿
        # 厉害钓竿
        RETURN 钓鱼($F2, $钓鱼最长时间, $目标全国图鉴编号, $识图阈值, $循环计数, $出闪后继续抓捕, $进入TV, $遭遇方法)
    ENDIF


    IF $遭遇方法 == 4
        # 游戏角
        RETURN 获取游戏角($F2, $目标全国图鉴编号, $游戏版本)
    ELIF $目标全国图鉴编号 == 1 or $目标全国图鉴编号 == 4 or $目标全国图鉴编号 == 7
        # 妙蛙种子 / Bulbasaur
        # 小火龙 / Charmander
        # 杰尼龟 / Squirtle
        RETURN 获取御三家($F2)
    ELIF $目标全国图鉴编号 == 97 or $目标全国图鉴编号 == 101 or $目标全国图鉴编号 == 143
        # 引梦貘人 / Hypno
        # 顽皮雷弹 / Electrode
        # 卡比兽 / Snorlax
        RETURN 获取定点($F2, $目标全国图鉴编号, $识图阈值, $出闪后继续抓捕)
    ELIF $目标全国图鉴编号 == 106 or $目标全国图鉴编号 == 107
        # 飞腿郎 / Hitmonlee
        # 快拳郎 / Hitmonchan
        RETURN 获取格斗道场($F2, $目标全国图鉴编号)
    ELIF $目标全国图鉴编号 == 129
        # 鲤鱼王 / Magikarp
        RETURN 获取鲤鱼王($F2)
    ELIF $目标全国图鉴编号 == 131
        # 拉普拉斯 / Lapras
        RETURN 获取拉普拉斯($F2)
    ELIF $目标全国图鉴编号 == 133
        # 伊布 / Eevee
        RETURN 获取伊布($F2)
    ELIF $目标全国图鉴编号 == 138 or $目标全国图鉴编号 == 140 or $目标全国图鉴编号 == 142
        # 菊石兽 / Omanyte
        # 化石盔 / Kabuto
        # 化石翼龙 / Aerodactyl
        RETURN 获取化石琥珀($F2, $目标全国图鉴编号)
    ELIF $目标全国图鉴编号 == 144 or $目标全国图鉴编号 == 145 or $目标全国图鉴编号 == 146
        # 急冻鸟 / Articuno
        # 闪电鸟 / Zapdos
        # 火焰鸟 / Moltres
        RETURN 获取三圣鸟($F2, $目标全国图鉴编号, $识图阈值, $出闪后继续抓捕)
    ELIF $目标全国图鉴编号 == 150
        # 超梦 / Mewtwo
        RETURN 获取超梦($F2, $目标全国图鉴编号, $识图阈值, $出闪后继续抓捕)
    ELIF $目标全国图鉴编号 == 175
        # 波克比 / Togepi
        RETURN 获取波克比($F2, $目标全国图鉴编号, $进入TV)
    ELIF $目标全国图鉴编号 == 243 or $目标全国图鉴编号 == 244 or $目标全国图鉴编号 == 245
        # 雷公 / Raikou
        # 炎帝 / Entei
        # 水君 / Suicune
        RETURN 获取游走($F2, $目标全国图鉴编号, $进入TV, $出闪后继续抓捕, $识图阈值)
    ELIF $目标全国图鉴编号 == 249 or $目标全国图鉴编号 == 250
        # 洛奇亚 / Lugia
        # 凤王 / Ho Oh
        RETURN 获取凤王洛奇亚($F2, $目标全国图鉴编号, $识图阈值, $出闪后继续抓捕)
    ELIF $目标全国图鉴编号 == 386
        # 代欧奇希斯 / Deoxys Normal
        RETURN 获取代欧奇希斯($F2, $目标全国图鉴编号, $识图阈值, $出闪后继续抓捕)
    ELSE
        PRINT ""
        PRINT 目标获取失败: 暂未支持图鉴编号: & $目标全国图鉴编号
        RETURN -1
    ENDIF

ENDFUNC

# ==================================================
# 目标获取支持检测
#
# 返回：
#   1 = 支持
#   0 = 暂未支持
# ==================================================

FUNC 目标获取是否支持($目标全国图鉴编号: INT, $遭遇方法: INT, $遭遇地点: INT): INT
    IF 是否狩猎地带($遭遇地点) == 1
        RETURN 1
    ENDIF

    # 野生类
    IF $遭遇方法 == 101
        RETURN 1
    ELIF $遭遇方法 == 102
        RETURN 1
    ELIF $遭遇方法 == 103
        RETURN 1
    ELIF $遭遇方法 == 201
        RETURN 1
    ELIF $遭遇方法 == 202
        RETURN 1
    ELIF $遭遇方法 == 203
        RETURN 1
    ENDIF

    # 静态类
    IF $目标全国图鉴编号 == 1
        RETURN 1
    ELIF $目标全国图鉴编号 == 4
        RETURN 1
    ELIF $目标全国图鉴编号 == 7
        RETURN 1
    ELIF $目标全国图鉴编号 == 24
        RETURN 1
    ELIF $目标全国图鉴编号 == 35
        RETURN 1
    ELIF $目标全国图鉴编号 == 63
        RETURN 1
    ELIF $目标全国图鉴编号 == 97
        RETURN 1
    ELIF $目标全国图鉴编号 == 101
        RETURN 1
    ELIF $目标全国图鉴编号 == 106
        RETURN 1
    ELIF $目标全国图鉴编号 == 107
        RETURN 1
    ELIF $目标全国图鉴编号 == 123
        RETURN 1
    ELIF $目标全国图鉴编号 == 127
        RETURN 1
    ELIF $目标全国图鉴编号 == 129
        RETURN 1
    ELIF $目标全国图鉴编号 == 131
        RETURN 1
    ELIF $目标全国图鉴编号 == 133
        RETURN 1
    ELIF $目标全国图鉴编号 == 137
        RETURN 1
    ELIF $目标全国图鉴编号 == 138
        RETURN 1
    ELIF $目标全国图鉴编号 == 140
        RETURN 1
    ELIF $目标全国图鉴编号 == 142
        RETURN 1
    ELIF $目标全国图鉴编号 == 143
        RETURN 1
    ELIF $目标全国图鉴编号 == 144
        RETURN 1
    ELIF $目标全国图鉴编号 == 145
        RETURN 1
    ELIF $目标全国图鉴编号 == 146
        RETURN 1
    ELIF $目标全国图鉴编号 == 147
        RETURN 1
    ELIF $目标全国图鉴编号 == 150
        RETURN 1
    ELIF $目标全国图鉴编号 == 175
        RETURN 1
    ELIF $目标全国图鉴编号 == 243
        RETURN 1
    ELIF $目标全国图鉴编号 == 244
        RETURN 1
    ELIF $目标全国图鉴编号 == 245
        RETURN 1
    ELIF $目标全国图鉴编号 == 249
        RETURN 1
    ELIF $目标全国图鉴编号 == 250
        RETURN 1
    ELIF $目标全国图鉴编号 == 386
        RETURN 1
    ENDIF

    RETURN 0
ENDFUNC
