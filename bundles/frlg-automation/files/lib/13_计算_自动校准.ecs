# lib/13 统计估计校准纯函数库（路径一致性候选选择 + EWA 阻尼修正）
# 已彻底移除死区方案与卡尔曼方差链。定点比例由调用方传入（默认 1000）。
# 数据流：
#   1) 候选选择：按候选残差到“路径中心”的加权平方距离最小者为最优（沿轨迹连续，排除跳变伪候选）。
#   2) 路径中心：每轮 EWA 更新 中心 += α*(本轮残差 - 中心)，作为下一轮的轨迹预测。
#   3) 修正量：阻尼积分 新增 += round(α*归一化误差)，α<1 平滑收敛、消除目标附近来回抖动；不可信维度用更小系数(永不冻结)。
#   - TV 周期混叠用 模周期归一 把帧误差折叠到最近相位零点（普通模式传周期 0，等价不变，严禁 314）。

$归一商 = 0

# 带符号整除四舍五入：$分母 须为正
FUNC 带符号整除四舍五入($分子: INT, $分母: INT): INT
    IF $分母 <= 0
        RETURN 0
    ENDIF
    IF $分子 >= 0
        RETURN ($分子 + $分母 / 2) / $分母
    ELSE
        RETURN 0 - ((0 - $分子) + $分母 / 2) / $分母
    ENDIF
ENDFUNC

# 模周期归一：把误差折叠到 (-周期/2, +周期/2]。周期<=0 表示无周期（普通模式），原样返回。
FUNC 模周期归一($误差: INT, $周期: INT): INT
    IF $周期 <= 0
        RETURN $误差
    ENDIF
    $归一商 = 带符号整除四舍五入($误差, $周期)
    RETURN $误差 - $归一商 * $周期
ENDFUNC

# EWA 更新路径中心：中心 += β*(测量-中心)。β 为定点×比例。平滑历史残差，供候选选择，消除目标附近来回抖动。
FUNC EWA更新中心($中心: INT, $测量: INT, $β定点: INT, $比例: INT): INT
    RETURN $中心 + 带符号整除四舍五入($β定点 * ($测量 - $中心), $比例)
ENDFUNC

# 候选 MSE 评分：权重Seed*dSeed^2 + 权重帧*dFrame^2，越小越优
FUNC 候选MSE评分($Seed距离: INT, $帧距离: INT, $权重Seed: INT, $权重帧: INT): INT
    RETURN $权重Seed * $Seed距离 * $Seed距离 + $权重帧 * $帧距离 * $帧距离
ENDFUNC

FUNC 累加实际执行修正量($当前实际执行修正量: INT, $本次新增修正量: INT): INT
    RETURN $当前实际执行修正量 + $本次新增修正量
ENDFUNC
