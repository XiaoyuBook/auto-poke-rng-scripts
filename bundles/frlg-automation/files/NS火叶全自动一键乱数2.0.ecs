$Seed命中保持负方向票数 = 0
$Seed曾命中目标 = 0
$方案2Seed接续启用 = 0
$方案2Seed接续正方向票数 = 0
$方案2Seed接续负方向票数 = 0
$方案0奇偶当前偏移 = 1
$方案0奇偶失败次数 = 0
$方案0奇偶已拉黑最大偏移 = 0
$方案0奇偶本轮执行偏移 = 0
$方案0奇偶本轮升级 = 0
$帧命中保持启用 = 0
$帧命中保持计数 = 0
$TV双分支跟踪等待帧 = 0 - 1
$TV双分支见零圈 = 0
$TV双分支见相邻圈 = 0
$TV双分支锁定 = 0

# ==================================================
# 在seed表里找到目标seed对应目标MS
# ==================================================
IF $调试日志输出 == 1
    PRINT ""
    PRINT ========================
    PRINT 目标SeedMS查找
    PRINT ========================
ENDIF
$Seed最大索引 = 取Seed最大索引($游戏版本)

IF $Seed最大索引 < 0
    PRINT ""
    PRINT 【目标SeedMS查找】
    PRINT 结果: 失败
    PRINT 原因: Seed表游戏版本无效: & $游戏版本
    RETURN
ENDIF

$目标Seed十进制 = HEX转十进制($目标Seed)

IF $目标Seed十进制 < 0
    PRINT ""
    PRINT 【目标SeedMS查找】
    PRINT 结果: 失败
    PRINT 原因: 目标Seed格式错误: & $目标Seed
    RETURN
ENDIF

FOR $种子索引 = 0 TO $Seed最大索引
    $当前Seed = 取SeedHEX($游戏版本, $种子索引, $Seed模式)

    IF $当前Seed == ""
        CONTINUE
    ENDIF

    $当前Seed十进制 = HEX转十进制($当前Seed)

    IF $当前Seed十进制 == $目标Seed十进制
        $目标SeedMS = 取MS($游戏版本, $种子索引) + $NXSeed平台偏移MS

        $目标索引 = $种子索引
        $目标RawTime = 取RawTime($游戏版本, $种子索引)
        $找到目标MS = 1

        IF $调试日志输出 == 1
            PRINT ""
            PRINT 结果: 找到
            PRINT 目标Seed: & $目标Seed
            PRINT 目标SeedMS: & $目标SeedMS & " ms"
        ENDIF

        BREAK
    ENDIF
NEXT

IF $找到目标MS == 0
    PRINT ""
    PRINT 【目标SeedMS查找】
    PRINT 结果: 失败
    PRINT 原因: 没有在seed表中找到目标Seed: & $目标Seed
    PRINT 建议：检查Seed模式设置是否正确
    RETURN
ENDIF

# 用TenLines表把预校准索引精确换算为毫秒；Seed表间隔并不恒定，不能用固定ms/seed估算。
$Seed累计修正索引 = $Seed预校准索引
$Seed修正目标索引 = $目标索引 + $Seed累计修正索引
IF $Seed修正目标索引 < 0
    $Seed修正目标索引 = 0
ENDIF
IF $Seed修正目标索引 > $Seed最大索引
    $Seed修正目标索引 = $Seed最大索引
ENDIF
$SeedMS实际执行修正量 = 取MS($游戏版本, $Seed修正目标索引) - 取MS($游戏版本, $目标索引)
$SeedMS = $目标SeedMS - $SeedMS实际执行修正量 + $Seed基础补偿 + $Seed精细修正MS

$F1等待MS = 0
$TV等待MS = 0
$F2等待MS = 0

$目标名称字符 = 目标名称($游戏版本, $目标全国图鉴编号)
$目标英文名称字符 = 目标英文名称($目标全国图鉴编号)

# ╔═════════════════════════════════════════════════════════════╗
# ║                           LOOP                              ║
# ╚═════════════════════════════════════════════════════════════╝

FOR
    FOR
        $刚进入TV = 0
        IF $循环计数 == 0
            IF $调试日志输出 == 1
                PRINT ""
                PRINT ========================
                IF $第0轮游戏设置检查 == 1 and $游戏设置检查完成 == 0
                    PRINT 第0轮 游戏设置检查
                ELSE
                    PRINT 第0轮 固定延迟检测
                ENDIF
                PRINT ========================
            ELSE
                IF $第0轮游戏设置检查 == 1 and $游戏设置检查完成 == 0
                    PRINT 第0轮：检查游戏设置
                ELSE
                    PRINT 第0轮：初始化计时
                ENDIF
            ENDIF
        ELSE
            IF $调试日志输出 == 1
                PRINT ""
                PRINT ========================
                PRINT 第 & $循环计数 & 轮
                PRINT ========================
            ELSE
                PRINT 第 & $循环计数 & 轮开始
            ENDIF
            CALL 输出下一轮等待参数
        ENDIF

        $本轮流程结果 = 执行RNG启动与目标获取()
        IF $本轮流程结果 == -1
            PRINT ""
            PRINT 目标获取流程结束，停止脚本
            RETURN
        ENDIF
        IF $本轮流程结果 == 0
            PRINT ""
            PRINT 目标获取未完成，重启本轮
            BREAK
        ENDIF
        IF $本轮流程结果 == 1 and $调试日志输出 == 1
            PRINT ""
            PRINT 目标获取成功，继续反查流程
        ENDIF
        IF $本轮流程结果 == 2
            PRINT ""
            PRINT 固定延迟校准完成，进入下一轮
            BREAK
        ENDIF
        IF $本轮流程结果 == 3
            PRINT ""
            PRINT 游戏设置检查完成，重启并执行真正的第0轮固定延迟检测
            BREAK
        ENDIF

        $道具乱数处理结果 = 处理道具乱数命中()
        IF $道具乱数处理结果 == -1
            PRINT ""
            PRINT 道具乱数存档失败，停止脚本
            RETURN
        ELIF $道具乱数处理结果 == 1
            $循环计数 += 1
            PRINT ""
            PRINT 道具目标已存档，重新启动游戏进行下一次命中
            BREAK
        ELIF $道具乱数处理结果 == 2
            PRINT ""
            PRINT 道具乱数目标数量已完成，脚本停止
            RETURN
        ENDIF

        CALL 御三家准备共同筛选
        $反查细分成功 = 执行识图反查直到候选唯一()
        IF ($御三家严格筛选 == 1 or $跨组筛选回退启用 == 1) and $反查细分成功 == 1
            $投票忽略 = 共同区提交()
        ENDIF
        IF $反查细分成功 == -1
            PRINT ""
            PRINT 识图反查失败，停止脚本
            RETURN
        ENDIF
        IF $反查细分成功 == 0
            PRINT ""
            PRINT 识图反查结束，停止脚本
            RETURN
        ENDIF
        IF $御三家严格筛选 == 1 or $跨组筛选回退启用 == 1
            IF $反查细分成功 != 1
                PRINT 御三家有界反查无结果，保留参数与跨轮候选，重试下一轮
                $循环计数 += 1
                BREAK
            ENDIF
            $御三家筛选结果 = 御三家应用共同候选()
            IF $御三家筛选结果 != 1
                $循环计数 += 1
                BREAK
            ENDIF
        ENDIF
        IF $反查细分成功 == 1 and $调试日志输出 == 1
            PRINT ""
            PRINT 识图反查成功，继续校准
        ENDIF

        $校准成功 = 执行自动校准与等待更新()
        IF $校准成功 == 0
            PRINT ""
            PRINT 自动校准结束，停止脚本
            RETURN
        ENDIF
        IF $校准成功 == 1
            IF $调试日志输出 == 1
                PRINT ""
                PRINT 自动校准成功，进入下一轮
            ENDIF
            BREAK
        ENDIF
    NEXT
NEXT

FUNC 执行识图反查直到候选唯一(): INT
    $候选细分累计范围有效 = 0
    $本轮糖果次数 = 0
    $野生遭遇初始等级 = -1
    $上轮候选数 = 999999
    $候选停滞次数 = 0
    $本轮真值解 = 0
    $本轮路径已重锚 = 0

    FOR
        $识图成功 = 读取并输出识图结果()
        IF $识图成功 == 0
            RETURN 0
        ENDIF
        IF $野生遭遇初始等级 < 0
            $野生遭遇初始等级 = $等级
            $野生等级校验结果 = 校验野生遭遇初始等级()
            IF $野生等级校验结果 != 1
                RETURN 0
            ENDIF
        ENDIF

        $反查准备成功 = 准备反查参数与输出()
        IF $反查准备成功 == 0
            RETURN -1
        ENDIF

        $候选细分合并成功 = 合并候选细分IV范围()
        IF $候选细分合并成功 == 0
            RETURN 0
        ENDIF

        # 分层扩窗(方向3)：默认窗口=配置值；仅当无结果时逐层放宽，重试，正常命中不受影响
        $当前扩窗层 = 0
        $有效Seed容差 = $Seed容差
        $有效最小消耗帧 = $最小消耗帧
        $有效最大消耗帧 = $最大消耗帧
        CALL 御三家准备反查窗口
        FOR
            $反查扫描成功 = 执行反查扫描()
            IF $反查扫描成功 == 1
                BREAK
            ENDIF
            # 先只扩大Seed轴并保留原帧窗。Seed偏离但帧数已命中时，可避免先扫描±5000帧的大窗口。
            IF $当前扩窗层 == 0 and $有效Seed容差 < $扩窗第1层Seed容差
                $有效Seed容差 = $扩窗第1层Seed容差
                IF $调试日志输出 == 1
                    PRINT ""
                    PRINT 【Seed优先扩窗】
                    PRINT 仅放宽Seed容差，暂不扩大消耗帧窗口
                    PRINT 有效Seed容差: ± & $有效Seed容差 & 个seed
                    PRINT 有效消耗帧范围: & $有效最小消耗帧 & - & $有效最大消耗帧 & " 帧"
                ENDIF
                CONTINUE
            ENDIF
            IF $御三家严格筛选 == 1
                IF $当前扩窗层 >= 1
                    BREAK
                ENDIF
                $当前扩窗层 = 1
                $有效最小消耗帧 = $御三家预测帧 - 500
                IF $有效最小消耗帧 < 0
                    $有效最小消耗帧 = 0
                ENDIF
                $有效最大消耗帧 = $御三家预测帧 + 500
                PRINT 御三家有界兜底窗: & $有效最小消耗帧 & - & $有效最大消耗帧 & " ADV；不使用千帧扩窗"
                CONTINUE
            ENDIF
            IF $扩窗层数上限 <= 0 or $当前扩窗层 >= $扩窗层数上限
                BREAK
            ENDIF
            $当前扩窗层 += 1
            IF $当前扩窗层 == 1
                $有效Seed容差 = $扩窗第1层Seed容差
                $扩窗帧半宽 = $扩窗第1层帧半宽
            ELIF $当前扩窗层 == 2
                $有效Seed容差 = $扩窗第2层Seed容差
                $扩窗帧半宽 = $扩窗第2层帧半宽
            ELSE
                $有效Seed容差 = $扩窗第3层Seed容差
                $扩窗帧半宽 = $扩窗第3层帧半宽
            ENDIF
            $有效最小消耗帧 = $目标消耗帧 - $扩窗帧半宽
            IF $有效最小消耗帧 < 0
                $有效最小消耗帧 = 0
            ENDIF
            $有效最大消耗帧 = $目标消耗帧 + $扩窗帧半宽
            IF $调试日志输出 == 1
                PRINT ""
                PRINT 【分层扩窗】
                PRINT 反查无结果，放宽搜索窗口至第 & $当前扩窗层 & 层
                PRINT 有效Seed容差: ± & $有效Seed容差 & 个seed
                PRINT 有效消耗帧范围: & $有效最小消耗帧 & - & $有效最大消耗帧 & " 帧"
            ENDIF
        NEXT
        IF $反查扫描成功 == 0
            IF $御三家严格筛选 == 1
                RETURN 2
            ENDIF
            RETURN 0
        ENDIF
        IF $御三家严格筛选 == 1
            PRINT 御三家完整候选保留: & $本轮候选命中计数 & "；先提交跨轮共同区，再决定是否校准"
            RETURN 1
        ENDIF
        IF $跨组筛选收集启用 == 1 and $本轮候选命中计数 >= $跨组筛选候选阈值 and $本轮候选命中计数 <= $跨组筛选候选容量
            $跨组筛选回退启用 = 1
            PRINT 多候选跨组筛选: 本轮候选 & $本轮候选命中计数 & "，达到阈值 " & $跨组筛选候选阈值 & "；保留完整候选组，不按路径猜测"
            RETURN 1
        ENDIF

        # 停滞检测：本轮候选数相比上一颗糖未减少则计为停滞
        IF $本轮候选命中计数 >= $上轮候选数
            $候选停滞次数 += 1
        ELSE
            $候选停滞次数 = 0
        ENDIF
        $上轮候选数 = $本轮候选命中计数

        # 投票停糖：帧票堆稳定领先 → 帧路径已确定，不再吃糖直接校准（可撤销，逻辑在 lib/25）
        $投票忽略 = 投票决策($进入TV, $消耗帧实际执行修正量, $Seed累计修正索引)
        $本轮停糖 = 投票更新停糖()
        IF $本轮停糖 == 1
            $投票确定路径 = 1
            $停糖显示领先 = 投票取帧领先()
            $停糖显示稳定 = 投票取稳定计数()
            $停糖显示原因 = 投票取停糖原因()
            IF $调试日志输出 == 1
                PRINT ""
                PRINT 【候选细分】
                IF $停糖显示原因 == 1
                    PRINT 停糖原因: 投票停糖/真值解直通，连续2轮独立真值解命中
                ELSE
                    PRINT 停糖原因: 投票停糖/占比稳定，峰值堆领先 & $停糖显示领先 & 票且占比达标，稳定 & $停糖显示稳定 & 次
                ENDIF
                PRINT 动作: 停止吃糖，直接校准
            ENDIF
            CALL 输出最佳命中结果
            RETURN 1
        ELSE
            $投票确定路径 = 0
        ENDIF

        $候选收束成功 = 尝试收束候选()
        IF $候选收束成功 == 1
            RETURN 1
        ENDIF

        IF $本轮候选命中计数 == 1
            $本轮真值解 = 1
            CALL 输出最佳命中结果
            RETURN 1
        ENDIF

        IF $HP最小 == $HP最大 and $ATK最小 == $ATK最大 and $DEF最小 == $DEF最大 and $SPA最小 == $SPA最大 and $SPD最小 == $SPD最大 and $SPE最小 == $SPE最大
            $本轮真值解 = 1
            IF $调试日志输出 == 1
                PRINT ""
                PRINT 【候选细分】
                PRINT 候选数量: & $本轮候选命中计数
                PRINT 累计IV范围已缩小到唯一值
                PRINT 输出最佳候选(票堆驱动+离群过滤选出)进行后续计算
            ENDIF
            CALL 输出最佳命中结果
            RETURN 1
        ENDIF

        $御三家目标 = 是否御三家目标()
        IF $御三家目标 == 1
            IF $调试日志输出 == 1
                PRINT ""
                PRINT 【候选细分】
                PRINT 候选数量大于1，御三家不使用神奇糖果
                PRINT 停糖原因: 御三家目标不吃糖
                PRINT 输出最佳候选(票堆驱动+离群过滤选出)进行后续计算
            ENDIF
            CALL 输出最佳命中结果
            RETURN 1
        ENDIF

        # 有界脱困(方向2)：糖果达单只上限或候选停滞则停止吃糖，转入拆分校准（不可信维度本轮不会更新）
        IF ($糖果单只上限 > 0 and $本轮糖果次数 >= $糖果单只上限) or ($候选停滞上限 > 0 and $候选停滞次数 >= $候选停滞上限)
            IF $调试日志输出 == 1
                PRINT ""
                PRINT 【候选细分】
                PRINT 候选数量: & $本轮候选命中计数
                IF $糖果单只上限 > 0 and $本轮糖果次数 >= $糖果单只上限
                    PRINT 停糖原因: 有界脱困/糖果单只上限，已吃 & $本轮糖果次数 & "/" & $糖果单只上限 & 颗
                ELSE
                    PRINT 停糖原因: 有界脱困/候选停滞，连续 & $候选停滞次数 & " 颗糖未减少"
                ENDIF
                PRINT 输出最佳候选(票堆驱动+离群过滤选出)进行后续计算
            ENDIF
            CALL 输出最佳命中结果
            RETURN 1
        ENDIF

        IF $调试日志输出 == 1
            PRINT ""
            PRINT 【候选细分】
            PRINT 候选数量: & $本轮候选命中计数
            PRINT 选择规则: 票堆驱动(选落在累积票堆最一致路径者)+离群过滤(NPC孤票本轮跳过)，同状态平票取近预测中心
            PRINT 当前最佳候选Seed差: & $命中差索引 & 个seed
            PRINT 当前最佳候选距离: Seed & $最佳候选Seed距离 & " 剩余帧误差 " & $最佳候选剩余帧距离 & " TV帧 " & $最佳候选TV帧距离 & " MSE " & $最佳候选MSE
            PRINT 离群来源: Seed & $最佳候选Seed离群 & " 剩余帧 " & $最佳候选剩余帧离群 & " TV帧 " & $最佳候选TV帧离群 & " 最终 " & $最佳候选离群
            IF $最佳候选离群 == 1
                PRINT 继续吃糖原因: 当前最佳候选=离群孤票，需要继续塌缩候选
            ELSE
                PRINT 继续吃糖原因: 候选数仍大于真值上限，继续塌缩候选
            ENDIF
            PRINT 使用神奇糖果后重新识图反查
        ENDIF

        IF $目标全国图鉴编号 == 175 and $波克比Seed复核已抓野生 == 1
            # 第6槽保留Seed复核野生，波克比固定在第5槽。
            $神奇糖果结果 = 孵蛋测试_使用神奇糖果指定槽(5, 0)
        ELSE
            $神奇糖果结果 = 使用神奇糖果()
        ENDIF
        IF $神奇糖果结果 == 0
            IF $调试日志输出 == 1
                PRINT ""
                PRINT 【候选细分】
                PRINT 停糖原因: 神奇糖果已用完，无法继续细分候选
                PRINT 输出最佳候选(票堆驱动+离群过滤选出)进行后续计算
            ENDIF
            CALL 输出最佳命中结果
            RETURN 1
        ENDIF

        $刚使用神奇糖果 = 1
        $本轮糖果次数 += 1
        IF $目标全国图鉴编号 == 175 and $波克比Seed复核已抓野生 == 1
            $孵蛋流程开页结果 = 孵蛋流程_喂糖后打开蛋能力页()
        ELSE
            CALL 打开能力值识图页面
        ENDIF
    NEXT

    RETURN 0
ENDFUNC

# 收束判定（可撤销，每轮重判）：候选塌缩到 ≤N 才算“真值解”(不依赖路径的独立解)，立刻直接选并结束本轮吃糖。
# 否则返回 0 → 继续吃糖逼出真值。不再有“一次唯一即永久停糖”的锁死。
FUNC 尝试收束候选(): INT
    IF $本轮候选命中计数 <= $候选真值上限
        $本轮真值解 = 1
        IF $调试日志输出 == 1
            PRINT ""
            PRINT 【候选细分】
            PRINT 候选数量: & $本轮候选命中计数
            PRINT 停糖原因: 候选已塌缩到 ≤ & $候选真值上限 & "（真值解，独立于路径）"
            PRINT 直接选择该结果，用于喂养/重锚路径中心
        ENDIF
        CALL 输出最佳命中结果
        RETURN 1
    ENDIF

    RETURN 0
ENDFUNC

FUNC 合并候选细分IV范围(): INT
    IF $候选细分累计范围有效 == 0
        $累计HP最小 = $HP最小
        $累计HP最大 = $HP最大
        $累计ATK最小 = $ATK最小
        $累计ATK最大 = $ATK最大
        $累计DEF最小 = $DEF最小
        $累计DEF最大 = $DEF最大
        $累计SPA最小 = $SPA最小
        $累计SPA最大 = $SPA最大
        $累计SPD最小 = $SPD最小
        $累计SPD最大 = $SPD最大
        $累计SPE最小 = $SPE最小
        $累计SPE最大 = $SPE最大
        $候选细分累计范围有效 = 1
        RETURN 1
    ENDIF

    IF $HP最小 < $累计HP最小
        $HP最小 = $累计HP最小
    ENDIF
    IF $HP最大 > $累计HP最大
        $HP最大 = $累计HP最大
    ENDIF

    IF $ATK最小 < $累计ATK最小
        $ATK最小 = $累计ATK最小
    ENDIF
    IF $ATK最大 > $累计ATK最大
        $ATK最大 = $累计ATK最大
    ENDIF

    IF $DEF最小 < $累计DEF最小
        $DEF最小 = $累计DEF最小
    ENDIF
    IF $DEF最大 > $累计DEF最大
        $DEF最大 = $累计DEF最大
    ENDIF

    IF $SPA最小 < $累计SPA最小
        $SPA最小 = $累计SPA最小
    ENDIF
    IF $SPA最大 > $累计SPA最大
        $SPA最大 = $累计SPA最大
    ENDIF

    IF $SPD最小 < $累计SPD最小
        $SPD最小 = $累计SPD最小
    ENDIF
    IF $SPD最大 > $累计SPD最大
        $SPD最大 = $累计SPD最大
    ENDIF

    IF $SPE最小 < $累计SPE最小
        $SPE最小 = $累计SPE最小
    ENDIF
    IF $SPE最大 > $累计SPE最大
        $SPE最大 = $累计SPE最大
    ENDIF

    IF $HP最小 > $HP最大 or $ATK最小 > $ATK最大 or $DEF最小 > $DEF最大 or $SPA最小 > $SPA最大 or $SPD最小 > $SPD最大 or $SPE最小 > $SPE最大
        PRINT ""
        PRINT 【候选细分】
        PRINT 多次识图IV范围交集为空，脚本停止
        PRINT 请检查神奇糖果后的识图结果或能力值标签
        RETURN 0
    ENDIF

    $累计HP最小 = $HP最小
    $累计HP最大 = $HP最大
    $累计ATK最小 = $ATK最小
    $累计ATK最大 = $ATK最大
    $累计DEF最小 = $DEF最小
    $累计DEF最大 = $DEF最大
    $累计SPA最小 = $SPA最小
    $累计SPA最大 = $SPA最大
    $累计SPD最小 = $SPD最小
    $累计SPD最大 = $SPD最大
    $累计SPE最小 = $SPE最小
    $累计SPE最大 = $SPE最大

    IF $调试日志输出 == 1
        PRINT ""
        PRINT 累计IV范围交集:
        PRINT HP: & $HP最小 & - & $HP最大
        PRINT ATK: & $ATK最小 & - & $ATK最大
        PRINT DEF: & $DEF最小 & - & $DEF最大
        PRINT SPA: & $SPA最小 & - & $SPA最大
        PRINT SPD: & $SPD最小 & - & $SPD最大
        PRINT SPE: & $SPE最小 & - & $SPE最大
    ENDIF

    RETURN 1
ENDFUNC

FUNC 是否御三家目标(): INT
    IF $目标全国图鉴编号 == 1 or $目标全国图鉴编号 == 4 or $目标全国图鉴编号 == 7
        RETURN 1
    ENDIF

    RETURN 0
ENDFUNC

# 1.6.4-a 第0轮快捷登记检查：重要道具第1项TV、第2项自行车、第3项当前钓竿。

FUNC 取当前流程快捷登记目标(): INT
    # 所有钓鱼路线都用Y快捷键出竿；TV改从背包使用。
    IF $遭遇类型 == 2 and ($遭遇方法 == 201 or $遭遇方法 == 202 or $遭遇方法 == 203)
        RETURN 3
    ENDIF

    # 狩猎区西区草丛路线需要自行车快捷键。
    IF $遭遇类型 == 2 and $遭遇地点 == 57 and $遭遇方法 == 101
        RETURN 2
    ENDIF

    # 波克比无TV时直接用自行车快捷键；有TV时由下面分支登记TV。
    IF $目标全国图鉴编号 == 175 and $进入TV == 0
        RETURN 2
    ENDIF

    # 普通定点、野生和游走的TV由Y快捷键启动；狩猎区TV从背包启动。
    IF $进入TV == 1 and 是否狩猎地带($遭遇地点) == 0
        RETURN 1
    ENDIF

    RETURN 0
ENDFUNC

FUNC 检查并校正快捷登记($目标位: INT, $识图阈值: INT): INT
    IF $目标位 <= 0
        RETURN 1
    ENDIF

    $快捷登记结果 = 1

    PRINT "FRLG_STAGE|BEGIN|settings.shortcut|settings.shortcut|20000|NS火叶全自动一键乱数2.0.ecs|检查并校正快捷登记|main.settings.shortcut|manual_prepare_then_restart|OR;快捷第一位.IL:>=:" & $识图阈值 & ",快捷第二位.IL:>=:" & $识图阈值 & ",快捷第三位.IL:>=:" & $识图阈值 & "|!"
    X
    WAIT 500
    # 不依赖主菜单上次停留项，先夹到顶部再进入背包。
    FOR 8
        UP
        WAIT 100
    NEXT
    FOR 2
        DOWN
        WAIT 150
    NEXT
    A
    WAIT 1500
    RIGHT
    WAIT 1500

    $快捷登记第一分数 = @快捷第一位
    $快捷登记第二分数 = @快捷第二位
    $快捷登记第三分数 = @快捷第三位
    $快捷登记目标分数 = $快捷登记第一分数
    IF $目标位 == 2
        $快捷登记目标分数 = $快捷登记第二分数
    ELIF $目标位 == 3
        $快捷登记目标分数 = $快捷登记第三分数
    ENDIF
    PRINT "快捷登记识别: 目标位=" & $目标位 & " 第一位=" & $快捷登记第一分数 & " 第二位=" & $快捷登记第二分数 & " 第三位=" & $快捷登记第三分数

    IF $快捷登记目标分数 < $识图阈值
        # 重要道具光标也先夹到顶部，再选择固定的第1/2/3项。
        FOR 6
            UP
            WAIT 100
        NEXT
        $快捷登记移动次数 = $目标位 - 1
        IF $快捷登记移动次数 > 0
            FOR $快捷登记移动索引 = 1 TO $快捷登记移动次数
                DOWN
                WAIT 150
            NEXT
        ENDIF
        A
        WAIT 700
        # 道具菜单固定为 USE / REGISTER / CANCEL，向下一项登记。
        DOWN
        WAIT 300
        A
        WAIT 1500

        $快捷登记目标分数 = -1
        FOR $快捷登记识别尝试 = 1 TO 3
            IF $目标位 == 1
                $快捷登记目标分数 = @快捷第一位
            ELIF $目标位 == 2
                $快捷登记目标分数 = @快捷第二位
            ELSE
                $快捷登记目标分数 = @快捷第三位
            ENDIF
            IF $快捷登记目标分数 >= $识图阈值
                BREAK
            ENDIF
            WAIT 500
        NEXT
        IF $快捷登记目标分数 < $识图阈值
            PRINT "FRLG_STAGE|FAIL|settings.shortcut|快捷登记后目标位置仍未匹配|!"
            PRINT "快捷登记检查失败: 目标位=" & $目标位 & " 匹配度=" & $快捷登记目标分数
            B
            WAIT 700
            B
            WAIT 1000
            RETURN 0
        ENDIF
        PRINT "快捷登记已修改为重要道具第" & $目标位 & "项"
        $快捷登记结果 = 2
    ELSE
        PRINT "快捷登记正确: 重要道具第" & $目标位 & "项"
        $快捷登记结果 = 1
    ENDIF

    B
    WAIT 700
    B
    WAIT 1000
    PRINT "FRLG_STAGE|END|settings.shortcut|!"
    RETURN $快捷登记结果
ENDFUNC

FUNC 检查并校正游戏设置(): INT
    IF $调试日志输出 == 1
        PRINT ""
        PRINT "【第0轮游戏设置检查】"
    ENDIF
    $游戏设置已修改 = 0
    $游戏设置目标声音 = 0
    $游戏设置目标按键 = 0

    # 按本轮流程自动检查并切换重要道具快捷登记。
    $游戏设置快捷目标位 = 取当前流程快捷登记目标()
    $游戏设置快捷结果 = 检查并校正快捷登记($游戏设置快捷目标位, $游戏设置识图阈值)
    IF $游戏设置快捷结果 == 0
        RETURN 0
    ENDIF
    IF $游戏设置快捷结果 == 2
        # 快捷登记属于存档状态；必须走本函数的保存/重启分支才能保留。
        $游戏设置已修改 = 1
    ENDIF

    # 模式0-9均使用HELP；模式3为STEREO/HELP/START；模式10为日版MONO/HELP/A。
    IF $Seed模式 == 1 or $Seed模式 == 3 or $Seed模式 == 6 or $Seed模式 == 7
        $游戏设置目标声音 = 1
    ENDIF

    X
    WAIT 500
    # 快捷登记检查会改变主菜单记忆位置，进入Options前统一夹到顶部。
    FOR 8
        UP
        WAIT 100
    NEXT
    IF 是否御三家目标() == 1
        # 开局尚无图鉴/宝可梦菜单，Options位于第4项。
        FOR 3
            LS DOWN
            WAIT 50
            LS RESET
            WAIT 100
        NEXT
    ELSE
        # 正常存档已有图鉴/宝可梦菜单，Options位于第6项。
        FOR 5
            LS DOWN
            WAIT 50
            LS RESET
            WAIT 100
        NEXT
    ENDIF
    A
    WAIT 1500

    PRINT "FRLG_STAGE|BEGIN|settings.text_speed|settings.text_speed|15000|NS火叶全自动一键乱数2.0.ecs|检查并校正游戏设置|main.settings.text_speed|manual_prepare_then_restart|OR;TEXT_SPEED_FAST.IL:>=:" & $游戏设置识图阈值 & ",日版TEXT_SPEED_FAST.IL:>=:" & $游戏设置识图阈值 & ",TEXT_SPEED_SLOW.IL:>=:" & $游戏设置识图阈值 & ",日版TEXT_SPEED_SLOW.IL:>=:" & $游戏设置识图阈值 & ",TEXT_SPEED_MID.IL:>=:" & $游戏设置识图阈值 & ",日版TEXT_SPEED_MID.IL:>=:" & $游戏设置识图阈值 & "|!"
    IF @TEXT_SPEED_FAST >= $游戏设置识图阈值 or @日版TEXT_SPEED_FAST >= $游戏设置识图阈值
        IF $调试日志输出 == 1
            PRINT "文字速度: FAST"
        ENDIF
    ELIF @TEXT_SPEED_SLOW >= $游戏设置识图阈值 or @日版TEXT_SPEED_SLOW >= $游戏设置识图阈值
        LS LEFT
        WAIT 50
        LS RESET
        WAIT 150
        $游戏设置已修改 = 1
        IF $调试日志输出 == 1
            PRINT "文字速度: SLOW -> FAST"
        ENDIF
    ELIF @TEXT_SPEED_MID >= $游戏设置识图阈值 or @日版TEXT_SPEED_MID >= $游戏设置识图阈值
        LS RIGHT
        WAIT 50
        LS RESET
        WAIT 150
        $游戏设置已修改 = 1
        IF $调试日志输出 == 1
            PRINT "文字速度: MID -> FAST"
        ENDIF
    ELSE
        PRINT "FRLG_STAGE|FAIL|settings.text_speed|文字速度选项未匹配|!"
        PRINT "游戏设置检查失败: 无法识别文字速度选项"
        RETURN 0
    ENDIF
    PRINT "FRLG_STAGE|END|settings.text_speed|!"

    LS DOWN
    WAIT 50
    LS RESET
    WAIT 150
    PRINT "FRLG_STAGE|BEGIN|settings.battle_scene|settings.battle_scene|15000|NS火叶全自动一键乱数2.0.ecs|检查并校正游戏设置|main.settings.battle_scene|manual_prepare_then_restart|OR;BATTLE_SCENE_OFF.IL:>=:" & $游戏设置识图阈值 & ",日版BATTLE_SCENE_OFF.IL:>=:" & $游戏设置识图阈值 & ",BATTLE_SCENE_ON.IL:>=:" & $游戏设置识图阈值 & ",日版BATTLE_SCENE_ON.IL:>=:" & $游戏设置识图阈值 & "|!"
    IF @BATTLE_SCENE_OFF >= $游戏设置识图阈值 or @日版BATTLE_SCENE_OFF >= $游戏设置识图阈值
        IF $调试日志输出 == 1
            PRINT "战斗动画: OFF"
        ENDIF
    ELIF @BATTLE_SCENE_ON >= $游戏设置识图阈值 or @日版BATTLE_SCENE_ON >= $游戏设置识图阈值
        LS RIGHT
        WAIT 50
        LS RESET
        WAIT 150
        $游戏设置已修改 = 1
        IF $调试日志输出 == 1
            PRINT "战斗动画: ON -> OFF"
        ENDIF
    ELSE
        PRINT "FRLG_STAGE|FAIL|settings.battle_scene|战斗动画选项未匹配|!"
        PRINT "游戏设置检查失败: 无法识别战斗动画选项"
        RETURN 0
    ENDIF
    PRINT "FRLG_STAGE|END|settings.battle_scene|!"

    FOR 2
        LS DOWN
        WAIT 50
        LS RESET
        WAIT 150
    NEXT
    PRINT "FRLG_STAGE|BEGIN|settings.sound|settings.sound|15000|NS火叶全自动一键乱数2.0.ecs|检查并校正游戏设置|main.settings.sound|manual_prepare_then_restart|OR;SOUND_MONO.IL:>=:" & $游戏设置识图阈值 & ",日版SOUND_MONO.IL:>=:" & $游戏设置识图阈值 & ",SOUND_STEREO.IL:>=:" & $游戏设置识图阈值 & ",日版SOUND_STEREO.IL:>=:" & $游戏设置识图阈值 & "|!"
    IF $游戏设置目标声音 == 0
        IF @SOUND_MONO >= $游戏设置识图阈值 or @日版SOUND_MONO >= $游戏设置识图阈值
            IF $调试日志输出 == 1
                PRINT "声音: MONO"
            ENDIF
        ELIF @SOUND_STEREO >= $游戏设置识图阈值 or @日版SOUND_STEREO >= $游戏设置识图阈值
            LS RIGHT
            WAIT 50
            LS RESET
            WAIT 150
            $游戏设置已修改 = 1
            IF $调试日志输出 == 1
                PRINT "声音: STEREO -> MONO"
            ENDIF
        ELSE
            PRINT "FRLG_STAGE|FAIL|settings.sound|声音选项未匹配|!"
            PRINT "游戏设置检查失败: 无法识别声音选项"
            RETURN 0
        ENDIF
    ELSE
        IF @SOUND_STEREO >= $游戏设置识图阈值 or @日版SOUND_STEREO >= $游戏设置识图阈值
            IF $调试日志输出 == 1
                PRINT "声音: STEREO"
            ENDIF
        ELIF @SOUND_MONO >= $游戏设置识图阈值 or @日版SOUND_MONO >= $游戏设置识图阈值
            LS RIGHT
            WAIT 50
            LS RESET
            WAIT 150
            $游戏设置已修改 = 1
            IF $调试日志输出 == 1
                PRINT "声音: MONO -> STEREO"
            ENDIF
        ELSE
            PRINT "FRLG_STAGE|FAIL|settings.sound|声音选项未匹配|!"
            PRINT "游戏设置检查失败: 无法识别声音选项"
            RETURN 0
        ENDIF
    ENDIF
    PRINT "FRLG_STAGE|END|settings.sound|!"

    LS DOWN
    WAIT 50
    LS RESET
    WAIT 150
    PRINT "FRLG_STAGE|BEGIN|settings.button_mode|settings.button_mode|15000|NS火叶全自动一键乱数2.0.ecs|检查并校正游戏设置|main.settings.button_mode|manual_prepare_then_restart|OR;BUTTON_MODE_HELP.IL:>=:" & $游戏设置识图阈值 & ",日版BUTTON_MODE_HELP.IL:>=:" & $游戏设置识图阈值 & ",BUTTON_MODE_LA.IL:>=:" & $游戏设置识图阈值 & ",日版BUTTON_MODE_LA.IL:>=:" & $游戏设置识图阈值 & ",BUTTON_MODE_LR.IL:>=:" & $游戏设置识图阈值 & ",日版BUTTON_MODE_LR.IL:>=:" & $游戏设置识图阈值 & "|!"
    IF $游戏设置目标按键 == 0
        IF @BUTTON_MODE_HELP >= $游戏设置识图阈值 or @日版BUTTON_MODE_HELP >= $游戏设置识图阈值
            IF $调试日志输出 == 1
                PRINT "按键模式: HELP"
            ENDIF
        ELIF @BUTTON_MODE_LA >= $游戏设置识图阈值 or @日版BUTTON_MODE_LA >= $游戏设置识图阈值
            LS RIGHT
            WAIT 50
            LS RESET
            WAIT 150
            $游戏设置已修改 = 1
            IF $调试日志输出 == 1
                PRINT "按键模式: L=A -> HELP"
            ENDIF
        ELIF @BUTTON_MODE_LR >= $游戏设置识图阈值 or @日版BUTTON_MODE_LR >= $游戏设置识图阈值
            LS LEFT
            WAIT 50
            LS RESET
            WAIT 150
            $游戏设置已修改 = 1
            IF $调试日志输出 == 1
                PRINT "按键模式: LR -> HELP"
            ENDIF
        ELSE
            PRINT "FRLG_STAGE|FAIL|settings.button_mode|按键模式选项未匹配|!"
            PRINT "游戏设置检查失败: 无法识别按键模式选项"
            RETURN 0
        ENDIF
    ELSE
        IF @BUTTON_MODE_LR >= $游戏设置识图阈值 or @日版BUTTON_MODE_LR >= $游戏设置识图阈值
            IF $调试日志输出 == 1
                PRINT "按键模式: LR"
            ENDIF
        ELIF @BUTTON_MODE_LA >= $游戏设置识图阈值 or @日版BUTTON_MODE_LA >= $游戏设置识图阈值
            LS LEFT
            WAIT 50
            LS RESET
            WAIT 150
            $游戏设置已修改 = 1
            IF $调试日志输出 == 1
                PRINT "按键模式: L=A -> LR"
            ENDIF
        ELIF @BUTTON_MODE_HELP >= $游戏设置识图阈值 or @日版BUTTON_MODE_HELP >= $游戏设置识图阈值
            LS RIGHT
            WAIT 50
            LS RESET
            WAIT 150
            $游戏设置已修改 = 1
            IF $调试日志输出 == 1
                PRINT "按键模式: HELP -> LR"
            ENDIF
        ELSE
            PRINT "FRLG_STAGE|FAIL|settings.button_mode|按键模式选项未匹配|!"
            PRINT "游戏设置检查失败: 无法识别按键模式选项"
            RETURN 0
        ENDIF
    ENDIF
    PRINT "FRLG_STAGE|END|settings.button_mode|!"

    IF $游戏设置已修改 == 0
        PRINT "结果: 游戏设置与Seed模式一致，无需保存"
        RETURN 1
    ENDIF

    B
    WAIT 1500
    LS UP
    WAIT 50
    LS RESET
    WAIT 100
    A
    WAIT 1000
    A
    WAIT 1500
    A
    WAIT 3000
    PRINT "结果: 游戏设置已校正并保存"
    RETURN 2
ENDFUNC

FUNC 准备Seed启动原点
    CALL 关闭游戏
    IF $Seed启动方案 == 0
        IF $调试日志输出 == 1
            PRINT Seed启动方案: 当前HOME_BUFFER
        ENDIF
        CALL HOME_BUFFER
        WAIT 1500
    ELSE
        IF $调试日志输出 == 1
            PRINT Seed启动方案: 固定用户界面HOME
        ENDIF
        # 关闭游戏后位于主页：先打开用户选择界面，再从参考脚本的起点执行固定时序。
        A
        WAIT 1500
        A
        WAIT 1500
        HOME 100
        WAIT 3000
    ENDIF
ENDFUNC

FUNC 波克比流程_准备水之迷宫野生反查(): INT
    $波克比流程原目标消耗帧 = $目标消耗帧
    $波克比流程原目标全国图鉴编号 = $目标全国图鉴编号
    $波克比流程原运行前目标全国图鉴编号 = $运行前目标全国图鉴编号
    $波克比流程原遭遇类型 = $遭遇类型
    $波克比流程原遭遇方法 = $遭遇方法
    $波克比流程原遭遇地点 = $遭遇地点
    $波克比流程原遭遇方法名称 = $遭遇方法名称
    $波克比流程原遭遇地点名称 = $遭遇地点名称
    $波克比流程原反查算法 = $反查算法
    $波克比流程原进入TV = $进入TV
    $波克比流程原道具乱数模式 = $道具乱数模式
    $波克比流程原最小消耗帧 = $最小消耗帧
    $波克比流程原最大消耗帧 = $最大消耗帧

    # 水之迷宫 / Water Labyrinth，冲浪。实际物种由抓捕OCR同步，随后按遇敌槽校验。
    $遭遇类型 = 2
    $遭遇方法 = 102
    $遭遇地点 = 99
    $遭遇方法名称 = 目标遭遇方法名称($遭遇方法)
    $遭遇地点名称 = 目标遭遇地点名称($遭遇地点)
    $波克比流程野生槽结果 = 加载野生遇敌槽数据()
    IF $波克比流程野生槽结果 != 1
        RETURN 0
    ENDIF

    $努力HP = 0
    $努力ATK = 0
    $努力DEF = 0
    $努力SPA = 0
    $努力SPD = 0
    $努力SPE = 0
    $道具乱数模式 = 0
    $进入TV = 0
    $反查算法 = 199
    $最小消耗帧 = $波克比流程原目标消耗帧 - $波克比野生反查帧半宽
    IF $最小消耗帧 < 0
        $最小消耗帧 = 0
    ENDIF
    $最大消耗帧 = $波克比流程原目标消耗帧 + $波克比野生反查帧半宽
    $有效Seed容差 = $Seed容差
    $有效最小消耗帧 = $最小消耗帧
    $有效最大消耗帧 = $最大消耗帧
    IF $调试日志输出 == 1
        PRINT 波克比Seed复核地点: 水之迷宫 / 冲浪
        PRINT 波克比野生反查窗口: 目标帧 & $波克比流程原目标消耗帧 & " ±" & $波克比野生反查帧半宽 & "（" & $最小消耗帧 & "-" & $最大消耗帧 & "）"
    ENDIF
    RETURN 1
ENDFUNC

FUNC 波克比流程_恢复静态目标(): INT
    $目标消耗帧 = $波克比流程原目标消耗帧
    $目标全国图鉴编号 = $波克比流程原目标全国图鉴编号
    $运行前目标全国图鉴编号 = $波克比流程原运行前目标全国图鉴编号
    $遭遇类型 = $波克比流程原遭遇类型
    $遭遇方法 = $波克比流程原遭遇方法
    $遭遇地点 = $波克比流程原遭遇地点
    $遭遇方法名称 = $波克比流程原遭遇方法名称
    $遭遇地点名称 = $波克比流程原遭遇地点名称
    $反查算法 = $波克比流程原反查算法
    $进入TV = $波克比流程原进入TV
    $道具乱数模式 = $波克比流程原道具乱数模式
    $最小消耗帧 = $波克比流程原最小消耗帧
    $最大消耗帧 = $波克比流程原最大消耗帧
    $有效Seed容差 = $Seed容差
    $有效最小消耗帧 = $最小消耗帧
    $有效最大消耗帧 = $最大消耗帧
    $目标名称字符 = 目标名称($游戏版本, $目标全国图鉴编号)
    $目标英文名称字符 = 目标英文名称($目标全国图鉴编号)
    $性别阈值 = 取性别阈值($目标全国图鉴编号)
    $波克比流程恢复结果 = 加载野生遇敌槽数据()
    IF $波克比流程恢复结果 != 1
        RETURN 0
    ENDIF
    $波克比流程恢复结果 = 加载目标组合数据()
    RETURN $波克比流程恢复结果
ENDFUNC

FUNC 波克比流程_验证水之迷宫野生Seed(): INT
    $波克比流程同步结果 = 孵蛋流程_同步Seed验证野生()
    IF $波克比流程同步结果 != 1
        RETURN 0
    ENDIF

    $本轮糖果次数 = 0
    $野生遭遇初始等级 = -1
    $波克比流程开页结果 = 孵蛋流程_打开指定槽能力页(6, 1)
    IF $波克比流程开页结果 != 1
        RETURN 0
    ENDIF

    # 固定使用波克比目标帧±5000的一次窗口；不调用普通孵蛋野生的追加扩窗。
    $有效Seed容差 = $Seed容差
    $有效最小消耗帧 = $最小消耗帧
    $有效最大消耗帧 = $最大消耗帧
    FOR
        $波克比流程识图结果 = 读取并输出识图结果()
        IF $波克比流程识图结果 != 1
            RETURN 0
        ENDIF
        IF $野生遭遇初始等级 < 0
            $野生遭遇初始等级 = $等级
            $野生等级校验结果 = 校验野生遭遇初始等级()
            IF $野生等级校验结果 != 1
                RETURN 0
            ENDIF
        ENDIF
        $波克比流程反查准备结果 = 准备反查参数与输出()
        IF $波克比流程反查准备结果 != 1
            RETURN 0
        ENDIF
        $波克比流程扫描结果 = 执行反查扫描()
        IF $波克比流程扫描结果 != 1
            PRINT 波克比水之迷宫野生在目标帧±5000内没有反查候选
            RETURN 0
        ENDIF

        IF $候选全部同一Seed == 1
            IF $候选同一Seed值 == 0
                IF $调试日志输出 == 1
                    PRINT 波克比Seed复核: 命中目标Seed
                    CALL 输出最佳命中结果
                ELSE
                    PRINT Seed结果: 命中目标Seed
                ENDIF
                RETURN 1
            ENDIF
            IF $调试日志输出 == 1
                PRINT 波克比Seed复核: 命中非目标Seed，偏差 & $候选同一Seed值
                CALL 输出最佳命中结果
            ELSE
                PRINT Seed结果: 偏差 & $候选同一Seed值 & "，未命中目标"
            ENDIF
            RETURN 2
        ENDIF

        IF $本轮糖果次数 >= $孵蛋野生最多糖果
            PRINT 波克比野生反查仍跨多个Seed，达到糖果上限
            RETURN 0
        ENDIF
        $波克比流程糖果结果 = 孵蛋测试_使用神奇糖果指定槽(6, 1)
        IF $波克比流程糖果结果 != 1
            RETURN 0
        ENDIF
        $本轮糖果次数 += 1
        $刚使用神奇糖果 = 1
        CALL 打开能力值识图页面
    NEXT
    RETURN 0
ENDFUNC

FUNC 波克比流程_按观测Seed校正等待($Seed差索引: INT): INT
    $命中差索引 = $Seed差索引
    $Seed差绝对 = $命中差索引
    IF $Seed差绝对 < 0
        $Seed差绝对 = 0 - $Seed差绝对
    ENDIF
    $Seed本轮可信 = 1
    IF $Seed校准方案 == 0
        $投票忽略 = 投票设置Seed校准样本($命中差索引, $Seed累计修正索引)
        $Seed校准样本数 = 投票取Seed校准样本数()
        $Seed校准目标绝对 = 投票取Seed校准目标()
        $Seed校准目标票数 = 投票取Seed校准目标票数()
        $Seed校准目标差 = $Seed校准目标绝对 - $Seed累计修正索引
        $Seed本次修正索引 = 计算Seed原始众数修正()
    ELSE
        $Seed本次修正索引 = 计算Seed锁定众数修正()
    ENDIF

    $Seed累计修正索引 = 累加实际执行修正量($Seed累计修正索引, $Seed本次修正索引)
    $Seed修正目标索引 = $目标索引 + $Seed累计修正索引
    IF $Seed修正目标索引 < 0
        $Seed修正目标索引 = 0
    ENDIF
    IF $Seed修正目标索引 > $Seed最大索引
        $Seed修正目标索引 = $Seed最大索引
    ENDIF
    $SeedMS上次实际执行修正量 = $SeedMS实际执行修正量
    $SeedMS实际执行修正量 = 取MS($游戏版本, $Seed修正目标索引) - 取MS($游戏版本, $目标索引)
    $SeedMS本次新增修正量 = $SeedMS实际执行修正量 - $SeedMS上次实际执行修正量
    $SeedMS = $目标SeedMS - $SeedMS实际执行修正量 + $Seed基础补偿 + $Seed预校准命令修正MS + $Seed精细修正MS
    IF $SeedMS <= 0
        PRINT 波克比Seed校准生成了无效等待: & $SeedMS
        RETURN 0
    ENDIF

    IF $调试日志输出 == 1
        PRINT 【波克比Seed校准】
        PRINT 观测差: & $Seed差索引 & "；修正模式: " & $Seed修正模式文本
        PRINT 索引修正: 本次 & $Seed本次修正索引 & "，累计 " & $Seed累计修正索引 & "，查表累计 " & $SeedMS实际执行修正量 & " ms"
        PRINT 下一轮Seed等待: & $SeedMS & " ms"
    ELSE
        PRINT 下轮Seed请求: & $SeedMS & " ms"
    ENDIF
    RETURN 1
ENDFUNC

FUNC 波克比流程_执行领取后Seed复核(): INT
    $波克比Seed复核已抓野生 = 0
    $波克比流程野生准备结果 = 波克比流程_准备水之迷宫野生反查()
    IF $波克比流程野生准备结果 != 1
        PRINT 波克比水之迷宫野生反查准备失败
        RETURN -1
    ENDIF

    $波克比流程抓捕结果 = 获取波克比_领取后前往水之迷宫抓捕($识图阈值, $实际出闪后继续抓捕)
    IF $波克比流程抓捕结果 != 1
        PRINT 波克比领取后野生抓捕失败，停止并保留当前画面
        $波克比流程恢复结果 = 波克比流程_恢复静态目标()
        RETURN -1
    ENDIF

    $波克比流程Seed验证结果 = 波克比流程_验证水之迷宫野生Seed()
    IF $波克比流程Seed验证结果 == 1
        # 目标Seed只负责放行；孵化后的波克比通用反查会为本轮正式记一次Seed样本。
        $波克比流程Seed校正结果 = 1
    ELIF $波克比流程Seed验证结果 == 2
        $波克比流程Seed校正结果 = 波克比流程_按观测Seed校正等待($候选同一Seed值)
    ELSE
        $波克比流程Seed校正结果 = 0
    ENDIF

    $波克比流程恢复结果 = 波克比流程_恢复静态目标()
    CALL 清空获取结果
    IF $波克比流程恢复结果 != 1
        PRINT 波克比Seed复核后恢复静态目标数据失败
        RETURN -1
    ENDIF
    IF $波克比流程Seed校正结果 != 1
        PRINT 波克比野生Seed反查或校准失败，停止并保留当前画面
        RETURN -1
    ENDIF

    IF $波克比流程Seed验证结果 == 2
        PRINT 波克比领取后未命中目标Seed；仅校正Seed等待，下一轮重新领取
        RETURN 0
    ENDIF

    $波克比Seed复核已抓野生 = 1
    $波克比流程孵化结果 = 获取波克比_Seed复核后执行专用骑车($目标全国图鉴编号, $进入TV)
    IF $波克比流程孵化结果 != 1
        PRINT 波克比孵化动作失败，停止并保留当前画面
        RETURN -1
    ENDIF
    RETURN 1
ENDFUNC


FUNC 执行RNG启动与目标获取(): INT
    $SeedMS_Blackout = 0
    $SeedBlackout肩键保持MS = 25820 + $NXSeed平台偏移MS
    $SeedBlackout最短MS = 4700 + $SeedBlackout肩键保持MS
    IF $SeedBlackout肩键保持MS <= 0
        PRINT ""
        PRINT 当前机型blackout固定等待无效: & $SeedBlackout肩键保持MS & " ms"
        RETURN -1
    ENDIF
    IF $Seed模式 == 4 or $Seed模式 == 5 or $Seed模式 == 6 or $Seed模式 == 7 or $Seed模式 == 8 or $Seed模式 == 9
        $SeedMS_Blackout = $SeedMS - $SeedBlackout最短MS
        IF $SeedMS_Blackout < 0
            PRINT ""
            PRINT 当前seed小于本机型blackout最短可执行值
            PRINT Seed请求: & $SeedMS & " ms；最短: " & $SeedBlackout最短MS & " ms"
            RETURN -1
        ENDIF
    ELIF $SeedMS <= 0
        PRINT ""
        PRINT 当前Seed请求无效: & $SeedMS & " ms"
        RETURN -1
    ENDIF
    PRINT ""
    CALL 准备Seed启动原点
    IF $循环计数 == 0
        $第0轮Seed等待请求 = $SeedMS
    ENDIF
    IF $Seed启动方案 == 1
        A#固定方案：恢复游戏后再建立Seed计时原点，与参考脚本一致
        $time_start = TIME()
    ELSE
        $time_start = TIME()
        A#进入游戏
    ENDIF
    IF $Seed模式 == 4 or $Seed模式 == 5 or $Seed模式 == 6 or  $Seed模式 == 7 or $Seed模式 == 8 or $Seed模式 == 9
        WAIT 4700
        IF $Seed模式 == 4 or $Seed模式 == 6 or $Seed模式 == 8
            R DOWN
        ELIF $Seed模式 == 5 or $Seed模式 == 7 or $Seed模式 == 9
            L DOWN
        ENDIF
        WAIT $SeedBlackout肩键保持MS
        IF $Seed模式 == 4 or $Seed模式 == 6 or $Seed模式 == 8
            R UP
        ELIF $Seed模式 == 5 or $Seed模式 == 7 or $Seed模式 == 9
            L UP
        ENDIF
        WAIT $SeedMS_Blackout
    ELSE
        WAIT $SeedMS
    ENDIF
    $time_OP = TIME()

    IF $Seed模式 == 0 or $Seed模式 == 1 or $Seed模式 == 4 or $Seed模式 == 5 or $Seed模式 == 6 or  $Seed模式 == 7 or $Seed模式 == 10
        A DOWN#封面确认
        WAIT 3000
        A UP#松开
    ELIF $Seed模式 == 2 or $Seed模式 == 3 or $Seed模式 == 8 or $Seed模式 == 9
        X DOWN#封面确认
        WAIT 3000
        X UP#松开
    ELIF $Seed模式 < 0 or $Seed模式 > 10
        PRINT ""
        PRINT 目标获取失败: Seed模式设置不准确
        RETURN -1
    ENDIF
    500
    WAIT $F1等待MS
    $time_F1 = TIME()

    A DOWN#进入存档
    1000
    A UP
    500
    B
    2500

    IF $循环计数 == 0 and $第0轮游戏设置检查 == 1 and $游戏设置检查完成 == 0
        $游戏设置检查结果 = 检查并校正游戏设置()
        IF $游戏设置检查结果 == 0
            RETURN -1
        ENDIF
        $游戏设置检查完成 = 1
        RETURN 3
    ENDIF

    $御三家F2执行等待MS = $F2等待MS
    $御三家菜单耗时MS = 0
    # 普通帧轴菜单奇偶方案：跳过回忆并回到地图后、进入TV/目标流程前执行。
    # 普通目标已在等待参数中预扣114帧；御三家保留独立计时，不使用该推进补偿。
    IF $帧奇偶修正方案 == 1 and $帧轴菜单奇偶开关 == 1
        IF $调试日志输出 == 1
            PRINT 普通帧轴奇偶修正: 开关菜单一次（普通目标预扣114帧；御三家不预扣）
        ENDIF
        $御三家菜单起始MS = TIME()
        X
        WAIT 500
        B
        WAIT 500
        IF $循环计数 > 0 and ($目标全国图鉴编号 == 1 or $目标全国图鉴编号 == 4 or $目标全国图鉴编号 == 7)
            $御三家菜单耗时MS = TIME() - $御三家菜单起始MS
            $御三家F2执行等待MS = 御三家计算菜单剩余等待($F2等待MS, $御三家菜单耗时MS)
            IF $御三家F2执行等待MS < 0
                PRINT 御三家菜单耗时超过F2等待预算，本轮不领取
                RETURN -1
            ENDIF
            PRINT 御三家菜单计时: 实耗 & $御三家菜单耗时MS & " ms；F2剩余等待 " & $御三家F2执行等待MS & " ms"
        ENDIF
    ENDIF

    # 从背包启动Teachy TV时，第0轮不能以0ms立刻退出：首个B可能被启动切换吞掉。
    # 狩猎区与普通钓鱼都只在第0轮使用1000ms保护；后续仍使用原TV等待。
    $目标获取TV等待MS = $TV等待MS
    IF $循环计数 == 0 and $进入TV == 1
        IF 是否狩猎地带($遭遇地点) == 1
            $目标获取TV等待MS = 1000
            IF $调试日志输出 == 1
                PRINT 背包Teachy TV第0轮启动保护: & $目标获取TV等待MS & " ms"
            ENDIF
        ELIF $遭遇类型 == 2 and ($遭遇方法 == 201 or $遭遇方法 == 202 or $遭遇方法 == 203)
            $目标获取TV等待MS = 1000
            IF $调试日志输出 == 1
                PRINT 背包Teachy TV第0轮启动保护: & $目标获取TV等待MS & " ms"
            ENDIF
        ENDIF
    ENDIF
    IF $进入TV == 1 and $目标全国图鉴编号 != 1 and $目标全国图鉴编号 != 4 and $目标全国图鉴编号 != 7 and 是否狩猎地带($遭遇地点) == 0
        IF $循环计数 == 0
            $time_TV开始 = TIME()
        ENDIF
        IF $遭遇类型 == 2 and ($遭遇方法 == 201 or $遭遇方法 == 202 or $遭遇方法 == 203)
            # 目标获取TV等待MS是本函数的局部变量，必须显式传入子函数。
            # EasyCon 1.6.4-a 跨函数读取它会触发 IndexOutOfRangeException。
            $钓鱼背包TV执行结果 = 执行钓鱼背包TV等待流程($目标获取TV等待MS)
        ELSE
            CALL 执行TV等待流程
        ENDIF
        $刚进入TV = 1
    ELIF $进入TV == 1 and 是否狩猎地带($遭遇地点) == 1
        IF $循环计数 == 0
            $第0轮TV等待请求 = $目标获取TV等待MS
        ENDIF
        $刚进入TV = 1
    ENDIF

    $获取结果_图鉴编号 = 0
    $获取结果_抓捕结果 = 0
    $获取结果_名称 = ""
    CALL 清空获取结果
    $波克比Seed复核已抓野生 = 0

    IF $循环计数 == 0
        $time_目标流程开始 = TIME()
        $time_F2 = 执行目标获取($目标全国图鉴编号, $遭遇方法, $遭遇地点, $御三家F2执行等待MS, $目标获取TV等待MS, $钓鱼最长时间, $进入TV, $识图阈值, $循环计数, $实际出闪后继续抓捕, $游戏版本, 0)
        IF $time_F2 <= 0
            RETURN -1
        ENDIF
        IF 是否狩猎地带($遭遇地点) == 1 and $遭遇方法 == 101
            $狩猎区路线实际耗时 = 读取狩猎区路线实际耗时()
        ENDIF
    ELSE
        $执行目标获取结果 = 执行目标获取($目标全国图鉴编号, $遭遇方法, $遭遇地点, $御三家F2执行等待MS, $目标获取TV等待MS, $钓鱼最长时间, $进入TV, $识图阈值, $循环计数, $实际出闪后继续抓捕, $游戏版本, 0)
        IF $执行目标获取结果 == -1
            # 获取流程执行失败
            RETURN -1
        ELIF $执行目标获取结果 == 0
            # 重启游戏
            RETURN 0
        ELIF $执行目标获取结果 == 2
            # 普通野生偶遇游走宝可梦会直接逃跑；本轮没有可反查样本。
            PRINT 目标在抓捕前逃跑，本轮作废并自动重启
            RETURN 0
        ELIF $执行目标获取结果 == 1
            # 目标获取执行成功，继续后续流程
        ELIF $执行目标获取结果 == 4 and $目标全国图鉴编号 == 175
            # 波克比蛋已领取：先抓水之迷宫冲浪野生复核Seed，命中后才孵化。
            $波克比流程Seed验证结果 = 波克比流程_执行领取后Seed复核()
            IF $波克比流程Seed验证结果 == -1
                RETURN -1
            ELIF $波克比流程Seed验证结果 == 0
                RETURN 0
            ENDIF
        ELSE
            PRINT ""
            PRINT 目标获取失败: 未知目标获取返回值: & $执行目标获取结果
            RETURN -1
        ENDIF
    ENDIF

    $获取结果_图鉴编号 = 读取获取结果图鉴编号()
    $获取结果_抓捕结果 = 读取获取结果抓捕结果()
    $获取结果_名称 = 读取获取结果名称()

    $野生目标同步结果 = 同步野生目标识别结果()
    IF $野生目标同步结果 == 0
        RETURN -1
    ELIF $野生目标同步结果 == 2
        RETURN 0
    ENDIF

    IF $循环计数 == 0
        $校准成功 = 记录固定延迟并开始自动乱数()
        IF $校准成功 == 0
            RETURN -1
        ENDIF
        RETURN 2
    ENDIF

    CALL 打开能力值识图页面
    RETURN 1
ENDFUNC

FUNC 同步野生目标识别结果(): INT
    $本轮物种命中 = 1
    IF $获取结果_图鉴编号 <= 0
        RETURN 1
    ENDIF

    IF $遭遇类型 == 2
        $野生识别默认等级 = 目标默认等级($游戏版本, $获取结果_图鉴编号, $遭遇方法, $遭遇地点)
        IF $野生识别默认等级 < 0
            PRINT ""
            PRINT 【野生路线校验】
            PRINT 实际物种图鉴编号: & $获取结果_图鉴编号
            PRINT 配置地点: & $遭遇地点名称
            PRINT 判定: 实际物种不属于配置地点，路线可能偏离
            PRINT 本轮放弃反查并自动重开
            RETURN 2
        ENDIF
    ENDIF

    IF $获取结果_图鉴编号 != $运行前目标全国图鉴编号
        $本轮物种命中 = 0
    ENDIF

    $目标全国图鉴编号 = $获取结果_图鉴编号
    $目标名称字符 = 目标名称($游戏版本, $目标全国图鉴编号)
    $目标英文名称字符 = 目标英文名称($目标全国图鉴编号)
    $性别阈值 = 取性别阈值($目标全国图鉴编号)
    $野生目标数据刷新结果 = 加载目标组合数据()

    IF $目标名称字符 == "未知 / Unknown"
        PRINT ""
        PRINT 野生目标识别失败: 图鉴编号无法读取目标名称: & $目标全国图鉴编号
        RETURN 0
    ENDIF

    IF $性别阈值 < 0
        PRINT ""
        PRINT 野生目标识别失败: 图鉴编号无法读取性别比例: & $目标全国图鉴编号
        RETURN 0
    ENDIF

    IF $野生目标数据刷新结果 == 0
        PRINT ""
        PRINT 野生目标识别失败: 无法加载实际宝可梦的等级数据
        RETURN 0
    ENDIF

    IF $调试日志输出 == 1
        PRINT ""
        PRINT 【野生目标识别】
        PRINT 识别名称: & $获取结果_名称
        PRINT 图鉴编号: & $目标全国图鉴编号
        PRINT 目标: & $目标名称字符
        IF $本轮物种命中 == 0
            PRINT 配置目标图鉴编号: & $运行前目标全国图鉴编号 & "（本轮个体仅用于反查校准）"
        ENDIF
    ENDIF

    RETURN 1
ENDFUNC

FUNC 执行钓鱼背包TV等待流程($TV等待: INT): INT
    # 冷启动进档后普通主菜单光标在“图鉴”：下移两次进入背包。
    X
    WAIT 3000
    DOWN
    WAIT 1000
    DOWN
    WAIT 500
    A
    WAIT 3500
    RIGHT
    WAIT 2500
    A
    WAIT 500
    A
    IF $循环计数 == 0
        $time_TV等待开始 = TIME()
        $第0轮TV等待请求 = $TV等待
    ENDIF
    WAIT $TV等待
    IF $循环计数 == 0
        $time_TV等待结束 = TIME()
    ENDIF
    # TV等待很短时启动转场可能吞掉前面的B。保持原6000ms退出预算，
    # 分6次发送B，稳定退出TV、道具子菜单、背包和主菜单；多余B在场地无副作用。
    FOR 6
        B
        WAIT 1000
    NEXT
    IF $循环计数 == 0
        $time_TV结束 = TIME()
    ENDIF
    RETURN 1
ENDFUNC

FUNC 执行TV等待流程
    Y#进入TV
    1000
    IF $循环计数 == 0
        $time_TV等待开始 = TIME()
        $第0轮TV等待请求 = $TV等待MS
    ENDIF
    WAIT $TV等待MS
    IF $循环计数 == 0
        $time_TV等待结束 = TIME()
    ENDIF
    B
    1500
    IF $循环计数 == 0
        $time_TV结束 = TIME()
    ENDIF
ENDFUNC

FUNC 记录固定延迟并开始自动乱数(): INT
    $Seed阶段实际延迟 = $time_OP - $time_start
    $Seed阶段命令开销 = $Seed阶段实际延迟 - $第0轮Seed等待请求
    $Seed预校准命令修正MS = 0 - $Seed阶段命令开销
    $Seed预校准总补偿MS = $Seed基础补偿 + $Seed预校准命令修正MS
    $SeedMS = $目标SeedMS - $SeedMS实际执行修正量 + $Seed预校准总补偿MS + $Seed精细修正MS
    $F1阶段脚本固定延迟 = $time_F1 - $time_OP
    # 使用第0轮实际传入的TV等待扣除主动等待；狩猎区1000ms保护不会混入固定延迟。
    $F2阶段脚本固定延迟 = $time_F2 - $time_F1 - $第0轮TV等待请求
    $F2诊断_TV实际等待 = 0
    IF $进入TV == 1 and 是否狩猎地带($遭遇地点) == 0
        $F2诊断_进存档到下一阶段 = $time_TV开始 - $time_F1
        $F2诊断_TV进入固定段 = $time_TV等待开始 - $time_TV开始
        $F2诊断_TV实际等待 = $time_TV等待结束 - $time_TV等待开始
        $F2诊断_TV退出固定段 = $time_TV结束 - $time_TV等待结束
        $F2诊断_TV结束到目标流程 = $time_目标流程开始 - $time_TV结束
    ELIF $进入TV == 1 and 是否狩猎地带($遭遇地点) == 1
        $F2诊断_进存档到下一阶段 = $time_目标流程开始 - $time_F1
        $F2诊断_TV进入固定段 = 0
        $F2诊断_TV实际等待 = $第0轮TV等待请求
        $F2诊断_TV退出固定段 = 0
        $F2诊断_TV结束到目标流程 = 0
    ELSE
        $F2诊断_进存档到下一阶段 = $time_目标流程开始 - $time_F1
        $F2诊断_TV进入固定段 = 0
        $F2诊断_TV退出固定段 = 0
        $F2诊断_TV结束到目标流程 = 0
    ENDIF
    $F2诊断_目标交互固定段 = $time_F2 - $time_目标流程开始
    $F2诊断_分段固定延迟校验 = $time_F2 - $time_F1 - $F2诊断_TV实际等待
    CALL 各阶段脚本固定延迟转帧数
    $循环计数 += 1
    $TV首轮固定推进帧 = 0
    $当前TV路线基线 = 取当前TV路线基线()
    IF $进入TV == 1 and $当前TV路线基线 == $TV路线基线未配置
        $TV首轮固定推进帧 = $TV首轮固定推进圈数 * $TV单次消耗帧 + $TV首轮固定推进相位
        $消耗帧实际执行修正量 = $TV首轮固定推进帧
        $消耗帧本次新增修正量 = $TV首轮固定推进帧
    ELIF $进入TV == 1
        # 路线基线已经包含该流程的全部固定推进，首轮从零校准量开始。
        $消耗帧实际执行修正量 = 0
        $消耗帧本次新增修正量 = 0
    ENDIF
    $校准成功 = 重新计算等待参数()
    IF $校准成功 == 0
        RETURN 0
    ENDIF

    IF $调试日志输出 == 1
        PRINT ""
        PRINT 【固定延迟】
        PRINT Seed阶段请求延迟: & $第0轮Seed等待请求 & " ms"
        PRINT Seed阶段实际延迟: & $Seed阶段实际延迟 & " ms"
        PRINT Seed阶段命令开销: & $Seed阶段命令开销 & " ms"
        PRINT F1阶段脚本固定延迟: & $F1阶段脚本固定延迟 & " ms"
        PRINT F2阶段脚本固定延迟: & $F2阶段脚本固定延迟 & " ms"
        PRINT ""
        PRINT 【Seed预校准】
        PRINT NX平台时间偏移: & $NXSeed平台偏移MS & " ms"
        PRINT 预校准索引: & $Seed预校准索引 & " 个seed"
        PRINT 索引换算修正: & $SeedMS实际执行修正量 & " ms"
        PRINT 基础补偿: & $Seed基础补偿 & " ms"
        PRINT 命令开销修正: & $Seed预校准命令修正MS & " ms"
        PRINT 第1轮Seed请求: & $SeedMS & " ms"
        PRINT ""
        PRINT 【第0轮F2分段诊断】
        IF $进入TV == 1 and 是否狩猎地带($遭遇地点) == 1
            PRINT 进存档到狩猎区流程: & $F2诊断_进存档到下一阶段 & " ms"
            PRINT TV执行位置: 到达狩猎区目标位置后、触发遭遇前
            PRINT TV等待请求: & $第0轮TV等待请求 & " ms"
        ELIF $进入TV == 1
            PRINT 进存档到TV开始: & $F2诊断_进存档到下一阶段 & " ms"
            PRINT TV进入固定段: & $F2诊断_TV进入固定段 & " ms"
            PRINT TV等待请求/实际: & $第0轮TV等待请求 & "/" & $F2诊断_TV实际等待 & " ms"
            PRINT TV退出固定段: & $F2诊断_TV退出固定段 & " ms"
            PRINT TV结束到目标流程: & $F2诊断_TV结束到目标流程 & " ms"
        ELSE
            PRINT 进存档到目标流程: & $F2诊断_进存档到下一阶段 & " ms"
        ENDIF
        PRINT 目标交互固定段: & $F2诊断_目标交互固定段 & " ms"
        PRINT 分段固定延迟校验: & $F2诊断_分段固定延迟校验 & " ms"
    ELSE
        PRINT 初始化完成，开始目标校准
    ENDIF
    IF $TV首轮固定推进帧 > 0 and $调试日志输出 == 1
        IF $调试日志输出 == 1
            PRINT ""
            PRINT 【TV首轮固定推进计算】
            PRINT 固定推进: & $TV首轮固定推进圈数 & "×" & $TV单次消耗帧 & " + " & $TV首轮固定推进相位
            PRINT 第1轮预校准: & $TV首轮固定推进帧 & " 帧"
            PRINT 第1轮等待结果: TV & $TV等待帧 & " 帧，F2 " & $F2等待帧 & " 帧"
        ELSE
            PRINT TV首轮计算: & $TV首轮固定推进圈数 & "×" & $TV单次消耗帧 & "+" & $TV首轮固定推进相位 & "=" & $TV首轮固定推进帧 & " 帧；等待 TV " & $TV等待帧 & " / F2 " & $F2等待帧
        ENDIF
    ELIF $进入TV == 1 and $当前TV路线基线 != $TV路线基线未配置 and $调试日志输出 == 1
        PRINT ""
        PRINT 【TV路线基线计算】
        PRINT 路线实际耗时: & $狩猎区路线实际耗时 & " ms"
        PRINT 路线基线: & $当前TV路线基线 & " 帧"
        PRINT 可分配帧: & $TV路线可分配帧 & " 帧"
        PRINT 第1轮等待结果: TV & $TV等待帧 & " 帧，F2 " & $F2等待帧 & " 帧"
    ENDIF
    RETURN 1
ENDFUNC

FUNC 选择道具乱数本轮捕获位置
    # 运行前已有 6-空位数 只；已保存命中会永久占用后续空位，本轮新捕获再加一格。
    $道具乱数当前队伍位置 = 6 - $队伍空位数量 + $道具乱数命中数量 + 1
    PRINT 道具乱数本轮捕获队伍位置: & $道具乱数当前队伍位置

    IF $道具乱数当前队伍位置 == 2
        DOWN
        500
    ELIF $道具乱数当前队伍位置 == 3
        DOWN
        500
        DOWN
        500
    ELIF $道具乱数当前队伍位置 == 4
        DOWN
        500
        DOWN
        500
        DOWN
        500
    ELIF $道具乱数当前队伍位置 == 5
        UP
        500
        UP
        500
        UP
        500
    ELSE
        # 第六位沿用原脚本从队首向上绕过取消按钮的最短路径。
        UP
        500
        UP
        500
    ENDIF
ENDFUNC

# 1.6.4-a 共享反查导航：队伍页按上移次数选择目标。
# 本段由 Python 固化到正式版与时间轴版主脚本，不单独执行。

FUNC 反查_队伍页按上移次数选择目标($上移次数: INT): INT
    IF $上移次数 < 1 or $上移次数 > 5
        PRINT 反查队伍槽上移次数无效: & $上移次数
        RETURN 0
    ENDIF
    FOR $反查队伍槽上移索引 = 1 TO $上移次数
        UP
        WAIT 500
    NEXT
    RETURN 1
ENDFUNC

FUNC 打开能力值识图页面
    IF $刚使用神奇糖果 == 1
        UP
        500
        A
        1500
        UP
        500
        UP
        500
        A
        500
        A
        1500
    ELSE
        FOR 1
            X# 打开菜单
            500
            IF $目标全国图鉴编号 != 1 and $目标全国图鉴编号 != 4 and $目标全国图鉴编号 != 7
                # 游走路线在2号道路必定从主菜单进入背包使用黄金喷雾；
                # Teachy TV通过Y快捷键启动，不影响最终停在“背包”的主菜单光标。
                IF $遭遇类型 == 1 and ($目标全国图鉴编号 == 243 or $目标全国图鉴编号 == 244 or $目标全国图鉴编号 == 245)
                    UP
                    500
                    BREAK
                ENDIF
                # 甜甜香气
                IF $遭遇类型 == 2 and ($遭遇方法 == 101 or $遭遇方法 == 102)
                    BREAK
                ENDIF
                # 钓鱼
                IF $遭遇类型 == 2 and ($遭遇方法 == 201 or $遭遇方法 == 202 or $遭遇方法 == 203)
                    IF 是否狩猎地带($遭遇地点) == 1
                        IF $刚进入TV == 1
                            # 狩猎区TV从背包使用Teachy TV；退出后光标仍记忆在“背包”。
                            UP
                            500
                        ELSE
                            # 狩猎区非TV钓鱼没有打开菜单；初始光标在“退出”。
                            DOWN
                            500
                            DOWN
                            500
                        ENDIF
                    ELIF $刚进入TV == 1
                        # 普通钓鱼TV从背包进入，退出后主菜单记忆光标在“背包”。
                        UP
                        500
                    ELSE
                        # 普通非TV钓鱼只用Y快捷键；冷启动主菜单光标在“图鉴”。
                        DOWN
                        500
                    ENDIF
                    BREAK
                ENDIF
                # 波克比
                IF $目标全国图鉴编号 == 175 and $刚进入TV == 1
                    UP
                    500
                    BREAK
                ENDIF
                DOWN
                500
                BREAK
            ENDIF
        NEXT
        A
        1500
        IF $目标全国图鉴编号 != 1 and $目标全国图鉴编号 != 4 and $目标全国图鉴编号 != 7
            IF $道具乱数模式 == 1
                CALL 选择道具乱数本轮捕获位置
            ELIF $目标全国图鉴编号 == 175 and $波克比Seed复核已抓野生 == 1
                # 第6槽是Seed复核野生，最终反查必须选择第5槽波克比。
                $反查队伍槽选择结果 = 反查_队伍页按上移次数选择目标(3)
            ELSE
                $反查队伍槽选择结果 = 反查_队伍页按上移次数选择目标(2)
            ENDIF
        ENDIF
        A
        500
        A
        1500
    ENDIF
    $刚使用神奇糖果 = 0
ENDFUNC

FUNC 道具乱数执行存档(): INT
    PRINT 正在退出能力页并保存游戏
    B
    WAIT 1500
    B
    WAIT 500
    B
    WAIT 1500

    IF 是否狩猎地带($遭遇地点) == 1
        PRINT 狩猎区道具目标已确认，正在退出园区后保存游戏
        # 狩猎区菜单顺序为“退出、图鉴、宝可梦……”。
        # 返回菜单后光标位于“宝可梦”，向上两次到“退出”。
        UP
        WAIT 500
        UP
        WAIT 500
        A
        WAIT 1200
        A
        WAIT 3500

        # 传送到入口后，推进柜台结束文本并等待人物自动走出入口。
        A
        WAIT 3000

        # 退出时主菜单光标位于第0项；重新打开普通菜单后从“图鉴”
        # 向下四次选择“保存”。
        X
        WAIT 1000
        DOWN
        WAIT 500
        DOWN
        WAIT 500
        DOWN
        WAIT 500
        DOWN
        WAIT 500
    ELSE
        # 普通地点返回主菜单后光标位于“宝可梦”，向下三次选择“保存”。
        DOWN
        WAIT 500
        DOWN
        WAIT 500
        DOWN
        WAIT 500
    ENDIF
    A
    WAIT 1200
    A
    WAIT 1200
    A
    WAIT 5000

    PRINT 存档操作完成
    RETURN 1
ENDFUNC

FUNC 处理道具乱数命中(): INT
    IF $道具乱数模式 != 1
        RETURN 0
    ENDIF

    PRINT ""
    PRINT 【道具乱数判定】
    IF $本轮物种命中 != 1
        PRINT 物种不符合配置目标，本轮继续反查校准
        RETURN 0
    ENDIF

    IF $调试日志输出 == 1
        PRINT 无道具标签匹配度: & @无道具
    ENDIF
    IF @无道具 >= $识图阈值
        PRINT 判定: 当前宝可梦没有携带道具，本轮继续反查校准
        RETURN 0
    ENDIF

    $道具乱数命中数量 += 1
    PRINT 判定: 物种正确且无道具标签不匹配，命中携带道具目标
    PRINT 命中进度: & $道具乱数命中数量 & "/" & $队伍空位数量
    $道具乱数存档结果 = 道具乱数执行存档()
    IF $道具乱数存档结果 != 1
        RETURN -1
    ENDIF
    IF $道具乱数命中数量 >= $队伍空位数量
        RETURN 2
    ENDIF
    RETURN 1
ENDFUNC

FUNC 读取并输出识图结果(): INT
    IF $Seed模式 == 10
        RETURN 读取并输出日版御三家识图结果()
    ENDIF
    $性别识图失败 = 0
    $性格识图失败 = 0
    $LV识图失败 = 0
    $HP识图失败 = 0
    $ATK识图失败 = 0
    $DEF识图失败 = 0
    $SPA识图失败 = 0
    $SPD识图失败 = 0
    $SPE识图失败 = 0
    $等级表直读 = 0
    $等级标签识别 = 0
    $候选数字命中项数 = 0
    $候选数字回退项数 = 0
    $候选数字标签次数 = 0
    CALL 重置候选数字标签次数

    IF $道具乱数模式 == 0 and @出闪 >= $识图阈值
        PRINT ""
        PRINT 已识别到出闪，脚本停止
        RETURN 0
    ENDIF

    $性别阈值 = 取性别阈值($目标全国图鉴编号)
    $识图性别 = 识别性别($性别阈值, $识图阈值)
    IF $识图性别 < 0
        $性别识图失败 = 1
    ENDIF

    $识图性格 = 识别性格($识图阈值)
    IF $识图性格 < 0
        $性格识图失败 = 1
    ENDIF

    $等级 = 识别LV($识图阈值)
    IF $等级 >= 0
        $等级标签识别 = 1
    ELIF $目标最低等级 > 0 and $目标最低等级 == $目标最高等级
        $等级 = $目标最低等级 + $本轮糖果次数
        $等级表直读 = 1
    ENDIF
    IF $等级 < 0
        $LV识图失败 = 1
    ENDIF

    RIGHT
    1000

    $种族HP = 取种族HP($游戏版本, $目标全国图鉴编号)
    $种族ATK = 取种族ATK($游戏版本, $目标全国图鉴编号)
    $种族DEF = 取种族DEF($游戏版本, $目标全国图鉴编号)
    $种族SPA = 取种族SPA($游戏版本, $目标全国图鉴编号)
    $种族SPD = 取种族SPD($游戏版本, $目标全国图鉴编号)
    $种族SPE = 取种族SPE($游戏版本, $目标全国图鉴编号)

    $能力最小 = 计算HP能力值($种族HP, $努力HP, $等级, 0)
    $能力最大 = 计算HP能力值($种族HP, $努力HP, $等级, 31)
    $实HP = 识别候选范围能力值(0, $能力最小, $能力最大, $识图阈值)
    IF $实HP < 0
        $实HP = 识别HP($识图阈值)
        $候选数字回退项数 += 1
    ELSE
        $候选数字命中项数 += 1
    ENDIF
    IF $实HP < 0
        $HP识图失败 = 1
    ENDIF

    $能力最小 = 计算非HP能力值($种族ATK, $努力ATK, $等级, 0, $识图性格, 0)
    $能力最大 = 计算非HP能力值($种族ATK, $努力ATK, $等级, 31, $识图性格, 0)
    $实ATK = 识别候选范围能力值(1, $能力最小, $能力最大, $识图阈值)
    IF $实ATK < 0
        $实ATK = 识别ATK($识图阈值)
        $候选数字回退项数 += 1
    ELSE
        $候选数字命中项数 += 1
    ENDIF
    IF $实ATK < 0
        $ATK识图失败 = 1
    ENDIF

    $能力最小 = 计算非HP能力值($种族DEF, $努力DEF, $等级, 0, $识图性格, 1)
    $能力最大 = 计算非HP能力值($种族DEF, $努力DEF, $等级, 31, $识图性格, 1)
    $实DEF = 识别候选范围能力值(2, $能力最小, $能力最大, $识图阈值)
    IF $实DEF < 0
        $实DEF = 识别DEF($识图阈值)
        $候选数字回退项数 += 1
    ELSE
        $候选数字命中项数 += 1
    ENDIF
    IF $实DEF < 0
        $DEF识图失败 = 1
    ENDIF

    $能力最小 = 计算非HP能力值($种族SPA, $努力SPA, $等级, 0, $识图性格, 3)
    $能力最大 = 计算非HP能力值($种族SPA, $努力SPA, $等级, 31, $识图性格, 3)
    $实SPA = 识别候选范围能力值(3, $能力最小, $能力最大, $识图阈值)
    IF $实SPA < 0
        $实SPA = 识别SPA($识图阈值)
        $候选数字回退项数 += 1
    ELSE
        $候选数字命中项数 += 1
    ENDIF
    IF $实SPA < 0
        $SPA识图失败 = 1
    ENDIF

    $能力最小 = 计算非HP能力值($种族SPD, $努力SPD, $等级, 0, $识图性格, 4)
    $能力最大 = 计算非HP能力值($种族SPD, $努力SPD, $等级, 31, $识图性格, 4)
    $实SPD = 识别候选范围能力值(4, $能力最小, $能力最大, $识图阈值)
    IF $实SPD < 0
        $实SPD = 识别SPD($识图阈值)
        $候选数字回退项数 += 1
    ELSE
        $候选数字命中项数 += 1
    ENDIF
    IF $实SPD < 0
        $SPD识图失败 = 1
    ENDIF

    $能力最小 = 计算非HP能力值($种族SPE, $努力SPE, $等级, 0, $识图性格, 2)
    $能力最大 = 计算非HP能力值($种族SPE, $努力SPE, $等级, 31, $识图性格, 2)
    $实SPE = 识别候选范围能力值(5, $能力最小, $能力最大, $识图阈值)
    IF $实SPE < 0
        $实SPE = 识别SPE($识图阈值)
        $候选数字回退项数 += 1
    ELSE
        $候选数字命中项数 += 1
    ENDIF
    IF $实SPE < 0
        $SPE识图失败 = 1
    ENDIF

    $识图性别文本 = 性别文本($识图性别)
    $识图性格文本 = 性格文本($识图性格)

    $候选数字标签次数 = 获取候选数字标签次数()
    IF $调试日志输出 == 0
        PRINT 识别结果: & $识图性格文本 & "，" & $识图性别文本 & "，LV" & $等级 & "；能力 " & $实HP & "/" & $实ATK & "/" & $实DEF & "/" & $实SPA & "/" & $实SPD & "/" & $实SPE
    ELSE
        PRINT ""
        PRINT 【识图】
        PRINT 性格: & $识图性格文本
        PRINT 性别: & $识图性别文本
        PRINT LV: & $等级
        PRINT HP: & $实HP
        PRINT ATK: & $实ATK
        PRINT DEF: & $实DEF
        PRINT SPA: & $实SPA
        PRINT SPD: & $实SPD
        PRINT SPE: & $实SPE
        PRINT 范围识图: 等级标签命中 & $等级标签识别 & " 等级表回退 " & $等级表直读 & " 能力命中 " & $候选数字命中项数 & " 项，完整标签回退 " & $候选数字回退项数 & " 项，候选标签 " & $候选数字标签次数 & " 次"
    ENDIF

    IF $性别识图失败 == 1
        PRINT 性别识图失败，无法继续反查
        RETURN 0
    ENDIF
    IF $性格识图失败 == 1
        PRINT 性格识图失败，无法继续反查
        RETURN 0
    ENDIF
    IF $LV识图失败 == 1
        PRINT LV识图失败，无法继续反查
        RETURN 0
    ENDIF
    IF $HP识图失败 == 1
        PRINT HP识图失败，无法继续反查
        RETURN 0
    ENDIF
    IF $ATK识图失败 == 1
        PRINT ATK识图失败，无法继续反查
        RETURN 0
    ENDIF
    IF $DEF识图失败 == 1
        PRINT DEF识图失败，无法继续反查
        RETURN 0
    ENDIF
    IF $SPA识图失败 == 1
        PRINT SPA识图失败，无法继续反查
        RETURN 0
    ENDIF
    IF $SPD识图失败 == 1
        PRINT SPD识图失败，无法继续反查
        RETURN 0
    ENDIF
    IF $SPE识图失败 == 1
        PRINT SPE识图失败，无法继续反查
        RETURN 0
    ENDIF

    RETURN 1
ENDFUNC

FUNC 准备反查参数与输出(): INT

    $种族HP = 取种族HP($游戏版本, $目标全国图鉴编号)
    $种族ATK = 取种族ATK($游戏版本, $目标全国图鉴编号)
    $种族DEF = 取种族DEF($游戏版本, $目标全国图鉴编号)
    $种族SPA = 取种族SPA($游戏版本, $目标全国图鉴编号)
    $种族SPD = 取种族SPD($游戏版本, $目标全国图鉴编号)
    $种族SPE = 取种族SPE($游戏版本, $目标全国图鉴编号)

    IF $种族HP < 0
        PRINT ""
        PRINT 反查准备失败: 未支持的目标图鉴编号: & $目标全国图鉴编号
        RETURN 0
    ENDIF

    IF $反查算法 == 0
        $当前反查算法 = 目标默认计算方法($游戏版本, $目标全国图鉴编号, $遭遇方法, $遭遇地点)
        $反查算法 = $当前反查算法
    ELSE
        $当前反查算法 = $反查算法
    ENDIF

    $雌性性别比例 = 雌性比例文本($性别阈值)
    $反查算法文本 = 反查算法文本($反查算法)

    CALL 输出反查开始参数
    CALL 计算并输出IV范围

    IF $范围有效 == 0
        RETURN 0
    ENDIF

    RETURN 1
ENDFUNC

FUNC 输出反查开始参数
    IF $调试日志输出 == 0
        RETURN
    ENDIF
    PRINT ""
    PRINT 【反查校准】
    PRINT 算法: & $反查算法文本
    PRINT 目标Seed: & $目标Seed
    PRINT Seed容差: ± & $Seed容差 & 个seed
    PRINT 消耗帧搜索范围: & $最小消耗帧 & - & $最大消耗帧 & " 帧"
ENDFUNC

FUNC 计算并输出IV范围
    $HP最小 = 计算HP_IV最小($种族HP, $努力HP, $等级, $实HP)
    $HP最大 = 计算HP_IV最大($种族HP, $努力HP, $等级, $实HP)
    $ATK最小 = 计算非HP_IV最小($种族ATK, $努力ATK, $等级, $实ATK, $识图性格, 0)
    $ATK最大 = 计算非HP_IV最大($种族ATK, $努力ATK, $等级, $实ATK, $识图性格, 0)
    $DEF最小 = 计算非HP_IV最小($种族DEF, $努力DEF, $等级, $实DEF, $识图性格, 1)
    $DEF最大 = 计算非HP_IV最大($种族DEF, $努力DEF, $等级, $实DEF, $识图性格, 1)
    $SPE最小 = 计算非HP_IV最小($种族SPE, $努力SPE, $等级, $实SPE, $识图性格, 2)
    $SPE最大 = 计算非HP_IV最大($种族SPE, $努力SPE, $等级, $实SPE, $识图性格, 2)
    $SPA最小 = 计算非HP_IV最小($种族SPA, $努力SPA, $等级, $实SPA, $识图性格, 3)
    $SPA最大 = 计算非HP_IV最大($种族SPA, $努力SPA, $等级, $实SPA, $识图性格, 3)
    $SPD最小 = 计算非HP_IV最小($种族SPD, $努力SPD, $等级, $实SPD, $识图性格, 4)
    $SPD最大 = 计算非HP_IV最大($种族SPD, $努力SPD, $等级, $实SPD, $识图性格, 4)

    # 游走IV Bug（FRLG雷公/炎帝/水君）：理论上 ATK≤7，DEF/SPA/SPD/SPE=0
    # 反推范围按此裁剪，避免出现 0-1 之类的误导显示
    IF $目标全国图鉴编号 == 243 or $目标全国图鉴编号 == 244 or $目标全国图鉴编号 == 245
        IF $ATK最大 > 7
            $ATK最大 = 7
        ENDIF
        IF $DEF最大 > 0
            $DEF最大 = 0
        ENDIF
        IF $SPA最大 > 0
            $SPA最大 = 0
        ENDIF
        IF $SPD最大 > 0
            $SPD最大 = 0
        ENDIF
        IF $SPE最大 > 0
            $SPE最大 = 0
        ENDIF
    ENDIF

    IF $调试日志输出 == 1
        PRINT ""
        PRINT 【IV范围】
        PRINT HP: & $HP最小 & - & $HP最大
        PRINT ATK: & $ATK最小 & - & $ATK最大
        PRINT DEF: & $DEF最小 & - & $DEF最大
        PRINT SPA: & $SPA最小 & - & $SPA最大
        PRINT SPD: & $SPD最小 & - & $SPD最大
        PRINT SPE: & $SPE最小 & - & $SPE最大
    ENDIF

    $范围有效 = 1
    IF $HP最小 == -1
        $范围有效 = 0
    ENDIF
    IF $ATK最小 == -1
        $范围有效 = 0
    ENDIF
    IF $DEF最小 == -1
        $范围有效 = 0
    ENDIF
    IF $SPA最小 == -1
        $范围有效 = 0
    ENDIF
    IF $SPD最小 == -1
        $范围有效 = 0
    ENDIF
    IF $SPE最小 == -1
        $范围有效 = 0
    ENDIF

    IF $范围有效 == 0
        PRINT ""
        PRINT 反查准备失败: 观察能力值无法反推到合法IV范围，需检查设置或扩大范围
        RETURN
    ENDIF

ENDFUNC

FUNC 执行反查扫描(): INT
    CALL 重置本轮候选状态
    $找到候选Seed = 0
    $扫描起始索引 = $目标索引 - $有效Seed容差
    $扫描结束索引 = $目标索引 + $有效Seed容差

    IF $扫描起始索引 < 0
        $扫描起始索引 = 0
    ENDIF

    IF $扫描结束索引 > $Seed最大索引
        $扫描结束索引 = $Seed最大索引
    ENDIF

    FOR $种子索引 = $扫描起始索引 TO $扫描结束索引
        $差索引 = $种子索引 - $目标索引

        IF $差索引 < 0
            $差索引绝对值 = 0
            $差索引绝对值 -= $差索引
        ELSE
            $差索引绝对值 = $差索引
        ENDIF

        IF $差索引绝对值 > $有效Seed容差
            CONTINUE
        ENDIF

        $当前MS = 取MS($游戏版本, $种子索引) + $NXSeed平台偏移MS

        $当前Seed = 取SeedHEX($游戏版本, $种子索引, $Seed模式)

        IF $当前Seed == ""
            CONTINUE
        ENDIF

        $候选Seed十进制 = HEX转十进制($当前Seed)

        IF $候选Seed十进制 < 0
            CONTINUE
        ENDIF

        $找到候选Seed = 1
        $候HI = 0
        $候LO = $候选Seed十进制

        IF $有效最小消耗帧 > 0
            FOR $预消耗帧 = 1 TO $有效最小消耗帧
                $新HI = RNG下一HI($候HI, $候LO)
                $新LO = RNG下一LO($候HI, $候LO)

                $候HI = $新HI
                $候LO = $新LO
            NEXT
        ENDIF

        FOR $当前消耗帧 = $有效最小消耗帧 TO $有效最大消耗帧

            IF $反查算法 == 199
                $当前反查算法 = 101
                CALL 按算法生成个体
                CALL 检查是否匹配
                CALL 处理匹配候选

                $当前反查算法 = 102
                CALL 按算法生成个体
                CALL 检查是否匹配
                CALL 处理匹配候选

                $当前反查算法 = 104
                CALL 按算法生成个体
                CALL 检查是否匹配
                CALL 处理匹配候选
            ELSE
                $当前反查算法 = $反查算法
                CALL 按算法生成个体
                CALL 检查是否匹配
                CALL 处理匹配候选
            ENDIF

            $新HI = RNG下一HI($候HI, $候LO)
            $新LO = RNG下一LO($候HI, $候LO)

            $候HI = $新HI
            $候LO = $新LO
        NEXT
    NEXT

    IF $找到候选Seed == 0
        PRINT ""
        PRINT Seed容差内没有找到候选
        RETURN 0
    ENDIF

    IF $本轮候选命中计数 == 0
        PRINT ""
        PRINT 本轮没有找到匹配个体
        RETURN 0
    ENDIF

    IF $调试日志输出 == 1
        PRINT ""
        PRINT 候选命中数量: & $本轮候选命中计数
    ENDIF
    RETURN 1
ENDFUNC

FUNC 计算Seed原始众数修正(): INT
    $Seed本次修正索引 = 0
    $Seed本次修正限幅 = 0
    $Seed本次修正原始 = 0
    $Seed精细校准启用 = 0
    $Seed精细修正MS = 0
    $Seed精细本轮更新 = 0
    $Seed精细本轮新增MS = 0

    IF $Seed校准样本数 <= 1
        $Seed簇内 = 0
        $Seed本次修正索引 = $命中差索引
        $Seed本次修正原始 = $Seed本次修正索引
        IF $Seed本次修正索引 > $Seed冷启动单轮修正上限
            $Seed本次修正索引 = $Seed冷启动单轮修正上限
            $Seed本次修正限幅 = 1
        ELIF $Seed本次修正索引 < 0 - $Seed冷启动单轮修正上限
            $Seed本次修正索引 = 0 - $Seed冷启动单轮修正上限
            $Seed本次修正限幅 = 1
        ENDIF
        $Seed修正余 = 0
        $Seed修正模式文本 = "原始方案：首轮按当前残差快速靠近，最大修正±" & $Seed冷启动单轮修正上限
    ELIF $Seed校准样本数 < $Seed稳态启用样本数
        $Seed簇内 = 1
        $Seed修正余 = $Seed修正余 + $命中差索引
        $Seed本次修正索引 = $Seed修正余 / 2
        $Seed修正余 = $Seed修正余 - $Seed本次修正索引 * 2
        $Seed本次修正原始 = $Seed本次修正索引
        IF $Seed本次修正索引 > $Seed稳态单轮修正上限
            $Seed本次修正索引 = $Seed稳态单轮修正上限
            $Seed修正余 = 0
            $Seed本次修正限幅 = 1
        ELIF $Seed本次修正索引 < 0 - $Seed稳态单轮修正上限
            $Seed本次修正索引 = 0 - $Seed稳态单轮修正上限
            $Seed修正余 = 0
            $Seed本次修正限幅 = 1
        ENDIF
        $Seed修正模式文本 = "原始方案：第2轮按当前残差半量修正，最大修正±" & $Seed稳态单轮修正上限
    ELSE
        $Seed簇内 = 1
        $Seed修正余 = 0
        $Seed本次修正索引 = $Seed校准目标差
        $Seed本次修正原始 = $Seed本次修正索引
        IF $Seed本次修正索引 > $Seed稳态单轮修正上限
            $Seed本次修正索引 = $Seed稳态单轮修正上限
            $Seed本次修正限幅 = 1
        ELIF $Seed本次修正索引 < 0 - $Seed稳态单轮修正上限
            $Seed本次修正索引 = 0 - $Seed稳态单轮修正上限
            $Seed本次修正限幅 = 1
        ENDIF
        $Seed修正模式文本 = "原始方案：跟随12轮最终命中绝对落点众数，单轮最大±" & $Seed稳态单轮修正上限
    ENDIF

    RETURN $Seed本次修正索引
ENDFUNC

FUNC 计算Seed锁定众数修正(): INT
    $Seed锁定本轮新启用 = 0
    $Seed锁定本轮触发 = 0
    $Seed锁定本轮样本计入 = 0
    $Seed锁定众数差 = 0
    $Seed锁定众数票数 = 0
    $Seed锁定目标票数 = 0
    $Seed锁定正方向票数 = 0
    $Seed锁定负方向票数 = 0
    $Seed锁定方向 = 0
    $Seed锁定方向票数 = 0
    $Seed命中保持本轮刷新 = 0
    $Seed命中保持触发固定半步 = 0
    $Seed锁定本轮大波动忽略 = 0
    $Seed本次修正限幅 = 0
    $Seed本次修正原始 = 0
    $Seed本次修正索引 = 0
    $Seed修正余 = 0
    $Seed精细本轮更新 = 0
    $Seed精细本轮新增MS = 0
    $Seed精细区间收敛 = 0
    $Seed直接修正触发 = 0
    $Seed立即夹逼触发 = 0

    IF $Seed锁定启用 == 0 and $Seed差绝对 <= $Seed锁定范围
        $Seed锁定启用 = 1
        $Seed锁定本轮新启用 = 1
        $Seed锁定参数累计修正 = $Seed累计修正索引
        $Seed锁定参数精细修正MS = $Seed精细修正MS
        $Seed锁定窗口样本数 = 0
        $Seed锁定窗口指针 = 0
        $Seed粗调上次有效 = 0
        $Seed命中保持启用 = 0
        $Seed命中保持计数 = 0
        $Seed命中保持正方向票数 = 0
        $Seed命中保持负方向票数 = 0
        $方案2Seed接续启用 = 0
        $方案2Seed接续正方向票数 = 0
        $方案2Seed接续负方向票数 = 0
    ENDIF

    # 尚未收敛时，大偏差仍按当前残差直接靠近并限幅。
    IF $Seed锁定启用 == 0
        $Seed精细校准启用 = 0
        $Seed精细修正MS = 0
        $Seed精细固定半步MS = 0
        $Seed粗调上次有效 = 0
        $Seed本次修正索引 = $命中差索引
        $Seed本次修正原始 = $Seed本次修正索引
        IF $Seed本次修正索引 > $Seed冷启动单轮修正上限
            $Seed本次修正索引 = $Seed冷启动单轮修正上限
            $Seed本次修正限幅 = 1
        ELIF $Seed本次修正索引 < 0 - $Seed冷启动单轮修正上限
            $Seed本次修正索引 = 0 - $Seed冷启动单轮修正上限
            $Seed本次修正限幅 = 1
        ENDIF
        $Seed修正模式文本 = "尚未进入±1锁定范围，按当前大偏差直接靠近，最大修正±" & $Seed冷启动单轮修正上限
        RETURN $Seed本次修正索引
    ENDIF

    IF $Seed锁定参数累计修正 != $Seed累计修正索引 or $Seed锁定参数精细修正MS != $Seed精细修正MS
        $Seed锁定参数累计修正 = $Seed累计修正索引
        $Seed锁定参数精细修正MS = $Seed精细修正MS
        $Seed锁定窗口样本数 = 0
        $Seed锁定窗口指针 = 0
        $方案2Seed接续启用 = 0
        $方案2Seed接续正方向票数 = 0
        $方案2Seed接续负方向票数 = 0
    ENDIF

    IF $Seed本轮可信 == 1
        IF $命中差索引 == 0
            # 每次精确命中都从头刷新5次保持；连续5次未命中前请求参数不动。
            $Seed曾命中目标 = 1
            $Seed命中保持启用 = 1
            $Seed命中保持计数 = 0
            $Seed命中保持正方向票数 = 0
            $Seed命中保持负方向票数 = 0
            $方案2Seed接续启用 = 0
            $方案2Seed接续正方向票数 = 0
            $方案2Seed接续负方向票数 = 0
            $Seed命中保持本轮刷新 = 1
            $Seed锁定目标票数 = 1
            $Seed锁定窗口样本数 = 0
            $Seed锁定窗口指针 = 0
            $Seed粗调上次有效 = 0
            $Seed修正模式文本 = "命中目标Seed，刷新连续5次未命中锁定"
            RETURN 0
        ELIF $Seed命中保持启用 == 1
            # 保持窗口按每次可信Seed反查推进；超出±1只占观察次数，不投方向票。
            $Seed命中保持计数 = $Seed命中保持计数 + 1
            IF $Seed差绝对 == 1
                $Seed锁定本轮样本计入 = 1
                IF $命中差索引 > 0
                    $Seed命中保持正方向票数 = $Seed命中保持正方向票数 + 1
                ELSE
                    $Seed命中保持负方向票数 = $Seed命中保持负方向票数 + 1
                ENDIF
            ELSE
                $Seed锁定本轮大波动忽略 = 1
            ENDIF
        ELIF $Seed校准方案 == 2 and $方案2Seed接续启用 == 1 and $Seed差绝对 == 1
            # 方案2在固定5次保持结束后保留不足或平票的±1证据，直到至少3票且出现多数方向。
            $Seed锁定本轮样本计入 = 1
            IF $命中差索引 > 0
                $方案2Seed接续正方向票数 = $方案2Seed接续正方向票数 + 1
            ELSE
                $方案2Seed接续负方向票数 = $方案2Seed接续负方向票数 + 1
            ENDIF
            $Seed锁定方向票数 = $方案2Seed接续正方向票数 + $方案2Seed接续负方向票数
            IF $Seed锁定方向票数 < $Seed命中保持最少方向样本数 or $方案2Seed接续正方向票数 == $方案2Seed接续负方向票数
                $Seed修正模式文本 = "方案2接续方向票：-" & $方案2Seed接续负方向票数 & "/+" & $方案2Seed接续正方向票数 & "；继续等待至少3票且出现多数方向"
                RETURN 0
            ENDIF
            IF $方案2Seed接续正方向票数 > $方案2Seed接续负方向票数
                $Seed锁定方向 = 1
                $Seed锁定方向票数 = $方案2Seed接续正方向票数
            ELSE
                $Seed锁定方向 = -1
                $Seed锁定方向票数 = $方案2Seed接续负方向票数
            ENDIF
            $Seed锁定众数差 = $Seed锁定方向
            $Seed锁定众数票数 = $Seed锁定方向票数
            $方案2Seed接续启用 = 0
            $方案2Seed接续正方向票数 = 0
            $方案2Seed接续负方向票数 = 0
            $Seed锁定本轮触发 = 1
            $Seed命中保持触发固定半步 = 1
        ELIF $Seed校准方案 == 2 and $方案2Seed接续启用 == 1
            # 接续阶段仍只接受±1方向票；大偏差视为机器波动，不清空已保留证据。
            $Seed锁定本轮大波动忽略 = 1
            $Seed修正模式文本 = "方案2接续方向票保持：-" & $方案2Seed接续负方向票数 & "/+" & $方案2Seed接续正方向票数 & "；忽略本轮超出±1的机器波动"
            RETURN 0
        ELIF $Seed差绝对 == 1
            $Seed锁定本轮样本计入 = 1
            $Seed锁定窗口[$Seed锁定窗口样本数] = $命中差索引
            $Seed锁定窗口样本数 = $Seed锁定窗口样本数 + 1
            $Seed锁定窗口指针 = $Seed锁定窗口样本数
        ELSE
            # 非保持期仍只收集±1微调样本；偶发大偏差不修正，也不占5次方向窗口。
            $Seed锁定本轮大波动忽略 = 1
            $Seed修正模式文本 = "Seed已锁定，忽略本轮超出±1的机器波动"
            RETURN 0
        ENDIF
    ELSE
        $Seed修正模式文本 = "Seed已锁定，本轮不可信，不参与微调"
        RETURN 0
    ENDIF

    IF $Seed命中保持启用 == 1
        IF $Seed命中保持计数 < $Seed命中保持样本数
            IF $Seed锁定本轮大波动忽略 == 1
                $Seed修正模式文本 = "目标Seed参数保持中：" & $Seed命中保持计数 & "/" & $Seed命中保持样本数 & "；本轮大波动不投方向票"
            ELSE
                $Seed修正模式文本 = "目标Seed参数保持中：" & $Seed命中保持计数 & "/" & $Seed命中保持样本数
            ENDIF
            RETURN 0
        ENDIF
        $Seed锁定方向票数 = $Seed命中保持正方向票数 + $Seed命中保持负方向票数
        IF $Seed锁定方向票数 < $Seed命中保持最少方向样本数
            IF $Seed校准方案 == 2
                $方案2Seed接续启用 = 1
                $方案2Seed接续正方向票数 = $Seed命中保持正方向票数
                $方案2Seed接续负方向票数 = $Seed命中保持负方向票数
                $Seed命中保持启用 = 0
                $Seed命中保持计数 = 0
                $Seed命中保持正方向票数 = 0
                $Seed命中保持负方向票数 = 0
                $Seed修正模式文本 = "方案2连续5次未命中，保留方向票 -" & $方案2Seed接续负方向票数 & "/+" & $方案2Seed接续正方向票数 & "；继续补足至至少3票"
                RETURN 0
            ENDIF
            $Seed命中保持启用 = 0
            $Seed命中保持计数 = 0
            $Seed命中保持正方向票数 = 0
            $Seed命中保持负方向票数 = 0
            $Seed修正模式文本 = "连续5次未命中但±1方向样本不足3，解除参数保持，本轮不修正"
            RETURN 0
        ENDIF
        IF $Seed命中保持正方向票数 == $Seed命中保持负方向票数
            # 大波动只占未命中次数；方向平票时解除保持但不任意选边。
            IF $Seed校准方案 == 2
                $方案2Seed接续启用 = 1
                $方案2Seed接续正方向票数 = $Seed命中保持正方向票数
                $方案2Seed接续负方向票数 = $Seed命中保持负方向票数
                $Seed命中保持启用 = 0
                $Seed命中保持计数 = 0
                $Seed命中保持正方向票数 = 0
                $Seed命中保持负方向票数 = 0
                $Seed修正模式文本 = "方案2连续5次未命中方向平票，保留方向票 -" & $方案2Seed接续负方向票数 & "/+" & $方案2Seed接续正方向票数 & "；继续等待多数方向"
                RETURN 0
            ENDIF
            $Seed命中保持启用 = 0
            $Seed命中保持计数 = 0
            $Seed命中保持正方向票数 = 0
            $Seed命中保持负方向票数 = 0
            $Seed修正模式文本 = "连续5次未命中且±1方向票相同，解除参数保持，本轮不修正"
            RETURN 0
        ENDIF
        IF $Seed命中保持正方向票数 > $Seed命中保持负方向票数
            $Seed锁定方向 = 1
            $Seed锁定方向票数 = $Seed命中保持正方向票数
        ELSE
            $Seed锁定方向 = -1
            $Seed锁定方向票数 = $Seed命中保持负方向票数
        ENDIF
        $Seed锁定众数差 = $Seed锁定方向
        $Seed锁定众数票数 = $Seed锁定方向票数
        $Seed命中保持启用 = 0
        $Seed命中保持计数 = 0
        $Seed命中保持正方向票数 = 0
        $Seed命中保持负方向票数 = 0
        $Seed锁定本轮触发 = 1
        $Seed命中保持触发固定半步 = 1
    ELSE
        IF $Seed命中保持触发固定半步 == 0
        $Seed锁定有效末索引 = $Seed锁定窗口样本数 - 1
        FOR $Seed锁定窗口索引 = 0 TO $Seed锁定有效末索引
            IF $Seed锁定窗口[$Seed锁定窗口索引] > 0
                $Seed锁定正方向票数 = $Seed锁定正方向票数 + 1
            ELSE
                $Seed锁定负方向票数 = $Seed锁定负方向票数 + 1
            ENDIF
        NEXT
        # 首次精确命中前，只要单侧已有3票，剩余两票已不可能改变5票多数结果，立即定案。
        # 一旦曾精确命中过目标，普通窗口仍完整观察5个±1样本；目标命中保持窗口也始终完整计5次。
        IF $Seed曾命中目标 == 0 and ($Seed锁定正方向票数 >= $Seed锁定提前多数票数 or $Seed锁定负方向票数 >= $Seed锁定提前多数票数)
            $Seed修正模式文本 = "首次命中前Seed±1多数已提前确定：-" & $Seed锁定负方向票数 & "/+" & $Seed锁定正方向票数
        ELIF $Seed锁定窗口样本数 < $Seed锁定窗口大小
            $Seed修正模式文本 = "Seed±1微调采样中：" & $Seed锁定窗口样本数 & "/" & $Seed锁定窗口大小 & "，方向票 -" & $Seed锁定负方向票数 & "/+" & $Seed锁定正方向票数
            RETURN 0
        ENDIF
        IF $Seed锁定正方向票数 > $Seed锁定负方向票数
            $Seed锁定方向 = 1
            $Seed锁定方向票数 = $Seed锁定正方向票数
        ELSE
            $Seed锁定方向 = -1
            $Seed锁定方向票数 = $Seed锁定负方向票数
        ENDIF
        $Seed锁定众数差 = $Seed锁定方向
        $Seed锁定众数票数 = $Seed锁定方向票数
        $Seed锁定窗口样本数 = 0
        $Seed锁定窗口指针 = 0
        $Seed锁定本轮触发 = 1
        ENDIF
    ENDIF

    IF $Seed命中保持触发固定半步 == 1
        # 命中过目标后连续5次未命中：直接取当前请求与多数方向相邻Seed间隔的一半。
        # 不先移动整个Seed索引；固定半步一旦建立，后续不再递归缩小。
        IF $Seed精细固定半步MS <= 0
            $Seed精细当前索引 = $目标索引 + $Seed累计修正索引
            $Seed精细相邻索引 = $Seed精细当前索引 + $Seed锁定方向
            IF $Seed精细当前索引 < 0
                $Seed精细当前索引 = 0
            ENDIF
            IF $Seed精细当前索引 > $Seed最大索引
                $Seed精细当前索引 = $Seed最大索引
            ENDIF
            IF $Seed精细相邻索引 < 0
                $Seed精细相邻索引 = 0
            ENDIF
            IF $Seed精细相邻索引 > $Seed最大索引
                $Seed精细相邻索引 = $Seed最大索引
            ENDIF
            $Seed精细相邻请求偏移MS = 取MS($游戏版本, $Seed精细当前索引) - 取MS($游戏版本, $Seed精细相邻索引)
            $Seed精细固定半步MS = $Seed精细相邻请求偏移MS
            IF $Seed精细固定半步MS < 0
                $Seed精细固定半步MS = 0 - $Seed精细固定半步MS
            ENDIF
            $Seed精细固定半步MS = $Seed精细固定半步MS / 2
            IF $Seed精细固定半步MS < 1
                $Seed精细固定半步MS = 1
            ENDIF
        ENDIF
        $Seed精细校准启用 = 1
        $Seed精细基准累计修正 = $Seed累计修正索引
        $Seed精细本轮新增MS = 0 - $Seed锁定方向 * $Seed精细固定半步MS
        $Seed精细修正MS = $Seed精细修正MS + $Seed精细本轮新增MS
        $Seed精细下界MS = 0 - $Seed精细固定半步MS
        $Seed精细上界MS = $Seed精细固定半步MS
        $Seed精细本轮更新 = 1
        $Seed锁定参数精细修正MS = $Seed精细修正MS
        $Seed粗调上次有效 = 0
        $Seed命中保持启用 = 1
        $Seed命中保持计数 = 0
        $Seed命中保持正方向票数 = 0
        $Seed命中保持负方向票数 = 0
        $方案2Seed接续启用 = 0
        $方案2Seed接续正方向票数 = 0
        $方案2Seed接续负方向票数 = 0
        $Seed修正模式文本 = "连续5次未命中，按±1多数方向直接固定半步微调：" & $Seed精细本轮新增MS & " ms（固定半步" & $Seed精细固定半步MS & " ms）"
        RETURN 0
    ENDIF

    IF $Seed精细校准启用 == 1
        # 固定半步只在首次相邻整索引反转时计算；之后不再递归缩小。
        $Seed精细本轮新增MS = 0 - $Seed锁定方向 * $Seed精细固定半步MS
        $Seed精细修正MS = $Seed精细修正MS + $Seed精细本轮新增MS
        $Seed精细本轮更新 = 1
        $Seed锁定参数精细修正MS = $Seed精细修正MS
        $Seed修正模式文本 = "Seed±1多数方向固定半步微调：" & $Seed精细本轮新增MS & " ms（固定半步" & $Seed精细固定半步MS & " ms）"
        RETURN 0
    ENDIF

    $Seed粗调下一累计修正 = $Seed累计修正索引 + $Seed锁定方向
    IF $Seed粗调上次有效 == 1 and $Seed粗调上次累计修正 == $Seed粗调下一累计修正 and $Seed粗调上次方向 == 0 - $Seed锁定方向
        $Seed精细当前索引 = $目标索引 + $Seed累计修正索引
        $Seed精细相邻索引 = $目标索引 + $Seed粗调上次累计修正
        IF $Seed精细当前索引 < 0
            $Seed精细当前索引 = 0
        ENDIF
        IF $Seed精细当前索引 > $Seed最大索引
            $Seed精细当前索引 = $Seed最大索引
        ENDIF
        IF $Seed精细相邻索引 < 0
            $Seed精细相邻索引 = 0
        ENDIF
        IF $Seed精细相邻索引 > $Seed最大索引
            $Seed精细相邻索引 = $Seed最大索引
        ENDIF
        $Seed精细相邻请求偏移MS = 取MS($游戏版本, $Seed精细当前索引) - 取MS($游戏版本, $Seed精细相邻索引)
        $Seed精细固定半步MS = $Seed精细相邻请求偏移MS
        IF $Seed精细固定半步MS < 0
            $Seed精细固定半步MS = 0 - $Seed精细固定半步MS
        ENDIF
        $Seed精细固定半步MS = $Seed精细固定半步MS / 2
        IF $Seed精细固定半步MS < 1
            $Seed精细固定半步MS = 1
        ENDIF
        $Seed精细校准启用 = 1
        $Seed精细基准累计修正 = $Seed累计修正索引
        $Seed精细本轮新增MS = 0 - $Seed锁定方向 * $Seed精细固定半步MS
        $Seed精细修正MS = $Seed精细修正MS + $Seed精细本轮新增MS
        $Seed精细下界MS = 0 - $Seed精细固定半步MS
        $Seed精细上界MS = $Seed精细固定半步MS
        $Seed精细本轮更新 = 1
        $Seed本次修正索引 = 0
        $Seed粗调上次有效 = 0
        $Seed修正模式文本 = "相邻整索引多数方向反转，启用固定半步毫秒微调"
        RETURN 0
    ENDIF

    $Seed本次修正索引 = $Seed锁定方向
    $Seed本次修正原始 = $Seed本次修正索引
    $Seed粗调上次有效 = 1
    $Seed粗调上次累计修正 = $Seed累计修正索引
    $Seed粗调上次方向 = $Seed锁定方向
    $Seed修正模式文本 = "完整5次±1样本多数方向，逐个Seed粗调"
    RETURN $Seed本次修正索引
ENDFUNC

FUNC 更新方案0奇偶状态
    $方案0奇偶本轮升级 = 0
    IF $帧奇偶修正方案 != 0
        RETURN
    ENDIF
    IF $命中差索引 != 0
        # 非目标Seed不是当前奇偶偏移的有效样本；保留已有连续计数，等待下次目标Seed继续。
        IF $调试日志输出 == 1 and $方案0奇偶失败次数 > 0
            PRINT 方案0奇偶计数保留: 本轮未命中目标Seed，累计不一致仍为 & $方案0奇偶失败次数
        ENDIF
        RETURN
    ENDIF
    IF $方案0奇偶本轮执行偏移 <= 0 or $方案0奇偶本轮执行偏移 != $方案0奇偶当前偏移
        RETURN
    ENDIF
    IF $命中消耗帧 % 2 == $目标消耗帧 % 2
        $方案0奇偶失败次数 = 0
    ELSE
        $方案0奇偶失败次数 = $方案0奇偶失败次数 + 1
        IF $方案0奇偶失败次数 >= 3
            # 旧偏移只在本次运行内拉黑；偏移单调递增，不能回退到已失败方案。
            $方案0奇偶已拉黑最大偏移 = $方案0奇偶当前偏移
            $方案0奇偶当前偏移 = $方案0奇偶当前偏移 + 1
            $方案0奇偶失败次数 = 0
            $方案0奇偶本轮升级 = 1
        ENDIF
    ENDIF
ENDFUNC

FUNC 更新方案1菜单保持状态
    IF $帧奇偶修正方案 != 1
        RETURN
    ENDIF
    IF $帧轴菜单奇偶开关 != 1 or $帧轴菜单保持运行中 == 1
        RETURN
    ENDIF
    IF $命中差索引 == 0 and $命中消耗帧 % 2 != $目标消耗帧 % 2
        $帧轴菜单保持剩余轮数 = 3
        $帧轴菜单保持运行中 = 1
        IF $调试日志输出 == 1
            PRINT 菜单奇偶仍不一致，保持菜单动作3轮
        ENDIF
    ENDIF
ENDFUNC

FUNC 执行自动校准与等待更新(): INT
    # GUI 2.0 校准可信门控：不可信维度只观察，不写窗、不下发修正
    $本轮SeedMS误差 = $命中SeedMS - $目标SeedMS
    $本轮消耗帧误差 = $命中消耗帧 - $目标消耗帧
    CALL 更新方案0奇偶状态
    CALL 更新方案1菜单保持状态

    # Seed 永不归一化（直接用原始 ms 误差 / 差索引）。仅消耗帧在 TV 模式按 314 周期折叠相位；普通模式严禁 314。
    IF $进入TV == 1
        $消耗帧归一化误差 = 模周期归一($本轮消耗帧误差, $TV单次消耗帧)
    ELSE
        $消耗帧归一化误差 = 模周期归一($本轮消耗帧误差, 0)
    ENDIF
    $本轮剩余帧校准允许 = 1
    $剩余帧校准门控文本 = ""
    $本轮剩余帧抖动冻结 = 0
    $剩余帧门控绝对 = $消耗帧归一化误差
    IF $剩余帧门控绝对 < 0
        $剩余帧门控绝对 = 0 - $剩余帧门控绝对
    ENDIF
    IF $命中差索引 != 0 and $剩余帧门控绝对 > 0 and $非目标Seed剩余帧冻结阈值 >= 0 and $剩余帧门控绝对 <= $非目标Seed剩余帧冻结阈值
        $本轮剩余帧校准允许 = 0
        $剩余帧校准门控文本 = "非目标Seed且剩余帧误差为±1，本轮剩余帧不计入、不修正；TV整圈独立判断"
    ENDIF

    # 本轮当前落点偏离“路径中心”的绝对量（路径中心为上一轮自适应簇中心，最优候选已在选择阶段贴近它）
    $Seed当前绝对落点 = $命中差索引 + $Seed累计修正索引
    $Seed本轮偏离中心 = $Seed当前绝对落点 - $Seed路径中心
    IF $Seed本轮偏离中心 < 0
        $Seed本轮偏离中心 = 0 - $Seed本轮偏离中心
    ENDIF
    $消耗帧当前绝对落点 = $本轮消耗帧误差 + $消耗帧实际执行修正量
    IF $进入TV == 1
        $剩余帧当前落点 = $消耗帧当前绝对落点 % $TV单次消耗帧
        IF $剩余帧当前落点 < 0
            $剩余帧当前落点 = $剩余帧当前落点 + $TV单次消耗帧
        ENDIF
        $消耗帧本轮偏离中心 = 模周期归一($剩余帧当前落点 - $剩余帧中心, $TV单次消耗帧)
    ELSE
        $剩余帧当前落点 = $消耗帧当前绝对落点
        $消耗帧本轮偏离中心 = $剩余帧当前落点 - $剩余帧中心
    ENDIF
    IF $消耗帧本轮偏离中心 < 0
        $消耗帧本轮偏离中心 = 0 - $消耗帧本轮偏离中心
    ENDIF

    # 维度可信判定：用上一轮命中滑窗簇做路径门控。冷启动样本不足2轮时不因路径偏离判不可信。
    $Seed可信样本数 = 投票取Seed样本数()
    $剩余帧可信样本数 = 投票取剩余帧样本数()
    $TV帧可信样本数 = 投票取TV帧样本数()
    $Seed冷启动样本数 = $Seed可信样本数
    $剩余帧冷启动样本数 = $剩余帧可信样本数
    $TV帧冷启动样本数 = $TV帧可信样本数
    $Seed动态边界 = 投票取Seed动态窗()
    $帧动态边界 = 投票取剩余帧动态窗()
    $圈动态边界 = 投票取TV帧动态窗()
    $Seed可信窗 = $Seed动态边界 * 3
    $剩余帧可信窗 = $帧动态边界 * 3
    $TV帧可信窗 = $圈动态边界 * 3

    $Seed本轮可信 = 1
    IF $Seed可信样本数 >= 2 and $Seed本轮偏离中心 > $Seed可信窗
        $Seed本轮可信 = 0
    ENDIF
    $剩余帧本轮可信 = 1
    IF $剩余帧可信样本数 >= 2 and $消耗帧本轮偏离中心 > $剩余帧可信窗
        $剩余帧本轮可信 = 0
    ENDIF
    $TV帧本轮可信 = 1
    IF $进入TV == 1
        $TV帧当前绝对落点 = 带符号整除四舍五入($消耗帧当前绝对落点, $TV单次消耗帧)
        $TV帧偏离簇中心 = $TV帧当前绝对落点 - $TV帧路径中心
        IF $TV帧偏离簇中心 < 0
            $TV帧偏离簇中心 = 0 - $TV帧偏离簇中心
        ENDIF
        IF $TV帧可信样本数 >= 2 and $TV帧偏离簇中心 > $TV帧可信窗
            $TV帧本轮可信 = 0
        ENDIF
    ELSE
        $TV帧本轮可信 = 1
    ENDIF
    $消耗帧本轮可信 = $剩余帧本轮可信
    IF $进入TV == 1 and $TV帧本轮可信 == 0
        $消耗帧本轮可信 = 0
    ENDIF
    # 按轴真值：真值解（候选塌缩到唯一）或该轴候选全部一致（独立于路径）→ 该轴必可信，不被旧偏中心误判。
    # Seed/帧分别判定：同Seed异帧时 Seed 已定（Seed真值），帧未定仍按路径门控；反之亦然。
    IF $本轮真值解 == 1 or $候选全部同一Seed == 1
        $Seed本轮可信 = 1
    ENDIF
    IF $本轮真值解 == 1 or $候选全部同一消耗帧 == 1
        $剩余帧本轮可信 = 1
        $TV帧本轮可信 = 1
        $消耗帧本轮可信 = 1
    ENDIF
    $Seed强可信来源 = ""
    $消耗帧强可信来源 = ""
    IF $命中差索引 == 0
        $Seed本轮可信 = 1
        $Seed强可信来源 = "真命中"
    ENDIF
    IF $本轮消耗帧误差 == 0
        $剩余帧本轮可信 = 1
        $TV帧本轮可信 = 1
        $消耗帧本轮可信 = 1
        $消耗帧强可信来源 = "真命中"
    ENDIF
    IF $本轮剩余帧校准允许 == 0
        $剩余帧本轮可信 = 0
        $消耗帧本轮可信 = 0
        $消耗帧强可信来源 = ""
    ENDIF

    # 路径中心更新：帧/Seed路径簇用于候选与离群；Seed修正另走同参数锁定窗口。
    $投票忽略 = 投票决策($进入TV, $消耗帧实际执行修正量, $Seed累计修正索引)
    $帧最高堆 = 投票取帧最高堆()
    $帧投票领先 = 投票取帧领先()
    # ② 真值解直通：本轮命中(真值解 且 落重心±动态窗)记入跨轮连续数，供下一轮吃糖循环停糖直通判定
    IF ($御三家严格筛选 == 1 or $跨组筛选回退启用 == 1) and $御三家共同证据可信 == 1
        $Seed本轮可信 = 1
        $TV帧本轮可信 = 1
        IF $本轮剩余帧校准允许 == 1
            $剩余帧本轮可信 = 1
            $消耗帧本轮可信 = 1
        ENDIF
    ENDIF
    $投票忽略 = 投票记真值解($本轮真值解, $消耗帧本轮偏离中心)
    # 候选全集仍进入诊断票表/共同区；最终命中只在对应轴可信时写入路径窗和控制样本。
    IF $本轮剩余帧校准允许 == 1 and $剩余帧本轮可信 == 1
        $投票忽略 = 投票设置帧窗($本轮消耗帧误差, $消耗帧实际执行修正量, $进入TV)
    ENDIF
    IF $Seed本轮可信 == 1
        $投票忽略 = 投票设置Seed窗($命中差索引, $Seed累计修正索引)
        IF $Seed校准方案 == 0
            $投票忽略 = 投票设置Seed校准样本($命中差索引, $Seed累计修正索引)
        ENDIF
    ENDIF
    IF $TV帧本轮可信 == 1
        $投票忽略 = 投票设置TV帧窗($本轮消耗帧误差, $消耗帧实际执行修正量, $进入TV)
    ENDIF
    # 刚大修正门控：此处 $消耗帧本次新增修正量 仍是上轮施加值(本轮修正在下方才算)。其绝对值 > 相位动态窗(动态测得的相位抖动)，
    # 说明上轮做了圈级大修正→本轮命中相位必然漂移(过冲期),这不是NPC而是我们自己的大移动,本轮一律不判离群跳过、照常修正快速逼近。
    $帧动态边界 = 投票取动态窗()
    $上轮修正绝对 = $消耗帧本次新增修正量
    IF $上轮修正绝对 < 0
        $上轮修正绝对 = 0 - $上轮修正绝对
    ENDIF
    $刚大修正 = 0
    IF $上轮修正绝对 > $帧动态边界
        $刚大修正 = 1
    ENDIF
    # 真值解优先级高于路径离群：候选唯一时，说明本轮观测已独立塌缩，不应被旧路径预测拦截。
    # 若唯一候选偏离旧路径，接受真值并重锚路径票表；多候选离群仍保留跳过/连续重锚保护。
    IF $本轮剩余帧校准允许 == 1 and $本轮真值解 == 1 and $最佳候选离群 == 1 and $刚大修正 == 0
        IF $调试日志输出 == 1
            PRINT ""
            PRINT 真值解偏离路径离群判定 → 接受真值并重锚路径票表，不执行离群跳过
        ENDIF
        CALL 投票重置
        IF $本轮剩余帧校准允许 == 1
            $投票忽略 = 投票设置帧窗($本轮消耗帧误差, $消耗帧实际执行修正量, $进入TV)
        ENDIF
        $投票忽略 = 投票设置Seed窗($命中差索引, $Seed累计修正索引)
        $投票忽略 = 投票设置TV帧窗($本轮消耗帧误差, $消耗帧实际执行修正量, $进入TV)
        $Seed修正余 = 0
        $帧修正余 = 0
        $圈修正余 = 0
        $TV帧修正余 = 0
        $TV圈上轮误差 = 0
        $TV圈交替停滞计数 = 0
        $TV圈脱困次数 = 0
        $TV圈强制脱困 = 0
        $TV双分支跟踪等待帧 = 0 - 1
        $TV双分支见零圈 = 0
        $TV双分支见相邻圈 = 0
        $TV双分支锁定 = 0
        $TV帧慢修正参数有效 = 0
        $TV帧慢修正窗口样本数 = 0
        $TV帧慢修正窗口指针 = 0
        $剩余帧慢修正参数有效 = 0
        $剩余帧慢修正窗口样本数 = 0
        $剩余帧慢修正窗口指针 = 0
        $帧命中保持启用 = 0
        $帧命中保持计数 = 0
        $离群聚集计数 = 0
        $连续离群计数 = 0
        $上次离群有效 = 0
        $本轮路径已重锚 = 1
    ENDIF
    # 离群轮处理：非真值离群轮不施加修正(跳过)；连续聚集≥逃生轮数 或 连续离群≥强制重锚轮数 → 判中心失准，重锚新路径+重置投票。
    IF $最佳候选离群 == 1 and $刚大修正 == 0 and $本轮真值解 == 0
        $连续离群计数 = $连续离群计数 + 1
        $本轮离群绝对 = $本轮消耗帧误差 + $消耗帧实际执行修正量
        IF $进入TV == 1
            $本轮离群绝对 = $本轮离群绝对 % $TV单次消耗帧
            IF $本轮离群绝对 < 0
                $本轮离群绝对 = $本轮离群绝对 + $TV单次消耗帧
            ENDIF
        ENDIF
        $离群间距 = $本轮离群绝对 - $上次离群绝对
        IF $离群间距 < 0
            $离群间距 = 0 - $离群间距
        ENDIF
        IF $上次离群有效 == 1 and $离群间距 <= $离群聚集窗
            $离群聚集计数 = $离群聚集计数 + 1
        ELSE
            $离群聚集计数 = 1
        ENDIF
        $上次离群绝对 = $本轮离群绝对
        $上次离群有效 = 1
        IF $离群聚集计数 >= $离群逃生轮数 or $连续离群计数 >= $离群强制重锚轮数
            IF $调试日志输出 == 1
                PRINT ""
                IF $离群聚集计数 >= $离群逃生轮数
                    PRINT 连续 & $离群聚集计数 & 轮离群命中聚集 → 判定真路径切换，重锚到新路径并重置投票表，跟随新路径校准
                ELSE
                    PRINT 连续 & $连续离群计数 & 轮离群(离群点分散未聚集，疑首轮中心偏/中心失准) → 强制重锚到当前命中并重置投票表，打破离群死锁
                ENDIF
            ENDIF
            $消耗帧路径中心 = $消耗帧归一化误差
            $本轮路径已重锚 = 1
            CALL 投票重置
            # 重锚=路径切换，旧的半量余数作废清0(免把旧路径的分数偏置带进新路径)
            $Seed修正余 = 0
            $帧修正余 = 0
            $圈修正余 = 0
            $TV帧修正余 = 0
            $TV圈上轮误差 = 0
            $TV圈交替停滞计数 = 0
            $TV圈脱困次数 = 0
            $TV圈强制脱困 = 0
            $TV双分支跟踪等待帧 = 0 - 1
            $TV双分支见零圈 = 0
            $TV双分支见相邻圈 = 0
            $TV双分支锁定 = 0
            $TV帧慢修正参数有效 = 0
            $TV帧慢修正窗口样本数 = 0
            $TV帧慢修正窗口指针 = 0
            $剩余帧慢修正参数有效 = 0
            $剩余帧慢修正窗口样本数 = 0
            $剩余帧慢修正窗口指针 = 0
            $帧命中保持启用 = 0
            $帧命中保持计数 = 0
            $离群聚集计数 = 0
            $连续离群计数 = 0
            $上次离群有效 = 0
        ELSE
            IF $调试日志输出 == 1
                PRINT ""
                PRINT 本轮离群跳过(命中偏离投票峰值过远，疑NPC抖动；连续聚集 & $离群聚集计数 & /& $离群逃生轮数 & 轮、连续离群 & $连续离群计数 & /& $离群强制重锚轮数 & 轮，未达切换判定)，不施加修正、保持上轮参数重试
                # 跳过轮也打印本轮偏移量+直方图，供分析为何判离群(本轮命中离簇峰值多远)
                PRINT 本轮偏移: Seed差 & $命中差索引 & " 真实帧误差 " & $本轮消耗帧误差 & " 剩余帧误差 " & $消耗帧归一化误差 & " 离群参考 " & $本轮离群绝对
            ELSE
                PRINT 本轮结果波动较大，参数保持不变
            ENDIF
            # EzCon 的 PRINT 不能内联函数调用，须先取到标量(复用中心/窗变量，跳过轮即 RETURN，下一轮会重算)
            $消耗帧路径中心 = 投票取帧中心()
            $帧动态边界 = 投票取动态窗()
            $Seed路径中心 = 投票取Seed绝对中心()
            $Seed动态边界 = 投票取Seed动态窗()
            $剩余帧中心 = 投票取剩余帧中心()
            $TV帧路径中心 = 投票取TV帧中心()
            $圈动态边界 = 投票取TV帧动态窗()
            $Seed当前绝对落点 = $命中差索引 + $Seed累计修正索引
            $Seed偏离簇中心 = $Seed当前绝对落点 - $Seed路径中心
            IF $Seed偏离簇中心 < 0
                $Seed偏离簇中心 = 0 - $Seed偏离簇中心
            ENDIF
            $消耗帧当前绝对落点 = $本轮消耗帧误差 + $消耗帧实际执行修正量
            IF $进入TV == 1
                $剩余帧当前落点 = $消耗帧当前绝对落点 % $TV单次消耗帧
                IF $剩余帧当前落点 < 0
                    $剩余帧当前落点 = $剩余帧当前落点 + $TV单次消耗帧
                ENDIF
                $剩余帧偏离簇中心 = 模周期归一($剩余帧当前落点 - $剩余帧中心, $TV单次消耗帧)
                IF $剩余帧偏离簇中心 < 0
                    $剩余帧偏离簇中心 = 0 - $剩余帧偏离簇中心
                ENDIF
                $TV帧当前绝对落点 = 带符号整除四舍五入($消耗帧当前绝对落点, $TV单次消耗帧)
                $TV帧偏离簇中心 = $TV帧当前绝对落点 - $TV帧路径中心
                IF $TV帧偏离簇中心 < 0
                    $TV帧偏离簇中心 = 0 - $TV帧偏离簇中心
                ENDIF
                IF $调试日志输出 == 1
                    PRINT 离群轴状态: Seed当前 & $Seed当前绝对落点 & "/中心" & $Seed路径中心 & "/窗" & $Seed动态边界 & "/偏离" & $Seed偏离簇中心 & " TV帧当前" & $TV帧当前绝对落点 & "/中心" & $TV帧路径中心 & "/窗" & $圈动态边界 & "/偏离" & $TV帧偏离簇中心 & " 剩余帧当前" & $剩余帧当前落点 & "/中心" & $剩余帧中心 & "/窗" & $帧动态边界 & "/偏离" & $剩余帧偏离簇中心
                ENDIF
            ELSE
                $剩余帧当前落点 = $消耗帧当前绝对落点
                $剩余帧偏离簇中心 = $剩余帧当前落点 - $剩余帧中心
                IF $剩余帧偏离簇中心 < 0
                    $剩余帧偏离簇中心 = 0 - $剩余帧偏离簇中心
                ENDIF
                IF $调试日志输出 == 1
                    PRINT 离群轴状态: Seed当前 & $Seed当前绝对落点 & "/中心" & $Seed路径中心 & "/窗" & $Seed动态边界 & "/偏离" & $Seed偏离簇中心 & " 帧误差当前" & $剩余帧当前落点 & "/中心" & $剩余帧中心 & "/窗" & $帧动态边界 & "/偏离" & $剩余帧偏离簇中心
                ENDIF
            ENDIF
            IF $调试日志输出 == 1
                $投票忽略 = 投票打印直方图($进入TV)
            ENDIF
            $循环计数 += 1
            RETURN 1
        ENDIF
    ELSE
        $连续离群计数 = 0
        $离群聚集计数 = 0
        $上次离群有效 = 0
    ENDIF
    # Seed 路径中心 = 最聚集簇均值(绝对落点)。帧路径中心保留残差空间中心，供候选选择/BINGO 使用。
    $Seed路径中心 = 投票取Seed绝对中心()
    $消耗帧路径中心 = 投票取帧中心()
    $剩余帧中心 = 投票取剩余帧中心()
    $TV帧路径中心 = 投票取TV帧中心()

    # 残差离目标绝对值（判断是否进入 BINGO 范围；下方收敛标志复用，不再重复计算）
    $Seed差绝对 = $命中差索引
    IF $Seed差绝对 < 0
        $Seed差绝对 = 0 - $Seed差绝对
    ENDIF
    $消耗帧归一化绝对 = $消耗帧归一化误差
    IF $消耗帧归一化绝对 < 0
        $消耗帧归一化绝对 = 0 - $消耗帧归一化绝对
    ENDIF
    # 真帧误差(含圈,未折叠)：TV 修正/收敛改用它(方案B,与消耗帧/Seed同构,使圈偏差也能被校正)；普通模式周期0时本轮消耗帧误差==归一化误差,无回归。
    $消耗帧真绝对 = $本轮消耗帧误差
    IF $消耗帧真绝对 < 0
        $消耗帧真绝对 = 0 - $消耗帧真绝对
    ENDIF

    # 当前绝对落点仍用于真实簇/离群诊断；Seed修正走同参数锁定窗口，帧轴继续以目标残差0为阻尼中心。
    $Seed当前绝对落点 = $命中差索引 + $Seed累计修正索引
    $Seed偏离簇中心 = $Seed当前绝对落点 - $Seed路径中心
    IF $Seed偏离簇中心 < 0
        $Seed偏离簇中心 = 0 - $Seed偏离簇中心
    ENDIF
    $消耗帧当前绝对落点 = $本轮消耗帧误差 + $消耗帧实际执行修正量
    $剩余帧误差 = $消耗帧归一化误差

    $Seed动态边界 = 投票取Seed动态窗()
    $帧动态边界 = 投票取剩余帧动态窗()
    $圈动态边界 = 投票取TV帧动态窗()
    $Seed样本数 = 投票取Seed样本数()
    $剩余帧样本数 = 投票取剩余帧样本数()
    $TV帧样本数 = 投票取TV帧样本数()
    IF $Seed校准方案 == 0
        $Seed校准样本数 = 投票取Seed校准样本数()
        $Seed校准目标绝对 = 投票取Seed校准目标()
        $Seed校准目标票数 = 投票取Seed校准目标票数()
        $Seed校准目标差 = $Seed校准目标绝对 - $Seed累计修正索引
    ENDIF
    $Seed可信窗 = $Seed动态边界 * 3
    $剩余帧可信窗 = $帧动态边界 * 3
    $TV帧可信窗 = $圈动态边界 * 3

    IF $Seed本轮可信 == 0
        # 冻结本轴：不调用控制器，避免不可信候选消耗窗口、余数或命中保持状态。
        $Seed簇内 = 0
        $Seed本次修正索引 = 0
        $Seed本次修正原始 = 0
        $Seed本次修正限幅 = 0
        $Seed精细本轮更新 = 0
        $Seed精细本轮新增MS = 0
        $Seed锁定本轮新启用 = 0
        $Seed锁定本轮触发 = 0
        $Seed锁定本轮样本计入 = 0
        $Seed命中保持本轮刷新 = 0
        $Seed命中保持触发固定半步 = 0
        $Seed直接修正触发 = 0
        $Seed立即夹逼触发 = 0
        $Seed修正模式文本 = "本轮Seed不可信，只观察，不写窗、不修正"
    ELIF $Seed校准方案 == 0
        $Seed本次修正索引 = 计算Seed原始众数修正()
    ELSE
        $Seed本次修正索引 = 计算Seed锁定众数修正()
        IF $Seed锁定启用 == 1
            $Seed簇内 = 1
        ELSE
            $Seed簇内 = 0
        ENDIF
    ENDIF

    IF $进入TV == 1
        $剩余帧当前落点 = $消耗帧当前绝对落点 % $TV单次消耗帧
        IF $剩余帧当前落点 < 0
            $剩余帧当前落点 = $剩余帧当前落点 + $TV单次消耗帧
        ENDIF
        $剩余帧偏离簇中心 = 模周期归一($剩余帧当前落点 - $剩余帧中心, $TV单次消耗帧)
        IF $剩余帧偏离簇中心 < 0
            $剩余帧偏离簇中心 = 0 - $剩余帧偏离簇中心
        ENDIF
        $圈误差 = 带符号整除四舍五入($本轮消耗帧误差, $TV单次消耗帧)
        $圈误差绝对 = $圈误差
        IF $圈误差绝对 < 0
            $圈误差绝对 = 0 - $圈误差绝对
        ENDIF
        $TV双分支本轮抑制 = 0
        $TV双分支本轮新锁定 = 0
        $TV双分支本轮解除 = 0
        # 只用目标Seed且TV帧轴可信的观测建立双分支证据。
        IF $命中差索引 == 0 and $TV帧本轮可信 == 1
            IF $TV双分支跟踪等待帧 != $TV等待帧
                IF $TV双分支锁定 == 1
                    $TV双分支本轮解除 = 1
                ENDIF
                $TV双分支跟踪等待帧 = $TV等待帧
                $TV双分支见零圈 = 0
                $TV双分支见相邻圈 = 0
                $TV双分支锁定 = 0
            ENDIF
            IF $圈误差绝对 <= 1 and $消耗帧归一化绝对 <= $TV双分支相位阈值
                IF $圈误差 == 0
                    $TV双分支见零圈 = 1
                ELSE
                    $TV双分支见相邻圈 = 1
                ENDIF
                IF $TV双分支见零圈 == 1 and $TV双分支见相邻圈 == 1 and $TV双分支锁定 == 0
                    $TV双分支锁定 = 1
                    $TV双分支本轮新锁定 = 1
                ENDIF
            ELSE
                IF $TV双分支锁定 == 1
                    $TV双分支本轮解除 = 1
                ENDIF
                $TV双分支见零圈 = 0
                $TV双分支见相邻圈 = 0
                $TV双分支锁定 = 0
            ENDIF
        ENDIF
        # TV整圈±1窗口允许所有Seed提供证据；参数变化或双分支锁定时重置。
        $TV帧慢修正触发 = 0
        $TV帧慢修正当前票数 = 0
        IF $TV帧慢修正参数有效 == 0 or $TV帧慢修正参数累计修正 != $消耗帧实际执行修正量 or $TV帧慢修正参数F1 != $F1等待帧 or $TV帧慢修正参数TV != $TV等待帧 or $TV帧慢修正参数F2 != $F2等待帧
            $TV帧慢修正参数有效 = 1
            $TV帧慢修正参数累计修正 = $消耗帧实际执行修正量
            $TV帧慢修正参数F1 = $F1等待帧
            $TV帧慢修正参数TV = $TV等待帧
            $TV帧慢修正参数F2 = $F2等待帧
            $TV帧慢修正窗口样本数 = 0
            $TV帧慢修正窗口指针 = 0
        ENDIF
        IF $TV双分支锁定 == 1 and $TV双分支跟踪等待帧 == $TV等待帧
            $TV帧慢修正窗口样本数 = 0
            $TV帧慢修正窗口指针 = 0
            $TV帧慢修正当前票数 = 0
        ELIF $TV帧本轮可信 == 1
            $TV帧慢修正窗口[$TV帧慢修正窗口指针] = $圈误差
            $TV帧慢修正窗口指针 = $TV帧慢修正窗口指针 + 1
            IF $TV帧慢修正窗口指针 >= $TV帧慢修正窗口大小
                $TV帧慢修正窗口指针 = 0
            ENDIF
            IF $TV帧慢修正窗口样本数 < $TV帧慢修正窗口大小
                $TV帧慢修正窗口样本数 = $TV帧慢修正窗口样本数 + 1
            ENDIF
            $TV帧慢修正当前票数 = 0
            IF $圈误差绝对 == 1
                $TV帧慢修正有效末索引 = $TV帧慢修正窗口样本数 - 1
                FOR $TV帧慢修正窗口索引 = 0 TO $TV帧慢修正有效末索引
                    IF $TV帧慢修正窗口[$TV帧慢修正窗口索引] == $圈误差
                        $TV帧慢修正当前票数 = $TV帧慢修正当前票数 + 1
                    ENDIF
                NEXT
                IF $TV帧慢修正当前票数 >= $TV帧慢修正触发票数
                    $TV帧慢修正触发 = 1
                ENDIF
            ENDIF
        ENDIF
        $TV帧当前绝对落点 = 带符号整除四舍五入($消耗帧当前绝对落点, $TV单次消耗帧)
        $TV帧偏离簇中心 = $TV帧当前绝对落点 - $TV帧路径中心
        IF $TV帧偏离簇中心 < 0
            $TV帧偏离簇中心 = 0 - $TV帧偏离簇中心
        ENDIF
        $TV圈强制脱困 = 0
        IF $TV帧本轮可信 == 0
            $TV帧簇内 = 0
            $TV帧本次修正 = 0
        ELIF $TV双分支锁定 == 1 and $TV双分支跟踪等待帧 == $TV等待帧 and $圈误差绝对 <= 1 and $消耗帧归一化绝对 <= $TV双分支相位阈值
            # 已确认同一等待参数存在0/±1圈随机落点；禁止把随机分支累计成±314修正。
            $TV双分支本轮抑制 = 1
            $TV帧簇内 = 1
            $TV帧本次修正 = 0
            $TV帧修正余 = 0
            $TV圈上轮误差 = 0
            $TV圈交替停滞计数 = 0
            $TV圈脱困次数 = 0
        ELSE
            IF $TV帧慢修正触发 == 1
                $TV帧簇内 = 1
                $TV帧本次修正 = $圈误差
                $TV帧修正余 = 0
                $TV圈上轮误差 = 0
                $TV圈交替停滞计数 = 0
                $TV圈脱困次数 = 0
            ELIF $圈误差绝对 == 1
                # 单次±1圈先冻结；只有同参数10轮窗内达到5票才执行整圈修正。
                $TV帧簇内 = 1
                $TV帧本次修正 = 0
                $TV帧修正余 = 0
                $TV圈上轮误差 = 0
                $TV圈交替停滞计数 = 0
                $TV圈脱困次数 = 0
            ELSE
            IF $圈误差 == 0
                $TV圈上轮误差 = 0
                $TV圈交替停滞计数 = 0
                $TV圈脱困次数 = 0
                $TV帧修正余 = 0
            ELSE
                IF $TV圈上轮误差 == 0 - $圈误差
                    $TV圈交替停滞计数 = $TV圈交替停滞计数 + 1
                ELSE
                    $TV圈交替停滞计数 = 0
                ENDIF
                $TV圈上轮误差 = $圈误差
            ENDIF
            IF $TV帧冷启动样本数 <= 0
                $TV帧簇内 = 0
                $TV帧本次修正 = $圈误差
                $TV帧修正余 = 0
            ELIF $圈误差绝对 <= $圈动态边界
                $TV帧簇内 = 1
                $TV帧修正余 = $TV帧修正余 + $圈误差
                $TV帧本次修正 = $TV帧修正余 / 2
                $TV帧修正余 = $TV帧修正余 - $TV帧本次修正 * 2
            ELSE
                $TV帧簇内 = 0
                $TV帧本次修正 = $圈误差
                $TV帧修正余 = 0
            ENDIF
            IF $TV帧本次修正 != 0
                $TV圈交替停滞计数 = 0
            ELIF $圈误差 != 0 and $TV圈交替停滞计数 >= $TV圈交替脱困轮数
                IF $TV圈脱困次数 >= $TV圈脱困次数上限
                    PRINT ""
                    PRINT 【TV过帧校准】
                    PRINT 结果: 停止脚本
                    PRINT 原因: TV圈误差持续正负交替，已达到脱困次数上限，避免进入无限校准循环
                    PRINT 当前圈误差: & $圈误差 & " 圈"
                    RETURN 0
                ENDIF
                $TV帧本次修正 = $圈误差
                $TV帧修正余 = 0
                $TV圈交替停滞计数 = 0
                $TV圈上轮误差 = 0
                $TV圈脱困次数 = $TV圈脱困次数 + 1
                $TV圈强制脱困 = 1
                IF $调试日志输出 == 1
                    PRINT ""
                    PRINT 【TV过帧校准】
                    PRINT 检测到圈误差正负交替且半量修正持续为0
                    PRINT 强制整圈脱困修正: & $TV帧本次修正 & " 圈，次数 " & $TV圈脱困次数 & "/" & $TV圈脱困次数上限
                ENDIF
            ENDIF
            ENDIF
        ENDIF
        IF $TV双分支本轮新锁定 == 1
            IF $调试日志输出 == 1
                PRINT ""
                PRINT 【TV双分支锁定】
                PRINT 同一TV等待帧已由目标Seed确认0圈与相邻圈两种落点
                PRINT 锁定TV等待帧: & $TV等待帧 & " 帧；后续相邻圈不再累计±314修正"
            ENDIF
        ELIF $TV双分支本轮解除 == 1
            IF $调试日志输出 == 1
                PRINT ""
                PRINT 【TV双分支解除】
                PRINT 目标Seed已超出相邻圈/小相位范围，恢复TV整圈校准
            ENDIF
        ENDIF
        $本次圈修正 = $TV帧本次修正
        $圈修正余 = $TV帧修正余
    ELSE
        $剩余帧当前落点 = $消耗帧当前绝对落点
        $剩余帧偏离簇中心 = $剩余帧当前落点 - $剩余帧中心
        IF $剩余帧偏离簇中心 < 0
            $剩余帧偏离簇中心 = 0 - $剩余帧偏离簇中心
        ENDIF
        $TV帧当前绝对落点 = 0
        $TV帧偏离簇中心 = 0
        $TV帧簇内 = 0
        $TV帧本次修正 = 0
        $TV帧修正余 = 0
        $本次圈修正 = 0
        $圈修正余 = 0
    ENDIF

    # 剩余帧慢修正窗口：只统计目标Seed。保存绝对相位，自动调整等待参数后按当前累计修正重新投影。
    $剩余帧慢修正触发 = 0
    IF $剩余帧慢修正参数有效 == 0
        $剩余帧慢修正参数有效 = 1
    ENDIF
    $剩余帧慢修正参数累计修正 = $消耗帧实际执行修正量
    $剩余帧慢修正参数F1 = $F1等待帧
    $剩余帧慢修正参数TV = $TV等待帧
    $剩余帧慢修正参数F2 = $F2等待帧

    $剩余帧慢修正当前票数 = 0
    # 剩余帧窗口只接收目标Seed且本轴可信的观测。
    IF $命中差索引 == 0 and $剩余帧本轮可信 == 1
        $剩余帧慢修正当前绝对相位 = $消耗帧归一化误差 + $消耗帧实际执行修正量
        IF $进入TV == 1
            $剩余帧慢修正当前绝对相位 = 模周期归一($剩余帧慢修正当前绝对相位, $TV单次消耗帧)
        ENDIF
        $剩余帧慢修正窗口[$剩余帧慢修正窗口指针] = $剩余帧慢修正当前绝对相位
        $剩余帧慢修正窗口指针 = $剩余帧慢修正窗口指针 + 1
        IF $剩余帧慢修正窗口指针 >= $剩余帧慢修正窗口大小
            $剩余帧慢修正窗口指针 = 0
        ENDIF
        IF $剩余帧慢修正窗口样本数 < $剩余帧慢修正窗口大小
            $剩余帧慢修正窗口样本数 = $剩余帧慢修正窗口样本数 + 1
        ENDIF

        IF $消耗帧归一化误差 != 0 and $消耗帧归一化绝对 <= $剩余帧慢修正误差上限
            $剩余帧慢修正有效末索引 = $剩余帧慢修正窗口样本数 - 1
            FOR $剩余帧慢修正窗口索引 = 0 TO $剩余帧慢修正有效末索引
                $剩余帧慢修正样本投影 = $剩余帧慢修正窗口[$剩余帧慢修正窗口索引] - $消耗帧实际执行修正量
                IF $进入TV == 1
                    $剩余帧慢修正样本投影 = 模周期归一($剩余帧慢修正样本投影, $TV单次消耗帧)
                ENDIF
                IF $剩余帧慢修正样本投影 == $消耗帧归一化误差
                    $剩余帧慢修正当前票数 = $剩余帧慢修正当前票数 + 1
                ENDIF
            NEXT
            IF $剩余帧慢修正当前票数 >= $剩余帧慢修正触发票数
                $剩余帧慢修正触发 = 1
            ENDIF
        ENDIF
    ENDIF
    IF $剩余帧本轮可信 == 0
        $剩余帧簇内 = 0
        $本次相位修正 = 0
    ELIF $剩余帧慢修正触发 == 1
        $剩余帧簇内 = 1
        $本次相位修正 = $消耗帧归一化误差
        $帧修正余 = 0
        $本轮剩余帧抖动冻结 = 0
        $本轮剩余帧校准允许 = 1
    ELIF $本轮剩余帧校准允许 == 0
        $剩余帧簇内 = 0
        $本次相位修正 = 0
    ELIF $命中差索引 == 0 and $消耗帧归一化绝对 > 0 and $消耗帧归一化绝对 <= $目标Seed剩余帧抖动死区
        $剩余帧簇内 = 1
        $本次相位修正 = 0
        $帧修正余 = 0
        $本轮剩余帧抖动冻结 = 1
    ELIF $剩余帧冷启动样本数 <= 0
        $剩余帧簇内 = 0
        $本次相位修正 = $消耗帧归一化误差
        $帧修正余 = 0
    ELIF $消耗帧归一化绝对 <= $帧动态边界
        $剩余帧簇内 = 1
        $帧修正余 = $帧修正余 + $消耗帧归一化误差
        $本次相位修正 = $帧修正余 / 2
        $帧修正余 = $帧修正余 - $本次相位修正 * 2
    ELSE
        $剩余帧簇内 = 0
        $本次相位修正 = $消耗帧归一化误差
        $帧修正余 = 0
    ENDIF
    # 精确命中帧轴后固定参数观察10次；再次命中会重新计数。第10个未命中可信样本按原帧轴规则恢复修正。
    $帧命中保持本轮抑制 = 0
    $帧命中保持本轮刷新 = 0
    IF $消耗帧本轮可信 == 1 and $命中差索引 == 0 and $本轮消耗帧误差 == 0
        $帧命中保持启用 = 1
        $帧命中保持计数 = 0
        $帧命中保持本轮抑制 = 1
        $帧命中保持本轮刷新 = 1
    ELIF $帧命中保持启用 == 1
        $帧命中保持本轮抑制 = 1
        IF $消耗帧本轮可信 == 1
            $帧命中保持计数 = $帧命中保持计数 + 1
            IF $帧命中保持计数 >= $帧命中保持样本数
                $帧命中保持启用 = 0
                $帧命中保持本轮抑制 = 0
            ENDIF
        ENDIF
    ENDIF
    IF $帧命中保持本轮抑制 == 1
        $TV帧本次修正 = 0
        $TV帧修正余 = 0
        $本次圈修正 = 0
        $圈修正余 = 0
        $本次相位修正 = 0
        $帧修正余 = 0
    ENDIF
    $消耗帧本次新增修正量 = $本次圈修正 * $TV单次消耗帧 + $本次相位修正

    IF $Seed校准方案 == 0
        IF $Seed本轮可信 == 1 and $Seed差绝对 <= 1
            $SeedMS本轮收敛 = 1
        ELSE
            $SeedMS本轮收敛 = 0
        ENDIF
    ELSE
        # 锁定方案精确命中后进入5次参数保持，视为Seed轴已收敛。
        IF $Seed本轮可信 == 1 and $Seed锁定启用 == 1 and $Seed命中保持启用 == 1
            $SeedMS本轮收敛 = 1
        ELSE
            $SeedMS本轮收敛 = 0
        ENDIF
    ENDIF
    IF $消耗帧本轮可信 == 1 and $本轮剩余帧校准允许 == 1 and $消耗帧真绝对 <= $直接选择接近阈值
        $消耗帧本轮收敛 = 1
    ELSE
        $消耗帧本轮收敛 = 0
    ENDIF

    # Seed 累计修正按索引累加；ms 校准量查 seed 表：偏移 累计索引 个 seed 对应的 ms 差（表非均匀，逐点查最准）
    $Seed累计修正索引 = 累加实际执行修正量($Seed累计修正索引, $Seed本次修正索引)
    $Seed修正目标索引 = $目标索引 + $Seed累计修正索引
    IF $Seed修正目标索引 < 0
        $Seed修正目标索引 = 0
    ENDIF
    IF $Seed修正目标索引 > $Seed最大索引
        $Seed修正目标索引 = $Seed最大索引
    ENDIF
    # 本次新增 ms 修正量 = 新累计ms - 旧累计ms（供日志显示）
    $SeedMS上次实际执行修正量 = $SeedMS实际执行修正量
    $SeedMS实际执行修正量 = 取MS($游戏版本, $Seed修正目标索引) - 取MS($游戏版本, $目标索引)
    $SeedMS本次新增修正量 = $SeedMS实际执行修正量 - $SeedMS上次实际执行修正量
    $消耗帧实际执行修正量 = 累加实际执行修正量($消耗帧实际执行修正量, $消耗帧本次新增修正量)

    $SeedMS = $目标SeedMS - $SeedMS实际执行修正量 + $Seed基础补偿 + $Seed预校准命令修正MS + $Seed精细修正MS

    $校准成功 = 重新计算等待参数()
    IF $校准成功 == 0
        RETURN 0
    ENDIF

    CALL 输出本轮校准决策

    # BINGO 仅作可视化诊断：死区一律传 0。
    # BINGO 下轮命中预测使用目标残差坐标：本轮残差 - 本轮新增修正量。路径中心只保留给候选/离群/诊断。
    CALL 准备BINGOSeed文本
    $temp = 获取Seed单边死区(0, 0)
    $稳定簇帧归一化 = $剩余帧误差 - $本次相位修正
    IF $进入TV == 1
        $TV帧预测累计修正 = 0
        $TV帧预测投影 = $圈误差 - $TV帧本次修正
    ELSE
        $TV帧预测累计修正 = 0
        $TV帧预测投影 = 0
    ENDIF
    IF $Seed校准方案 == 0
        IF $Seed校准样本数 >= $Seed稳态启用样本数
            $稳定簇Seed归一化 = $Seed校准目标差 - $Seed本次修正索引
            $Seed预测来源文本 = "原始12轮绝对落点众数"
        ELSE
            $稳定簇Seed归一化 = $命中差索引 - $Seed本次修正索引
            $Seed预测来源文本 = "原始方案当前残差"
        ENDIF
    ELSE
        IF $Seed锁定启用 == 1 and $Seed锁定目标票数 > 0
            $稳定簇Seed归一化 = 0
            $Seed预测来源文本 = "锁定窗口已命中目标Seed"
        ELIF $Seed锁定启用 == 1 and $Seed锁定本轮触发 == 1
            $稳定簇Seed归一化 = $Seed锁定众数差 - $Seed本次修正索引
            $Seed预测来源文本 = "同参数锁定窗口众数"
        ELSE
            $稳定簇Seed归一化 = $命中差索引 - $Seed本次修正索引
            $Seed预测来源文本 = "当前残差"
        ENDIF
    ENDIF
    $BINGO二维预测启用 = 0
    IF $本轮剩余帧校准允许 == 1 and $Seed样本数 >= 2 and $剩余帧样本数 >= 2
        $BINGO二维预测启用 = 1
    ENDIF
    $BINGOTV帧预测启用 = 0
    IF $进入TV == 1 and $TV帧样本数 >= 2
        $BINGOTV帧预测启用 = 1
    ENDIF
    $BINGOSeed预测半径生效 = $Seed动态边界
    $BINGO帧预测半径生效 = $帧动态边界
    IF $BINGO二维预测启用 == 0
        $BINGOSeed预测半径生效 = 0 - 1
        $BINGO帧预测半径生效 = 0 - 1
    ENDIF
    $BINGOTV帧预测半径生效 = $圈动态边界
    IF $BINGOTV帧预测启用 == 0
        $BINGOTV帧预测半径生效 = 0 - 1
    ENDIF
    $BINGO投影帧低 = $稳定簇帧归一化 - $帧动态边界
    $BINGO投影帧高 = $稳定簇帧归一化 + $帧动态边界
    $BINGO投影覆盖表格 = 0
    IF $BINGO二维预测启用 == 1 and $BINGO投影帧高 >= -4 and $BINGO投影帧低 <= 4
        $BINGO投影覆盖表格 = 1
    ENDIF
    CALL 输出簇状态
    $BINGO设置结果 = 设置BINGO上下文($命中差索引, $本轮消耗帧误差, 0, 0, 0, $Seed容差, $目标索引, $Seed最大索引, $游戏版本, $Seed模式, $进入TV, $TV单次消耗帧, $已新增正向TV倍数, $已新增负向TV倍数)
    $BINGO设置结果 = 设置BINGO簇($稳定簇Seed归一化, $BINGOSeed预测半径生效, $稳定簇帧归一化, $BINGO帧预测半径生效)
    $BINGO设置结果 = 设置BINGOTV帧轴($进入TV, $圈误差, $TV帧预测投影, $BINGOTV帧预测半径生效)
    $BINGO设置结果 = 设置BINGOSeed文本($BINGOSeed负4文本, $BINGOSeed负3文本, $BINGOSeed负2文本, $BINGOSeed负1文本, $BINGOSeed零文本, $BINGOSeed正1文本, $BINGOSeed正2文本, $BINGOSeed正3文本, $BINGOSeed正4文本)
    $BINGO表格命中 = 0
    IF $命中差索引 >= -4 and $命中差索引 <= 4 and $消耗帧归一化误差 >= -4 and $消耗帧归一化误差 <= 4
        $BINGO表格命中 = 1
    ENDIF
    IF $进入TV == 1 and $消耗帧本轮可信 == 1
        CALL 记录BINGOTV帧命中
    ENDIF
    IF $Seed本轮可信 == 1 and $消耗帧本轮可信 == 1
        CALL 记录BINGO命中
    ENDIF
    CALL 输出自动校准结果

    # 命中判定：Seed 精确(差索引=0) 且 真实消耗帧精确命中目标(TV帧+剩余帧都对)。
    # TV 模式整周期等价的不同圈，PID 不同、不是目标个体 → 必须真实帧误差==0，不能只看相位归一化(否则差整数圈会误判命中)。
    # 普通模式周期0，真实误差与归一化误差等价，行为不变。
    IF $道具乱数模式 == 0 and $命中差索引 == 0 and $本轮消耗帧误差 == 0 and $本轮物种命中 == 1
        PRINT ""
        PRINT SeedMS误差: & $本轮SeedMS误差 & " ms"
        IF $进入TV == 1
            PRINT 真实消耗帧误差:0 帧(TV帧与剩余帧均命中目标)
        ELSE
            PRINT 真实消耗帧误差:0 帧
        ENDIF
        PRINT 已命中目标，脚本停止
        RETURN 0
    ENDIF

    IF $命中差索引 == 0 and $本轮消耗帧误差 == 0 and $本轮物种命中 == 0
        PRINT ""
        PRINT Seed与消耗帧精确命中，但本轮物种不是配置目标，仅保留校准结果
    ENDIF

    $循环计数 += 1
    RETURN 1
ENDFUNC

FUNC 准备BINGOSeed文本
    $BINGOSeed负4文本 = 读取BINGOSeed文本(-4)
    $BINGOSeed负3文本 = 读取BINGOSeed文本(-3)
    $BINGOSeed负2文本 = 读取BINGOSeed文本(-2)
    $BINGOSeed负1文本 = 读取BINGOSeed文本(-1)
    $BINGOSeed零文本 = 读取BINGOSeed文本(0)
    $BINGOSeed正1文本 = 读取BINGOSeed文本(1)
    $BINGOSeed正2文本 = 读取BINGOSeed文本(2)
    $BINGOSeed正3文本 = 读取BINGOSeed文本(3)
    $BINGOSeed正4文本 = 读取BINGOSeed文本(4)
ENDFUNC

FUNC 读取BINGOSeed文本($偏移: INT): STRING
    $BINGOSeed临时索引 = $目标索引 + $偏移
    IF $BINGOSeed临时索引 < 0 or $BINGOSeed临时索引 > $Seed最大索引
        RETURN ""
    ENDIF
    RETURN 取SeedHEX($游戏版本, $BINGOSeed临时索引, $Seed模式)
ENDFUNC

FUNC 取当前TV路线基线(): INT
    IF $进入TV == 1 and 是否狩猎地带($遭遇地点) == 1
        IF ($遭遇地点 == 54 or $遭遇地点 == 55 or $遭遇地点 == 56 or $遭遇地点 == 57) and $遭遇方法 == 101
            IF $狩猎区路线实际耗时 > 0
                RETURN $狩猎区入口草丛TV路线基线 + ($狩猎区路线实际耗时 - $狩猎区入口草丛参考路线耗时) * 3 / 25
            ENDIF
        ENDIF
    ENDIF

    RETURN $TV路线基线未配置
ENDFUNC

FUNC 重新计算等待参数(): INT
    $F1等待帧 = 0
    $TV等待帧 = 0
    $F2等待帧 = 0

    $当前TV路线基线 = 取当前TV路线基线()
    IF $进入TV == 1 and $当前TV路线基线 != $TV路线基线未配置
        $TV路线可分配帧 = $目标消耗帧 - $消耗帧实际执行修正量 - $当前TV路线基线
        $TV等待帧 = $TV路线可分配帧 / $TV单次消耗帧
        $F2等待帧 = $TV路线可分配帧 % $TV单次消耗帧
    ELIF $进入TV == 1
        $TV路线可分配帧 = 0
        $TV等待帧 = 计算TV帧($目标消耗帧, $消耗帧实际执行修正量, $F1阶段脚本固定帧, $F2阶段脚本固定帧, $总消耗帧基础补偿, $TV单次消耗帧)
        $F2等待帧 = 计算TV模式F2帧($目标消耗帧, $消耗帧实际执行修正量, $F1阶段脚本固定帧, $F2阶段脚本固定帧, $总消耗帧基础补偿, $TV单次消耗帧)
    ELSE
        $TV等待帧 = 0
        $F2等待帧 = 计算普通F2帧($目标消耗帧, $消耗帧实际执行修正量, $F1阶段脚本固定帧, $F2阶段脚本固定帧, $总消耗帧基础补偿)
    ENDIF

    $临时F1等待帧 = $F1等待帧
    $临时F2等待帧 = $F2等待帧
    $帧轴菜单奇偶开关 = 0
    $方案0奇偶本轮执行偏移 = 0

    IF $帧奇偶修正方案 == 0
        IF $临时F2等待帧 % 2 != 0
            $方案0奇偶本轮执行偏移 = $方案0奇偶当前偏移
            $F1等待帧 = $临时F1等待帧 + $方案0奇偶本轮执行偏移
            $F2等待帧 = $临时F2等待帧 - $方案0奇偶本轮执行偏移
        ELSE
            $F1等待帧 = $临时F1等待帧
            $F2等待帧 = $临时F2等待帧
        ENDIF
    ELSE
        # 普通目标实测开关菜单额外推进114帧；御三家使用独立计时模型，不套此补偿。
        $F1等待帧 = $临时F1等待帧
        $F2等待帧 = $临时F2等待帧
        IF $帧轴菜单保持运行中 == 1
            IF $帧轴菜单保持剩余轮数 > 0
                $帧轴菜单奇偶开关 = 1
                $帧轴菜单保持剩余轮数 -= 1
            ELSE
                $帧轴菜单保持运行中 = 0
            ENDIF
        ENDIF
        IF $帧轴菜单奇偶开关 == 0 and $临时F2等待帧 % 2 != 0
            $帧轴菜单奇偶开关 = 1
        ENDIF
        IF $帧轴菜单奇偶开关 == 1
            IF $静态或野生 != "孵蛋" and 是否御三家目标() == 0
                $F2等待帧 = $F2等待帧 - $普通帧轴菜单额外推进帧
                # TV余帧不足时从上一圈借回314帧，保持总推进不变。
                IF $F2等待帧 < 0 and $进入TV == 1 and $TV等待帧 > 0
                    $TV等待帧 = $TV等待帧 - 1
                    $F2等待帧 = $F2等待帧 + $TV单次消耗帧
                ENDIF
            ENDIF
        ENDIF
    ENDIF

    IF $F1等待帧 < 0
        PRINT ""
        PRINT 【等待参数】
        PRINT 结果: 失败，停止脚本
        PRINT F1等待帧小于0： & $F1等待帧
        PRINT 建议：选择更高的目标消耗帧个体
        RETURN 0
    ENDIF
    IF $TV等待帧 < 0
        PRINT ""
        PRINT 【等待参数】
        PRINT 结果: 失败，停止脚本
        PRINT TV等待帧小于0： & $TV等待帧
        PRINT 建议：提高目标消耗帧，减少消耗帧实际执行修正量，或检查TV进入阈值
        RETURN 0
    ENDIF
    IF $F2等待帧 < 0
        PRINT ""
        PRINT 【等待参数】
        PRINT 结果: 失败，停止脚本
        PRINT F2等待帧小于0： & $F2等待帧
        PRINT 建议：选择更高的目标消耗帧个体
        RETURN 0
    ENDIF
    $F1等待MS = 帧转60FPS毫秒($F1等待帧)
    $TV等待MS = 帧转60FPS毫秒($TV等待帧)
    $F2等待MS = 帧转120FPS毫秒($F2等待帧)
    RETURN 1
ENDFUNC

FUNC 输出簇状态
    IF $调试日志输出 == 0
        RETURN
    ENDIF
    PRINT ""
    PRINT 【簇状态】
    PRINT 【命中滑窗簇】
    PRINT Seed簇: 样本数 & $Seed样本数 & " 冷启动判定样本数 " & $Seed冷启动样本数 & " 中心 " & $Seed路径中心 & " 动态窗 " & $Seed动态边界 & " 可信窗 " & $Seed可信窗
    IF $进入TV == 1
        PRINT TV帧簇: 样本数 & $TV帧样本数 & " 冷启动判定样本数 " & $TV帧冷启动样本数 & " 中心 " & $TV帧路径中心 & " 动态窗 " & $圈动态边界 & " 可信窗 " & $TV帧可信窗
        PRINT 剩余帧簇: 样本数 & $剩余帧样本数 & " 冷启动判定样本数 " & $剩余帧冷启动样本数 & " 中心 " & $剩余帧中心 & " 动态窗 " & $帧动态边界 & " 可信窗 " & $剩余帧可信窗
    ELSE
        PRINT 帧簇: 样本数 & $剩余帧样本数 & " 冷启动判定样本数 " & $剩余帧冷启动样本数 & " 中心 " & $剩余帧中心 & " 动态窗 " & $帧动态边界 & " 可信窗 " & $剩余帧可信窗
    ENDIF
    PRINT 路径坐标: 原始误差 + 累计修正 = 当前绝对落点；路径中心仅用于候选/离群/诊断
    PRINT ""
    PRINT 【校准控制】
    IF $Seed校准方案 == 0
        PRINT Seed校准方案: 0 原始12轮绝对落点众数
        PRINT Seed修正规则: 首轮限幅快速靠近；第2轮限幅半量；第3轮起跟随12轮最终命中绝对落点众数
    ELIF $Seed校准方案 == 1
        PRINT Seed校准方案: 1 实验锁定与毫秒细调
        PRINT Seed修正规则: 大偏差限幅靠近；锁定后可信±1单轮直调；相邻参数反转立即取中点；细调后按同方向5轮3票二分
    ELSE
        PRINT Seed校准方案: 2 命中保持后的方向票接续
        PRINT Seed修正规则: 精确Seed后固定参数观察5次；不足3票或平票时保留已有±1方向票，继续补足后按多数方向固定半步
    ENDIF
    PRINT 帧修正规则: TV圈绝对偏差大于1照常校准；TV±1按同参数10轮5票；非目标Seed剩余帧±1冻结；目标Seed剩余帧±1按5轮3票
    PRINT 剩余帧校准允许: & $本轮剩余帧校准允许
    IF $本轮剩余帧校准允许 == 0
        PRINT 剩余帧校准门控: & $剩余帧校准门控文本
    ENDIF
    PRINT Seed真实簇: 中心 & $Seed路径中心 & " 窗 " & $Seed动态边界 & " 当前绝对落点 " & $Seed当前绝对落点 & " 偏离真实簇 " & $Seed偏离簇中心
    IF $Seed校准方案 == 0
        PRINT Seed校准众数: 样本数 & $Seed校准样本数 & "/12 目标绝对落点 " & $Seed校准目标绝对 & " 票数 " & $Seed校准目标票数 & " 当前累计 " & $Seed累计修正索引 & " 目标差 " & $Seed校准目标差
    ELSE
        PRINT Seed锁定窗口: 启用 & $Seed锁定启用 & " 新锁定 " & $Seed锁定本轮新启用 & " 参数累计修正 " & $Seed锁定参数累计修正 & " 精细 " & $Seed锁定参数精细修正MS & "ms 固定半步 " & $Seed精细固定半步MS & "ms 样本 " & $Seed锁定窗口样本数 & "/" & $Seed锁定窗口大小 & " 多数方向 " & $Seed锁定众数差 & " 票数 " & $Seed锁定众数票数 & " 方向票 -" & $Seed锁定负方向票数 & "/+" & $Seed锁定正方向票数 & " 保持 " & $Seed命中保持启用 & " 计数 " & $Seed命中保持计数 & "/" & $Seed命中保持样本数 & " 大波动忽略 " & $Seed锁定本轮大波动忽略 & " 触发 " & $Seed锁定本轮触发
        IF $Seed校准方案 == 2
            PRINT 方案2接续方向票: 启用 & $方案2Seed接续启用 & " 方向票 -" & $方案2Seed接续负方向票数 & "/+" & $方案2Seed接续正方向票数
        ENDIF
    ENDIF
    PRINT Seed修正模式: & $Seed修正模式文本
    PRINT Seed本次修正: 当前残差 & $命中差索引 & " 原始计划 " & $Seed本次修正原始 & " 限幅 " & $Seed本次修正限幅 & " 实际索引 " & $Seed本次修正索引 & " 精细 " & $Seed精细修正MS & "ms 本轮精细变化 " & $Seed精细本轮新增MS & "ms"

    IF $进入TV == 1
        PRINT TV帧真实簇: 中心 & $TV帧路径中心 & " 窗 " & $圈动态边界 & " 当前绝对落点 " & $TV帧当前绝对落点 & " 偏离真实簇 " & $TV帧偏离簇中心
        PRINT TV帧目标阻尼区: 中心0 窗 & $圈动态边界 & " 当前残差 " & $圈误差 & " 区内半量 " & $TV帧簇内 & " 余数 " & $TV帧修正余 & " 本次修正 " & $TV帧本次修正
        PRINT 剩余帧真实簇: 中心 & $剩余帧中心 & " 窗 " & $帧动态边界 & " 当前落点 " & $剩余帧当前落点 & " 偏离真实簇 " & $剩余帧偏离簇中心
        PRINT 剩余帧目标阻尼区: 中心0 窗 & $帧动态边界 & " 当前误差 " & $剩余帧误差 & " 区内半量 " & $剩余帧簇内 & " 余数 " & $帧修正余 & " 本次修正 " & $本次相位修正
    ELSE
        PRINT 帧真实簇: 中心 & $剩余帧中心 & " 窗 " & $帧动态边界 & " 当前绝对落点 " & $剩余帧当前落点 & " 偏离真实簇 " & $剩余帧偏离簇中心
        PRINT 帧目标阻尼区: 中心0 窗 & $帧动态边界 & " 当前残差 " & $剩余帧误差 & " 区内半量 " & $剩余帧簇内 & " 余数 " & $帧修正余 & " 本次修正 " & $本次相位修正
    ENDIF

    PRINT ""
    PRINT 【下轮预测】
    PRINT BINGO下轮命中预测: 启用 & $BINGO二维预测启用 & " Seed中心 " & $稳定簇Seed归一化 & " Seed窗 " & $Seed动态边界 & " 横轴中心 " & $稳定簇帧归一化 & " 横轴窗 " & $帧动态边界
    PRINT BINGO下轮命中预测公式: Seed来源 " & $Seed预测来源文本 & "，投影 " & $稳定簇Seed归一化 & "；帧残差 " & $剩余帧误差 & " - 本次修正 " & $本次相位修正 & " = " & $稳定簇帧归一化
    IF $BINGO二维预测启用 == 0
        PRINT BINGO下轮命中预测: Seed/剩余帧样本数不足2，本轮不显示ｏ
    ELIF $BINGO投影覆盖表格 == 1
        PRINT BINGO下轮命中预测: 横轴预测覆盖 -4..+4；Seed预测也覆盖表格时会显示ｏ
    ELSE
        PRINT BINGO下轮命中预测: 横轴预测未覆盖 -4..+4，表内不显示ｏ
    ENDIF
    IF $进入TV == 1
        PRINT TV帧下轮命中预测: 启用 & $BINGOTV帧预测启用 & " 中心 " & $TV帧预测投影 & " 窗 " & $圈动态边界
        PRINT TV帧下轮命中预测公式: TV帧残差 " & $圈误差 & " - 本次修正 " & $TV帧本次修正 & " = " & $TV帧预测投影
        IF $BINGOTV帧预测启用 == 0
            PRINT TV帧下轮命中预测: TV帧样本数不足2，本轮不显示ｏ
        ENDIF
    ENDIF
ENDFUNC

FUNC 输出TV帧预测条
    $TV帧预测格负4 = "．"
    $TV帧预测格负3 = "．"
    $TV帧预测格负2 = "．"
    $TV帧预测格负1 = "．"
    $TV帧预测格零 = "＋"
    $TV帧预测格正1 = "．"
    $TV帧预测格正2 = "．"
    $TV帧预测格正3 = "．"
    $TV帧预测格正4 = "．"

    IF $TV帧预测投影 == -4
        $TV帧预测格负4 = "ｏ"
    ELIF $TV帧预测投影 == -3
        $TV帧预测格负3 = "ｏ"
    ELIF $TV帧预测投影 == -2
        $TV帧预测格负2 = "ｏ"
    ELIF $TV帧预测投影 == -1
        $TV帧预测格负1 = "ｏ"
    ELIF $TV帧预测投影 == 0
        $TV帧预测格零 = "ｏ"
    ELIF $TV帧预测投影 == 1
        $TV帧预测格正1 = "ｏ"
    ELIF $TV帧预测投影 == 2
        $TV帧预测格正2 = "ｏ"
    ELIF $TV帧预测投影 == 3
        $TV帧预测格正3 = "ｏ"
    ELIF $TV帧预测投影 == 4
        $TV帧预测格正4 = "ｏ"
    ENDIF

    PRINT TV帧预测　－４－３－２－１　０＋１＋２＋３＋４
    PRINT "　　　　　" & $TV帧预测格负4 & "　" & $TV帧预测格负3 & "　" & $TV帧预测格负2 & "　" & $TV帧预测格负1 & "　" & $TV帧预测格零 & "　" & $TV帧预测格正1 & "　" & $TV帧预测格正2 & "　" & $TV帧预测格正3 & "　" & $TV帧预测格正4
    IF $TV帧预测投影 < -4 or $TV帧预测投影 > 4
        PRINT TV帧预测: & $TV帧预测投影 & "，超出 -4..+4 显示范围"
    ENDIF
ENDFUNC

FUNC 输出自动校准结果
    IF $调试日志输出 == 0
        PRINT 本轮结果: Seed & $命中Seed & "（偏差 " & $命中差索引 & "），消耗帧 " & $命中消耗帧 & "（偏差 " & $本轮消耗帧误差 & "）"
        PRINT 下轮请求: Seed & $SeedMS & " ms，F1 " & $F1等待帧 & "，TV " & $TV等待帧 & "，F2 " & $F2等待帧 & "，菜单 " & $帧轴菜单奇偶开关
        RETURN
    ENDIF
    PRINT ""
    PRINT 【Seed校准】
    PRINT 命中Seed: & $命中Seed
    PRINT 与目标Seed差: & $命中差索引 & "个seed"
    PRINT 目标SeedMS: & $目标SeedMS & " ms"
    PRINT 命中SeedMS: & $命中SeedMS & " ms"
    PRINT 当前SeedMS: & $SeedMS & " ms"
    PRINT 误差: & $本轮SeedMS误差 & " ms"
    PRINT 校准方案: & $Seed校准方案
    IF $Seed校准方案 == 0
        PRINT 校准众数目标: 绝对落点 & $Seed校准目标绝对 & " 票数 " & $Seed校准目标票数 & "/" & $Seed校准样本数
    ELSE
        PRINT 锁定窗口: 启用 & $Seed锁定启用 & " 参数累计修正 " & $Seed锁定参数累计修正 & " 样本 " & $Seed锁定窗口样本数 & "/" & $Seed锁定窗口大小
        PRINT Seed微调: 多数方向 & $Seed锁定众数差 & " 票数 " & $Seed锁定众数票数 & "；目标保持 " & $Seed命中保持启用 & " " & $Seed命中保持计数 & "/" & $Seed命中保持样本数 & " 触发 " & $Seed锁定本轮触发
        IF $Seed校准方案 == 2
            PRINT 方案2接续方向票: 启用 & $方案2Seed接续启用 & " 方向票 -" & $方案2Seed接续负方向票数 & "/+" & $方案2Seed接续正方向票数
        ENDIF
    ENDIF
    PRINT 修正模式: & $Seed修正模式文本
    IF $Seed校准方案 == 1 or $Seed校准方案 == 2
        PRINT 毫秒细调: 启用 & $Seed精细校准启用 & " 基准累计索引 " & $Seed精细基准累计修正 & " 区间 " & $Seed精细下界MS & ".." & $Seed精细上界MS & " ms 当前 " & $Seed精细修正MS & " ms 方向票 -" & $Seed锁定负方向票数 & "/+" & $Seed锁定正方向票数
    ENDIF
    IF $Seed本次修正限幅 == 1
        PRINT 单轮限幅: 原始计划 & $Seed本次修正原始 & " → 实际 " & $Seed本次修正索引
    ENDIF
    PRINT 本次修正(索引): & $Seed本次修正索引 & " 累计 " & $Seed累计修正索引
    PRINT 新增修正量(查表): & $SeedMS本次新增修正量 & " ms"
    PRINT 累计修正量(查表): & $SeedMS实际执行修正量 & " ms"
    PRINT 下轮Seed请求: & $SeedMS & " ms"

    PRINT ""
    PRINT 【消耗帧校准】
    PRINT 目标消耗帧: & $目标消耗帧 & " 帧"
    PRINT 命中消耗帧: & $命中消耗帧 & " 帧"
    PRINT 误差: & $本轮消耗帧误差 & " 帧"
    IF $进入TV == 1
        PRINT 剩余帧落点(0..周期-1): & $剩余帧当前落点 & "；剩余帧误差 " & $消耗帧归一化误差 & " 帧"
        PRINT TV帧修正: & $TV帧本次修正 & " TV帧，余数 " & $TV帧修正余
        IF $TV双分支本轮抑制 == 1
            PRINT TV整圈修正: 双分支锁定，本轮不累计±314；跟踪等待帧 & $TV双分支跟踪等待帧
        ELIF $TV帧慢修正触发 == 1
            PRINT TV整圈修正: 同参数窗口持续偏差 & $TV帧慢修正当前票数 & "/" & $TV帧慢修正触发票数 & "票，本轮修正" & $TV帧本次修正 & "圈"
        ELIF $圈误差绝对 == 1
            PRINT TV整圈修正: 单次±1圈冻结；同偏差票 & $TV帧慢修正当前票数 & "/" & $TV帧慢修正触发票数
        ENDIF
        PRINT 剩余帧修正: & $本次相位修正 & " 帧，余数 " & $帧修正余
        PRINT 合成帧修正: TV帧 & $TV帧本次修正 & "*" & $TV单次消耗帧 & " + 剩余帧 " & $本次相位修正 & " = " & $消耗帧本次新增修正量 & " 帧"
        $TV真帧显示 = 投票取真帧()
        PRINT TV合成真帧(TV帧×周期+剩余帧误差): & $TV真帧显示 & " 帧"
    ELSE
        PRINT 帧误差修正: & $本次相位修正 & " 帧，余数 " & $帧修正余
    ENDIF
    IF $剩余帧慢修正触发 == 1
        PRINT 修正: 目标Seed最近& $剩余帧慢修正窗口大小 & "个绝对相位样本投影后同偏差达到" & $剩余帧慢修正当前票数 & "票，慢修正" & $本次相位修正 & "帧"
    ELIF $本轮剩余帧抖动冻结 == 1
        PRINT 修正: 目标Seed稳态±1帧视为相位抖动；本轮不修正并清空半量余数
    ELIF $本轮剩余帧校准允许 == 1
        PRINT 修正: 目标阻尼区内半量带余数；区外全量并清本轴余数
    ELSE
        PRINT 修正: 非目标Seed剩余帧±1冻结；TV整圈按独立规则判断
    ENDIF
    PRINT 新增修正量: & $消耗帧本次新增修正量 & " 帧"
    PRINT 累计修正量: & $消耗帧实际执行修正量 & " 帧"
    # 诊断：打印直方图票表(各表非零槽)+滑动窗命中样本，供分析多堆/多簇实际分布
    $投票忽略 = 投票打印直方图($进入TV)
    CALL 输出BINGO
ENDFUNC

FUNC 输出本轮校准决策
    IF $调试日志输出 == 0
        RETURN
    ENDIF
    PRINT ""
    PRINT 【本轮校准决策】
    PRINT 候选数: & $本轮候选命中计数
    PRINT 候选全部同一消耗帧: & $候选全部同一消耗帧
    PRINT 候选全部同一Seed: & $候选全部同一Seed
    PRINT SeedMS误差: & $本轮SeedMS误差 & " ms"
    PRINT 真实消耗帧误差: & $本轮消耗帧误差 & " 帧"
    IF $进入TV == 1
        PRINT 剩余帧落点: & $剩余帧当前落点 & " 剩余帧误差: " & $消耗帧归一化误差 & " TV帧当前: " & $TV帧当前绝对落点
    ELSE
        PRINT 帧误差: & $消耗帧归一化误差 & " 帧"
    ENDIF
    PRINT Seed偏离预测中心: & $Seed本轮偏离中心 & "个seed；可信样本数 " & $Seed可信样本数 & " 可信窗 " & $Seed可信窗
    IF $进入TV == 1
        PRINT 剩余帧偏离预测中心: & $消耗帧本轮偏离中心 & " 帧；可信样本数 " & $剩余帧可信样本数 & " 可信窗 " & $剩余帧可信窗
        PRINT TV帧偏离预测中心: & $TV帧偏离簇中心 & " TV帧；可信样本数 " & $TV帧可信样本数 & " 可信窗 " & $TV帧可信窗
    ELSE
        PRINT 帧偏离预测中心: & $消耗帧本轮偏离中心 & " 帧；可信样本数 " & $剩余帧可信样本数 & " 可信窗 " & $剩余帧可信窗
    ENDIF
    PRINT ""
    PRINT 【本轮计入判定】
    PRINT Seed可信: & $Seed本轮可信
    IF $Seed强可信来源 != ""
        PRINT Seed强可信来源: & $Seed强可信来源
    ENDIF
    PRINT 剩余帧可信: & $剩余帧本轮可信
    IF $进入TV == 1
        PRINT TV帧可信: & $TV帧本轮可信
        PRINT TV帧表计入: & $TV帧本轮可信 & "（TV整圈独立于小幅剩余帧门控）"
    ENDIF
    PRINT 消耗帧最终可信: & $消耗帧本轮可信
    PRINT 帧命中保持: 启用 & $帧命中保持启用 & " 计数 " & $帧命中保持计数 & "/" & $帧命中保持样本数 & " 本轮刷新 " & $帧命中保持本轮刷新 & " 本轮抑制 " & $帧命中保持本轮抑制
    PRINT 剩余帧校准允许: & $本轮剩余帧校准允许
    IF $进入TV == 1
        PRINT TV帧慢修正: 参数窗样本 & $TV帧慢修正窗口样本数 & "/" & $TV帧慢修正窗口大小 & " 当前圈偏差票 " & $TV帧慢修正当前票数 & "/" & $TV帧慢修正触发票数 & " 触发 " & $TV帧慢修正触发
    ENDIF
    PRINT 剩余帧慢修正: 目标Seed绝对相位窗样本 & $剩余帧慢修正窗口样本数 & "/" & $剩余帧慢修正窗口大小 & " 当前投影偏差票 " & $剩余帧慢修正当前票数 & "/" & $剩余帧慢修正触发票数 & " 触发 " & $剩余帧慢修正触发
    PRINT 剩余帧慢修正当前投影参数: 累计修正 & $剩余帧慢修正参数累计修正 & " F1 " & $剩余帧慢修正参数F1 & " TV " & $剩余帧慢修正参数TV & " F2 " & $剩余帧慢修正参数F2
    IF $本轮剩余帧校准允许 == 0
        PRINT 剩余帧校准门控: & $剩余帧校准门控文本
    ENDIF
    IF $消耗帧强可信来源 != ""
        PRINT 消耗帧强可信来源: & $消耗帧强可信来源
    ENDIF
    PRINT 本轮真值解: & $本轮真值解
    PRINT Seed收敛: & $SeedMS本轮收敛
    PRINT 消耗帧收敛: & $消耗帧本轮收敛
    IF $本轮剩余帧校准允许 == 0
        PRINT 原因: Seed轴和TV整圈照常校准；非目标Seed的小幅VBlank差异不追踪
    ELIF $Seed本轮可信 == 1 and $消耗帧本轮可信 == 1
        PRINT 原因: Seed与消耗帧各轴命中均在可信窗内，BINGO表内命中会计入
    ELIF $Seed本轮可信 == 0 and $消耗帧本轮可信 == 1
        PRINT 原因: Seed命中偏离路径可信窗：Seed轴只观察，不写窗、不下发修正
    ELIF $Seed本轮可信 == 1 and $消耗帧本轮可信 == 0
        PRINT 原因: 消耗帧至少一轴偏离路径可信窗：不可信帧轴只观察，不写窗、不下发修正
    ELSE
        PRINT 原因: Seed与消耗帧均偏离路径可信窗：各不可信轴只观察，不写窗、不下发修正
    ENDIF
ENDFUNC

FUNC 输出下一轮等待参数
    IF $调试日志输出 == 0
        PRINT 本轮请求: Seed & $SeedMS & " ms，F1 " & $F1等待帧 & "，TV " & $TV等待帧 & "，F2 " & $F2等待帧 & "，菜单 " & $帧轴菜单奇偶开关
        RETURN
    ENDIF
    PRINT ""
    PRINT 【等待帧】
    PRINT F1等待帧: & $F1等待帧 & " 帧"
    IF $进入TV == 1
        PRINT TV等待帧: & $TV等待帧 & " 帧"
    ENDIF
    PRINT F2等待帧: & $F2等待帧 & " 帧"
    PRINT 帧奇偶修正: 方案 & $帧奇偶修正方案 & "，菜单 " & $帧轴菜单奇偶开关
    IF $帧奇偶修正方案 == 0
        PRINT "方案0奇偶状态: 下轮偏移 +" & $方案0奇偶当前偏移 & "，本轮执行 +" & $方案0奇偶本轮执行偏移 & "，累计不一致 " & $方案0奇偶失败次数 & "，已拉黑至 +" & $方案0奇偶已拉黑最大偏移 & "，本轮升级 " & $方案0奇偶本轮升级
    ELSE
        PRINT "菜单保持剩余轮数: " & $帧轴菜单保持剩余轮数
    ENDIF
ENDFUNC

# ==================================================
# 临时RNG前进一次
#
# 输入：
#   $临HI
#   $临LO
#
# 输出：
#   $临HI
#   $临LO
#   $临RAND
# ==================================================

FUNC 临时RNG前进一次
    $新HI = RNG下一HI($临HI, $临LO)
    $新LO = RNG下一LO($临HI, $临LO)

    $临HI = $新HI
    $临LO = $新LO
    $临RAND = $临HI
ENDFUNC

# ==================================================
# 按算法生成个体
#
# 输入：
#   $候HI
#   $候LO
#   $反查算法
#   $野生PID尝试上限
#
# 输出：
#   $PIDLO
#   $PIDHI
#   $IV1
#   $IV2
#   $个体性格
#   $个体性别
#   $个体HPIV / ATK / DEF / SPA / SPD / SPE
# ==================================================

FUNC 按算法生成个体
    $临HI = $候HI
    $临LO = $候LO

    $野生遇敌值 = 0
    $野生等级值 = 0
    $野生锁定性格 = -1
    $野生PID尝试 = 0
    $野生PID找到 = 1

    IF $当前反查算法 == 1
        # Static1:
        # RNG1 -> PIDLO
        # RNG2 -> PIDHI
        # RNG3 -> IV1
        # RNG4 -> IV2

        CALL 临时RNG前进一次
        $PIDLO = $临RAND

        CALL 临时RNG前进一次
        $PIDHI = $临RAND

        CALL 临时RNG前进一次
        $IV1 = $临RAND

        CALL 临时RNG前进一次
        $IV2 = $临RAND

    ELIF $当前反查算法 == 2
        # Static2:
        # RNG1 -> PIDLO
        # RNG2 -> PIDHI
        # RNG3 -> skip
        # RNG4 -> IV1
        # RNG5 -> IV2

        CALL 临时RNG前进一次
        $PIDLO = $临RAND

        CALL 临时RNG前进一次
        $PIDHI = $临RAND

        CALL 临时RNG前进一次
        $跳过RAND = $临RAND

        CALL 临时RNG前进一次
        $IV1 = $临RAND

        CALL 临时RNG前进一次
        $IV2 = $临RAND

    ELIF $当前反查算法 == 4
        # Static4:
        # RNG1 -> PIDLO
        # RNG2 -> PIDHI
        # RNG3 -> IV1
        # RNG4 -> skip
        # RNG5 -> IV2

        CALL 临时RNG前进一次
        $PIDLO = $临RAND

        CALL 临时RNG前进一次
        $PIDHI = $临RAND

        CALL 临时RNG前进一次
        $IV1 = $临RAND

        CALL 临时RNG前进一次
        $跳过RAND = $临RAND

        CALL 临时RNG前进一次
        $IV2 = $临RAND

    ELIF $当前反查算法 == 101
        # Wild1:
        # RNG1 -> encounter slot
        # RNG2 -> level
        # RNG3 -> nature lock
        # PID循环直到 PID % 25 == nature lock
        # RNG -> IV1
        # RNG -> IV2

        CALL 临时RNG前进一次
        $野生遇敌值 = $临RAND

        CALL 临时RNG前进一次
        $野生等级值 = $临RAND

        CALL 临时RNG前进一次
        $野生锁定性格 = $临RAND % 25

        $野生PID找到 = 0

        FOR $野生PID尝试 = 1 TO $野生PID尝试上限
            CALL 临时RNG前进一次
            $PIDLO = $临RAND

            CALL 临时RNG前进一次
            $PIDHI = $临RAND

            $个体性格 = Static_性格($PIDHI, $PIDLO)

            IF $个体性格 == $野生锁定性格
                $野生PID找到 = 1
                BREAK
            ENDIF
        NEXT

        IF $野生PID找到 == 1
            CALL 临时RNG前进一次
            $IV1 = $临RAND

            CALL 临时RNG前进一次
            $IV2 = $临RAND
        ELSE
            $PIDLO = 0
            $PIDHI = 0
            $IV1 = 0
            $IV2 = 0
        ENDIF

    ELIF $当前反查算法 == 102
        # Wild2:
        # RNG1 -> encounter slot
        # RNG2 -> level
        # RNG3 -> nature lock
        # PID循环
        # RNG -> skip
        # RNG -> IV1
        # RNG -> IV2

        CALL 临时RNG前进一次
        $野生遇敌值 = $临RAND

        CALL 临时RNG前进一次
        $野生等级值 = $临RAND

        CALL 临时RNG前进一次
        $野生锁定性格 = $临RAND % 25

        $野生PID找到 = 0

        FOR $野生PID尝试 = 1 TO $野生PID尝试上限
            CALL 临时RNG前进一次
            $PIDLO = $临RAND

            CALL 临时RNG前进一次
            $PIDHI = $临RAND

            $个体性格 = Static_性格($PIDHI, $PIDLO)

            IF $个体性格 == $野生锁定性格
                $野生PID找到 = 1
                BREAK
            ENDIF
        NEXT

        IF $野生PID找到 == 1
            CALL 临时RNG前进一次
            $跳过RAND = $临RAND

            CALL 临时RNG前进一次
            $IV1 = $临RAND

            CALL 临时RNG前进一次
            $IV2 = $临RAND
        ELSE
            $PIDLO = 0
            $PIDHI = 0
            $IV1 = 0
            $IV2 = 0
        ENDIF

    ELIF $当前反查算法 == 104
        # Wild4:
        # RNG1 -> encounter slot
        # RNG2 -> level
        # RNG3 -> nature lock
        # PID循环
        # RNG -> IV1
        # RNG -> skip
        # RNG -> IV2

        CALL 临时RNG前进一次
        $野生遇敌值 = $临RAND

        CALL 临时RNG前进一次
        $野生等级值 = $临RAND

        CALL 临时RNG前进一次
        $野生锁定性格 = $临RAND % 25

        $野生PID找到 = 0

        FOR $野生PID尝试 = 1 TO $野生PID尝试上限
            CALL 临时RNG前进一次
            $PIDLO = $临RAND

            CALL 临时RNG前进一次
            $PIDHI = $临RAND

            $个体性格 = Static_性格($PIDHI, $PIDLO)

            IF $个体性格 == $野生锁定性格
                $野生PID找到 = 1
                BREAK
            ENDIF
        NEXT

        IF $野生PID找到 == 1
            CALL 临时RNG前进一次
            $IV1 = $临RAND

            CALL 临时RNG前进一次
            $跳过RAND = $临RAND

            CALL 临时RNG前进一次
            $IV2 = $临RAND
        ELSE
            $PIDLO = 0
            $PIDHI = 0
            $IV1 = 0
            $IV2 = 0
        ENDIF

    ELSE
        PRINT ""
        PRINT 未支持的反查算法: & $当前反查算法
        $野生PID找到 = 0
        RETURN
    ENDIF

    # Wild 没找到合法 PID，则给必不匹配状态
    IF $野生PID找到 == 0
        $个体性格 = -1
        $个体性别 = -1
        $个体HPIV = 0
        $个体ATKIV = 0
        $个体DEFIV = 0
        $个体SPAIV = 0
        $个体SPDIV = 0
        $个体SPEIV = 0
        RETURN
    ENDIF

    # Static 算法需要在这里计算性格
    IF $当前反查算法 == 1
        $个体性格 = Static_性格($PIDHI, $PIDLO)
    ELIF $当前反查算法 == 2
        $个体性格 = Static_性格($PIDHI, $PIDLO)
    ELIF $当前反查算法 == 4
        $个体性格 = Static_性格($PIDHI, $PIDLO)
    ENDIF

    $个体性别 = Static_性别($PIDLO, $性别阈值)

    # 游走IV Bug（FRLG雷公/炎帝/水君）：IV1 只保留低8位，IV2 强制为0
    # 实际效果：HP 0-31，ATK 0-7，DEF/SPA/SPD/SPE 必为 0
    IF $目标全国图鉴编号 == 243 or $目标全国图鉴编号 == 244 or $目标全国图鉴编号 == 245
        $IV1 = $IV1 % 256
        $IV2 = 0
    ENDIF

    $个体HPIV = Static_HPIV($IV1)
    $个体ATKIV = Static_ATKIV($IV1)
    $个体DEFIV = Static_DEFIV($IV1)

    $个体SPEIV = Static_SPEIV($IV2)
    $个体SPAIV = Static_SPAIV($IV2)
    $个体SPDIV = Static_SPDIV($IV2)
ENDFUNC

FUNC IV是否在范围($个体IV: INT, $最小IV: INT, $最大IV: INT): INT
    IF $个体IV < $最小IV
        RETURN 0
    ENDIF

    IF $个体IV > $最大IV
        RETURN 0
    ENDIF

    RETURN 1
ENDFUNC

FUNC 检查是否匹配
    $匹配 = 1

    # TenLines Wild 反查先校验遇敌槽对应的物种和等级。缺少这一步时，
    # 其他物种仅凭性格/性别/IV也可能被误认成目标Seed与目标帧。
    IF $当前反查算法 >= 101 and $野生槽验证启用 == 1
        $野生遇敌百分值 = $野生遇敌值 % 100
        $野生遇敌槽 = $当前野生百分槽表[$野生遇敌百分值]
        IF $野生遇敌槽 < 0
            $匹配 = 0
        ELSE
            $野生候选打包值 = $当前野生槽打包表[$野生遇敌槽]
            $野生候选图鉴编号 = $野生候选打包值 % 512
            IF $野生候选图鉴编号 != $目标全国图鉴编号
                $匹配 = 0
            ENDIF

            $野生候选最低等级 = ($野生候选打包值 / 512) % 128
            $野生候选最高等级 = ($野生候选打包值 / 65536) % 128
            IF $野生候选最低等级 > 0
                $野生候选等级范围 = $野生候选最高等级 - $野生候选最低等级 + 1
                $野生候选等级 = $野生候选最低等级 + ($野生等级值 % $野生候选等级范围)
                IF $野生候选等级 != $野生遭遇初始等级
                    $匹配 = 0
                ENDIF
            ENDIF
        ENDIF
    ENDIF

    IF $个体性格 != $识图性格
        $匹配 = 0
    ENDIF

    IF $识图性别 != -1
        IF $个体性别 != $识图性别
            $匹配 = 0
        ENDIF
    ENDIF

    $IV在范围 = IV是否在范围($个体HPIV, $HP最小, $HP最大)
    IF $IV在范围 == 0
        $匹配 = 0
    ENDIF

    $IV在范围 = IV是否在范围($个体ATKIV, $ATK最小, $ATK最大)
    IF $IV在范围 == 0
        $匹配 = 0
    ENDIF

    $IV在范围 = IV是否在范围($个体DEFIV, $DEF最小, $DEF最大)
    IF $IV在范围 == 0
        $匹配 = 0
    ENDIF

    $IV在范围 = IV是否在范围($个体SPAIV, $SPA最小, $SPA最大)
    IF $IV在范围 == 0
        $匹配 = 0
    ENDIF

    $IV在范围 = IV是否在范围($个体SPDIV, $SPD最小, $SPD最大)
    IF $IV在范围 == 0
        $匹配 = 0
    ENDIF

    $IV在范围 = IV是否在范围($个体SPEIV, $SPE最小, $SPE最大)
    IF $IV在范围 == 0
        $匹配 = 0
    ENDIF
ENDFUNC

FUNC 重置本轮候选状态
    IF $跨组筛选收集启用 == 1
        CALL 共同区开始扫描
    ENDIF
    $本轮候选命中计数 = 0
    $找到个体 = 0
    $候选同一消耗帧有效 = 0
    $候选同一消耗帧 = -1
    $候选全部同一消耗帧 = 0
    $候选同一Seed有效 = 0
    $候选同一Seed值 = 0
    $候选全部同一Seed = 0
    $允许更新SeedMS本轮 = 1
    $允许更新消耗帧本轮 = 1

    $最佳候选有效 = 0
    $最佳候选离群 = 0
    $最佳候选距离 = 30000
    $当前候选距离 = 0
    $最佳候选Seed距离 = 30000
    $当前候选Seed距离 = 0
    $最佳候选TV帧距离 = 30000
    $最佳候选剩余帧距离 = 30000
    $当前候选TV帧距离 = 0
    $当前候选剩余帧离群 = 0
    $当前候选Seed离群 = 0
    $当前候选TV帧离群 = 0
    $最佳候选剩余帧离群 = 0
    $最佳候选Seed离群 = 0
    $最佳候选TV帧离群 = 0

    $命中SeedMS = -1
    $命中消耗帧 = -1
    $命中Seed索引 = -1
    $命中Seed = ""

    $命中反查算法 = 0
    $命中差索引 = 0

    $命中个体性格 = 0
    $命中个体性别 = 0

    $命中HPIV = 0
    $命中ATKIV = 0
    $命中DEFIV = 0
    $命中SPAIV = 0
    $命中SPDIV = 0
    $命中SPEIV = 0

    $命中野生锁定性格 = 0
    $命中野生PID尝试 = 0
ENDFUNC

FUNC 处理匹配候选
    IF $匹配 != 1
        RETURN
    ENDIF

    $找到个体 = 1
    $本轮候选命中计数 += 1

    IF $候选同一消耗帧有效 == 0
        $候选同一消耗帧 = $当前消耗帧
        $候选同一消耗帧有效 = 1
        $候选全部同一消耗帧 = 1
    ELIF $当前消耗帧 != $候选同一消耗帧
        $候选全部同一消耗帧 = 0
    ENDIF

    # 追踪候选间 Seed 距离是否一致（同帧多解时 Seed 常不一致，不可信）
    IF $候选同一Seed有效 == 0
        $候选同一Seed值 = $差索引
        $候选同一Seed有效 = 1
        $候选全部同一Seed = 1
    ELIF $差索引 != $候选同一Seed值
        $候选全部同一Seed = 0
    ENDIF

    # 候选投票：投进自洽模块 lib/25。传【原始帧误差】(未折叠)给模块自行做圈/相位分解(TV双投票)；
    # 绝对偏差=原始帧误差+已累计帧修正，对真路径跨轮恒定。模块按 $候选全部同一Seed 切联合 key(自适应联合)。
    $当前候选帧原始 = $当前消耗帧 - $目标消耗帧
    IF $跨组筛选收集启用 == 1
        $投票忽略 = 共同区收集($游戏版本, $种子索引, $Seed累计修正索引, $当前消耗帧, $消耗帧实际执行修正量, $NXSeed平台偏移MS)
    ENDIF
    $投票忽略 = 投票投候选($差索引, $当前候选帧原始, $Seed累计修正索引, $消耗帧实际执行修正量, $候选全部同一Seed, $进入TV, $TV单次消耗帧)

    # 路径一致性选择：候选绝对落点贴近最近6轮自适应簇中心。TV剩余帧使用非负落点+环形距离。
    $当前候选绝对帧 = $当前候选帧原始 + $消耗帧实际执行修正量
    IF $进入TV == 1
        $当前候选剩余帧落点 = $当前候选绝对帧 % $TV单次消耗帧
        IF $当前候选剩余帧落点 < 0
            $当前候选剩余帧落点 = $当前候选剩余帧落点 + $TV单次消耗帧
        ENDIF
        $当前候选剩余帧中心 = 投票取剩余帧中心()
        $当前候选距离 = 模周期归一($当前候选剩余帧落点 - $当前候选剩余帧中心, $TV单次消耗帧)
        IF $当前候选距离 < 0
            $当前候选距离 = 0 - $当前候选距离
        ENDIF
        $当前候选TV帧落点 = 带符号整除四舍五入($当前候选绝对帧, $TV单次消耗帧)
        $当前候选TV帧距离 = $当前候选TV帧落点 - 投票取TV帧中心()
        IF $当前候选TV帧距离 < 0
            $当前候选TV帧距离 = 0 - $当前候选TV帧距离
        ENDIF
    ELSE
        $当前候选距离 = $当前候选绝对帧 - 投票取剩余帧中心()
        IF $当前候选距离 < 0
            $当前候选距离 = 0 - $当前候选距离
        ENDIF
        $当前候选TV帧距离 = 0
    ENDIF

    $当前候选Seed距离 = $差索引 + $Seed累计修正索引 - $Seed路径中心
    IF $当前候选Seed距离 < 0
        $当前候选Seed距离 = 0 - $当前候选Seed距离
    ENDIF

    # 加权平方距离：Seed + 剩余帧；TV模式额外加入TV帧距离，避免只贴相位而选错TV帧。
    $当前候选MSE = 候选MSE评分($当前候选Seed距离, $当前候选距离, $候选权重Seed, $候选权重帧)
    IF $进入TV == 1
        $当前候选MSE = $当前候选MSE + $当前候选TV帧距离 * $当前候选TV帧距离 * $候选权重帧
    ENDIF
    IF $御三家严格筛选 == 1
        $当前候选MSE = $当前候选MSE + 共同区候选加权距离($种子索引 + $Seed累计修正索引, $当前消耗帧 + $消耗帧实际执行修正量, $候选权重Seed, $候选权重帧)
    ENDIF
    # NPC离群过滤：帧 或 Seed 任一维偏离簇中心过远即离群孤票。非离群优先；同离群状态再比 MSE
    $当前候选剩余帧离群 = 投票候选是否离群($当前候选帧原始, $消耗帧实际执行修正量, $进入TV)
    $当前候选Seed离群 = 投票Seed候选是否离群($差索引, $Seed累计修正索引)
    $当前候选TV帧离群 = 投票TV帧候选是否离群($当前候选帧原始, $消耗帧实际执行修正量, $进入TV)
    $当前候选离群 = $当前候选剩余帧离群
    IF $当前候选Seed离群 == 1
        $当前候选离群 = 1
    ENDIF
    IF $当前候选TV帧离群 == 1
        $当前候选离群 = 1
    ENDIF
    IF $最佳候选有效 == 0
        CALL 记录当前候选为最佳候选
        $最佳候选离群 = $当前候选离群
    ELIF $最佳候选离群 == 1 and $当前候选离群 == 0
        CALL 记录当前候选为最佳候选
        $最佳候选离群 = 0
    ELIF $最佳候选离群 == $当前候选离群 and $当前候选MSE < $最佳候选MSE
        CALL 记录当前候选为最佳候选
        $最佳候选离群 = $当前候选离群
    ENDIF
ENDFUNC

FUNC 记录当前候选为最佳候选
    $最佳候选有效 = 1
    $最佳候选距离 = $当前候选距离
    $最佳候选Seed距离 = $当前候选Seed距离
    $最佳候选剩余帧距离 = $当前候选距离
    $最佳候选TV帧距离 = $当前候选TV帧距离
    $最佳候选剩余帧离群 = $当前候选剩余帧离群
    $最佳候选Seed离群 = $当前候选Seed离群
    $最佳候选TV帧离群 = $当前候选TV帧离群
    $最佳候选MSE = $当前候选MSE

    $命中SeedMS = $当前MS
    $命中消耗帧 = $当前消耗帧
    $命中Seed索引 = $种子索引
    $命中Seed = $当前Seed

    $命中反查算法 = $当前反查算法
    $命中差索引 = $差索引

    $命中个体性格 = $个体性格
    $命中个体性别 = $个体性别

    $命中HPIV = $个体HPIV
    $命中ATKIV = $个体ATKIV
    $命中DEFIV = $个体DEFIV
    $命中SPAIV = $个体SPAIV
    $命中SPDIV = $个体SPDIV
    $命中SPEIV = $个体SPEIV

    $命中野生锁定性格 = $野生锁定性格
    $命中野生PID尝试 = $野生PID尝试
ENDFUNC

FUNC 输出最佳命中结果
    IF $最佳候选有效 != 1
        RETURN
    ENDIF

    $个体性别文本 = 性别文本($命中个体性别)
    $个体性格文本 = 性格文本($命中个体性格)
    $反查算法文本 = 反查算法文本($命中反查算法)

    PRINT ""
    IF $调试日志输出 == 0
        PRINT 命中候选: & $个体性格文本 & "，" & $个体性别文本 & "；IV " & $命中HPIV & "/" & $命中ATKIV & "/" & $命中DEFIV & "/" & $命中SPAIV & "/" & $命中SPDIV & "/" & $命中SPEIV
        RETURN
    ENDIF
    PRINT 【命中个体】
    PRINT 反查算法: & $反查算法文本
    PRINT 性格: & $个体性格文本
    PRINT 性别: & $个体性别文本

    PRINT ""
    PRINT 【命中IV】
    PRINT HP: & $命中HPIV
    PRINT ATK: & $命中ATKIV
    PRINT DEF: & $命中DEFIV
    PRINT SPA: & $命中SPAIV
    PRINT SPD: & $命中SPDIV
    PRINT SPE: & $命中SPEIV
ENDFUNC

FUNC 关闭游戏
    FOR
        IF @主页 < 95 and @主页_NS2 < 95
            HOME 100
            1500
        ENDIF
        IF (@正确退出 >= 95 or @HOME_BUFFER正确退出 >= 95) or (@正确退出_NS2 >= 95 or @HOME_BUFFER正确退出_NS2 >= 95)
            IF $调试日志输出 == 1
                PRINT 第一次退出正确
            ENDIF
            X
            1500
            A
            1500
            PRINT "FRLG_STAGE|BEGIN|shutdown.await_close|shutdown.await_close|60000|NS火叶全自动一键乱数2.0.ecs|关闭游戏|main.shutdown.await_close|manual_prepare_then_restart|OR;正在关闭.IL:>=:95,正在关闭_暗.IL:>=:95|!"
            FOR
                IF @正在关闭 >= 95 or @正在关闭_暗 >= 95
                    WAIT 2000
                ELSE
                    BREAK
                ENDIF
            NEXT
            PRINT "FRLG_STAGE|END|shutdown.await_close|!"
            RETURN
        ELIF @错误退出 >= 95 or @错误退出_NS2 >= 95
            PRINT 错误进入休眠菜单
            B
            1500
            CONTINUE
        ELSE
            IF $调试日志输出 == 1
                PRINT 游戏外启动
            ENDIF
            RETURN
        ENDIF
    NEXT
ENDFUNC

# 1.6.4-a HOME_BUFFER 稳定低分自适应：默认关闭，仅在当前主机标签连续稳定时降低本次运行阈值。
FUNC HOME_BUFFER识别稳定状态($只使用当前NX: INT): INT
    $HOME_BUFFER自适应首次状态 = 0
    $HOME_BUFFER自适应首次分数 = 0

    FOR $HOME_BUFFER自适应采样 = 1 TO $HOME_BUFFER自适应稳定要求
        IF $HOME_BUFFER自适应采样 > 1
            WAIT 200
        ENDIF

        $HOME_BUFFER当前正确退出 = @HOME_BUFFER正确退出
        $HOME_BUFFER当前正确退出_NS2 = @HOME_BUFFER正确退出_NS2
        $HOME_BUFFER当前正确退出普通 = @正确退出
        $HOME_BUFFER当前正确退出普通_NS2 = @正确退出_NS2
        $HOME_BUFFER当前错误退出 = @错误退出
        $HOME_BUFFER当前错误退出_NS2 = @错误退出_NS2

        IF $只使用当前NX == 1
            IF $NX机型 == 1
                $HOME_BUFFER选中正确 = $HOME_BUFFER当前正确退出
                $HOME_BUFFER选中普通 = $HOME_BUFFER当前正确退出普通
                $HOME_BUFFER选中错误 = $HOME_BUFFER当前错误退出
            ELSE
                $HOME_BUFFER选中正确 = $HOME_BUFFER当前正确退出_NS2
                $HOME_BUFFER选中普通 = $HOME_BUFFER当前正确退出普通_NS2
                $HOME_BUFFER选中错误 = $HOME_BUFFER当前错误退出_NS2
            ENDIF
        ELSE
            $HOME_BUFFER选中正确 = $HOME_BUFFER当前正确退出
            IF $HOME_BUFFER当前正确退出_NS2 > $HOME_BUFFER选中正确
                $HOME_BUFFER选中正确 = $HOME_BUFFER当前正确退出_NS2
            ENDIF
            $HOME_BUFFER选中普通 = $HOME_BUFFER当前正确退出普通
            IF $HOME_BUFFER当前正确退出普通_NS2 > $HOME_BUFFER选中普通
                $HOME_BUFFER选中普通 = $HOME_BUFFER当前正确退出普通_NS2
            ENDIF
            $HOME_BUFFER选中错误 = $HOME_BUFFER当前错误退出
            IF $HOME_BUFFER当前错误退出_NS2 > $HOME_BUFFER选中错误
                $HOME_BUFFER选中错误 = $HOME_BUFFER当前错误退出_NS2
            ENDIF
        ENDIF

        IF $调试日志输出 == 1
            PRINT "HOME_BUFFER_LABEL|NX_MODE=" & $只使用当前NX & "|NX=" & $NX机型 & "|BUFFER=" & $HOME_BUFFER选中正确 & "|NORMAL=" & $HOME_BUFFER选中普通 & "|ERROR=" & $HOME_BUFFER选中错误 & "|NS1_BUFFER=" & $HOME_BUFFER当前正确退出 & "|NS2_BUFFER=" & $HOME_BUFFER当前正确退出_NS2 & "|THRESHOLD=" & $HOME_BUFFER有效识图阈值 & "|ADAPTIVE=" & $HOME_BUFFER稳定低分自适应 & "|SAMPLE=" & $HOME_BUFFER自适应采样
        ENDIF

        # 95 分及以上保持 2.0 的判断优先级：BUFFER、ERROR、NORMAL。
        IF $HOME_BUFFER选中正确 >= $HOME_BUFFER有效识图阈值
            RETURN 1
        ELIF $HOME_BUFFER选中错误 >= $HOME_BUFFER有效识图阈值
            RETURN 3
        ELIF $HOME_BUFFER选中普通 >= $HOME_BUFFER有效识图阈值
            RETURN 2
        ENDIF

        IF $HOME_BUFFER稳定低分自适应 == 0
            RETURN 0
        ENDIF

        # 低分自适应只接受唯一最高标签；并列时不降低阈值。
        $HOME_BUFFER自适应候选状态 = 0
        $HOME_BUFFER自适应候选分数 = 0
        IF $HOME_BUFFER选中正确 > $HOME_BUFFER选中普通 and $HOME_BUFFER选中正确 > $HOME_BUFFER选中错误
            $HOME_BUFFER自适应候选状态 = 1
            $HOME_BUFFER自适应候选分数 = $HOME_BUFFER选中正确
        ELIF $HOME_BUFFER选中错误 > $HOME_BUFFER选中正确 and $HOME_BUFFER选中错误 > $HOME_BUFFER选中普通
            $HOME_BUFFER自适应候选状态 = 3
            $HOME_BUFFER自适应候选分数 = $HOME_BUFFER选中错误
        ELIF $HOME_BUFFER选中普通 > $HOME_BUFFER选中正确 and $HOME_BUFFER选中普通 > $HOME_BUFFER选中错误
            $HOME_BUFFER自适应候选状态 = 2
            $HOME_BUFFER自适应候选分数 = $HOME_BUFFER选中普通
        ELSE
            RETURN 0
        ENDIF

        IF $HOME_BUFFER自适应候选分数 < $HOME_BUFFER自适应最低阈值
            RETURN 0
        ENDIF
        IF $HOME_BUFFER自适应采样 == 1
            $HOME_BUFFER自适应首次状态 = $HOME_BUFFER自适应候选状态
            $HOME_BUFFER自适应首次分数 = $HOME_BUFFER自适应候选分数
        ELIF $HOME_BUFFER自适应候选状态 != $HOME_BUFFER自适应首次状态 or $HOME_BUFFER自适应候选分数 != $HOME_BUFFER自适应首次分数
            RETURN 0
        ENDIF
    NEXT

    IF $HOME_BUFFER自适应首次分数 < $HOME_BUFFER有效识图阈值
        $HOME_BUFFER有效识图阈值 = $HOME_BUFFER自适应首次分数
        PRINT "FRLG_STAGE|THRESHOLD|main.home_buffer|" & $HOME_BUFFER有效识图阈值 & "|!"
    ENDIF
    PRINT "HOME_BUFFER_ADAPTIVE|OLD=95|NEW=" & $HOME_BUFFER有效识图阈值 & "|STATE=" & $HOME_BUFFER自适应首次状态 & "|STABLE=" & $HOME_BUFFER自适应稳定要求
    RETURN $HOME_BUFFER自适应首次状态
ENDFUNC

# 1.6.4-a 正式版 HOME_BUFFER：可选稳定低分自适应，关闭时保持原 95 分逻辑。
FUNC HOME_BUFFER
    $HOME_BUFFER尝试 = 0
    $孵蛋HOME_BUFFER尝试 = 0
    $孵蛋HOME_BUFFER失败 = 0
    $HOME_BUFFER未知连续次数 = 0
    $HOME_BUFFER锁定连续失败 = 0
    $HOME_BUFFER本轮待确认 = 0
    $HOME_BUFFER恢复需要 = 1
    $HOME_BUFFER恢复已按HOME = 0
    $HOME_BUFFER恢复关闭次数 = 0
    $HOME_BUFFER恢复稳定 = 0
    $HOME_BUFFER恢复未知 = 0
    PRINT "FRLG_STAGE|BEGIN|main.home_buffer|main.home_buffer|0|NS火叶全自动一键乱数2.0.ecs|HOME_BUFFER|main.home_buffer.calibrate|manual_prepare_then_restart|OR;主页.IL:>=:95,主页_NS2.IL:>=:95,正确退出.IL:>=:" & $HOME_BUFFER有效识图阈值 & ",正确退出_NS2.IL:>=:" & $HOME_BUFFER有效识图阈值 & ",HOME_BUFFER正确退出.IL:>=:" & $HOME_BUFFER有效识图阈值 & ",HOME_BUFFER正确退出_NS2.IL:>=:" & $HOME_BUFFER有效识图阈值 & ",错误退出.IL:>=:" & $HOME_BUFFER有效识图阈值 & ",错误退出_NS2.IL:>=:" & $HOME_BUFFER有效识图阈值 & ",正在关闭.IL:>=:95,正在关闭_暗.IL:>=:95|!"
    FOR
        $HOME_BUFFER尝试 = $HOME_BUFFER尝试 + 1
        $孵蛋HOME_BUFFER尝试 = $HOME_BUFFER尝试
        IF $HOME_BUFFER尝试 > 20
            PRINT HOME_BUFFER校准失败：20轮恢复或试探后仍未确认可用窗口
            PRINT "FRLG_STAGE|FAIL|main.home_buffer|HOME_BUFFER校准达到20轮上限|!"
            IF $静态或野生 == "孵蛋"
                $孵蛋HOME_BUFFER失败 = 1
            ENDIF
            RETURN
        ENDIF
        IF $HOME_BUFFER锁定启用 == 1
            $HOME_BUFFER延迟 = $HOME_BUFFER锁定延迟
        ENDIF
        IF $HOME_BUFFER恢复需要 == 1
            $HOME_BUFFER恢复结果 = HOME_BUFFER恢复启动原点()
            IF $HOME_BUFFER恢复结果 == 2
                $HOME_BUFFER延迟 = $HOME_BUFFER本轮延迟
                $HOME_BUFFER锁定启用 = 1
                $HOME_BUFFER锁定延迟 = $HOME_BUFFER本轮延迟
                $HOME_BUFFER锁定连续失败 = 0
                PRINT 可用并锁定HOME_BUFFER延迟: & $HOME_BUFFER锁定延迟 & " ms"
                PRINT "FRLG_STAGE|END|main.home_buffer|!"
                RETURN
            ENDIF
            IF $HOME_BUFFER恢复结果 == 0
                PRINT HOME_BUFFER恢复未确认：保持延迟，只重采样，不启动游戏
                WAIT 500
                CONTINUE
            ENDIF
            $HOME_BUFFER恢复需要 = 0
        ENDIF
        $HOME_BUFFER本轮待确认 = 0
        $HOME_BUFFER本轮延迟 = $HOME_BUFFER延迟
        A
        WAIT 1500
        A
        WAIT $HOME_BUFFER延迟
        IF $调试日志输出 == 1
            PRINT 尝试HOME_BUFFER延迟: & $HOME_BUFFER延迟 & " ms"
        ENDIF
        HOME 100
        WAIT 1500
        $HOME_BUFFER识别状态 = HOME_BUFFER重采样状态(1)
        IF $HOME_BUFFER识别状态 == 1
            $HOME_BUFFER锁定启用 = 1
            $HOME_BUFFER锁定延迟 = $HOME_BUFFER延迟
            $HOME_BUFFER锁定连续失败 = 0
            PRINT 可用并锁定HOME_BUFFER延迟: & $HOME_BUFFER锁定延迟 & " ms"
            PRINT "FRLG_STAGE|END|main.home_buffer|!"
            RETURN
        ENDIF
        IF $HOME_BUFFER识别状态 == 0
            $HOME_BUFFER本轮待确认 = 1
        ENDIF
        $HOME_BUFFER下一延迟 = HOME_BUFFER规划下一延迟($HOME_BUFFER识别状态)
        IF $HOME_BUFFER下一延迟 < 100 or $HOME_BUFFER下一延迟 > 3000
            PRINT HOME_BUFFER校准失败：下一延迟超出100-3000 ms
            PRINT "FRLG_STAGE|FAIL|main.home_buffer|下一延迟超出100-3000毫秒范围|!"
            IF $静态或野生 == "孵蛋"
                $孵蛋HOME_BUFFER失败 = 1
            ENDIF
            RETURN
        ENDIF
        $HOME_BUFFER延迟 = $HOME_BUFFER下一延迟
        $HOME_BUFFER恢复需要 = 1
        $HOME_BUFFER恢复已按HOME = 0
        $HOME_BUFFER恢复关闭次数 = 0
        $HOME_BUFFER恢复稳定 = 0
        $HOME_BUFFER恢复未知 = 0
    NEXT
    PRINT "FRLG_STAGE|FAIL|main.home_buffer|HOME_BUFFER校准循环意外退出|!"
ENDFUNC

# HOME_BUFFER 专用恢复与步长决策；不改变其他流程的关闭游戏函数。
FUNC HOME_BUFFER重采样状态($只使用当前NX: INT): INT
    # 未知画面只等待，不发送按键；覆盖直采中晚于旧三次采样窗口到达的画面。
    FOR $HOME_BUFFER重采样 = 1 TO 8
        $HOME_BUFFER识别状态 = HOME_BUFFER识别稳定状态($只使用当前NX)
        IF $调试日志输出 == 1
            PRINT "HOME_BUFFER_RESAMPLE|SAMPLE=" & $HOME_BUFFER重采样 & "|LIMIT=8|STATE=" & $HOME_BUFFER识别状态
        ENDIF
        IF $HOME_BUFFER识别状态 != 0
            RETURN $HOME_BUFFER识别状态
        ENDIF
        IF $HOME_BUFFER重采样 < 8
            WAIT 200
        ENDIF
    NEXT
    RETURN 0
ENDFUNC

FUNC HOME_BUFFER恢复启动原点(): INT
    FOR $HOME_BUFFER恢复采样 = 1 TO 10
        IF $NX机型 == 1
            $HOME_BUFFER恢复主页 = @主页
            $HOME_BUFFER恢复普通 = @正确退出
            $HOME_BUFFER恢复窗口 = @HOME_BUFFER正确退出
            $HOME_BUFFER恢复错误 = @错误退出
        ELSE
            $HOME_BUFFER恢复主页 = @主页_NS2
            $HOME_BUFFER恢复普通 = @正确退出_NS2
            $HOME_BUFFER恢复窗口 = @HOME_BUFFER正确退出_NS2
            $HOME_BUFFER恢复错误 = @错误退出_NS2
        ENDIF
        $HOME_BUFFER恢复关闭中 = @正在关闭
        IF $调试日志输出 == 1
            PRINT "HOME_BUFFER_RECOVERY|NX=" & $NX机型 & "|HOME=" & $HOME_BUFFER恢复主页 & "|NORMAL=" & $HOME_BUFFER恢复普通 & "|BUFFER=" & $HOME_BUFFER恢复窗口 & "|ERROR=" & $HOME_BUFFER恢复错误 & "|CLOSING=" & $HOME_BUFFER恢复关闭中 & "|HOME_SENT=" & $HOME_BUFFER恢复已按HOME
        ENDIF

        IF $HOME_BUFFER恢复关闭中 >= 95
            $HOME_BUFFER本轮待确认 = 0
            $HOME_BUFFER恢复稳定 = 0
            $HOME_BUFFER恢复未知 = 0
        ELIF $HOME_BUFFER本轮待确认 == 1 and $HOME_BUFFER恢复窗口 >= $HOME_BUFFER有效识图阈值
            # 只接纳本轮 HOME 后的未知结果；恢复尚未发键，窗口仍属于本轮延迟。
            $HOME_BUFFER本轮待确认 = 0
            PRINT "HOME_BUFFER_LATE_SUCCESS|DELAY=" & $HOME_BUFFER本轮延迟 & "|BUFFER=" & $HOME_BUFFER恢复窗口 & "|THRESHOLD=" & $HOME_BUFFER有效识图阈值
            RETURN 2
        ELIF $HOME_BUFFER恢复普通 >= $HOME_BUFFER有效识图阈值 or $HOME_BUFFER恢复窗口 >= $HOME_BUFFER有效识图阈值
            IF $HOME_BUFFER恢复关闭次数 >= 3
                RETURN 0
            ENDIF
            $HOME_BUFFER恢复关闭次数 = $HOME_BUFFER恢复关闭次数 + 1
            $HOME_BUFFER本轮待确认 = 0
            X
            WAIT 1500
            A
            WAIT 1500
            $HOME_BUFFER恢复稳定 = 0
            $HOME_BUFFER恢复未知 = 0
            CONTINUE
        ELIF $HOME_BUFFER恢复错误 >= $HOME_BUFFER有效识图阈值
            $HOME_BUFFER本轮待确认 = 0
            B
            WAIT 1500
            $HOME_BUFFER恢复稳定 = 0
            $HOME_BUFFER恢复未知 = 0
            CONTINUE
        ELIF $HOME_BUFFER恢复主页 >= 95 and $HOME_BUFFER恢复普通 < 90 and $HOME_BUFFER恢复窗口 < 90 and $HOME_BUFFER恢复错误 < 90
            # Online 图标只能证明在 HOME 页；还需连续确认两种正在游玩标签均已消失。
            $HOME_BUFFER恢复稳定 = $HOME_BUFFER恢复稳定 + 1
            $HOME_BUFFER恢复未知 = 0
            IF $HOME_BUFFER恢复稳定 >= 3
                $HOME_BUFFER本轮待确认 = 0
                PRINT HOME_BUFFER恢复：已连续确认主页且正在游玩标志消失
                RETURN 1
            ENDIF
        ELSE
            $HOME_BUFFER恢复稳定 = 0
            # 90-94 只用于阻止误按 HOME/误判关闭，绝不作为成功阈值。
            IF $HOME_BUFFER恢复主页 >= 95 or $HOME_BUFFER恢复普通 >= 90 or $HOME_BUFFER恢复窗口 >= 90 or $HOME_BUFFER恢复错误 >= 90
                $HOME_BUFFER恢复未知 = 0
            ELSE
                $HOME_BUFFER恢复未知 = $HOME_BUFFER恢复未知 + 1
                IF $HOME_BUFFER恢复未知 >= 3 and $HOME_BUFFER恢复已按HOME == 0
                    $HOME_BUFFER本轮待确认 = 0
                    HOME 100
                    WAIT 1500
                    $HOME_BUFFER恢复已按HOME = 1
                    $HOME_BUFFER恢复未知 = 0
                    CONTINUE
                ENDIF
            ENDIF
        ENDIF
        WAIT 200
    NEXT
    RETURN 0
ENDFUNC

FUNC HOME_BUFFER规划下一延迟($状态: INT): INT
    IF $状态 == 0
        # 未识别不是过短证据，也不能与普通退出混算为连续方向失败。
        $HOME_BUFFER锁定连续失败 = 0
        $HOME_BUFFER未知连续次数 = $HOME_BUFFER未知连续次数 + 1
        PRINT HOME_BUFFER画面未识别：保留当前延迟，不记录短边界
        IF $HOME_BUFFER锁定启用 == 0 and $HOME_BUFFER未知连续次数 >= 3
            $HOME_BUFFER未知连续次数 = 0
            PRINT HOME_BUFFER尚无锁定值：连续未识别后按50ms向上试探，不认定过短
            RETURN $HOME_BUFFER延迟 + $HOME_BUFFER最小调整MS
        ENDIF
        RETURN $HOME_BUFFER延迟
    ENDIF

    $HOME_BUFFER未知连续次数 = 0
    IF $状态 != 2
        $HOME_BUFFER锁定连续失败 = 0
        RETURN $HOME_BUFFER延迟
    ENDIF
    IF $HOME_BUFFER锁定启用 == 1
        $HOME_BUFFER锁定连续失败 = $HOME_BUFFER锁定连续失败 + 1
        IF $HOME_BUFFER锁定连续失败 < $HOME_BUFFER锁定失败阈值
            PRINT HOME_BUFFER普通退出连续确认: & $HOME_BUFFER锁定连续失败 & "/" & $HOME_BUFFER锁定失败阈值 & "，保持锁定延迟重试"
            RETURN $HOME_BUFFER延迟
        ENDIF
        PRINT HOME_BUFFER连续3次明确识别普通退出，解除锁定并重新校准
        $HOME_BUFFER锁定启用 = 0
        $HOME_BUFFER锁定连续失败 = 0
    ENDIF
    PRINT HOME_BUFFER明确识别普通退出：按50ms向下试探
    RETURN $HOME_BUFFER延迟 - $HOME_BUFFER最小调整MS
ENDFUNC

FUNC 各阶段脚本固定延迟转帧数

    # F1: 60 fps
    $F1阶段脚本固定帧 = $F1阶段脚本固定延迟 * 3 / 50


    # F2: 120 fps
    $F2阶段脚本固定帧 = $F2阶段脚本固定延迟 * 3 / 25

ENDFUNC

# ==================================================
# 启动前合法性与支持情况检测
#
# 返回：
#   1 = 通过
#   0 = 失败
# ==================================================

FUNC 启动前合法性与支持检测(): INT
    PRINT ""
    PRINT ========================
    PRINT 启动前检测
    PRINT ========================

    $检查通过 = 检查基础输入参数()
    IF $检查通过 == 0
        RETURN 0
    ENDIF

    $检查通过 = 检查Seed表设置()
    IF $检查通过 == 0
        RETURN 0
    ENDIF

    $检查通过 = 检查目标Seed与消耗帧参数()
    IF $检查通过 == 0
        RETURN 0
    ENDIF

    $检查通过 = 解析遭遇方法与地点()
    IF $检查通过 == 0
        RETURN 0
    ENDIF

    $检查通过 = 加载目标组合数据()
    IF $检查通过 == 0
        RETURN 0
    ENDIF

    $检查通过 = 加载野生遇敌槽数据()
    IF $检查通过 == 0
        RETURN 0
    ENDIF

    $检查通过 = 检查获取流程支持()
    IF $检查通过 == 0
        RETURN 0
    ENDIF

    # -------------------------
    # 反查算法
    # -------------------------
    IF $反查算法 == 0
        $当前反查算法 = 目标默认计算方法($游戏版本, $目标全国图鉴编号, $遭遇方法, $遭遇地点)
        $反查算法 = $当前反查算法
    ELSE
        $当前反查算法 = $反查算法
    ENDIF

    $反查算法检查通过 = 检查反查算法与遭遇类型()
    IF $反查算法检查通过 == 0
        RETURN 0
    ENDIF

    $检查通过 = 加载宝可梦基础数据()
    IF $检查通过 == 0
        RETURN 0
    ENDIF

    $检查通过 = 检查运行参数()
    IF $检查通过 == 0
        RETURN 0
    ENDIF

    CALL 输出启动前检测结果

    RETURN 1
ENDFUNC

FUNC 检查基础输入参数(): INT
    $游戏版本 = 规范化游戏版本($游戏版本文本)

    IF $游戏版本 < 0
        PRINT 游戏版本填写无效: & $游戏版本文本
        RETURN 0
    ENDIF

    IF $NX机型 != 1 and $NX机型 != 2
        PRINT NX机型填写无效: & $NX机型
        RETURN 0
    ENDIF
    IF $Seed启动方案 != 0 and $Seed启动方案 != 1
        PRINT Seed启动方案填写无效: & $Seed启动方案
        PRINT 仅支持: 0=当前HOME_BUFFER，1=固定用户界面HOME
        RETURN 0
    ENDIF

    IF $Seed模式 < 0 or $Seed模式 > 10
        PRINT Seed模式填写无效: & $Seed模式
        RETURN 0
    ENDIF

    RETURN 1
ENDFUNC

FUNC 检查Seed表设置(): INT
    $Seed最大索引 = 取Seed最大索引($游戏版本)

    IF $Seed最大索引 < 0
        PRINT Seed表不支持当前游戏版本: & $游戏版本文本
        RETURN 0
    ENDIF

    # 允许未来的稀疏表首项为空；扫描整列确认是否确有可用Seed。
    $Seed模式有效记录 = 0
    FOR $Seed模式检查索引 = 0 TO $Seed最大索引
        $预检Seed = 取SeedHEX($游戏版本, $Seed模式检查索引, $Seed模式)
        IF $预检Seed != ""
            $Seed模式有效记录 = 1
            BREAK
        ENDIF
    NEXT

    IF $Seed模式有效记录 == 0
        PRINT Seed模式 & $Seed模式 & " 已定义，但当前Ten Lines表没有有效Seed数据"
        IF $Seed模式 == 3
            PRINT 模式3为STEREO / HELP / START；当前上游该列为空，请更新Seed表后再使用
        ENDIF
        RETURN 0
    ENDIF

    RETURN 1
ENDFUNC

FUNC 检查目标Seed与消耗帧参数(): INT
    $目标Seed十进制 = HEX转十进制($目标Seed)

    IF $目标Seed十进制 < 0
        PRINT 目标Seed格式错误: & $目标Seed
        PRINT 示例: 70FE 或 0x70FE
        RETURN 0
    ENDIF

    IF $Seed容差 < 0
        PRINT Seed容差不能为负数: & $Seed容差
        RETURN 0
    ENDIF

    IF $目标消耗帧 < 0
        PRINT 目标消耗帧不能为负数: & $目标消耗帧
        RETURN 0
    ENDIF

    IF $最小消耗帧 < 0
        PRINT ""
        PRINT 消耗帧搜索范围错误：最小消耗帧小于0
        PRINT 目标消耗帧: & $目标消耗帧
        PRINT 最小消耗帧: & $最小消耗帧
        PRINT 最大消耗帧: & $最大消耗帧
        PRINT 建议：提高目标消耗帧，或缩小搜索范围下限，保证最小消耗帧不小于0
        RETURN 0
    ENDIF

    IF $最小消耗帧 > $最大消耗帧
        PRINT ""
        PRINT 消耗帧搜索范围错误
        PRINT 最小消耗帧: & $最小消耗帧
        PRINT 最大消耗帧: & $最大消耗帧
        RETURN 0
    ENDIF

    RETURN 1
ENDFUNC

FUNC 设置TV模式
    $进入TV = 0

    # 御三家(图鉴1/4/7)在实验室开局拿、无法用 Teachy TV 推帧，物理 TV 等待流程也被跳过(见 执行目标获取 1390行)，
    # 故不进 TV：否则进入TV=1 会套 TV 数学(圈/相位/±1000搜索)却没物理推帧→帧模型与实际不符、校准必错。与 1390 行御三家排除一致。
    IF $目标消耗帧 > $TV进入阈值 and $目标全国图鉴编号 != 1 and $目标全国图鉴编号 != 4 and $目标全国图鉴编号 != 7
        $进入TV = 1
        $总消耗帧基础补偿 += $TV帧基础补偿
        # TV 模式：生效消耗帧搜索范围切换为 TV 范围(±1000,覆盖多圈)；普通模式保持 ±100
        $最小消耗帧 = $最小TV消耗帧
        $最大消耗帧 = $最大TV消耗帧
    ENDIF

    PRINT ""
    PRINT 【TV模式】
    PRINT TV进入阈值: & $TV进入阈值 & " 帧"
    IF $进入TV == 1
        PRINT TV模式: 进入
    ELSE
        PRINT TV模式: 不进入
    ENDIF

ENDFUNC

FUNC 规范化静态或野生($静态或野生文本: STRING): INT
    IF $静态或野生文本 == "静态"
        RETURN 1
    ELIF $静态或野生文本 == "野生"
        RETURN 2
    ELIF $静态或野生文本 == "孵蛋"
        RETURN 3
    ENDIF

    RETURN -1
ENDFUNC

FUNC 自动静态遭遇方法($游戏版本: INT, $目标全国图鉴编号: INT): INT

    IF 目标是否支持($游戏版本, $目标全国图鉴编号, 1, 0) == 1
        RETURN 1
    ELIF 目标是否支持($游戏版本, $目标全国图鉴编号, 2, 0) == 1
        RETURN 2
    ELIF 目标是否支持($游戏版本, $目标全国图鉴编号, 3, 0) == 1
        RETURN 3
    ELIF 目标是否支持($游戏版本, $目标全国图鉴编号, 4, 0) == 1
        RETURN 4
    ELIF 目标是否支持($游戏版本, $目标全国图鉴编号, 5, 0) == 1
        RETURN 5
    ELIF 目标是否支持($游戏版本, $目标全国图鉴编号, 6, 0) == 1
        RETURN 6
    ELIF 目标是否支持($游戏版本, $目标全国图鉴编号, 7, 0) == 1
        RETURN 7
    ELIF 目标是否支持($游戏版本, $目标全国图鉴编号, 8, 0) == 1
        RETURN 8
    ENDIF

    RETURN -1
ENDFUNC

FUNC 解析遭遇方法与地点(): INT
    $遭遇类型 = 规范化静态或野生($静态或野生)

    IF $遭遇类型 < 0
        PRINT 静态或野生填写无效: & $静态或野生
        PRINT 支持: 静态 / 野生
        RETURN 0
    ENDIF

    $遭遇地点 = 0
    $遭遇地点名称 = "不需要"

    IF $遭遇类型 == 1
        $遭遇方法 = 自动静态遭遇方法($游戏版本, $目标全国图鉴编号)

        IF $遭遇方法 < 0
            PRINT 未找到可用的静态类遭遇方法
            PRINT 图鉴编号: & $目标全国图鉴编号
            PRINT 如果这是野生目标，请把静态或野生改为 野生
            RETURN 0
        ENDIF

        $遭遇方法名称 = 目标遭遇方法名称($遭遇方法)
        RETURN 1
    ENDIF

    $遭遇方法 = 规范化遭遇方法($宝可梦遭遇方法)

    IF $遭遇方法 < 0
        PRINT 野生遭遇方法填写无效: & $宝可梦遭遇方法
        RETURN 0
    ENDIF

    IF $遭遇方法 < 101
        PRINT 当前设置为野生，但遭遇方法不是野生类: & $宝可梦遭遇方法
        PRINT 野生类支持: 草丛 / 冲浪 / 碎岩 / 破旧钓竿 / 好钓竿 / 厉害钓竿
        RETURN 0
    ENDIF

    $遭遇地点 = 规范化遭遇地点($宝可梦遭遇地点)

    IF $遭遇地点 < 0
        PRINT 遭遇地点填写无效: & $宝可梦遭遇地点
        PRINT 野生目标必须填写正确地点
        RETURN 0
    ENDIF

    $遭遇地点名称 = 目标遭遇地点名称($遭遇地点)

    $遭遇方法名称 = 目标遭遇方法名称($遭遇方法)

    RETURN 1
ENDFUNC

FUNC 加载目标组合数据(): INT
    $目标默认等级 = 目标默认等级($游戏版本, $目标全国图鉴编号, $遭遇方法, $遭遇地点)

    IF $目标默认等级 < 0
        PRINT 游戏版本: & $游戏版本文本
        PRINT 图鉴编号: & $目标全国图鉴编号
        PRINT 遭遇方法: & $宝可梦遭遇方法

        IF $遭遇方法 >= 101
            PRINT 遭遇地点: & $宝可梦遭遇地点
        ENDIF
        PRINT 未找到目标组合，用户设置有错误

        RETURN 0
    ENDIF

    $目标最低等级 = 目标最低等级($游戏版本, $目标全国图鉴编号, $遭遇方法, $遭遇地点)
    $目标最高等级 = 目标最高等级($游戏版本, $目标全国图鉴编号, $遭遇方法, $遭遇地点)
    $目标出现率 = 目标出现率($游戏版本, $目标全国图鉴编号, $遭遇方法, $遭遇地点)

    RETURN 1
ENDFUNC

FUNC 加载野生遇敌槽数据(): INT
    $野生槽验证启用 = 0
    $野生遇敌表索引 = -1

    IF $遭遇类型 != 2
        RETURN 1
    ENDIF

    $野生遇敌表索引 = 查找野生遇敌表索引($游戏版本, $遭遇方法, $遭遇地点)
    IF $野生遇敌表索引 < 0
        PRINT 野生遇敌槽数据缺失
        PRINT 游戏版本: & $游戏版本文本
        PRINT 遭遇方法: & $遭遇方法名称
        PRINT 遭遇地点: & $遭遇地点名称
        RETURN 0
    ENDIF

    FOR $野生槽加载索引 = 0 TO 11
        $当前野生槽打包表[$野生槽加载索引] = 取野生遇敌槽打包值($野生遇敌表索引, $野生槽加载索引)
    NEXT
    FOR $野生百分加载索引 = 0 TO 99
        $当前野生百分槽表[$野生百分加载索引] = 野生遇敌槽编号($遭遇方法, $野生百分加载索引)
    NEXT
    $野生槽验证启用 = 1
    RETURN 1
ENDFUNC

FUNC 校验野生遭遇初始等级(): INT
    IF $遭遇类型 != 2
        RETURN 1
    ENDIF
    IF $野生槽验证启用 != 1
        RETURN 1
    ENDIF
    IF $野生遭遇初始等级 < 0
        RETURN 1
    ENDIF

    $野生等级校验发现物种 = 0
    $野生等级校验汇总最低 = 999
    $野生等级校验汇总最高 = -1
    FOR $野生等级校验槽索引 = 0 TO 11
        $野生等级校验打包值 = $当前野生槽打包表[$野生等级校验槽索引]
        IF $野生等级校验打包值 <= 0
            CONTINUE
        ENDIF

        $野生等级校验图鉴编号 = $野生等级校验打包值 % 512
        IF $野生等级校验图鉴编号 != $目标全国图鉴编号
            CONTINUE
        ENDIF

        $野生等级校验发现物种 = 1
        $野生等级校验最低等级 = ($野生等级校验打包值 / 512) % 128
        $野生等级校验最高等级 = ($野生等级校验打包值 / 65536) % 128
        # 最低等级为0的旧数据只校验物种，不拦截本轮。
        IF $野生等级校验最低等级 <= 0
            RETURN 1
        ENDIF

        IF $野生等级校验最低等级 < $野生等级校验汇总最低
            $野生等级校验汇总最低 = $野生等级校验最低等级
        ENDIF
        IF $野生等级校验最高等级 > $野生等级校验汇总最高
            $野生等级校验汇总最高 = $野生等级校验最高等级
        ENDIF

        IF $野生遭遇初始等级 >= $野生等级校验最低等级
            IF $野生遭遇初始等级 <= $野生等级校验最高等级
                RETURN 1
            ENDIF
        ENDIF
    NEXT

    # 物种不存在仍由前置路线校验负责；这里只拦截“物种存在但等级不可能”的情况。
    IF $野生等级校验发现物种 == 0
        RETURN 1
    ENDIF

    PRINT ""
    PRINT 【野生遭遇等级校验】
    PRINT 实际目标: & $目标名称字符
    PRINT 实际等级: LV & $野生遭遇初始等级
    PRINT 配置版本: & $游戏版本文本
    PRINT 配置地点: & $遭遇地点名称
    PRINT 配置遭遇方法: & $遭遇方法名称
    PRINT 合法等级范围: LV & $野生等级校验汇总最低 & "-" & $野生等级校验汇总最高
    PRINT 判定: 实际等级不属于当前地点与遭遇方法
    IF $遭遇方法 >= 201 and $遭遇方法 <= 203
        PRINT 提示: 疑似实际使用的钓竿与配置不一致
    ENDIF
    PRINT 本轮停止反查，避免无效扩窗
    RETURN 0
ENDFUNC

FUNC 检查获取流程支持(): INT
    $获取支持 = 目标获取是否支持($目标全国图鉴编号, $遭遇方法, $遭遇地点)

    IF $获取支持 == 0
        PRINT 当前目标获取流程暂未支持
        PRINT 图鉴编号: & $目标全国图鉴编号
        PRINT 遭遇方法: & $遭遇方法名称
        RETURN 0
    ENDIF

    RETURN 1
ENDFUNC

FUNC 加载宝可梦基础数据(): INT
    $目标名称字符 = 目标名称($游戏版本, $目标全国图鉴编号)

    IF $目标名称字符 == "未知 / Unknown"
        PRINT 未找到目标名称，图鉴编号: & $目标全国图鉴编号
        RETURN 0
    ENDIF

    $种族HP = 取种族HP($游戏版本, $目标全国图鉴编号)
    $种族ATK = 取种族ATK($游戏版本, $目标全国图鉴编号)
    $种族DEF = 取种族DEF($游戏版本, $目标全国图鉴编号)
    $种族SPA = 取种族SPA($游戏版本, $目标全国图鉴编号)
    $种族SPD = 取种族SPD($游戏版本, $目标全国图鉴编号)
    $种族SPE = 取种族SPE($游戏版本, $目标全国图鉴编号)
    $性别阈值 = 取性别阈值($目标全国图鉴编号)

    IF $种族HP < 0 or $种族ATK < 0 or $种族DEF < 0 or $种族SPA < 0 or $种族SPD < 0 or $种族SPE < 0
        PRINT 种族值数据缺失，图鉴编号: & $目标全国图鉴编号
        RETURN 0
    ENDIF

    IF $性别阈值 < 0
        PRINT 性别阈值数据缺失，图鉴编号: & $目标全国图鉴编号
        RETURN 0
    ENDIF

    RETURN 1
ENDFUNC

FUNC 检查运行参数(): INT
    IF $Seed模式 == 10
        IF $遭遇类型 != 1 or ($目标全国图鉴编号 != 1 and $目标全国图鉴编号 != 4 and $目标全国图鉴编号 != 7)
            PRINT 日版御三家临时模式10仅支持静态图鉴1/4/7
            RETURN 0
        ENDIF
    ENDIF

    IF $识图阈值 <= 0
        PRINT 识图阈值不合法: & $识图阈值
        RETURN 0
    ENDIF
    IF $第0轮游戏设置检查 != 0 and $第0轮游戏设置检查 != 1
        PRINT 第0轮游戏设置检查开关不合法: & $第0轮游戏设置检查
        PRINT 仅支持: 0=跳过，1=自动检查并校正
        RETURN 0
    ENDIF
    IF $游戏设置识图阈值 <= 0 or $游戏设置识图阈值 > 100
        PRINT 游戏设置识图阈值不合法: & $游戏设置识图阈值
        RETURN 0
    ENDIF
    IF $调试日志输出 != 0 and $调试日志输出 != 1
        PRINT 调试日志输出设置不合法: & $调试日志输出
        PRINT 仅支持: 0=用户日志，1=调试日志
        RETURN 0
    ENDIF
    IF $Seed校准方案 != 0 and $Seed校准方案 != 1 and $Seed校准方案 != 2
        PRINT Seed校准方案设置不合法: & $Seed校准方案
        PRINT 仅支持: 0=原始12轮绝对落点众数，1=实验锁定与毫秒细调，2=命中保持后的方向票接续
        RETURN 0
    ENDIF
    IF $帧奇偶修正方案 != 0 and $帧奇偶修正方案 != 1
        PRINT 帧奇偶修正方案设置不合法: & $帧奇偶修正方案
        PRINT 仅支持: 0=方案0自适应奇偶阶梯，1=跳过回忆后开关菜单
        RETURN 0
    ENDIF
    IF $道具乱数模式 != 0 and $道具乱数模式 != 1
        PRINT 道具乱数模式设置不合法: & $道具乱数模式
        PRINT 仅支持: 0=关闭，1=开启
        RETURN 0
    ENDIF
    IF $道具乱数模式 == 1
        IF $遭遇类型 != 2
            PRINT 道具乱数模式当前仅支持野生目标
            RETURN 0
        ENDIF
        IF $队伍空位数量 < 1 or $队伍空位数量 > 5
            PRINT 队伍空位数量设置不合法: & $队伍空位数量
            PRINT 道具乱数模式支持范围: 1-5
            RETURN 0
        ENDIF
    ENDIF

    RETURN 1
ENDFUNC

FUNC 输出启动前检测结果
    IF $调试日志输出 == 0
        PRINT ""
        PRINT 开始运行: & $脚本类型 & "，" & $目标名称字符 & " / " & $遭遇方法名称
        PRINT 目标: Seed & $目标Seed & "，消耗帧 " & $目标消耗帧
        IF $道具乱数模式 == 1
            PRINT 道具乱数: 开启；目标命中数量 & $队伍空位数量
        ENDIF
        RETURN
    ENDIF
    PRINT ""
    PRINT 脚本版本： & $脚本版本
    PRINT 脚本类型： & $脚本类型
    PRINT 结果: 通过
    PRINT 伊机控适配: 仅确认1.6.4-a
    IF $Seed校准方案 == 0
        PRINT Seed校准方案: 0 原始12轮绝对落点众数
    ELIF $Seed校准方案 == 1
        PRINT Seed校准方案: 1 实验锁定与毫秒细调
    ELSE
        PRINT Seed校准方案: 2 命中保持后的方向票接续
    ENDIF
    IF $帧奇偶修正方案 == 0
        PRINT 帧奇偶修正: 0 自适应阶梯，初始 F1+1/F2-1，目标Seed累计3次奇偶不一致后逐级增加偏移，非目标Seed不打断计数
    ELSE
        PRINT 帧奇偶修正: 1 跳过回忆后开关菜单，F1/F2保留原请求
    ENDIF
    PRINT ""
    PRINT 【目标】
    PRINT 名称: & $目标名称字符
    PRINT 游戏版本: & $游戏版本文本
    PRINT 遭遇方法: & $遭遇方法名称

    IF $遭遇方法 >= 101
        PRINT 遭遇地点: & $遭遇地点名称
    ENDIF

    PRINT 默认等级: LV & $目标默认等级
    PRINT 等级范围: LV & $目标最低等级 & - & $目标最高等级
    PRINT 出现率: & $目标出现率 & "%"
    IF $道具乱数模式 == 1
        PRINT 道具乱数模式: 开启
        PRINT 道具命中数量: & $队伍空位数量 & "（按队伍空位）"
    ENDIF

    PRINT ""
    PRINT 【Seed设置】
    PRINT 目标Seed: & $目标Seed
    PRINT Seed模式: & $Seed模式
    PRINT NX机型: & $NX机型
    PRINT Seed校准方案编号: & $Seed校准方案
    PRINT 帧奇偶修正方案编号: & $帧奇偶修正方案
    PRINT Seed容差: ± & $Seed容差 & 个seed
    PRINT Seed表最大索引: & $Seed最大索引

    PRINT ""
    PRINT 【反查设置】
    $反查算法文本 = 反查算法文本($反查算法)
    PRINT 反查算法: & $反查算法文本
    PRINT 目标消耗帧: & $目标消耗帧 & " 帧"
    PRINT 消耗帧搜索范围: & $最小消耗帧 & - & $最大消耗帧 & " 帧"
    PRINT 日志模式: 完整调试

ENDFUNC

FUNC 检查反查算法与遭遇类型(): INT
    IF $反查算法 != 1 and $反查算法 != 2 and $反查算法 != 4 and $反查算法 != 101 and $反查算法 != 102 and $反查算法 != 104 and $反查算法 != 199
        PRINT 反查算法不支持: & $反查算法
        PRINT 支持: 1, 2, 4, 101, 102, 104, 199
        RETURN 0
    ENDIF

    # 静态目标不应该使用野生算法
    IF $遭遇方法 < 101
        IF $反查算法 == 101 or $反查算法 == 102 or $反查算法 == 104 or $反查算法 == 199
            PRINT 静态类目标不应使用野生反查算法
            PRINT 遭遇方法: & $遭遇方法名称
            PRINT 反查算法: & $反查算法
            RETURN 0
        ENDIF
    ENDIF

    # 野生目标不应该使用静态算法
    IF $遭遇方法 >= 101
        IF $反查算法 == 1 or $反查算法 == 2 or $反查算法 == 4
            PRINT 野生类目标不应使用静态反查算法
            PRINT 遭遇方法: & $遭遇方法名称
            PRINT 反查算法: & $反查算法
            RETURN 0
        ENDIF
    ENDIF

    RETURN 1
ENDFUNC

# ===== 日版御三家临时识图分支 =====
# 日版御三家临时分支；日版标签随1.1.8包提供，默认英文流程不调用。
FUNC 读取并输出日版御三家识图结果(): INT
    $性别识图失败 = 0
    $性格识图失败 = 0
    $LV识图失败 = 0
    $HP识图失败 = 0
    $ATK识图失败 = 0
    $DEF识图失败 = 0
    $SPA识图失败 = 0
    $SPD识图失败 = 0
    $SPE识图失败 = 0
    $等级表直读 = 1
    $等级标签识别 = 0
    $候选数字命中项数 = 0
    $候选数字回退项数 = 0
    $候选数字标签次数 = 0
    CALL 重置候选数字标签次数

    IF $道具乱数模式 == 0 and @出闪 >= $识图阈值
        PRINT 已识别到出闪，脚本停止
        RETURN 0
    ENDIF

    PRINT "FRLG_STAGE|BEGIN|main.jp.gender|main.jp.gender|0|NS火叶全自动一键乱数2.0.ecs|读取并输出日版御三家识图结果|main.jp.gender|manual_prepare_then_restart|OR;火红公图标.IL:>=:" & $识图阈值 & ",火红母图标.IL:>=:" & $识图阈值 & "|!"
    $日版公图标分数 = @火红公图标
    $日版母图标分数 = @火红母图标
    IF $日版公图标分数 < $识图阈值 and $日版母图标分数 < $识图阈值
        $识图性别 = -1
        $性别识图失败 = 1
        PRINT 日版性别识图失败，公母标签均低于阈值
        PRINT "FRLG_STAGE|FAIL|main.jp.gender|日版公母图标候选均低于阈值|!"
        RETURN 0
    ELIF $日版公图标分数 >= $日版母图标分数
        $识图性别 = 0
        $当前性别 = 0
        IF $调试日志输出 == 1
            PRINT ▶ 日版性别: ♂
        ENDIF
    ELSE
        $识图性别 = 1
        $当前性别 = 1
        $检测到性别母 = 1
        IF $调试日志输出 == 1
            PRINT ▶ 日版性别: ♀
        ENDIF
    ENDIF

    PRINT "FRLG_STAGE|END|main.jp.gender|!"
    PRINT "FRLG_STAGE|BEGIN|main.jp.nature|main.jp.nature|0|NS火叶全自动一键乱数2.0.ecs|读取并输出日版御三家识图结果|main.jp.nature|manual_prepare_then_restart|OR;性格日版勤奋.IL:>:" & $识图阈值 & ",性格日版怕寂寞.IL:>:" & $识图阈值 & ",性格日版勇敢.IL:>:" & $识图阈值 & ",性格日版固执.IL:>:" & $识图阈值 & ",性格日版顽皮.IL:>:" & $识图阈值 & ",性格日版大胆.IL:>:" & $识图阈值 & ",性格日版坦率.IL:>:" & $识图阈值 & ",性格日版悠闲.IL:>:" & $识图阈值 & ",性格日版淘气.IL:>:" & $识图阈值 & ",性格日版乐天.IL:>:" & $识图阈值 & ",性格日版胆小.IL:>:" & $识图阈值 & ",性格日版急躁.IL:>:" & $识图阈值 & ",性格日版认真.IL:>:" & $识图阈值 & ",性格日版爽朗.IL:>:" & $识图阈值 & ",性格日版内敛.IL:>:" & $识图阈值 & ",性格日版慢吞吞.IL:>:" & $识图阈值 & ",性格日版冷静.IL:>:" & $识图阈值 & ",性格日版害羞.IL:>:" & $识图阈值 & ",性格日版马虎.IL:>:" & $识图阈值 & ",性格日版温和.IL:>:" & $识图阈值 & ",性格日版温顺.IL:>:" & $识图阈值 & ",性格日版自大.IL:>:" & $识图阈值 & ",性格日版慎重.IL:>:" & $识图阈值 & ",性格日版浮躁.IL:>:" & $识图阈值 & ",性格日版天真.IL:>:" & $识图阈值 & "|!"
