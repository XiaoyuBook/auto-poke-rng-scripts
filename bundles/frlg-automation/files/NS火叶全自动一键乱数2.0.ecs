IF $目标全国图鉴编号 != 1 and $目标全国图鉴编号 != 4 and $目标全国图鉴编号 != 7
    IF $调试日志输出 == 0
        PRINT ""
        PRINT 运行前确认: 第0轮自动检查游戏设置，队伍/背包/快捷键已按脚本说明准备
    ELSE
        PRINT ""
        PRINT ========================
        PRINT 运行前必要要求
        PRINT ========================
        PRINT ""
        PRINT 【当前宝可梦要求】
        PRINT ""
        PRINT 第0轮自动检查文字速度、战斗动画、声音和按键模式
        PRINT ""
        IF $道具乱数模式 == 1
            PRINT 队伍预留 & $队伍空位数量 & " 个空位；脚本保存同样数量的携带道具目标"
        ELIF $目标全国图鉴编号 == 175
            PRINT 队伍放四只宝可梦，第五位留给波克比蛋，第六位留给Seed复核野生
        ELSE
            PRINT 队伍放五只宝可梦，第六位留空
        ENDIF

    IF ($静态或野生 == "野生" and ($宝可梦遭遇方法 == "草丛" or $宝可梦遭遇方法 == "冲浪")) or $目标全国图鉴编号 == 175
        PRINT 队伍第一位放甜甜香气宝可梦
    ENDIF
    IF $目标全国图鉴编号 == 243 or $目标全国图鉴编号 == 244 or $目标全国图鉴编号 == 245
        PRINT 队首宝可梦需低于50级
    ENDIF
    IF $静态或野生 == "野生" or $目标全国图鉴编号 == 97 or $目标全国图鉴编号 == 101 or $目标全国图鉴编号 == 143 or $目标全国图鉴编号 == 150 or $目标全国图鉴编号 == 243 or $目标全国图鉴编号 == 244 or $目标全国图鉴编号 == 245 or $目标全国图鉴编号 == 249 or $目标全国图鉴编号 == 250 or $目标全国图鉴编号 == 386
        IF $麻痹 == 1
            PRINT 队伍第一位放麻痹宝可梦，技能栏第一位放麻痹招式
        ENDIF
        IF $点到为止 == 1
            PRINT 队伍第二位放点到为止宝可梦，技能栏第一位放点到为止招式
        ENDIF
    ENDIF
    IF $目标全国图鉴编号 == 243 or $目标全国图鉴编号 == 244 or $目标全国图鉴编号 == 245
        PRINT 队伍第三位放飞翔宝可梦，飞翔放技能首位
    ENDIF
    PRINT ""
    PRINT 背包第一页第一格放神奇糖果，数量不限
    PRINT 重要道具固定顺序: 第1项Teachy TV，第2项自行车，钓鱼时第3项放本次使用的钓竿
    PRINT 第0轮会按当前流程自动检查并切换快捷登记
    IF $静态或野生 == "野生" or $目标全国图鉴编号 == 97 or $目标全国图鉴编号 == 101 or $目标全国图鉴编号 == 143 or $目标全国图鉴编号 == 150 or $目标全国图鉴编号 == 175 or $目标全国图鉴编号 == 243 or $目标全国图鉴编号 == 244 or $目标全国图鉴编号 == 245 or $目标全国图鉴编号 == 249 or $目标全国图鉴编号 == 250 or $目标全国图鉴编号 == 386
        PRINT 背包第一页第二格放血药
    ENDIF
    IF $目标全国图鉴编号 == 243 or $目标全国图鉴编号 == 244 or $目标全国图鉴编号 == 245
        PRINT 背包第一页第三格放黄金喷雾
    ENDIF
    IF $目标消耗帧 > $TV进入阈值
        IF $静态或野生 == "野生" and ($宝可梦遭遇方法 == "破旧钓竿" or $宝可梦遭遇方法 == "好钓竿" or $宝可梦遭遇方法 == "厉害钓竿" or $宝可梦遭遇方法 == "超级钓竿")
            PRINT 重要道具第1项放Teachy TV；本流程不登记TV快捷键
            IF $宝可梦遭遇方法 == "破旧钓竿"
                PRINT 重要道具第3项放破旧钓竿，第0轮自动登记第3项
            ELIF $宝可梦遭遇方法 == "好钓竿"
                PRINT 重要道具第3项放好钓竿，第0轮自动登记第3项
            ELSE
                PRINT 重要道具第3项放厉害钓竿，第0轮自动登记第3项
            ENDIF
        ELIF $静态或野生 == "野生" and 是否狩猎地带($运行前遭遇地点) == 1
            PRINT 重要道具第1项放Teachy TV；本流程不登记TV快捷键
        ELSE
            PRINT 重要道具第1项放Teachy TV，第0轮自动登记第1项
            IF $目标全国图鉴编号 == 175
                PRINT 重要道具第2项放自行车
            ENDIF
        ENDIF
    ELSE
        IF $静态或野生 == "野生" and $宝可梦遭遇方法 == "破旧钓竿"
            PRINT 重要道具第3项放破旧钓竿，第0轮自动登记第3项
        ENDIF
        IF $静态或野生 == "野生" and $宝可梦遭遇方法 == "好钓竿"
            PRINT 重要道具第3项放好钓竿，第0轮自动登记第3项
        ENDIF
        IF $静态或野生 == "野生" and ($宝可梦遭遇方法 == "厉害钓竿" or $宝可梦遭遇方法 == "超级钓竿")
            PRINT 重要道具第3项放厉害钓竿，第0轮自动登记第3项
        ENDIF
        IF $目标全国图鉴编号 == 175
            PRINT 重要道具第2项放自行车，第0轮自动登记第2项
        ENDIF
    ENDIF
    IF $静态或野生 == "野生" and $运行前遭遇地点 == 57 and $宝可梦遭遇方法 == "草丛"
        PRINT 重要道具第2项放自行车，第0轮自动登记第2项
    ENDIF
        IF $静态或野生 == "野生" or $目标全国图鉴编号 == 97 or $目标全国图鉴编号 == 101 or $目标全国图鉴编号 == 143 or $目标全国图鉴编号 == 150 or $目标全国图鉴编号 == 175 or $目标全国图鉴编号 == 243 or $目标全国图鉴编号 == 244 or $目标全国图鉴编号 == 245 or $目标全国图鉴编号 == 249 or $目标全国图鉴编号 == 250 or $目标全国图鉴编号 == 386
            PRINT 背包第三页第一格放大师球
            IF $出闪后继续抓捕 == 1
                PRINT 背包第三页第二格放抓捕要用的球种
            ENDIF
        ENDIF
    ENDIF
    WAIT 10000
ENDIF

