        $总消耗帧基础补偿 = 162
    ELIF $目标全国图鉴编号 == 143
        $总消耗帧基础补偿 = 169
    ELIF $目标全国图鉴编号 == 144 or $目标全国图鉴编号 == 145 or $目标全国图鉴编号 == 146
        $总消耗帧基础补偿 = 61
    ELIF $目标全国图鉴编号 == 150
        $总消耗帧基础补偿 = -201
    ELIF $目标全国图鉴编号 == 175
        $总消耗帧基础补偿 = 157
    ELIF $目标全国图鉴编号 == 63 or $目标全国图鉴编号 == 35 or $目标全国图鉴编号 == 147 or $目标全国图鉴编号 == 123 or $目标全国图鉴编号 == 127 or $目标全国图鉴编号 == 137
        $总消耗帧基础补偿 = 169
    ELIF $目标全国图鉴编号 == 243 or $目标全国图鉴编号 == 244 or $目标全国图鉴编号 == 245
        $总消耗帧基础补偿 = 166
    ELIF $目标全国图鉴编号 == 249
        $总消耗帧基础补偿 = -384
    ELIF $目标全国图鉴编号 == 250
        $总消耗帧基础补偿 = -587
    ELIF $目标全国图鉴编号 == 386
        $总消耗帧基础补偿 = -837
        $TV帧基础补偿 = -8041 + 1854
    ENDIF
ENDIF

IF $遭遇类型 == 2
    IF $遭遇方法 == 101 or $遭遇方法 == 102
        $总消耗帧基础补偿 = -303
    ELIF $遭遇方法 == 201 or $遭遇方法 == 202 or $遭遇方法 == 203
        $总消耗帧基础补偿 = 152
    ENDIF
ENDIF

CALL 设置TV模式

# 投票自洽模块(lib/25) 阶段4-5 初始化：相位(帧)+圈数+Seed+联合 配置注入 + 清零（模块内含物理上限clamp）
# 普通模式：周期=0、圈半宽=0 → 退化单相位表(等价阶段1-3)；相位半宽=搜索窗。
# TV模式：周期=314、相位半宽=157、圈半宽=ceil(搜索窗TV/314)+2。
# 无条件预声明(EzCon 不识别仅在分支内首次赋值的变量)
$相位投票半宽生效 = 0
$相位投票槽数生效 = 0
$圈数投票半宽生效 = 0
$圈数投票槽数生效 = 0
$投票周期生效 = 0
$搜索窗TV生效 = 0
IF $进入TV == 1
    $相位投票半宽生效 = $TV单次消耗帧 / 2
    $搜索窗TV生效 = $最大TV消耗帧 - $目标消耗帧
    $圈数投票半宽生效 = ($搜索窗TV生效 + $TV单次消耗帧 - 1) / $TV单次消耗帧 + 2
    $投票周期生效 = $TV单次消耗帧
ELSE
    $相位投票半宽生效 = $最大消耗帧 - $目标消耗帧
    IF $相位投票半宽生效 > 157
        $相位投票半宽生效 = 157
    ENDIF
    IF $相位投票半宽生效 < 1
        $相位投票半宽生效 = 1
    ENDIF
    $圈数投票半宽生效 = 0
    $投票周期生效 = 0
ENDIF
$相位投票槽数生效 = $相位投票半宽生效 * 2 + 1
$圈数投票槽数生效 = $圈数投票半宽生效 * 2 + 1
$投票忽略 = 投票设置配置($相位投票半宽生效, $相位投票槽数生效, $圈数投票半宽生效, $圈数投票槽数生效, $投票周期生效, $票堆帧窗, $票堆Seed窗, $Seed投票半宽, $Seed投票槽数, $停糖领先阈值, $停糖稳定轮数)
CALL 投票重置
CALL 投票重置Seed校准
CALL 共同区重置
$Seed锁定启用 = 0
