# STARTER_CALIBRATION_V1
# SEED_COMMON_REGION_HOOK_V2_STARTER_ONLY
# 当前仅确认适配伊机控1.6.4-a；其他版本不要用于正式长跑
# FORMAL_EGG_WAIT_V1：孵蛋使用正式版普通WAIT，同一编排也供时间轴版调用
# 脚本版本：2.0
# 脚本类型：正式版
# 游戏内任意界面启动脚本
# 脚本文件夹内的Tessdata文件夹内的.traineddata文件放入 .\伊机控\publish\Tessdata文件夹

# 要求：知道SID，会使用TenLines查目标
# TenLines网页：
# https://tenlines.skrxiaoyu.com/?page=2&reachableAdvancesFilter=false

# 当前版本支持：
# 所有定点
# 野生支持普通路线，以及狩猎地带中央、东区、北区、西区草丛和钓鱼路线
# 孵蛋支持同Seed的生成帧、领取帧与领取后野生Seed复核流程

# ╔══════════════════════════════════════════════════════════════╗
# ║                           用户输入区                          ║
# ╚══════════════════════════════════════════════════════════════╝

$脚本版本 = "2.0"
$脚本类型 = "正式版"

# 游戏版本文本：
$游戏版本文本 = "火红"

# Seed模式：
#   0 = mono_h_a
#   1 = stereo_h_a
#   2 = mono_h_start
#   3 = stereo_h_start（立体声 / 帮助 / 封面Start，对应手柄X）
#   4 = mono_h_a_blackout_r
#   5 = mono_h_a_blackout_l
#   6 = stereo_h_a_blackout_r
#   7 = stereo_h_a_blackout_l
#   8 = mono_h_start_blackout_r
#   9 = mono_h_start_blackout_l
#   10 = japanese_mono_h_a（临时日版御三家，仅MONO/HELP/A）
$Seed模式 = 0

# NX机型：
# 1 = Switch1
# 2 = Switch2
$NX机型 = 1

# Seed启动方案：
# 0 = 当前HOME_BUFFER方案（原样保留）
# 1 = 固定用户界面HOME方案：主页打开用户选择后，A → 1500ms → HOME → 3000ms → A，再开始Seed计时
$Seed启动方案 = 0

# 目标seed，支持 "70FE" / "0x70FE" / "70fe"等写法
$目标Seed = "77A1"

# 目标消耗帧；孵蛋模式下填写 Held/生成目标帧
$目标消耗帧 = 45661

# 目标宝可梦名称：可填写TenLines显示的中文名或英文名，例如 "吉利蛋" / "Chansey"
# 名称非空时优先使用名称；留空时使用下面的全国图鉴编号
$目标宝可梦名称 = "哈克龙"

# 目标宝可梦全国图鉴编号
$目标全国图鉴编号 = 113

# 目标类型："静态" / "野生" / "孵蛋"
# 孵蛋当前接入同 Seed 正式流程；目标宝可梦名称/编号作为蛋种，遭遇方法和地点会被忽略。
$静态或野生 = "野生"

# 野生类：
#   "草丛"
#   "冲浪"
#   "碎岩"
#   "破旧钓竿"
#   "好钓竿"
#   "厉害钓竿"（兼容旧称“超级钓竿”）
# 静态类可以不管，会自动忽略。
$宝可梦遭遇方法 = "厉害钓竿"

# 遭遇地点：
# 野生类必须填写，例如 "常磐森林"，按TenLines译名填写
# 静态类可以不管，会自动忽略。
$宝可梦遭遇地点 = "狩猎地带（入口）"

# 抓捕配置：
# 建议使用大师球，关闭麻痹/点到为止，关闭出闪后继续抓捕。此配置下出闪后手动抓捕较为可靠

# 麻痹/点到为止配置：
# 0为关闭，1为启用
$麻痹 = 0
$点到为止 = 0

# 出闪后是否继续抓捕
# 0为手动抓捕，1为自动抓捕
$出闪后继续抓捕 = 0

# 道具乱数模式：
# 0 = 关闭，按普通Seed/消耗帧目标运行
# 1 = 开启，物种正确且“无道具”标签不匹配时视为命中；每次命中存档
$道具乱数模式 = 0
# 当前队伍预留的空位数量，也就是需要保存的道具命中次数（1-5）
$队伍空位数量 = 1

# 日志输出：
# 0 = 用户日志（只显示目标、每轮最终命中结果、下轮请求和成功/失败原因）
# 1 = 调试日志（保留识图、候选、时间轴、校准簇、投票和BINGO等详尽数据）
$调试日志输出 = 1

# Seed校准方案（用于A/B测试，三套方案只影响Seed请求，不影响帧数校准）：
# 0 = 原始12轮绝对落点众数（肯泰罗/吉利蛋/卡比兽测试所用方案）
# 1 = 实验锁定与毫秒细调（哈克龙近期测试所用方案）
# 2 = 方案1基础上，命中保持结束后保留不足或平票的±1方向票并继续补足
$Seed校准方案 = 0

# 普通静态/野生帧轴奇偶修正方案：
# 0 = 自适应阶梯：F2请求为奇数时先执行F1+1/F2-1；目标Seed累计3次帧奇偶不一致后升级，非目标Seed不打断计数
# 1 = 菜单方案：跳过回忆后开关一次菜单切换奇偶；普通目标预扣菜单额外推进，御三家不预扣
$帧奇偶修正方案 = 0
$普通帧轴菜单额外推进帧 = 114

# 第0轮游戏设置检查：
# 1 = 首次进入存档后自动校正并保存游戏设置，再重启执行真正的第0轮
# 0 = 跳过检查
$第0轮游戏设置检查 = 1

# 孵蛋共享库计时模式：正式入口固定使用普通WAIT；不作为用户配置。
$孵蛋使用绝对时间轴 = 0
# 正式版不会忙等；该值仅作为共享孵蛋函数的内部兼容参数。
$时间轴精确尾段MS = 50

# -------------------- 孵蛋目标 --------------------
# 仅在 $静态或野生 = "孵蛋" 时生效。
# 1 = Held与Pickup在同一次启动中命中（当前正式流程）；0 = 不同启动流程，暂未开放。
$孵蛋同Seed模式 = 1
# GUI 孵蛋运行时覆盖：可从已完成254步的基础存档开始
$孵蛋从已完成254步开始 = 0
# Pickup/领取目标帧；Held/生成目标帧使用上方的 $目标消耗帧。
$孵蛋领取目标帧 = 0

# 双亲相性只填写 20 / 50 / 70。
$孵蛋双亲相性 = 70

# 亲本A/B类型填写 "雄" / "雌" / "无性别" / "百变怪"，顺序与 Ten Lines 保持一致。
# 合法组合为雄+雌，或恰好一只是百变怪。
# 两只亲本IV顺序均为 HP / ATK / DEF / SPA / SPD / SPE。
$孵蛋亲本A性别 = "雌"
$孵蛋双亲A_HP = -1
$孵蛋双亲A_ATK = -1
$孵蛋双亲A_DEF = -1
$孵蛋双亲A_SPA = -1
$孵蛋双亲A_SPD = -1
$孵蛋双亲A_SPE = -1
$孵蛋亲本B性别 = "雄"
$孵蛋双亲B_HP = -1
$孵蛋双亲B_ATK = -1
$孵蛋双亲B_DEF = -1
$孵蛋双亲B_SPA = -1
$孵蛋双亲B_SPD = -1
$孵蛋双亲B_SPE = -1


# ============================进阶设置============================
# 进阶设置没问题不建议修改

# -------------------- 孵蛋内部参数 --------------------
# 下列值由脚本统一使用，不属于每个目标需要填写的内容。
$孵蛋奇偶等待MS = 1500
$孵蛋封面长按MS = 4000
$孵蛋出蛋检测阈值 = 95
$孵蛋最大尝试次数 = 0
# 孵蛋个体反查成功后是否存档：0=不存档（默认），1=保留旧版存档行为。
$孵蛋成功后存档 = 0
# 普通野生/定点识别到闪光后是否保存最近约30秒录像：0=关闭，1=长按CAPTURE保存。
$出闪录像 = 0
$出闪录像长按MS = 1000
# 野生流程遇到非目标种类的闪光时是否停止：0=继续抓捕，1=立即停止脚本。
# 定点流程不会使用此开关；定点目标本身就是固定种类。
$非目标闪光停止 = 1
$孵蛋孵化周期覆盖 = 0
$孵蛋骑车每循环步数 = 38
$孵蛋孵化安全循环数 = 1
$孵蛋野生Seed容差 = 5
$孵蛋野生最小消耗帧 = 500
$孵蛋野生最大消耗帧 = 6500
$孵蛋野生最多糖果 = 20
$孵蛋蛋反查最多糖果 = 20
# 定点波克比领取后的水之迷宫野生Seed反查，以波克比目标帧为中心使用一次固定窗口。
$波克比野生反查帧半宽 = 5000
# Held/Pickup固定预校准来自本机实测；Held已按生成菜单测试更新为222。
# 固定预校准不由蛋反查改写；蛋反查得到的偏差另存到动态执行修正。
$孵蛋Held固定预校准帧 = 222
$孵蛋Pickup固定预校准帧 = 230
# Held只扫描目标前后100帧；Pickup继续保留宽窗，用完整IV定位领取帧。
$孵蛋Held反查帧容差 = 100
$孵蛋Pickup反查帧容差 = 2000
# 预校准后的正常波动预期为前后20帧；超过时优先检查跨轮候选位移。
$孵蛋跨轮近目标阈值 = 20
$孵蛋TV启用阈值 = 14400
$孵蛋TV路线保留帧 = 3600
$孵蛋领取路线最小间隔帧 = 1800
$孵蛋HeldOffset = 0
$孵蛋PickupOffset = 0

# Pickup稳定只决定是否进入正式Held微调；目标Seed下的无蛋证据始终累计，并可按有效无蛋表临时跳区。
# 首次Held反查校准前才使用连续无蛋门槛；有校准记录后无蛋立即复核Seed，不要求Pickup稳定。
$孵蛋Pickup稳定所需连续次数 = 2
$孵蛋普通无蛋复核阈值 = 3
$孵蛋普通目标Seed无蛋上限 = 6
$孵蛋无蛋区间确认次数 = 2
$孵蛋无蛋区间最大推断距离 = 20
$孵蛋无蛋最大跳出次数 = 3
$孵蛋无蛋跳出最大绝对偏移帧 = 100

# frlg-held-availability/v2：以下字段由工具按当前孵蛋目标自动生成并写入。
# 无蛋区间为闭区间；空表或签名不一致时禁止跳区，防止误用上一目标的数据。
$孵蛋Held无蛋表Seed = ""
$孵蛋Held无蛋表目标帧 = 0
$孵蛋Held无蛋表相性 = 0
$孵蛋Held无蛋表Offset = 0
$孵蛋Held无蛋表最小帧 = 0
$孵蛋Held无蛋表最大帧 = 0
$孵蛋Held无蛋区间起点表 = []
$孵蛋Held无蛋区间终点表 = []
# 近邻表优先保存“目标±2且中间帧也出蛋”的恢复点；远端表按附近出蛋密度排序。
# 两张表都只含与原目标生成帧同奇偶的出蛋帧。
$孵蛋Held近邻恢复锚点表 = []
$孵蛋Held远端恢复锚点表 = []

# Seed容差
# 比如：3 代表 搜索前后各3个Seed，没问题不建议修改
$Seed容差 = 20

# Seed首轮预校准，单位为Seed索引。NS1当前值来自本机实测稳定中心；NS2待实测后单独填写。
$Seed预校准索引_NS1 = -4
$Seed预校准索引_NS2 = 0
# 毫秒级基础补偿，没问题不建议修改。
$Seed基础补偿 = 33

# 消耗帧搜索范围(普通模式)，没问题不建议修改
$最小消耗帧 = $目标消耗帧 - 100
$最大消耗帧 = $目标消耗帧 + 100
# TV消耗帧搜索范围(目标帧>TV阈值进入TV时生效)，没问题不建议修改
$最小TV消耗帧 = $目标消耗帧 - 1000
$最大TV消耗帧 = $目标消耗帧 + 1000

# TV进入阈值:目标消耗帧超过该值则进入TV，没问题不建议修改
$TV进入阈值 = 14400

# HOME_BUFFER延迟，没问题不建议修改
$HOME_BUFFER延迟 = 1200
$HOME_BUFFER当前正确退出 = 0
$HOME_BUFFER当前正确退出_NS2 = 0
$HOME_BUFFER当前正确退出普通 = 0
$HOME_BUFFER当前正确退出普通_NS2 = 0
$HOME_BUFFER当前错误退出 = 0
$HOME_BUFFER当前错误退出_NS2 = 0
# HOME_BUFFER 稳定低分自适应默认关闭；开启后只接受连续3次相同且唯一最高的90-94分标签。
# 首次命中后锁定延迟；同一锁定值连续失败3次才重新校准，单次调整至少50 ms。
$HOME_BUFFER本轮待确认 = 0
$HOME_BUFFER本轮延迟 = 0
$HOME_BUFFER最小调整MS = 50
$HOME_BUFFER锁定失败阈值 = 3
$HOME_BUFFER锁定启用 = 0
$HOME_BUFFER锁定延迟 = 0
$HOME_BUFFER锁定连续失败 = 0
$HOME_BUFFER稳定低分自适应 = 0
$HOME_BUFFER自适应最低阈值 = 90
$HOME_BUFFER有效识图阈值 = 95
$HOME_BUFFER自适应稳定要求 = 3
$HOME_BUFFER自适应采样 = 0
$HOME_BUFFER自适应候选状态 = 0
$HOME_BUFFER自适应候选分数 = 0
$HOME_BUFFER自适应首次状态 = 0
$HOME_BUFFER自适应首次分数 = 0
$HOME_BUFFER识别状态 = 0
$HOME_BUFFER未知连续次数 = 0
$HOME_BUFFER重采样 = 0
$HOME_BUFFER恢复需要 = 0
$HOME_BUFFER恢复结果 = 0
$HOME_BUFFER恢复采样 = 0
$HOME_BUFFER恢复已按HOME = 0
$HOME_BUFFER恢复关闭次数 = 0
$HOME_BUFFER恢复主页 = 0
$HOME_BUFFER恢复普通 = 0
$HOME_BUFFER恢复窗口 = 0
$HOME_BUFFER恢复错误 = 0
$HOME_BUFFER恢复关闭中 = 0
$HOME_BUFFER恢复稳定 = 0
$HOME_BUFFER恢复未知 = 0
$HOME_BUFFER下一延迟 = 0
$HOME_BUFFER只使用当前NX = 1
$孵蛋HOME_BUFFER尝试 = 0
$孵蛋HOME_BUFFER短边界 = 0
$孵蛋HOME_BUFFER长边界 = 0
$孵蛋HOME_BUFFER已有短边界 = 0
$孵蛋HOME_BUFFER已有长边界 = 0
$孵蛋HOME_BUFFER下一延迟 = 0
$孵蛋HOME_BUFFER调整差 = 0
$孵蛋HOME_BUFFER选中正确 = 0
$孵蛋HOME_BUFFER选中普通 = 0
$孵蛋HOME_BUFFER选中错误 = 0
$孵蛋HOME_BUFFER失败 = 0
$HOME_BUFFER尝试 = 0
$HOME_BUFFER选中正确 = 0
$HOME_BUFFER选中普通 = 0
$HOME_BUFFER选中错误 = 0

# 识图阈值，低于该值视为识图失败，没问题不建议修改
$识图阈值 = 85
# 游戏设置标签使用更严格的阈值，避免菜单未正确打开时误判为设置正确
$游戏设置识图阈值 = 95

# 有界脱困(方向2)：避免持续吃糖却不收敛而浪费糖果/时间
# 糖果单只上限：单只个体本轮最多吃多少颗糖后停止细分，0=不限制
$糖果单只上限 = 8
# 候选停滞上限：连续多少颗糖后候选数不再减少则停止吃糖，0=不限制
$候选停滞上限 = 1
# 候选真值上限 N：本轮候选塌缩到 ≤N 才算“真值解”(不依赖路径的独立解)，才可直接选并喂养/重锚路径中心。
# N=1 即要求 seed/消耗帧 唯一(彻底独立)；N≥2 仍是在候选里按路径自我印证，不是纯真值。
$候选真值上限 = 1
# 普通野生/定点在单轮达到此候选数时，不再按路径猜测，改用跨组共同区筛选。
$跨组筛选候选阈值 = 5
$跨组筛选候选容量 = 200

# 分层扩窗(方向3)：仅当反查无结果时逐层放宽窗口，正常命中路径不受影响，无覆盖回退
# 扩窗层数上限：最多向外扩展几层，0=关闭分层扩窗
$扩窗层数上限 = 3
# 各层均为相对目标中心的绝对半宽，不与上一层累计。
$扩窗第1层Seed容差 = 25
$扩窗第1层帧半宽 = 5000
$扩窗第2层Seed容差 = 30
$扩窗第2层帧半宽 = 10000
$扩窗第3层Seed容差 = 30
$扩窗第3层帧半宽 = 30000

# ╔══════════════════════════════════════════════════════════════╗
# ║                           全局变量                            ║
# ╚══════════════════════════════════════════════════════════════╝
# 全局变量没问题不建议修改

# ==================================================
# 1. 自动校准配置
# ==================================================

# 路径自适应 + 分轴校准：路径簇负责候选选择/离群诊断；Seed校准另用最终命中绝对落点滚动众数；帧轴保留目标阻尼。
# 候选选择：按残差到“路径中心”的加权平方距离最小者为最优（沿轨迹连续，排伪候选）。
# Seed修正：由用户输入区的Seed校准方案选择原始12轮众数或实验锁定细调。
# 路径中心：最近命中最聚集簇中心，供下一轮候选选择和离群诊断，不直接作为Seed单轮残差修正量。
# 定点比例：β 等系数用整数定点表示，比例=1000 即三位小数精度
$定点比例 = 1000
# 路径中心 EWA 平滑系数 β（定点×比例）：越大越跟随近期残差、越小越平滑迟钝。仅作用于候选选择的路径中心，不降低修正
$路径EWA系数 = 500
# 旧固定路径容差保留为兼容占位；本轮可信改用各轴“动态窗*3”。
$路径容差Seed = 3
$路径容差帧 = 3
# 路径重锚阈值：真值解(候选≤N 的独立解)若偏离当前预测中心超此值 → 判定中心已被错路径带偏 → 直接 snap 重锚到真值，丢弃旧中心
$路径重锚阈值 = 4
# 直接选择接近阈值：归一化误差绝对值 ≤ 此值视为已贴近目标
$直接选择接近阈值 = 2
# 候选加权平方距离权重：Seed 权重远大于帧 → Seed 为主、帧做次级区分（沿用“先Seed后帧”优先级）
$候选权重Seed = 100
$候选权重帧 = 1
# 非目标Seed的±1剩余帧可能来自Seed各自的VBlank路径，不应追着微调；绝对偏差大于1仍照常校准。
$非目标Seed剩余帧冻结阈值 = 1
# 目标Seed进入稳态后，单轮±1帧不修正、不累计半量余数；仅绝对相位窗口达到3/5时慢修正。
$目标Seed剩余帧抖动死区 = 1
# 慢修正：最近N个目标Seed样本记录绝对相位落点，按当前累计修正投影回残差。
# 0和反号会占用窗口但不清空历史；自动调整F1/TV/F2后证据仍可换算复用，明确路径重锚时才清空。
$剩余帧慢修正窗口大小 = 5
$剩余帧慢修正触发票数 = 3
$剩余帧慢修正误差上限 = 1
# 帧轴一旦精确命中，后续使用同一参数再观察10个可信样本；期间不改整圈或相位参数。
$帧命中保持样本数 = 10
# Seed校准方案0：首轮限幅快速靠近，第2轮限幅半量，第3轮起跟随12轮最终命中绝对落点众数。
# Seed校准方案1：进入目标±1后锁定；首次精确命中前单侧达到3票即可提前定案，之后仍用完整5次窗口。
# 相邻整索引反转后按固定半步毫秒细调。
$Seed冷启动单轮修正上限 = 4
$Seed稳态启用样本数 = 3
$Seed稳态单轮修正上限 = 2
$Seed锁定范围 = 1
$Seed锁定窗口大小 = 5
$Seed锁定提前多数票数 = 3
$Seed命中保持样本数 = 5
$Seed命中保持最少方向样本数 = 3
# 进入锁定后只允许逐个Seed移动，避免多分支短期众数造成±4往返跳变。
$Seed锁定单轮修正上限 = 1

# 帧路径“候选历史投票”：每轮把每个候选换算成绝对偏差(=帧残差+已累计帧修正,对真路径恒定)投进直方图，
# 跨轮累计，票数最高者=真路径(个别噪声轮撼动不了多数票)，换回当前残差空间即帧路径中心。半宽=直方图覆盖±N帧。
$帧投票半宽 = 40
$帧投票槽数 = 81
# Seed 路径同逻辑投票（绝对偏差=差索引+已累计Seed索引修正）。半宽=20 个 seed（覆盖 ±Seed容差）。
$Seed投票半宽 = 20
$Seed投票槽数 = 41
# 票堆聚合窗：固有随机抖动让真路径票散到相邻格，求众数按“中心±窗内票数和(堆高)”取最高坨，容忍抖动。
# 范围未知→先给保守小窗(Seed±1/帧±2)，覆盖典型小抖动；后续可按观测到的堆宽自适应放大。
$票堆Seed窗 = 1
$票堆帧窗 = 2
# 投票停糖(问题2)：联合票堆领先次高堆≥阈值 且 最优路径连续稳定≥轮数 → 路径已确定，不再吃糖、直接用投票路径校准。
# 可撤销：领先消失/最优键变 → 稳定计数重置、恢复吃糖。判据"领先且稳定几轮"=稳健(用户选)。
$停糖领先阈值 = 4
$停糖稳定轮数 = 3

# 死区相关变量保留为 0（仅供 BINGO 显示等历史引用，不再参与校准）
$Seed帧死区 = 0
$SeedMS校准死区 = 0
$Seed负向死区 = 0
$Seed正向死区 = 0
$SeedMS负向死区 = 0
$SeedMS正向死区 = 0
$temp = 获取Seed单边死区($Seed负向死区, $Seed正向死区)
$消耗帧校准死区 = 0
$消耗帧负向死区 = 0
$消耗帧正向死区 = 0

# TV单次消耗帧
$TV单次消耗帧 = 314
# TV路线基线：实际消耗帧 = 路线基线 + TV等待帧×314 + F1/F2等待帧。
# 中央草丛基线由实测 28728 - 106×314 - 86 - 1 得到；其他草丛路线按第0轮实际路线耗时与中央路线耗时之差，以120 advances/s换算。
$TV路线基线未配置 = 99999999
$狩猎区入口草丛TV路线基线 = -4643
$狩猎区入口草丛参考路线耗时 = 2200
$狩猎区路线实际耗时 = 0
# 伊机控1.6.4-a的TV公共固定推进：进入/退出TV带来2个完整周期，
# 其余固定流程稳定落在47帧相位；目标差异继续由总消耗帧基础补偿承担。
$TV首轮固定推进圈数 = 2
$TV首轮固定推进相位 = 47
# TV_CYCLE_ESCAPE：圈误差正负交替且半量余数持续抵消时，强制执行一次整圈修正。
# 连续多少次“反号且正常圈修正为0”后脱困；3代表观测到至少4轮交替。
$TV圈交替脱困轮数 = 3
# 同一目标最多强制脱困次数；超过后停止，避免永久校准循环。
$TV圈脱困次数上限 = 3
# TV双分支锁：同一TV等待帧下，目标Seed若同时出现0圈与相邻±1圈，且圈内误差均在此范围，
# 视为游戏内部VBlank随机分支。锁定后不再追逐±314整圈，只继续校准圈内剩余帧。
$TV双分支相位阈值 = 8
# 未锁定双分支时，TV整圈±1默认冻结；同一帧参数最近10轮内同偏差达到5票才修正。
# TV圈窗口允许非目标Seed提供证据，避免真实持续整圈偏差长期不动。
$TV帧慢修正窗口大小 = 10
$TV帧慢修正触发票数 = 5

