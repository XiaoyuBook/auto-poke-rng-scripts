FUNC 孵蛋流程_校验Held无蛋区间表(): INT
    $孵蛋Held无蛋表有效 = 0
    IF $孵蛋Held无蛋表Seed == ""
        PRINT 孵蛋Held无蛋区间表为空：可执行基础校准，但微调阶段命中目标Seed且无蛋时将停止
        RETURN 0
    ENDIF
    $孵蛋流程表Seed十进制 = HEX转十进制($孵蛋Held无蛋表Seed)
    $孵蛋流程当前目标Seed十进制 = HEX转十进制($目标Seed)
    IF $孵蛋流程表Seed十进制 < 0 or $孵蛋流程表Seed十进制 != $孵蛋流程当前目标Seed十进制
        PRINT 孵蛋Held无蛋区间表Seed与当前目标不一致，禁止跳区
        RETURN 0
    ENDIF
    IF $孵蛋Held无蛋表目标帧 != $孵蛋生成目标帧 or $孵蛋Held无蛋表相性 != $孵蛋双亲相性 or $孵蛋Held无蛋表Offset != $孵蛋HeldOffset
        PRINT 孵蛋Held无蛋区间表签名与当前Held目标、相性或Offset不一致，禁止跳区
        RETURN 0
    ENDIF
    IF $孵蛋Held无蛋表最小帧 > $孵蛋生成目标帧 - $孵蛋Held反查帧容差 or $孵蛋Held无蛋表最大帧 < $孵蛋生成目标帧 + $孵蛋Held反查帧容差
        PRINT 孵蛋Held无蛋区间表没有覆盖完整反查窗口，禁止跳区
        RETURN 0
    ENDIF
    $孵蛋流程无蛋区间数量 = LEN($孵蛋Held无蛋区间起点表)
    IF $孵蛋流程无蛋区间数量 <= 0 or LEN($孵蛋Held无蛋区间终点表) != $孵蛋流程无蛋区间数量
        PRINT 孵蛋Held无蛋区间表为空或起止数量不一致，禁止跳区
        RETURN 0
    ENDIF
    $孵蛋流程无蛋区间末索引 = $孵蛋流程无蛋区间数量 - 1
    $孵蛋流程无蛋区间上个终点 = $孵蛋Held无蛋表最小帧 - 1
    FOR $孵蛋流程无蛋区间查找索引 = 0 TO $孵蛋流程无蛋区间末索引
        $孵蛋流程无蛋区间当前起点 = $孵蛋Held无蛋区间起点表[$孵蛋流程无蛋区间查找索引]
        $孵蛋流程无蛋区间当前终点 = $孵蛋Held无蛋区间终点表[$孵蛋流程无蛋区间查找索引]
        IF $孵蛋流程无蛋区间当前起点 < $孵蛋Held无蛋表最小帧 or $孵蛋流程无蛋区间当前终点 > $孵蛋Held无蛋表最大帧 or $孵蛋流程无蛋区间当前起点 > $孵蛋流程无蛋区间当前终点 or $孵蛋流程无蛋区间当前起点 <= $孵蛋流程无蛋区间上个终点
            PRINT 孵蛋Held无蛋区间表含越界、倒序或重叠区间，禁止跳区
            RETURN 0
        ENDIF
        $孵蛋流程无蛋区间上个终点 = $孵蛋流程无蛋区间当前终点
    NEXT
    $孵蛋Held无蛋表有效 = 1
    IF $调试日志输出 == 1
        PRINT 孵蛋Held无蛋区间表已启用: & $孵蛋Held无蛋表最小帧 & "-" & $孵蛋Held无蛋表最大帧 & "，区间 " & $孵蛋流程无蛋区间数量
    ENDIF
    RETURN 1
ENDFUNC

FUNC 孵蛋流程_解析并校验配置(): INT
    IF $孵蛋同Seed模式 != 1
        PRINT 当前原操作流程只支持同Seed模式，请把孵蛋同Seed模式设为1
        RETURN 0
    ENDIF
    $孵蛋Seed关系模式 = 0
    $孵蛋生成目标帧 = $目标消耗帧

    # 与其他模式共用目标名称/图鉴编号输入。
    IF $目标宝可梦名称 != ""
        $孵蛋流程蛋种名称解析结果 = 目标宝可梦名称查图鉴编号($目标宝可梦名称)
        IF $孵蛋流程蛋种名称解析结果 < 1
            PRINT 未找到孵蛋蛋种名称: & $目标宝可梦名称
            PRINT 请填写TenLines显示的中文名、英文名，或留空后使用全国图鉴编号
            RETURN 0
        ENDIF
        $孵蛋蛋种族全国图鉴编号 = $孵蛋流程蛋种名称解析结果
    ELSE
        $孵蛋蛋种族全国图鉴编号 = $目标全国图鉴编号
    ENDIF
    IF $孵蛋蛋种族全国图鉴编号 < 1 or $孵蛋蛋种族全国图鉴编号 > 386
        PRINT 孵蛋蛋种族图鉴编号无效: & $孵蛋蛋种族全国图鉴编号
        RETURN 0
    ENDIF
    # 孵蛋的野生Seed验证只复用录像开关，不启用普通野生的非目标闪光停止。
    $孵蛋流程普通闪光策略结果 = 设置普通闪光策略($孵蛋蛋种族全国图鉴编号, 0, $出闪录像, $出闪录像长按MS)
    IF $孵蛋流程普通闪光策略结果 != 1
        RETURN 0
    ENDIF
    IF $孵蛋生成目标帧 <= 0 or $孵蛋领取目标帧 - $孵蛋生成目标帧 < $孵蛋领取路线最小间隔帧
        PRINT 孵蛋目标帧无效: Held/生成 & $孵蛋生成目标帧 & "，Pickup/领取 " & $孵蛋领取目标帧
        PRINT 领取帧至少需要比生成帧晚 & $孵蛋领取路线最小间隔帧 & " 帧，才能完成出门检查和领取对话
        RETURN 0
    ENDIF
    IF $孵蛋Held固定预校准帧 < 0 or $孵蛋Pickup固定预校准帧 < 0
        PRINT 孵蛋固定预校准不能为负数
        RETURN 0
    ENDIF
    IF $孵蛋生成目标帧 - $孵蛋Held固定预校准帧 <= 0 or $孵蛋领取目标帧 - $孵蛋Pickup固定预校准帧 <= 0
        PRINT 孵蛋固定预校准后的请求帧无效
        RETURN 0
    ENDIF
    IF $孵蛋Held反查帧容差 < 0 or $孵蛋Pickup反查帧容差 < 0 or $孵蛋跨轮近目标阈值 < 0
        PRINT 孵蛋蛋个体反查窗口无效
        RETURN 0
    ENDIF
    IF $孵蛋Pickup稳定所需连续次数 <= 0 or $孵蛋普通无蛋复核阈值 <= 0 or $孵蛋普通目标Seed无蛋上限 <= 0 or $孵蛋无蛋区间确认次数 <= 0 or $孵蛋无蛋区间最大推断距离 < 0 or $孵蛋无蛋最大跳出次数 <= 0 or $孵蛋无蛋跳出最大绝对偏移帧 <= 0
        PRINT 孵蛋Pickup稳定或无蛋脱困参数无效
        RETURN 0
    ENDIF
    IF ($孵蛋亲本A性别 != "雄" and $孵蛋亲本A性别 != "雌" and $孵蛋亲本A性别 != "无性别" and $孵蛋亲本A性别 != "百变怪") or ($孵蛋亲本B性别 != "雄" and $孵蛋亲本B性别 != "雌" and $孵蛋亲本B性别 != "无性别" and $孵蛋亲本B性别 != "百变怪")
        PRINT 孵蛋亲本类型填写无效: 只能填写雄、雌、无性别或百变怪
        RETURN 0
    ENDIF
    IF $孵蛋亲本A性别 != "百变怪" and $孵蛋亲本B性别 != "百变怪"
        IF ($孵蛋亲本A性别 != "雄" or $孵蛋亲本B性别 != "雌") and ($孵蛋亲本A性别 != "雌" or $孵蛋亲本B性别 != "雄")
            PRINT 孵蛋亲本组合无效: 需要雄+雌或一只百变怪
            RETURN 0
        ENDIF
    ELSE
        IF $孵蛋亲本A性别 == "百变怪" and $孵蛋亲本B性别 == "百变怪"
            PRINT 孵蛋亲本组合无效: 两只百变怪不能孵蛋
            RETURN 0
        ENDIF
    ENDIF
    IF $孵蛋双亲相性 != 20 and $孵蛋双亲相性 != 50 and $孵蛋双亲相性 != 70
        PRINT 孵蛋双亲相性无效: & $孵蛋双亲相性
        RETURN 0
    ENDIF
    $孵蛋流程周期预检 = 孵蛋测试_计算孵化循环数($孵蛋蛋种族全国图鉴编号, $孵蛋孵化周期覆盖, $孵蛋骑车每循环步数, $孵蛋孵化安全循环数)
    IF $孵蛋流程周期预检 <= 0
        RETURN 0
    ENDIF
    $孵蛋流程双亲预检 = 孵蛋反查_设置双亲($孵蛋双亲A_HP, $孵蛋双亲A_ATK, $孵蛋双亲A_DEF, $孵蛋双亲A_SPA, $孵蛋双亲A_SPD, $孵蛋双亲A_SPE, $孵蛋双亲B_HP, $孵蛋双亲B_ATK, $孵蛋双亲B_DEF, $孵蛋双亲B_SPA, $孵蛋双亲B_SPD, $孵蛋双亲B_SPE)
    IF $孵蛋流程双亲预检 != 1
        PRINT 孵蛋双亲IV配置无效
        RETURN 0
    ENDIF
    IF $孵蛋野生Seed容差 < 0 or $孵蛋野生最小消耗帧 < 0 or $孵蛋野生最大消耗帧 < $孵蛋野生最小消耗帧
        PRINT 孵蛋内部野生Seed反查窗口无效
        RETURN 0
    ENDIF
    $孵蛋流程无蛋表校验结果 = 孵蛋流程_校验Held无蛋区间表()
    RETURN 1
ENDFUNC

FUNC 孵蛋流程_加载Seed配置(): INT
    $游戏版本 = 规范化游戏版本($游戏版本文本)
    IF $游戏版本 < 0
        PRINT 孵蛋游戏版本无效: & $游戏版本文本
        RETURN 0
    ENDIF
    $Seed最大索引 = 取Seed最大索引($游戏版本)
    $孵蛋流程目标Seed十进制 = HEX转十进制($目标Seed)
    IF $Seed最大索引 < 0 or $孵蛋流程目标Seed十进制 < 0
        PRINT 孵蛋Seed表或目标Seed无效
        RETURN 0
    ENDIF

    $目标索引 = -1
    FOR $孵蛋流程Seed索引 = 0 TO $Seed最大索引
        $孵蛋流程查表Seed = 取SeedHEX($游戏版本, $孵蛋流程Seed索引, $Seed模式)
        IF HEX转十进制($孵蛋流程查表Seed) == $孵蛋流程目标Seed十进制
            $目标索引 = $孵蛋流程Seed索引
            BREAK
        ENDIF
    NEXT
    IF $目标索引 < 0
        PRINT 孵蛋目标Seed不在当前版本/模式Seed表中: & $目标Seed
        RETURN 0
    ENDIF

    $NXSeed平台偏移MS = 0
    IF $NX机型 == 2
        $NXSeed平台偏移MS = -750
    ELIF $NX机型 != 1
        PRINT 孵蛋NX机型无效: & $NX机型
        RETURN 0
    ENDIF
    RETURN 1
ENDFUNC

FUNC 孵蛋流程_准备野生反查(): INT
    # 四之岛水面：FR为可达鸭/乌波，LG为呆呆兽/玛力露；实际物种由OCR后动态刷新。
    $遭遇类型 = 2
    $遭遇方法 = 102
    $遭遇地点 = 106
    $遭遇方法名称 = 目标遭遇方法名称($遭遇方法)
    $遭遇地点名称 = 目标遭遇地点名称($遭遇地点)
    $孵蛋流程野生槽结果 = 加载野生遇敌槽数据()
    IF $孵蛋流程野生槽结果 != 1
        RETURN 0
    ENDIF

    $努力HP = 0
    $努力ATK = 0
    $努力DEF = 0
    $努力SPA = 0
    $努力SPD = 0
    $努力SPE = 0
    $道具乱数模式 = 0
    $进入TV = 0
    $Seed累计修正索引 = 0
    $消耗帧实际执行修正量 = 0
    $反查算法 = 199
    $投票忽略 = 投票设置配置(157, 315, 0, 1, 0, $票堆帧窗, $票堆Seed窗, $Seed投票半宽, $Seed投票槽数, $停糖领先阈值, $停糖稳定轮数)
    CALL 投票重置
    CALL 投票重置Seed校准
    $Seed锁定启用 = 0
    $Seed锁定窗口样本数 = 0
    $Seed锁定窗口指针 = 0
    $Seed粗调上次有效 = 0
    $Seed精细校准启用 = 0
    $Seed精细修正MS = 0
    $Seed精细固定半步MS = 0
    $Seed命中保持启用 = 0
    $Seed命中保持计数 = 0
    $Seed命中保持正方向票数 = 0
    $Seed命中保持负方向票数 = 0
    $Seed曾命中目标 = 0
    $方案2Seed接续启用 = 0
    $方案2Seed接续正方向票数 = 0
    $方案2Seed接续负方向票数 = 0
    RETURN 1
ENDFUNC

FUNC 孵蛋流程_初始化Seed与野生反查(): INT
    $孵蛋流程配置结果 = 孵蛋流程_解析并校验配置()
    IF $孵蛋流程配置结果 != 1
        RETURN 0
    ENDIF
    $孵蛋流程Seed配置结果 = 孵蛋流程_加载Seed配置()
    IF $孵蛋流程Seed配置结果 != 1
        RETURN 0
    ENDIF
    $孵蛋蛋种名称文本 = 目标中文名称($游戏版本, $孵蛋蛋种族全国图鉴编号)
    IF $调试日志输出 == 1
        PRINT 孵蛋蛋种: & $孵蛋蛋种名称文本 & "（全国图鉴 " & $孵蛋蛋种族全国图鉴编号 & "）"
        PRINT 孵蛋目标: Seed & $目标Seed & "，Held " & $孵蛋生成目标帧 & "，Pickup " & $孵蛋领取目标帧
        PRINT 孵蛋固定预校准: Held - & $孵蛋Held固定预校准帧 & "，Pickup -" & $孵蛋Pickup固定预校准帧
        PRINT 孵蛋反查窗口: Held ± & $孵蛋Held反查帧容差 & "，Pickup ±" & $孵蛋Pickup反查帧容差
        PRINT 孵蛋微调门槛: Pickup连续精确 & $孵蛋Pickup稳定所需连续次数 & " 次；无蛋区间连续确认 " & $孵蛋无蛋区间确认次数 & " 次"
        PRINT 亲本: A & $孵蛋亲本A性别 & "，B " & $孵蛋亲本B性别 & "，相性 " & $孵蛋双亲相性
    ELSE
        PRINT 孵蛋目标: & $孵蛋蛋种名称文本 & "，Seed " & $目标Seed & "，Held " & $孵蛋生成目标帧 & "，Pickup " & $孵蛋领取目标帧
    ENDIF
    $孵蛋流程野生准备结果 = 孵蛋流程_准备野生反查()
    IF $孵蛋流程野生准备结果 != 1
        RETURN 0
    ENDIF
    RETURN 1
ENDFUNC

# -------------------- 菜单与队伍槽 --------------------

# GUI 孵蛋运行时覆盖：按目标身份选择队伍末位或固定槽位
FUNC 孵蛋流程_选择队伍槽($队伍位置: INT, $目标为队伍末位: INT): INT
    IF $目标为队伍末位 == 1
        # 刚抓到的野生永远位于当前队伍末位；从队首向上绕过取消按钮只需两次。
        RETURN 反查_队伍页按上移次数选择目标(2)
    ELIF $队伍位置 == 5
        # 复用普通定点的末位反查导航；蛋在第5位、复核野生在第6位，因此多按一次UP。
        RETURN 反查_队伍页按上移次数选择目标(3)
    ELIF $队伍位置 == 6
        RETURN 反查_队伍页按上移次数选择目标(2)
    ELSE
        PRINT 孵蛋队伍槽参数无效: & $队伍位置
        RETURN 0
    ENDIF
ENDFUNC

FUNC 孵蛋流程_打开指定槽能力页($队伍位置: INT, $目标为队伍末位: INT): INT
    X
    WAIT 500
    A
    WAIT 1500
    $孵蛋流程选槽结果 = 孵蛋流程_选择队伍槽($队伍位置, $目标为队伍末位)
    IF $孵蛋流程选槽结果 != 1
        RETURN 0
    ENDIF
    A
    WAIT 500
    A
    WAIT 1500
    $刚使用神奇糖果 = 0
    RETURN 1
ENDFUNC

# 孵蛋反查喂糖后仍在队伍菜单返回能力页；蛋固定在第5位，不能复用通用末位(第6位)导航。
FUNC 孵蛋流程_喂糖后打开蛋能力页(): INT
    UP
    WAIT 500
    A
    WAIT 1500
    UP
    WAIT 500
    UP
    WAIT 500
    UP
    WAIT 500
    A
    WAIT 500
    A
    WAIT 1500
    $刚使用神奇糖果 = 0
    RETURN 1
ENDFUNC

# -------------------- 野生Seed验证 --------------------

FUNC 孵蛋流程_同步Seed验证野生(): INT
    $获取结果_图鉴编号 = 读取获取结果图鉴编号()
    $获取结果_抓捕结果 = 读取获取结果抓捕结果()
    $获取结果_名称 = 读取获取结果名称()
    IF $获取结果_抓捕结果 != 1 or $获取结果_图鉴编号 <= 0
        PRINT 孵蛋Seed验证野生抓捕结果无效
        RETURN 0
    ENDIF
    $运行前目标全国图鉴编号 = $获取结果_图鉴编号
    $目标全国图鉴编号 = $获取结果_图鉴编号
    $孵蛋流程野生同步结果 = 同步野生目标识别结果()
    IF $孵蛋流程野生同步结果 != 1
        RETURN 0
    ENDIF
    RETURN 1
ENDFUNC

FUNC 孵蛋流程_验证野生Seed($队伍位置: INT): INT
    $本轮糖果次数 = 0
    $野生遭遇初始等级 = -1
    $目标消耗帧 = ($孵蛋野生最小消耗帧 + $孵蛋野生最大消耗帧) / 2
    $最小消耗帧 = $孵蛋野生最小消耗帧
    $最大消耗帧 = $孵蛋野生最大消耗帧
    $反查算法 = 199
    $孵蛋流程开页结果 = 孵蛋流程_打开指定槽能力页($队伍位置, 1)

    # 同一只野生扩窗后，后续吃糖继续使用扩大窗口；下一只重新从默认窗口开始。
    $有效Seed容差 = $孵蛋野生Seed容差
    $有效最小消耗帧 = $孵蛋野生最小消耗帧
    $有效最大消耗帧 = $孵蛋野生最大消耗帧
    FOR
        $孵蛋流程识图结果 = 读取并输出识图结果()
        IF $孵蛋流程识图结果 != 1
            RETURN 0
        ENDIF
        IF $野生遭遇初始等级 < 0
            $野生遭遇初始等级 = $等级
            $野生等级校验结果 = 校验野生遭遇初始等级()
            IF $野生等级校验结果 != 1
                RETURN 0
            ENDIF
        ENDIF
        $孵蛋流程反查准备 = 准备反查参数与输出()
        IF $孵蛋流程反查准备 != 1
            RETURN 0
        ENDIF

        $孵蛋流程扫描结果 = 执行反查扫描()
        IF $孵蛋流程扫描结果 != 1 and $有效Seed容差 == $孵蛋野生Seed容差
            # 仅默认窗口无候选时追加一档：Seed前后各5，帧上限增加1000，下限不变。
            $有效Seed容差 = $孵蛋野生Seed容差 + 5
            $有效最大消耗帧 = $孵蛋野生最大消耗帧 + 1000
            IF $调试日志输出 == 1
                PRINT 孵蛋野生Seed反查无候选，追加一档扩窗
                PRINT 有效Seed容差: ± & $有效Seed容差 & "，有效消耗帧范围: " & $有效最小消耗帧 & "-" & $有效最大消耗帧
            ENDIF
            $孵蛋流程扫描结果 = 执行反查扫描()
        ENDIF
        IF $孵蛋流程扫描结果 != 1
            PRINT 孵蛋野生Seed反查无候选
            RETURN 0
        ENDIF

        IF $候选全部同一Seed == 1
            IF $调试日志输出 == 1
                PRINT 孵蛋野生反查候选全部归属于Seed差: & $候选同一Seed值
            ENDIF
            IF $候选同一Seed值 == 0
                IF $调试日志输出 == 1
                    PRINT 孵蛋Seed验证: 命中目标Seed
                    CALL 输出最佳命中结果
                ELSE
                    PRINT Seed结果: 命中目标Seed
                ENDIF
                RETURN 1
            ENDIF
            IF $调试日志输出 == 1
                PRINT 孵蛋Seed验证: 命中非目标Seed，本轮丢弃
            ELSE
                PRINT Seed结果: 偏差 & $候选同一Seed值 & "，未命中目标"
            ENDIF
            RETURN 2
        ENDIF

        IF $本轮糖果次数 >= $孵蛋野生最多糖果
            PRINT 孵蛋野生反查仍跨多个Seed，达到糖果上限
            RETURN 0
        ENDIF
        $神奇糖果结果 = 孵蛋测试_使用神奇糖果指定槽($队伍位置, 1)
        IF $神奇糖果结果 != 1
            RETURN 0
        ENDIF
        $本轮糖果次数 += 1
        $刚使用神奇糖果 = 1
        CALL 打开能力值识图页面
    NEXT
    # EasyCon 会把 FOR 视为可能结束；正常流程不会到这里。
    RETURN 0
ENDFUNC

FUNC 孵蛋流程_执行野生Seed反查($队伍位置: INT): INT
    $孵蛋流程同步结果 = 孵蛋流程_同步Seed验证野生()
    IF $孵蛋流程同步结果 != 1
        $目标消耗帧 = $孵蛋生成目标帧
        $目标全国图鉴编号 = $孵蛋蛋种族全国图鉴编号
        $运行前目标全国图鉴编号 = $孵蛋蛋种族全国图鉴编号
        RETURN 0
    ENDIF
    $孵蛋流程Seed验证结果 = 孵蛋流程_验证野生Seed($队伍位置)
    # 野生反查会临时占用通用目标变量；返回孵蛋阶段前必须恢复。
    $目标消耗帧 = $孵蛋生成目标帧
    $目标全国图鉴编号 = $孵蛋蛋种族全国图鉴编号
    $运行前目标全国图鉴编号 = $孵蛋蛋种族全国图鉴编号
    RETURN $孵蛋流程Seed验证结果
ENDFUNC

# GUI 孵蛋运行时覆盖：复用 Seed 锁定、固定半步与方案2方向票接续控制器
# 本文件由 Python 替换到 1.1.8 的孵蛋主脚本，不单独执行。

$孵蛋Seed控制器已初始化 = 0
$孵蛋Seed控制器初始累计索引 = 0
$孵蛋流程目标Seed基准MS = 0
$孵蛋流程Seed控制器初始化结果 = 0

FUNC 孵蛋流程_初始化Seed校准控制器(): INT
    IF $孵蛋Seed控制器已初始化 == 1
        RETURN 1
    ENDIF

    $孵蛋Seed控制器初始累计索引 = $Seed预校准索引_NS1
    IF $NX机型 == 2
        $孵蛋Seed控制器初始累计索引 = $Seed预校准索引_NS2
    ENDIF
    $Seed累计修正索引 = $孵蛋Seed控制器初始累计索引
    $Seed修正目标索引 = $目标索引 + $Seed累计修正索引
    IF $Seed修正目标索引 < 0
        $Seed修正目标索引 = 0
    ENDIF
    IF $Seed修正目标索引 > $Seed最大索引
        $Seed修正目标索引 = $Seed最大索引
    ENDIF
    $SeedMS实际执行修正量 = 取MS($游戏版本, $Seed修正目标索引) - 取MS($游戏版本, $目标索引)
    $SeedMS上次实际执行修正量 = $SeedMS实际执行修正量

    # 与主脚本方案1/2共用同一个计算函数；这里只重置该控制器的跨轮状态。
    $Seed锁定启用 = 0
    $Seed锁定窗口样本数 = 0
    $Seed锁定窗口指针 = 0
    $Seed粗调上次有效 = 0
    $Seed精细校准启用 = 0
    $Seed精细修正MS = 0
    $Seed精细固定半步MS = 0
    $Seed命中保持启用 = 0
    $Seed命中保持计数 = 0
    $Seed命中保持正方向票数 = 0
    $Seed命中保持负方向票数 = 0
    $Seed曾命中目标 = 0
    $方案2Seed接续启用 = 0
    $方案2Seed接续正方向票数 = 0
    $方案2Seed接续负方向票数 = 0
    $Seed锁定参数累计修正 = $Seed累计修正索引
    $Seed锁定参数精细修正MS = 0
    $孵蛋Seed控制器已初始化 = 1
    IF $调试日志输出 == 1
        PRINT 孵蛋Seed校准控制器: 正式版±1五次多数、固定半步与命中后连续5次未命中保持，初始累计索引 & $Seed累计修正索引
    ENDIF
    RETURN 1
ENDFUNC

FUNC 孵蛋流程_按观测Seed校正等待($Seed差索引: INT): INT
    $孵蛋流程观测Seed索引 = $目标索引 + $Seed差索引
    IF $孵蛋流程观测Seed索引 < 0 or $孵蛋流程观测Seed索引 > $Seed最大索引
        PRINT 孵蛋Seed校正索引越界: & $孵蛋流程观测Seed索引
        RETURN 0
    ENDIF

    $孵蛋流程Seed控制器初始化结果 = 孵蛋流程_初始化Seed校准控制器()
    IF $孵蛋流程Seed控制器初始化结果 != 1
        RETURN 0
    ENDIF

    # 野生反查只有在全部候选属于同一个 Seed 时才会进入这里，因此本轮 Seed 轴可信。
    $命中差索引 = $Seed差索引
    $Seed差绝对 = $Seed差索引
    IF $Seed差绝对 < 0
        $Seed差绝对 = 0 - $Seed差绝对
    ENDIF
    $Seed本轮可信 = 1
    $Seed本次修正索引 = 计算Seed锁定众数修正()

    $Seed累计修正索引 = 累加实际执行修正量($Seed累计修正索引, $Seed本次修正索引)
    $Seed修正目标索引 = $目标索引 + $Seed累计修正索引
    IF $Seed修正目标索引 < 0
        $Seed修正目标索引 = 0
    ENDIF
    IF $Seed修正目标索引 > $Seed最大索引
        $Seed修正目标索引 = $Seed最大索引
    ENDIF
    $SeedMS上次实际执行修正量 = $SeedMS实际执行修正量
    $SeedMS实际执行修正量 = 取MS($游戏版本, $Seed修正目标索引) - 取MS($游戏版本, $目标索引)
    $SeedMS本次新增修正量 = $SeedMS实际执行修正量 - $SeedMS上次实际执行修正量

    $孵蛋流程目标Seed基准MS = 取MS($游戏版本, $目标索引) + $NXSeed平台偏移MS
    $孵蛋Seed等待MS = $孵蛋流程目标Seed基准MS - $SeedMS实际执行修正量 + $Seed基础补偿 + $Seed精细修正MS
    IF $孵蛋Seed等待MS <= 0
        PRINT 孵蛋Seed校准生成了无效等待: & $孵蛋Seed等待MS
        RETURN 0
    ENDIF

    IF $调试日志输出 == 1
        PRINT 【孵蛋Seed校准】
        PRINT 观测差: & $Seed差索引 & "；修正模式: " & $Seed修正模式文本
        PRINT 索引修正: 本次 & $Seed本次修正索引 & "，累计 " & $Seed累计修正索引 & "，查表累计 " & $SeedMS实际执行修正量 & " ms"
        PRINT 毫秒细调: 启用 & $Seed精细校准启用 & "，固定半步 " & $Seed精细固定半步MS & " ms，当前 " & $Seed精细修正MS & " ms"
        PRINT 目标Seed保持: & $Seed命中保持启用 & "，观察次数 " & $Seed命中保持计数 & "/" & $Seed命中保持样本数 & "，方向票 -" & $Seed命中保持负方向票数 & "/+" & $Seed命中保持正方向票数
        IF $Seed校准方案 == 2
            PRINT 方案2接续方向票: 启用 & $方案2Seed接续启用 & "，方向票 -" & $方案2Seed接续负方向票数 & "/+" & $方案2Seed接续正方向票数
        ENDIF
        PRINT 下轮Seed等待: & $孵蛋Seed等待MS & " ms"
    ELSE
        PRINT 下轮Seed请求: & $孵蛋Seed等待MS & " ms"
    ENDIF
    RETURN 1
ENDFUNC

# -------------------- 蛋个体反查 --------------------

FUNC 孵蛋流程_读取当前蛋个体范围(): INT
    $孵蛋流程识图结果 = 读取并输出识图结果()
    IF $孵蛋流程识图结果 != 1
        RETURN 0
    ENDIF
    $种族HP = 取种族HP($游戏版本, $目标全国图鉴编号)
    $种族ATK = 取种族ATK($游戏版本, $目标全国图鉴编号)
    $种族DEF = 取种族DEF($游戏版本, $目标全国图鉴编号)
    $种族SPA = 取种族SPA($游戏版本, $目标全国图鉴编号)
    $种族SPD = 取种族SPD($游戏版本, $目标全国图鉴编号)
    $种族SPE = 取种族SPE($游戏版本, $目标全国图鉴编号)
    CALL 计算并输出IV范围
    IF $范围有效 != 1
        RETURN 0
    ENDIF
    RETURN 1
ENDFUNC

FUNC 孵蛋流程_准备蛋个体反查(): INT
    $目标全国图鉴编号 = $孵蛋蛋种族全国图鉴编号
    $目标最低等级 = 5
    $目标最高等级 = 5
    $本轮糖果次数 = 0
    $候选细分累计范围有效 = 0
    # 闪光已在蛋能力页入口单独判定为成功；这里借用开关跳过通用函数内部的“见闪即停”。
    $道具乱数模式 = 1
    $孵蛋流程双亲结果 = 孵蛋反查_设置双亲($孵蛋双亲A_HP, $孵蛋双亲A_ATK, $孵蛋双亲A_DEF, $孵蛋双亲A_SPA, $孵蛋双亲A_SPD, $孵蛋双亲A_SPE, $孵蛋双亲B_HP, $孵蛋双亲B_ATK, $孵蛋双亲B_DEF, $孵蛋双亲B_SPA, $孵蛋双亲B_SPD, $孵蛋双亲B_SPE)
    IF $孵蛋流程双亲结果 != 1
        PRINT 孵蛋双亲IV配置无效
        RETURN 0
    ENDIF

    RETURN 1
ENDFUNC

# 多帧候选只有在全部候选给出同一套完整IV时，才可停止继续喂糖。
# 性格与性别已由孵蛋反查的Held预筛统一约束，因此这里只比较六项IV。
FUNC 孵蛋流程_候选个体是否完全一致(): INT
    $孵蛋流程一致检查总数 = 孵蛋反查_取总命中数()
    $孵蛋流程一致检查保存数 = 孵蛋反查_取已保存结果数()
    IF $孵蛋流程一致检查总数 <= 0 or $孵蛋流程一致检查保存数 != $孵蛋流程一致检查总数
        RETURN 0
    ENDIF
    IF $孵蛋流程一致检查保存数 == 1
        RETURN 1
    ENDIF

    $孵蛋流程一致HP = 孵蛋反查_取结果IV(0, 0)
    $孵蛋流程一致ATK = 孵蛋反查_取结果IV(0, 1)
    $孵蛋流程一致DEF = 孵蛋反查_取结果IV(0, 2)
    $孵蛋流程一致SPA = 孵蛋反查_取结果IV(0, 3)
    $孵蛋流程一致SPD = 孵蛋反查_取结果IV(0, 4)
    $孵蛋流程一致SPE = 孵蛋反查_取结果IV(0, 5)
    $孵蛋流程一致检查末索引 = $孵蛋流程一致检查保存数 - 1
    FOR $孵蛋流程一致检查索引 = 1 TO $孵蛋流程一致检查末索引
        $孵蛋流程检查HP = 孵蛋反查_取结果IV($孵蛋流程一致检查索引, 0)
        $孵蛋流程检查ATK = 孵蛋反查_取结果IV($孵蛋流程一致检查索引, 1)
        $孵蛋流程检查DEF = 孵蛋反查_取结果IV($孵蛋流程一致检查索引, 2)
        $孵蛋流程检查SPA = 孵蛋反查_取结果IV($孵蛋流程一致检查索引, 3)
        $孵蛋流程检查SPD = 孵蛋反查_取结果IV($孵蛋流程一致检查索引, 4)
        $孵蛋流程检查SPE = 孵蛋反查_取结果IV($孵蛋流程一致检查索引, 5)
        IF $孵蛋流程检查HP != $孵蛋流程一致HP or $孵蛋流程检查ATK != $孵蛋流程一致ATK or $孵蛋流程检查DEF != $孵蛋流程一致DEF or $孵蛋流程检查SPA != $孵蛋流程一致SPA or $孵蛋流程检查SPD != $孵蛋流程一致SPD or $孵蛋流程检查SPE != $孵蛋流程一致SPE
            RETURN 0
        ENDIF
    NEXT
    RETURN 1
ENDFUNC

# 合并当前反查方法的全部候选。停止喂糖的判据必须覆盖 Normal、Split、
# Alternate 与 Mixed 四种方法；任一方法的候选未完整保存时也不能提前收敛。
FUNC 孵蛋流程_合并当前方法候选($方法: INT): INT
    $孵蛋流程合并方法总数 = 孵蛋反查_取总命中数()
    $孵蛋流程合并方法保存数 = 孵蛋反查_取已保存结果数()
    IF $孵蛋流程合并方法总数 <= 0
        RETURN 1
    ENDIF
    $孵蛋流程跨方法候选总数 += $孵蛋流程合并方法总数
    IF $孵蛋流程合并方法保存数 != $孵蛋流程合并方法总数
        $孵蛋流程跨方法候选保存完整 = 0
        $孵蛋流程跨方法候选个体一致 = 0
    ENDIF
    IF $孵蛋流程合并方法保存数 <= 0
        RETURN 1
    ENDIF

    $孵蛋流程合并方法末索引 = $孵蛋流程合并方法保存数 - 1
    FOR $孵蛋流程合并方法索引 = 0 TO $孵蛋流程合并方法末索引
        $孵蛋流程合并HP = 孵蛋反查_取结果IV($孵蛋流程合并方法索引, 0)
        $孵蛋流程合并ATK = 孵蛋反查_取结果IV($孵蛋流程合并方法索引, 1)
        $孵蛋流程合并DEF = 孵蛋反查_取结果IV($孵蛋流程合并方法索引, 2)
        $孵蛋流程合并SPA = 孵蛋反查_取结果IV($孵蛋流程合并方法索引, 3)
        $孵蛋流程合并SPD = 孵蛋反查_取结果IV($孵蛋流程合并方法索引, 4)
        $孵蛋流程合并SPE = 孵蛋反查_取结果IV($孵蛋流程合并方法索引, 5)
        IF $孵蛋流程跨方法参考个体有效 == 0
            $孵蛋流程跨方法参考HP = $孵蛋流程合并HP
            $孵蛋流程跨方法参考ATK = $孵蛋流程合并ATK
            $孵蛋流程跨方法参考DEF = $孵蛋流程合并DEF
            $孵蛋流程跨方法参考SPA = $孵蛋流程合并SPA
            $孵蛋流程跨方法参考SPD = $孵蛋流程合并SPD
            $孵蛋流程跨方法参考SPE = $孵蛋流程合并SPE
            $孵蛋流程跨方法参考个体有效 = 1
        ELIF $孵蛋流程合并HP != $孵蛋流程跨方法参考HP or $孵蛋流程合并ATK != $孵蛋流程跨方法参考ATK or $孵蛋流程合并DEF != $孵蛋流程跨方法参考DEF or $孵蛋流程合并SPA != $孵蛋流程跨方法参考SPA or $孵蛋流程合并SPD != $孵蛋流程跨方法参考SPD or $孵蛋流程合并SPE != $孵蛋流程跨方法参考SPE
            $孵蛋流程跨方法候选个体一致 = 0
        ENDIF

        $孵蛋流程合并Held帧 = 孵蛋反查_取结果Held帧($孵蛋流程合并方法索引)
        $孵蛋流程合并Pickup帧 = 孵蛋反查_取结果Pickup帧($孵蛋流程合并方法索引)
        $孵蛋流程跨方法Held候选表 = APPEND($孵蛋流程跨方法Held候选表, $孵蛋流程合并Held帧)
        $孵蛋流程跨方法Pickup候选表 = APPEND($孵蛋流程跨方法Pickup候选表, $孵蛋流程合并Pickup帧)
        $孵蛋流程跨方法候选方法表 = APPEND($孵蛋流程跨方法候选方法表, $方法)

        $孵蛋流程合并Held已存在 = 0
        IF $孵蛋流程不同Held候选数 > 0
            $孵蛋流程不同Held候选末索引 = $孵蛋流程不同Held候选数 - 1
            FOR $孵蛋流程不同Held候选索引 = 0 TO $孵蛋流程不同Held候选末索引
                IF $孵蛋流程不同Held候选表[$孵蛋流程不同Held候选索引] == $孵蛋流程合并Held帧
                    $孵蛋流程合并Held已存在 = 1
                    BREAK
                ENDIF
            NEXT
        ENDIF
        IF $孵蛋流程合并Held已存在 == 0
            $孵蛋流程不同Held候选表 = APPEND($孵蛋流程不同Held候选表, $孵蛋流程合并Held帧)
            $孵蛋流程不同Held候选数 += 1
        ENDIF

        $孵蛋流程合并Pickup已存在 = 0
        IF $孵蛋流程不同Pickup候选数 > 0
            $孵蛋流程不同Pickup候选末索引 = $孵蛋流程不同Pickup候选数 - 1
            FOR $孵蛋流程不同Pickup候选索引 = 0 TO $孵蛋流程不同Pickup候选末索引
                IF $孵蛋流程不同Pickup候选表[$孵蛋流程不同Pickup候选索引] == $孵蛋流程合并Pickup帧
                    $孵蛋流程合并Pickup已存在 = 1
                    BREAK
                ENDIF
            NEXT
        ENDIF
        IF $孵蛋流程合并Pickup已存在 == 0
            $孵蛋流程不同Pickup候选表 = APPEND($孵蛋流程不同Pickup候选表, $孵蛋流程合并Pickup帧)
            $孵蛋流程不同Pickup候选数 += 1
        ENDIF
        $孵蛋流程当前候选目标命中 = 0
        IF $孵蛋流程合并Held帧 == $孵蛋生成目标帧 and $孵蛋流程合并Pickup帧 == $孵蛋领取目标帧
            $孵蛋流程当前候选目标命中 = 1
        ENDIF
        $孵蛋流程当前候选跳出匹配 = 0
        IF $孵蛋Held临时跳出偏移帧 != 0 and $孵蛋流程无蛋跳出最佳蛋起点 >= 0 and $孵蛋流程合并Held帧 >= $孵蛋流程无蛋跳出最佳蛋起点 and $孵蛋流程合并Held帧 <= $孵蛋流程无蛋跳出最佳蛋终点
            $孵蛋流程当前候选跳出匹配 = 1
        ENDIF
        $孵蛋流程合并Held距离 = $孵蛋流程合并Held帧 - $孵蛋流程候选参考Held帧
        IF $孵蛋流程合并Held距离 < 0
            $孵蛋流程合并Held距离 = -$孵蛋流程合并Held距离
        ENDIF
        $孵蛋流程合并Pickup距离 = $孵蛋流程合并Pickup帧 - $孵蛋领取目标帧
        IF $孵蛋流程合并Pickup距离 < 0
            $孵蛋流程合并Pickup距离 = -$孵蛋流程合并Pickup距离
        ENDIF

        $孵蛋流程替换最佳方法 = 0
        IF $孵蛋流程最佳候选方法 == 0 or $孵蛋流程当前候选目标命中 > $孵蛋流程最佳候选目标命中
            $孵蛋流程替换最佳方法 = 1
        ELIF $孵蛋流程当前候选目标命中 == $孵蛋流程最佳候选目标命中
            IF $孵蛋流程当前候选跳出匹配 > $孵蛋流程最佳候选跳出匹配
                $孵蛋流程替换最佳方法 = 1
            ELIF $孵蛋流程当前候选跳出匹配 == $孵蛋流程最佳候选跳出匹配
                IF $孵蛋流程合并Held距离 < $孵蛋流程最佳候选Held距离
                    $孵蛋流程替换最佳方法 = 1
                ELIF $孵蛋流程合并Held距离 == $孵蛋流程最佳候选Held距离 and $孵蛋流程合并Pickup距离 < $孵蛋流程最佳候选Pickup距离
                    $孵蛋流程替换最佳方法 = 1
                ENDIF
            ENDIF
        ENDIF
        IF $孵蛋流程替换最佳方法 == 1
            $孵蛋流程最佳候选方法 = $方法
            $孵蛋流程最佳候选目标命中 = $孵蛋流程当前候选目标命中
            $孵蛋流程最佳候选跳出匹配 = $孵蛋流程当前候选跳出匹配
            $孵蛋流程最佳候选Held距离 = $孵蛋流程合并Held距离
            $孵蛋流程最佳候选Pickup距离 = $孵蛋流程合并Pickup距离
        ENDIF
    NEXT
    RETURN 1
ENDFUNC

# 根据最近一次孵化反查确认的Held落点和本轮执行修正，预测无蛋实际落点。
# 没有历史落点时只以目标帧作为保守中心；同一无蛋区间必须重复确认后才允许跳出。
FUNC 孵蛋流程_查找推测无蛋区间(): INT
    IF $孵蛋Held无蛋表有效 != 1
        RETURN -1
    ENDIF
    $孵蛋流程本轮Held总执行修正帧 = $孵蛋Held执行修正帧 + $孵蛋Held临时跳出偏移帧
    $孵蛋流程无蛋预测Held帧 = $孵蛋生成目标帧
    $孵蛋流程无蛋预测方向 = 0
    IF $孵蛋流程上次确认实际Held帧 >= 0
        $孵蛋流程无蛋预测Held帧 = $孵蛋流程上次确认实际Held帧 + $孵蛋流程本轮Held总执行修正帧 - $孵蛋流程上次确认Held总执行修正帧
        IF $孵蛋流程本轮Held总执行修正帧 > $孵蛋流程上次确认Held总执行修正帧
            $孵蛋流程无蛋预测方向 = 1
        ELIF $孵蛋流程本轮Held总执行修正帧 < $孵蛋流程上次确认Held总执行修正帧
            $孵蛋流程无蛋预测方向 = -1
        ENDIF
    ENDIF
    # 已经执行过临时跳区时，上一轮选中的同奇偶目标比旧蛋反查轨迹更接近当前落点。
    IF $孵蛋Held临时跳出偏移帧 != 0 and $孵蛋流程无蛋跳出最佳预测落点 >= 0
        $孵蛋流程无蛋预测Held帧 = $孵蛋流程无蛋跳出最佳预测落点
    ENDIF

    $孵蛋流程无蛋区间最近索引 = -1
    $孵蛋流程无蛋区间最近距离 = 999999999
    FOR $孵蛋流程无蛋区间查找索引 = 0 TO $孵蛋流程无蛋区间末索引
        $孵蛋流程无蛋区间当前起点 = $孵蛋Held无蛋区间起点表[$孵蛋流程无蛋区间查找索引]
        $孵蛋流程无蛋区间当前终点 = $孵蛋Held无蛋区间终点表[$孵蛋流程无蛋区间查找索引]
        $孵蛋流程无蛋区间当前距离 = 0
        IF $孵蛋流程无蛋预测Held帧 < $孵蛋流程无蛋区间当前起点
            $孵蛋流程无蛋区间当前距离 = $孵蛋流程无蛋区间当前起点 - $孵蛋流程无蛋预测Held帧
        ELIF $孵蛋流程无蛋预测Held帧 > $孵蛋流程无蛋区间当前终点
            $孵蛋流程无蛋区间当前距离 = $孵蛋流程无蛋预测Held帧 - $孵蛋流程无蛋区间当前终点
        ENDIF
        IF $孵蛋流程无蛋区间当前距离 < $孵蛋流程无蛋区间最近距离
            $孵蛋流程无蛋区间最近距离 = $孵蛋流程无蛋区间当前距离
            $孵蛋流程无蛋区间最近索引 = $孵蛋流程无蛋区间查找索引
        ELIF $孵蛋流程无蛋区间当前距离 == $孵蛋流程无蛋区间最近距离
            IF $孵蛋流程无蛋预测方向 > 0 and $孵蛋流程无蛋区间当前起点 >= $孵蛋流程无蛋预测Held帧
                $孵蛋流程无蛋区间最近索引 = $孵蛋流程无蛋区间查找索引
            ELIF $孵蛋流程无蛋预测方向 < 0 and $孵蛋流程无蛋区间当前终点 <= $孵蛋流程无蛋预测Held帧
                $孵蛋流程无蛋区间最近索引 = $孵蛋流程无蛋区间查找索引
            ENDIF
        ENDIF
    NEXT
    IF $孵蛋流程无蛋区间最近索引 < 0 or $孵蛋流程无蛋区间最近距离 > $孵蛋无蛋区间最大推断距离
        PRINT 无蛋实际Held落点无法在允许距离内映射到区间: 预测 & $孵蛋流程无蛋预测Held帧 & "，最近距离 " & $孵蛋流程无蛋区间最近距离
        RETURN -1
    ENDIF
    $孵蛋流程无蛋区间最近起点 = $孵蛋Held无蛋区间起点表[$孵蛋流程无蛋区间最近索引]
    $孵蛋流程无蛋区间最近终点 = $孵蛋Held无蛋区间终点表[$孵蛋流程无蛋区间最近索引]
    IF $调试日志输出 == 1
        PRINT 无蛋Held区间推测: 预测 & $孵蛋流程无蛋预测Held帧 & "，区间 " & $孵蛋流程无蛋区间最近起点 & "-" & $孵蛋流程无蛋区间最近终点 & "，距离 " & $孵蛋流程无蛋区间最近距离
    ENDIF
    RETURN $孵蛋流程无蛋区间最近索引
ENDFUNC

FUNC 孵蛋流程_评估无蛋跳出目标($出蛋区间起点: INT, $出蛋区间终点: INT): INT
    # 只选择一个与原目标同奇偶的出蛋帧。无蛋区间只是排除范围，
    # 不再要求把整段无蛋区间搬进同一个出蛋区间，否则短出蛋段会全部被淘汰。
    IF $出蛋区间终点 < $孵蛋流程无蛋跳出源起点
        $孵蛋流程无蛋跳出候选预测落点 = $出蛋区间终点
        IF $孵蛋流程无蛋跳出候选预测落点 % 2 != $孵蛋生成目标帧 % 2
            $孵蛋流程无蛋跳出候选预测落点 -= 1
        ENDIF
        IF $孵蛋流程无蛋跳出候选预测落点 < $出蛋区间起点
            RETURN 0
        ENDIF
    ELIF $出蛋区间起点 > $孵蛋流程无蛋跳出源终点
        $孵蛋流程无蛋跳出候选预测落点 = $出蛋区间起点
        IF $孵蛋流程无蛋跳出候选预测落点 % 2 != $孵蛋生成目标帧 % 2
            $孵蛋流程无蛋跳出候选预测落点 += 1
        ENDIF
        IF $孵蛋流程无蛋跳出候选预测落点 > $出蛋区间终点
            RETURN 0
        ENDIF
    ELSE
        RETURN 0
    ENDIF
    $孵蛋流程候选锚点数量 = LEN($孵蛋流程已尝试Held锚点表)
    IF $孵蛋流程候选锚点数量 > 0
        $孵蛋流程候选锚点末索引 = $孵蛋流程候选锚点数量 - 1
        FOR $孵蛋流程候选锚点索引 = 0 TO $孵蛋流程候选锚点末索引
            IF $孵蛋流程已尝试Held锚点表[$孵蛋流程候选锚点索引] == $孵蛋流程无蛋跳出候选预测落点
                RETURN 0
            ENDIF
        NEXT
    ENDIF
    $孵蛋流程无蛋跳出候选偏移 = $孵蛋流程无蛋跳出候选预测落点 - $孵蛋流程无蛋跳出估计落点

    $孵蛋流程无蛋跳出新偏移 = $孵蛋Held临时跳出偏移帧 + $孵蛋流程无蛋跳出候选偏移
    $孵蛋流程无蛋跳出候选绝对偏移 = $孵蛋流程无蛋跳出新偏移
    IF $孵蛋流程无蛋跳出候选绝对偏移 < 0
        $孵蛋流程无蛋跳出候选绝对偏移 = -$孵蛋流程无蛋跳出候选绝对偏移
    ENDIF
    IF $孵蛋流程无蛋跳出候选绝对偏移 > $孵蛋无蛋跳出最大绝对偏移帧
        RETURN 0
    ENDIF

    $孵蛋流程无蛋跳出候选优先级 = 0
    IF $孵蛋流程无蛋预测方向 > 0 and $孵蛋流程无蛋跳出候选偏移 < 0
        $孵蛋流程无蛋跳出候选优先级 = 1
    ELIF $孵蛋流程无蛋预测方向 < 0 and $孵蛋流程无蛋跳出候选偏移 > 0
        $孵蛋流程无蛋跳出候选优先级 = 1
    ENDIF
    $孵蛋流程无蛋跳出候选绝对步长 = $孵蛋流程无蛋跳出候选偏移
    IF $孵蛋流程无蛋跳出候选绝对步长 < 0
        $孵蛋流程无蛋跳出候选绝对步长 = -$孵蛋流程无蛋跳出候选绝对步长
    ENDIF
    $孵蛋流程无蛋跳出候选评分 = $孵蛋流程无蛋跳出候选优先级 * 1000000 + $孵蛋流程无蛋跳出候选绝对步长
    IF $孵蛋流程无蛋跳出候选评分 < $孵蛋流程无蛋跳出最佳评分
        $孵蛋流程无蛋跳出最佳评分 = $孵蛋流程无蛋跳出候选评分
        $孵蛋流程无蛋跳出最佳偏移 = $孵蛋流程无蛋跳出候选偏移
        $孵蛋流程无蛋跳出最佳蛋起点 = $出蛋区间起点
        $孵蛋流程无蛋跳出最佳蛋终点 = $出蛋区间终点
        $孵蛋流程无蛋跳出最佳预测落点 = $孵蛋流程无蛋跳出候选预测落点
    ENDIF
    RETURN 1
ENDFUNC

# 从无蛋区间表的补集寻找与原目标同奇偶的出蛋帧。
FUNC 孵蛋流程_应用无蛋区间跳出($无蛋区间索引: INT): INT
    IF $无蛋区间索引 < 0 or $无蛋区间索引 > $孵蛋流程无蛋区间末索引
        RETURN 0
    ENDIF
    IF $孵蛋流程无蛋跳出尝试次数 >= $孵蛋无蛋最大跳出次数
        PRINT 无蛋区间跳出已达到次数上限，停止以避免死循环
        RETURN 0
    ENDIF
    $孵蛋流程无蛋跳出源起点 = $孵蛋Held无蛋区间起点表[$无蛋区间索引]
    $孵蛋流程无蛋跳出源终点 = $孵蛋Held无蛋区间终点表[$无蛋区间索引]
    # 把预测值夹入已确认无蛋区间，再尽量修到与目标相同的奇偶。
    # 这只是本轮的实际落点估计；若仍无蛋，下一轮会重新映射区间继续跳出。
    $孵蛋流程无蛋跳出估计落点 = $孵蛋流程无蛋预测Held帧
    IF $孵蛋流程无蛋跳出估计落点 < $孵蛋流程无蛋跳出源起点
        $孵蛋流程无蛋跳出估计落点 = $孵蛋流程无蛋跳出源起点
    ELIF $孵蛋流程无蛋跳出估计落点 > $孵蛋流程无蛋跳出源终点
        $孵蛋流程无蛋跳出估计落点 = $孵蛋流程无蛋跳出源终点
    ENDIF
    IF $孵蛋流程无蛋跳出估计落点 % 2 != $孵蛋生成目标帧 % 2
        IF $孵蛋流程无蛋预测方向 > 0 and $孵蛋流程无蛋跳出估计落点 + 1 <= $孵蛋流程无蛋跳出源终点
            $孵蛋流程无蛋跳出估计落点 += 1
        ELIF $孵蛋流程无蛋预测方向 < 0 and $孵蛋流程无蛋跳出估计落点 - 1 >= $孵蛋流程无蛋跳出源起点
            $孵蛋流程无蛋跳出估计落点 -= 1
        ELIF $孵蛋流程无蛋跳出估计落点 - 1 >= $孵蛋流程无蛋跳出源起点
            $孵蛋流程无蛋跳出估计落点 -= 1
        ELIF $孵蛋流程无蛋跳出估计落点 + 1 <= $孵蛋流程无蛋跳出源终点
            $孵蛋流程无蛋跳出估计落点 += 1
        ENDIF
    ENDIF
    IF $调试日志输出 == 1
        PRINT 无蛋跳出估计Held: & $孵蛋流程无蛋预测Held帧 & " -> " & $孵蛋流程无蛋跳出估计落点
    ENDIF
    $孵蛋流程无蛋跳出最佳评分 = 999999999
    $孵蛋流程无蛋跳出最佳偏移 = 0
    $孵蛋流程无蛋跳出最佳蛋起点 = -1
    $孵蛋流程无蛋跳出最佳蛋终点 = -1
    $孵蛋流程无蛋跳出最佳预测落点 = -1
    $孵蛋流程无蛋跳出游标 = $孵蛋Held无蛋表最小帧
    FOR $孵蛋流程无蛋区间查找索引 = 0 TO $孵蛋流程无蛋区间末索引
        $孵蛋流程无蛋跳出蛋起点 = $孵蛋流程无蛋跳出游标
        $孵蛋流程无蛋跳出蛋终点 = $孵蛋Held无蛋区间起点表[$孵蛋流程无蛋区间查找索引] - 1
        IF $孵蛋流程无蛋跳出蛋终点 >= $孵蛋流程无蛋跳出蛋起点
            $孵蛋流程无蛋跳出评估结果 = 孵蛋流程_评估无蛋跳出目标($孵蛋流程无蛋跳出蛋起点, $孵蛋流程无蛋跳出蛋终点)
        ENDIF
        $孵蛋流程无蛋跳出游标 = $孵蛋Held无蛋区间终点表[$孵蛋流程无蛋区间查找索引] + 1
    NEXT
    IF $孵蛋流程无蛋跳出游标 <= $孵蛋Held无蛋表最大帧
        $孵蛋流程无蛋跳出评估结果 = 孵蛋流程_评估无蛋跳出目标($孵蛋流程无蛋跳出游标, $孵蛋Held无蛋表最大帧)
    ENDIF
    IF $孵蛋流程无蛋跳出最佳蛋起点 < 0 or $孵蛋流程无蛋跳出最佳偏移 == 0
        PRINT 当前无蛋区间附近没有可用的同奇偶出蛋帧，停止以避免盲目跳帧
        RETURN 0
    ENDIF
    $孵蛋Held临时跳出偏移帧 += $孵蛋流程无蛋跳出最佳偏移
    $孵蛋流程无蛋跳出尝试次数 += 1
    $孵蛋流程已尝试Held锚点表 = APPEND($孵蛋流程已尝试Held锚点表, $孵蛋流程无蛋跳出最佳预测落点)
    IF $调试日志输出 == 1
        PRINT 无蛋区间跳出: & $孵蛋流程无蛋跳出源起点 & "-" & $孵蛋流程无蛋跳出源终点 & " -> 出蛋区间 " & $孵蛋流程无蛋跳出最佳蛋起点 & "-" & $孵蛋流程无蛋跳出最佳蛋终点
        PRINT 跳出估计落点: & $孵蛋流程无蛋跳出估计落点 & " -> " & $孵蛋流程无蛋跳出最佳预测落点 & "（与目标奇偶一致）"
        PRINT 本轮临时Held跳出偏移: & $孵蛋Held临时跳出偏移帧 & " 帧；正式Held累计修正保持 " & $孵蛋Held执行修正帧
    ELSE
        PRINT 无蛋处理: Held估计 & $孵蛋流程无蛋跳出估计落点 & "，下轮尝试 " & $孵蛋流程无蛋跳出最佳预测落点
    ENDIF
    $孵蛋流程目标Seed无蛋区间索引 = -1
    $孵蛋流程目标Seed无蛋区间确认次数 = 0
    RETURN 1
ENDFUNC

# 优先使用工具生成的近邻恢复点；全部尝试后才进入远端密集出蛋区。
# 参考帧必须是本轮对实际Held的估计或已确认落点，不能使用多候选中的任意展示值。
FUNC 孵蛋流程_选择恢复锚点($参考Held帧: INT): INT
    IF $孵蛋Held无蛋表有效 != 1
        PRINT 没有有效Held出蛋表，无法选择恢复锚点
        RETURN 0
    ENDIF
    IF $孵蛋流程无蛋跳出尝试次数 >= $孵蛋无蛋最大跳出次数
        PRINT Held恢复锚点尝试已达到次数上限
        RETURN 0
    ENDIF
    $孵蛋流程恢复锚点参考帧 = $参考Held帧
    FOR $孵蛋流程恢复锚点表类型 = 0 TO 1
        IF $孵蛋流程恢复锚点表类型 == 0
            $孵蛋流程恢复锚点表数量 = LEN($孵蛋Held近邻恢复锚点表)
        ELSE
            $孵蛋流程恢复锚点表数量 = LEN($孵蛋Held远端恢复锚点表)
        ENDIF
        IF $孵蛋流程恢复锚点表数量 <= 0
            CONTINUE
        ENDIF
        $孵蛋流程恢复锚点表末索引 = $孵蛋流程恢复锚点表数量 - 1
        FOR $孵蛋流程恢复锚点索引 = 0 TO $孵蛋流程恢复锚点表末索引
            IF $孵蛋流程恢复锚点表类型 == 0
                $孵蛋流程恢复锚点候选 = $孵蛋Held近邻恢复锚点表[$孵蛋流程恢复锚点索引]
            ELSE
                $孵蛋流程恢复锚点候选 = $孵蛋Held远端恢复锚点表[$孵蛋流程恢复锚点索引]
            ENDIF
            $孵蛋流程Held当前恢复锚点 = $孵蛋流程恢复锚点候选
            IF $孵蛋流程Held当前恢复锚点 == $孵蛋生成目标帧 or $孵蛋流程Held当前恢复锚点 < $孵蛋Held无蛋表最小帧 or $孵蛋流程Held当前恢复锚点 > $孵蛋Held无蛋表最大帧
                CONTINUE
            ENDIF
            IF $孵蛋流程Held当前恢复锚点 % 2 != $孵蛋生成目标帧 % 2
                CONTINUE
            ENDIF
            $孵蛋流程恢复锚点已尝试 = 0
            $孵蛋流程候选锚点数量 = LEN($孵蛋流程已尝试Held锚点表)
            IF $孵蛋流程候选锚点数量 > 0
                $孵蛋流程候选锚点末索引 = $孵蛋流程候选锚点数量 - 1
                FOR $孵蛋流程候选锚点索引 = 0 TO $孵蛋流程候选锚点末索引
                    IF $孵蛋流程已尝试Held锚点表[$孵蛋流程候选锚点索引] == $孵蛋流程Held当前恢复锚点
                        $孵蛋流程恢复锚点已尝试 = 1
                        BREAK
                    ENDIF
                NEXT
            ENDIF
            IF $孵蛋流程恢复锚点已尝试 == 1
                CONTINUE
            ENDIF

            # 再用无蛋表补集验证工具给出的锚点确实出蛋，并保存候选匹配区间。
            $孵蛋流程恢复锚点区间起点 = -1
            $孵蛋流程恢复锚点区间终点 = -1
            $孵蛋流程恢复锚点区间游标 = $孵蛋Held无蛋表最小帧
            FOR $孵蛋流程无蛋区间查找索引 = 0 TO $孵蛋流程无蛋区间末索引
                $孵蛋流程恢复锚点区间当前终点 = $孵蛋Held无蛋区间起点表[$孵蛋流程无蛋区间查找索引] - 1
                IF $孵蛋流程Held当前恢复锚点 >= $孵蛋流程恢复锚点区间游标 and $孵蛋流程Held当前恢复锚点 <= $孵蛋流程恢复锚点区间当前终点
                    $孵蛋流程恢复锚点区间起点 = $孵蛋流程恢复锚点区间游标
                    $孵蛋流程恢复锚点区间终点 = $孵蛋流程恢复锚点区间当前终点
                    BREAK
                ENDIF
                $孵蛋流程恢复锚点区间游标 = $孵蛋Held无蛋区间终点表[$孵蛋流程无蛋区间查找索引] + 1
            NEXT
            IF $孵蛋流程恢复锚点区间起点 < 0 and $孵蛋流程恢复锚点区间游标 <= $孵蛋Held无蛋表最大帧 and $孵蛋流程Held当前恢复锚点 >= $孵蛋流程恢复锚点区间游标
                $孵蛋流程恢复锚点区间起点 = $孵蛋流程恢复锚点区间游标
                $孵蛋流程恢复锚点区间终点 = $孵蛋Held无蛋表最大帧
            ENDIF
            IF $孵蛋流程恢复锚点区间起点 < 0
                CONTINUE
            ENDIF

            $孵蛋流程Held锚点修正差 = $孵蛋流程Held当前恢复锚点 - $孵蛋流程恢复锚点参考帧
            $孵蛋流程恢复锚点绝对新偏移 = $孵蛋Held临时跳出偏移帧 + $孵蛋流程Held锚点修正差
            IF $孵蛋流程恢复锚点绝对新偏移 < 0
                $孵蛋流程恢复锚点绝对新偏移 = -$孵蛋流程恢复锚点绝对新偏移
            ENDIF
            IF $孵蛋流程恢复锚点绝对新偏移 > $孵蛋无蛋跳出最大绝对偏移帧
                CONTINUE
            ENDIF
            $孵蛋Held临时跳出偏移帧 += $孵蛋流程Held锚点修正差
            $孵蛋流程Held恢复锚点有效 = 1
            $孵蛋流程无蛋跳出最佳预测落点 = $孵蛋流程Held当前恢复锚点
            $孵蛋流程无蛋跳出最佳蛋起点 = $孵蛋流程恢复锚点区间起点
            $孵蛋流程无蛋跳出最佳蛋终点 = $孵蛋流程恢复锚点区间终点
            $孵蛋流程无蛋跳出尝试次数 += 1
            $孵蛋流程已尝试Held锚点表 = APPEND($孵蛋流程已尝试Held锚点表, $孵蛋流程Held当前恢复锚点)
            IF $调试日志输出 == 1
                IF $孵蛋流程恢复锚点表类型 == 0
                    PRINT 无蛋恢复优先尝试近邻锚点: & $孵蛋流程恢复锚点参考帧 & " -> " & $孵蛋流程Held当前恢复锚点
                ELSE
                    PRINT 近邻路线已用尽，尝试远端密集出蛋锚点: & $孵蛋流程恢复锚点参考帧 & " -> " & $孵蛋流程Held当前恢复锚点
                ENDIF
                PRINT Held恢复临时偏移: & $孵蛋Held临时跳出偏移帧 & "；正式累计修正保持 " & $孵蛋Held执行修正帧
            ELSE
                PRINT 无蛋处理: 下轮尝试Held锚点 & $孵蛋流程Held当前恢复锚点
            ENDIF
            $孵蛋流程目标Seed无蛋区间索引 = -1
            $孵蛋流程目标Seed无蛋区间确认次数 = 0
            RETURN 1
        NEXT
    NEXT
    $孵蛋流程Held当前恢复锚点 = -1
    PRINT 没有剩余的同奇偶Held恢复锚点
    RETURN 0
ENDFUNC

# 蛋已孵化但可见个体对应多个不同Held时，不再猜一个候选写入正式修正。
# 改为保留当前正式修正，从无蛋表补集里寻找下一个未尝试、同奇偶的出蛋区间。
FUNC 孵蛋流程_应用多候选锚点跳出(): INT
    IF $孵蛋Held无蛋表有效 != 1
        PRINT Held候选不唯一且没有有效无蛋表，无法安全寻找下一个出蛋锚点
        RETURN 0
    ENDIF
    IF $孵蛋流程无蛋跳出尝试次数 >= $孵蛋无蛋最大跳出次数
        PRINT Held候选锚点尝试已达到次数上限，停止以避免在歧义区间循环
        RETURN 0
    ENDIF

    $孵蛋流程候选锚点参考帧 = $孵蛋流程实际Held帧
    IF $孵蛋Held临时跳出偏移帧 != 0 and $孵蛋流程无蛋跳出最佳预测落点 >= 0
        $孵蛋流程候选锚点参考帧 = $孵蛋流程无蛋跳出最佳预测落点
    ENDIF
    $孵蛋流程候选锚点已尝试 = 0
    $孵蛋流程候选锚点数量 = LEN($孵蛋流程已尝试Held锚点表)
    IF $孵蛋流程候选锚点数量 > 0
        $孵蛋流程候选锚点末索引 = $孵蛋流程候选锚点数量 - 1
        FOR $孵蛋流程候选锚点索引 = 0 TO $孵蛋流程候选锚点末索引
            IF $孵蛋流程已尝试Held锚点表[$孵蛋流程候选锚点索引] == $孵蛋流程候选锚点参考帧
                $孵蛋流程候选锚点已尝试 = 1
                BREAK
            ENDIF
        NEXT
    ENDIF
    IF $孵蛋流程候选锚点已尝试 == 0
        $孵蛋流程已尝试Held锚点表 = APPEND($孵蛋流程已尝试Held锚点表, $孵蛋流程候选锚点参考帧)
    ENDIF

    # 找出当前参考帧所在的出蛋区间；候选来自实际孵化结果，正常应位于无蛋表补集。
    $孵蛋流程候选锚点出蛋起点 = -1
    $孵蛋流程候选锚点出蛋终点 = -1
    $孵蛋流程候选锚点游标 = $孵蛋Held无蛋表最小帧
    FOR $孵蛋流程无蛋区间查找索引 = 0 TO $孵蛋流程无蛋区间末索引
        $孵蛋流程候选锚点当前终点 = $孵蛋Held无蛋区间起点表[$孵蛋流程无蛋区间查找索引] - 1
        IF $孵蛋流程候选锚点参考帧 >= $孵蛋流程候选锚点游标 and $孵蛋流程候选锚点参考帧 <= $孵蛋流程候选锚点当前终点
            $孵蛋流程候选锚点出蛋起点 = $孵蛋流程候选锚点游标
            $孵蛋流程候选锚点出蛋终点 = $孵蛋流程候选锚点当前终点
            BREAK
        ENDIF
        $孵蛋流程候选锚点游标 = $孵蛋Held无蛋区间终点表[$孵蛋流程无蛋区间查找索引] + 1
    NEXT
    IF $孵蛋流程候选锚点出蛋起点 < 0 and $孵蛋流程候选锚点游标 <= $孵蛋Held无蛋表最大帧 and $孵蛋流程候选锚点参考帧 >= $孵蛋流程候选锚点游标 and $孵蛋流程候选锚点参考帧 <= $孵蛋Held无蛋表最大帧
        $孵蛋流程候选锚点出蛋起点 = $孵蛋流程候选锚点游标
        $孵蛋流程候选锚点出蛋终点 = $孵蛋Held无蛋表最大帧
    ENDIF
    IF $孵蛋流程候选锚点出蛋起点 < 0
        PRINT 候选Held与无蛋表补集不一致: & $孵蛋流程候选锚点参考帧
        RETURN 0
    ENDIF

    $孵蛋流程无蛋跳出源起点 = $孵蛋流程候选锚点出蛋起点
    $孵蛋流程无蛋跳出源终点 = $孵蛋流程候选锚点出蛋终点
    $孵蛋流程无蛋跳出估计落点 = $孵蛋流程候选锚点参考帧
    $孵蛋流程无蛋跳出最佳评分 = 999999999
    $孵蛋流程无蛋跳出最佳偏移 = 0
    $孵蛋流程无蛋跳出最佳蛋起点 = -1
    $孵蛋流程无蛋跳出最佳蛋终点 = -1
    $孵蛋流程无蛋跳出最佳预测落点 = -1
    # 多候选换锚点只按距离选择，不继承上一轮无蛋推测留下的方向偏好。
    $孵蛋流程无蛋预测方向 = 0
    $孵蛋流程无蛋跳出游标 = $孵蛋Held无蛋表最小帧
    FOR $孵蛋流程无蛋区间查找索引 = 0 TO $孵蛋流程无蛋区间末索引
        $孵蛋流程无蛋跳出蛋起点 = $孵蛋流程无蛋跳出游标
        $孵蛋流程无蛋跳出蛋终点 = $孵蛋Held无蛋区间起点表[$孵蛋流程无蛋区间查找索引] - 1
        IF $孵蛋流程无蛋跳出蛋终点 >= $孵蛋流程无蛋跳出蛋起点
            $孵蛋流程无蛋跳出评估结果 = 孵蛋流程_评估无蛋跳出目标($孵蛋流程无蛋跳出蛋起点, $孵蛋流程无蛋跳出蛋终点)
        ENDIF
        $孵蛋流程无蛋跳出游标 = $孵蛋Held无蛋区间终点表[$孵蛋流程无蛋区间查找索引] + 1
    NEXT
    IF $孵蛋流程无蛋跳出游标 <= $孵蛋Held无蛋表最大帧
        $孵蛋流程无蛋跳出评估结果 = 孵蛋流程_评估无蛋跳出目标($孵蛋流程无蛋跳出游标, $孵蛋Held无蛋表最大帧)
    ENDIF
    IF $孵蛋流程无蛋跳出最佳蛋起点 < 0 or $孵蛋流程无蛋跳出最佳偏移 == 0
        PRINT 没有剩余的未尝试同奇偶出蛋锚点
        RETURN 0
    ENDIF

    $孵蛋Held临时跳出偏移帧 += $孵蛋流程无蛋跳出最佳偏移
    $孵蛋流程无蛋跳出尝试次数 += 1
    $孵蛋流程已尝试Held锚点表 = APPEND($孵蛋流程已尝试Held锚点表, $孵蛋流程无蛋跳出最佳预测落点)
    IF $调试日志输出 == 1
        PRINT Held候选不唯一: 保留正式Held累计修正 & $孵蛋Held执行修正帧
        PRINT 寻找下一个同奇偶出蛋锚点: & $孵蛋流程候选锚点参考帧 & " -> " & $孵蛋流程无蛋跳出最佳预测落点 & "，临时偏移 " & $孵蛋Held临时跳出偏移帧
    ELSE
        PRINT 蛋帧结果: Held候选不唯一；下轮尝试锚点 & $孵蛋流程无蛋跳出最佳预测落点
    ENDIF
    RETURN 1
ENDFUNC

FUNC 孵蛋流程_处理目标Seed无蛋(): INT
    $孵蛋流程Held已稳定 = 0
    $孵蛋流程目标Seed无蛋次数 += 1
    IF $孵蛋流程目标Seed无蛋次数 > $孵蛋普通目标Seed无蛋上限
        PRINT 连续命中目标Seed且无蛋超过处理上限，停止以避免死循环
        RETURN 0
    ENDIF
    IF $调试日志输出 == 1
        IF $孵蛋流程Pickup已稳定 == 1
            PRINT Pickup已稳定：登记本轮Held无蛋区间证据
        ELSE
            PRINT Pickup尚未稳定：仍登记本轮Held无蛋区间证据；已有可信Held正式修正时允许直接吸收±1帧
        ENDIF
    ENDIF
    IF $孵蛋Held无蛋表有效 != 1
        PRINT 当前目标没有有效无蛋区间表；请用工具重新生成脚本
        RETURN 0
    ENDIF
    $孵蛋流程本轮无蛋区间索引 = 孵蛋流程_查找推测无蛋区间()
    IF $孵蛋流程本轮无蛋区间索引 < 0
        IF $孵蛋流程目标Seed无蛋次数 >= $孵蛋无蛋区间确认次数
            PRINT 多次目标Seed无蛋仍无法定位区间，停止以检查反查窗口或无蛋表
            RETURN 0
        ENDIF
        RETURN 2
    ENDIF
    IF $孵蛋流程本轮无蛋区间索引 == $孵蛋流程目标Seed无蛋区间索引
        $孵蛋流程目标Seed无蛋区间确认次数 += 1
    ELSE
        $孵蛋流程目标Seed无蛋区间索引 = $孵蛋流程本轮无蛋区间索引
        $孵蛋流程目标Seed无蛋区间确认次数 = 1
    ENDIF
    IF $调试日志输出 == 1
        PRINT 目标Seed无蛋区间确认: & $孵蛋流程目标Seed无蛋区间确认次数 & "/" & $孵蛋无蛋区间确认次数
    ELSE
        PRINT 无蛋结果: 目标Seed，区间确认 & $孵蛋流程目标Seed无蛋区间确认次数 & "/" & $孵蛋无蛋区间确认次数
    ENDIF
    IF $孵蛋流程目标Seed无蛋区间确认次数 < $孵蛋无蛋区间确认次数
        RETURN 2
    ENDIF
    $孵蛋流程无蛋跳出源起点 = $孵蛋Held无蛋区间起点表[$孵蛋流程目标Seed无蛋区间索引]
    $孵蛋流程无蛋跳出源终点 = $孵蛋Held无蛋区间终点表[$孵蛋流程目标Seed无蛋区间索引]
    $孵蛋流程恢复锚点参考帧 = $孵蛋流程无蛋预测Held帧
    IF $孵蛋流程恢复锚点参考帧 < $孵蛋流程无蛋跳出源起点
        $孵蛋流程恢复锚点参考帧 = $孵蛋流程无蛋跳出源起点
    ELIF $孵蛋流程恢复锚点参考帧 > $孵蛋流程无蛋跳出源终点
        $孵蛋流程恢复锚点参考帧 = $孵蛋流程无蛋跳出源终点
    ENDIF
    $孵蛋流程Held无蛋微调差 = $孵蛋生成目标帧 - $孵蛋流程恢复锚点参考帧
    IF $孵蛋流程Held正式修正可信 == 1 and ($孵蛋流程Held无蛋微调差 == -1 or $孵蛋流程Held无蛋微调差 == 1)
        $孵蛋Held执行修正帧 += $孵蛋流程Held无蛋微调差
        $孵蛋Held临时跳出偏移帧 = 0
        $孵蛋流程Held恢复锚点有效 = 0
        $孵蛋流程Held当前恢复锚点 = -1
        $孵蛋流程目标Seed无蛋区间索引 = -1
        $孵蛋流程目标Seed无蛋区间确认次数 = 0
        $孵蛋流程无蛋连续次数 = 0
        PRINT 可信Held正式修正后连续确认目标Seed无蛋：直接吸收 & $孵蛋流程Held无蛋微调差 & " 帧；Held累计修正 " & $孵蛋Held执行修正帧
        RETURN 1
    ENDIF
    IF $调试日志输出 == 1
        PRINT 已确认无蛋实际Held估计: & $孵蛋流程恢复锚点参考帧 & "；开始近邻恢复"
    ENDIF
    RETURN 孵蛋流程_选择恢复锚点($孵蛋流程恢复锚点参考帧)
ENDFUNC

# 把四种方法的不同Held候选还原到未执行本轮修正的坐标，再跨轮求交。
# 精确交集优先；只有精确交集为空时才允许唯一的±1临近帧继续提供证据。
FUNC 孵蛋流程_更新Held归一候选交集(): INT
    $孵蛋流程Held交集当前表 = []
    $孵蛋流程Held交集当前数量 = LEN($孵蛋流程不同Held候选表)
    IF $孵蛋流程Held交集当前数量 <= 0
        RETURN 0
    ENDIF
    $孵蛋流程Held交集当前末索引 = $孵蛋流程Held交集当前数量 - 1
    FOR $孵蛋流程Held交集当前索引 = 0 TO $孵蛋流程Held交集当前末索引
        $孵蛋流程Held交集当前值 = $孵蛋流程不同Held候选表[$孵蛋流程Held交集当前索引] - $孵蛋流程本轮Held总执行修正帧
        $孵蛋流程Held交集当前表 = APPEND($孵蛋流程Held交集当前表, $孵蛋流程Held交集当前值)
    NEXT

    IF $孵蛋流程Held归一交集有效 != 1
        $孵蛋流程Held归一交集表 = $孵蛋流程Held交集当前表
        $孵蛋流程Held归一交集有效 = 1
    ELSE
        $孵蛋流程Held交集精确表 = []
        $孵蛋流程Held交集历史数量 = LEN($孵蛋流程Held归一交集表)
        IF $孵蛋流程Held交集历史数量 > 0
            $孵蛋流程Held交集历史末索引 = $孵蛋流程Held交集历史数量 - 1
            FOR $孵蛋流程Held交集当前索引 = 0 TO $孵蛋流程Held交集当前末索引
                $孵蛋流程Held交集当前值 = $孵蛋流程Held交集当前表[$孵蛋流程Held交集当前索引]
                FOR $孵蛋流程Held交集历史索引 = 0 TO $孵蛋流程Held交集历史末索引
                    IF $孵蛋流程Held交集当前值 == $孵蛋流程Held归一交集表[$孵蛋流程Held交集历史索引]
                        $孵蛋流程Held交集精确表 = APPEND($孵蛋流程Held交集精确表, $孵蛋流程Held交集当前值)
                        BREAK
                    ENDIF
                NEXT
            NEXT
        ENDIF
        $孵蛋流程Held交集精确数量 = LEN($孵蛋流程Held交集精确表)
        IF $孵蛋流程Held交集精确数量 > 0
            $孵蛋流程Held归一交集表 = $孵蛋流程Held交集精确表
        ELSE
            $孵蛋流程Held交集临近表 = []
            # ±1只在历史已经唯一时使用；历史多解时不能让一个中间值同时贴近两条路径而假收敛。
            IF $孵蛋流程Held交集历史数量 == 1
                FOR $孵蛋流程Held交集当前索引 = 0 TO $孵蛋流程Held交集当前末索引
                    $孵蛋流程Held交集当前值 = $孵蛋流程Held交集当前表[$孵蛋流程Held交集当前索引]
                    $孵蛋流程Held交集临近匹配 = 0
                    FOR $孵蛋流程Held交集历史索引 = 0 TO $孵蛋流程Held交集历史末索引
                        $孵蛋流程Held交集历史值 = $孵蛋流程Held归一交集表[$孵蛋流程Held交集历史索引]
                        $孵蛋流程Held交集临近差 = $孵蛋流程Held交集当前值 - $孵蛋流程Held交集历史值
                        IF $孵蛋流程Held交集临近差 < 0
                            $孵蛋流程Held交集临近差 = -$孵蛋流程Held交集临近差
                        ENDIF
                        IF $孵蛋流程Held交集临近差 <= 1
                            $孵蛋流程Held交集临近匹配 = 1
                            BREAK
                        ENDIF
                    NEXT
                    IF $孵蛋流程Held交集临近匹配 == 1
                        $孵蛋流程Held交集临近表 = APPEND($孵蛋流程Held交集临近表, $孵蛋流程Held交集当前值)
                    ENDIF
                NEXT
            ENDIF
            $孵蛋流程Held交集临近数量 = LEN($孵蛋流程Held交集临近表)
            IF $孵蛋流程Held交集临近数量 > 0
                $孵蛋流程Held归一交集表 = $孵蛋流程Held交集临近表
                IF $调试日志输出 == 1
                    PRINT Held跨轮归一候选精确交集为空，使用±1临近帧继续排除
                ENDIF
            ELSE
                $孵蛋流程Held归一交集表 = $孵蛋流程Held交集当前表
                IF $调试日志输出 == 1
                    PRINT Held跨轮归一候选无交集，丢弃冲突历史并从本轮重新累计
                ENDIF
            ENDIF
        ENDIF
    ENDIF

    $孵蛋流程Held归一交集数 = LEN($孵蛋流程Held归一交集表)
    $孵蛋流程Held归一交集唯一 = 0
    $孵蛋流程Held归一交集落点 = -1
    IF $孵蛋流程Held归一交集数 == 1
        $孵蛋流程Held归一交集唯一 = 1
        $孵蛋流程Held归一交集落点 = $孵蛋流程Held归一交集表[0]
        PRINT Held跨轮归一候选唯一: & $孵蛋流程Held归一交集落点
        RETURN 2
    ENDIF
    IF $调试日志输出 == 1
        PRINT Held跨轮归一候选剩余: & $孵蛋流程Held归一交集数
    ENDIF
    RETURN 1
ENDFUNC

# 从已经确定为同一个体的候选中选择校准落点。
# 第一轮取离Held目标最近者；修正后若所有候选仍超出±20，则优先选择能按累计修正
# 映射回上轮候选轨迹的结果。例如累计修正-67、当前候选1207，会还原为1274。
FUNC 孵蛋流程_选择校准候选(): INT
    $孵蛋流程选择总数 = 孵蛋反查_取总命中数()
    $孵蛋流程选择保存数 = 孵蛋反查_取已保存结果数()
    IF $孵蛋流程选择总数 <= 0 or $孵蛋流程选择保存数 != $孵蛋流程选择总数
        RETURN 0
    ENDIF

    # 临时跳区或累计修正后，候选应靠近本轮预测落点，而不是始终靠近原始目标。
    $孵蛋流程候选参考Held帧 = $孵蛋生成目标帧
    IF $孵蛋流程上次确认实际Held帧 >= 0
        $孵蛋流程候选参考Held帧 = $孵蛋流程上次确认实际Held帧 + $孵蛋流程本轮Held总执行修正帧 - $孵蛋流程上次确认Held总执行修正帧
    ENDIF
    IF $孵蛋Held临时跳出偏移帧 != 0 and $孵蛋流程无蛋跳出最佳预测落点 >= 0
        $孵蛋流程候选参考Held帧 = $孵蛋流程无蛋跳出最佳预测落点
    ENDIF
    IF $调试日志输出 == 1 and $孵蛋流程选择保存数 > 1
        PRINT 多候选本轮Held参考落点: & $孵蛋流程候选参考Held帧
    ENDIF

    $孵蛋流程本轮归一Held候选表 = []
    $孵蛋流程本轮归一Pickup候选表 = []
    $孵蛋流程最近候选索引 = -1
    $孵蛋流程最近候选跳出匹配 = 0
    $孵蛋流程最近Held距离 = 999999999
    $孵蛋流程最近Pickup距离 = 999999999
    $孵蛋流程轨迹候选索引 = -1
    $孵蛋流程轨迹候选跳出匹配 = 0
    $孵蛋流程轨迹Held距离 = 999999999
    $孵蛋流程轨迹Pickup距离 = 999999999
    $孵蛋流程目标候选索引 = -1
    $孵蛋流程选择末索引 = $孵蛋流程选择保存数 - 1
    FOR $孵蛋流程选择索引 = 0 TO $孵蛋流程选择末索引
        $孵蛋流程当前Held帧 = 孵蛋反查_取结果Held帧($孵蛋流程选择索引)
        $孵蛋流程当前Pickup帧 = 孵蛋反查_取结果Pickup帧($孵蛋流程选择索引)
        $孵蛋流程当前归一Held帧 = $孵蛋流程当前Held帧 - $孵蛋Held执行修正帧 - $孵蛋Held临时跳出偏移帧
        $孵蛋流程当前归一Pickup帧 = $孵蛋流程当前Pickup帧 - $孵蛋Pickup执行修正帧
        $孵蛋流程本轮归一Held候选表 = APPEND($孵蛋流程本轮归一Held候选表, $孵蛋流程当前归一Held帧)
        $孵蛋流程本轮归一Pickup候选表 = APPEND($孵蛋流程本轮归一Pickup候选表, $孵蛋流程当前归一Pickup帧)

        $孵蛋流程当前Held距离 = $孵蛋流程当前Held帧 - $孵蛋流程候选参考Held帧
        IF $孵蛋流程当前Held距离 < 0
            $孵蛋流程当前Held距离 = -$孵蛋流程当前Held距离
        ENDIF
        $孵蛋流程当前Pickup距离 = $孵蛋流程当前Pickup帧 - $孵蛋领取目标帧
        IF $孵蛋流程当前Pickup距离 < 0
            $孵蛋流程当前Pickup距离 = -$孵蛋流程当前Pickup距离
        ENDIF

        $孵蛋流程当前候选跳出匹配 = 0
        IF $孵蛋Held临时跳出偏移帧 != 0 and $孵蛋流程无蛋跳出最佳蛋起点 >= 0 and $孵蛋流程当前Held帧 >= $孵蛋流程无蛋跳出最佳蛋起点 and $孵蛋流程当前Held帧 <= $孵蛋流程无蛋跳出最佳蛋终点
            $孵蛋流程当前候选跳出匹配 = 1
        ENDIF

        IF $孵蛋流程最近候选索引 < 0 or $孵蛋流程当前候选跳出匹配 > $孵蛋流程最近候选跳出匹配
            $孵蛋流程最近候选索引 = $孵蛋流程选择索引
            $孵蛋流程最近候选跳出匹配 = $孵蛋流程当前候选跳出匹配
            $孵蛋流程最近Held距离 = $孵蛋流程当前Held距离
            $孵蛋流程最近Pickup距离 = $孵蛋流程当前Pickup距离
        ELIF $孵蛋流程当前候选跳出匹配 == $孵蛋流程最近候选跳出匹配
            IF $孵蛋流程当前Held距离 < $孵蛋流程最近Held距离
                $孵蛋流程最近候选索引 = $孵蛋流程选择索引
                $孵蛋流程最近Held距离 = $孵蛋流程当前Held距离
                $孵蛋流程最近Pickup距离 = $孵蛋流程当前Pickup距离
            ELIF $孵蛋流程当前Held距离 == $孵蛋流程最近Held距离 and $孵蛋流程当前Pickup距离 < $孵蛋流程最近Pickup距离
                $孵蛋流程最近候选索引 = $孵蛋流程选择索引
                $孵蛋流程最近Pickup距离 = $孵蛋流程当前Pickup距离
            ENDIF
        ENDIF

        IF $孵蛋流程当前Held帧 == $孵蛋生成目标帧 and $孵蛋流程当前Pickup帧 == $孵蛋领取目标帧 and $孵蛋流程目标候选索引 < 0
            $孵蛋流程目标候选索引 = $孵蛋流程选择索引
        ENDIF

        $孵蛋流程当前候选命中轨迹 = 0
        IF $孵蛋流程候选轨迹有效 == 1 and $孵蛋流程上轮候选方法 == $孵蛋流程实际方法 and $孵蛋流程上轮候选数 > 0
            $孵蛋流程上轮候选末索引 = $孵蛋流程上轮候选数 - 1
            FOR $孵蛋流程上轮候选索引 = 0 TO $孵蛋流程上轮候选末索引
                IF $孵蛋流程当前归一Held帧 == $孵蛋流程上轮归一Held候选表[$孵蛋流程上轮候选索引] and $孵蛋流程当前归一Pickup帧 == $孵蛋流程上轮归一Pickup候选表[$孵蛋流程上轮候选索引]
                    $孵蛋流程当前候选命中轨迹 = 1
                    BREAK
                ENDIF
            NEXT
        ENDIF
        IF $孵蛋流程当前候选命中轨迹 == 1
            IF $孵蛋流程轨迹候选索引 < 0 or $孵蛋流程当前候选跳出匹配 > $孵蛋流程轨迹候选跳出匹配
                $孵蛋流程轨迹候选索引 = $孵蛋流程选择索引
                $孵蛋流程轨迹候选跳出匹配 = $孵蛋流程当前候选跳出匹配
                $孵蛋流程轨迹Held距离 = $孵蛋流程当前Held距离
                $孵蛋流程轨迹Pickup距离 = $孵蛋流程当前Pickup距离
            ELIF $孵蛋流程当前候选跳出匹配 == $孵蛋流程轨迹候选跳出匹配
                IF $孵蛋流程当前Held距离 < $孵蛋流程轨迹Held距离
                    $孵蛋流程轨迹候选索引 = $孵蛋流程选择索引
                    $孵蛋流程轨迹Held距离 = $孵蛋流程当前Held距离
                    $孵蛋流程轨迹Pickup距离 = $孵蛋流程当前Pickup距离
                ELIF $孵蛋流程当前Held距离 == $孵蛋流程轨迹Held距离 and $孵蛋流程当前Pickup距离 < $孵蛋流程轨迹Pickup距离
                    $孵蛋流程轨迹候选索引 = $孵蛋流程选择索引
                    $孵蛋流程轨迹Pickup距离 = $孵蛋流程当前Pickup距离
                ENDIF
            ENDIF
        ENDIF
    NEXT

    $孵蛋流程选中候选索引 = $孵蛋流程最近候选索引
    $孵蛋流程候选选择来源 = 1
    IF $孵蛋流程目标候选索引 >= 0
        $孵蛋流程选中候选索引 = $孵蛋流程目标候选索引
        $孵蛋流程候选选择来源 = 3
    ELIF $孵蛋流程最近Held距离 > $孵蛋跨轮近目标阈值 and $孵蛋流程轨迹候选索引 >= 0 and $孵蛋流程轨迹候选跳出匹配 >= $孵蛋流程最近候选跳出匹配
        $孵蛋流程选中候选索引 = $孵蛋流程轨迹候选索引
        $孵蛋流程候选选择来源 = 2
    ENDIF
    IF $孵蛋流程选中候选索引 < 0
        RETURN 0
    ENDIF

    $孵蛋流程实际Held帧 = 孵蛋反查_取结果Held帧($孵蛋流程选中候选索引)
    $孵蛋流程实际Pickup帧 = 孵蛋反查_取结果Pickup帧($孵蛋流程选中候选索引)
    $孵蛋流程选中归一Held帧 = $孵蛋流程实际Held帧 - $孵蛋Held执行修正帧 - $孵蛋Held临时跳出偏移帧
    $孵蛋流程选中归一Pickup帧 = $孵蛋流程实际Pickup帧 - $孵蛋Pickup执行修正帧
    $孵蛋流程包含目标候选 = 0
    IF $孵蛋流程实际Held帧 == $孵蛋生成目标帧 and $孵蛋流程实际Pickup帧 == $孵蛋领取目标帧
        $孵蛋流程包含目标候选 = 1
    ENDIF

    $孵蛋流程上轮归一Held候选表 = $孵蛋流程本轮归一Held候选表
    $孵蛋流程上轮归一Pickup候选表 = $孵蛋流程本轮归一Pickup候选表
    $孵蛋流程上轮候选数 = $孵蛋流程选择保存数
    $孵蛋流程上轮候选方法 = $孵蛋流程实际方法
    $孵蛋流程候选轨迹有效 = 1
    RETURN 1
ENDFUNC

FUNC 孵蛋流程_执行蛋个体反查(): INT
    $孵蛋流程蛋反查准备结果 = 孵蛋流程_准备蛋个体反查()
    IF $孵蛋流程蛋反查准备结果 != 1
        RETURN 0
    ENDIF
    # 记录本轮真正执行的修正。临时跳出只影响本轮Held，反查归一后必须清除。
    $孵蛋流程本轮Held总执行修正帧 = $孵蛋Held执行修正帧 + $孵蛋Held临时跳出偏移帧
    $孵蛋流程本轮Pickup执行修正帧 = $孵蛋Pickup执行修正帧
    $孵蛋流程开页结果 = 孵蛋流程_打开指定槽能力页(5, 0)
    IF $孵蛋流程开页结果 != 1
        RETURN 0
    ENDIF
    $孵蛋流程闪光检测分数 = @出闪
    IF $孵蛋流程闪光检测分数 >= $识图阈值
        PRINT 已在孵化蛋能力页识别到闪光，目标命中并结束反查
        IF $出闪录像 == 1
            PRINT 闪光录像：长按CAPTURE保存最近约30秒录像
            CAPTURE $出闪录像长按MS
            WAIT 500
        ENDIF
        RETURN 1
    ENDIF
    FOR
        $孵蛋流程个体读取结果 = 孵蛋流程_读取当前蛋个体范围()
        IF $孵蛋流程个体读取结果 != 1
            RETURN 0
        ENDIF
        # 每次升级得到的是当前等级单独可行的IV范围；必须与此前等级取交集，
        # 否则下一等级范围变宽时，已经排除的蛋候选会重新出现。
        $孵蛋流程IV范围合并结果 = 合并候选细分IV范围()
        IF $孵蛋流程IV范围合并结果 != 1
            RETURN 0
        ENDIF
        $孵蛋流程观察结果 = 孵蛋反查_设置个体观察($孵蛋蛋种族全国图鉴编号, $识图性格, $识图性别, $HP最小, $HP最大, $ATK最小, $ATK最大, $DEF最小, $DEF最大, $SPA最小, $SPA最大, $SPD最小, $SPD最大, $SPE最小, $SPE最大)
        IF $孵蛋流程观察结果 != 1
            RETURN 0
        ENDIF
        $孵蛋流程候选总数 = 0
        $孵蛋流程实际Held帧 = -1
        $孵蛋流程实际Pickup帧 = -1
        $孵蛋流程实际方法 = 0
        # 固定窗口不扩展：Held按预校准后的目标前后100帧扫描，Pickup保留独立宽窗。
        FOR $孵蛋流程蛋扩窗层 = 0 TO 0
            $孵蛋流程Held最小帧 = $孵蛋生成目标帧 - $孵蛋Held反查帧容差
            IF $孵蛋流程Held最小帧 < 0
                $孵蛋流程Held最小帧 = 0
            ENDIF
            $孵蛋流程Held最大帧 = $孵蛋生成目标帧 + $孵蛋Held反查帧容差
            $孵蛋流程Pickup最小帧 = $孵蛋领取目标帧 - $孵蛋Pickup反查帧容差
            IF $孵蛋流程Pickup最小帧 < 0
                $孵蛋流程Pickup最小帧 = 0
            ENDIF
            $孵蛋流程Pickup最大帧 = $孵蛋领取目标帧 + $孵蛋Pickup反查帧容差
            $孵蛋流程候选参考Held帧 = $孵蛋生成目标帧
            IF $孵蛋流程上次确认实际Held帧 >= 0
                $孵蛋流程候选参考Held帧 = $孵蛋流程上次确认实际Held帧 + $孵蛋流程本轮Held总执行修正帧 - $孵蛋流程上次确认Held总执行修正帧
            ENDIF
            IF $孵蛋Held临时跳出偏移帧 != 0 and $孵蛋流程无蛋跳出最佳预测落点 >= 0
                $孵蛋流程候选参考Held帧 = $孵蛋流程无蛋跳出最佳预测落点
            ENDIF
            $孵蛋流程跨方法候选总数 = 0
            $孵蛋流程跨方法候选保存完整 = 1
            $孵蛋流程跨方法候选个体一致 = 1
            $孵蛋流程跨方法Held候选表 = []
            $孵蛋流程跨方法Pickup候选表 = []
            $孵蛋流程跨方法候选方法表 = []
            $孵蛋流程不同Held候选表 = []
            $孵蛋流程不同Pickup候选表 = []
            $孵蛋流程不同Held候选数 = 0
            $孵蛋流程不同Pickup候选数 = 0
            $孵蛋流程Held候选唯一 = 0
            $孵蛋流程Pickup候选唯一 = 0
            $孵蛋流程唯一Held帧 = -1
            $孵蛋流程唯一Pickup帧 = -1
            $孵蛋流程候选诊断序号 = 0
            $孵蛋流程跨方法参考个体有效 = 0
            $孵蛋流程最佳候选方法 = 0
            $孵蛋流程最佳候选目标命中 = 0
            $孵蛋流程最佳候选跳出匹配 = 0
            $孵蛋流程最佳候选Held距离 = 999999999
            $孵蛋流程最佳候选Pickup距离 = 999999999
            # GUI 孵蛋反查覆盖：四方法候选全部合并确认
            # Normal/Split/Alternate/Mixed 任一方法仍有不同完整IV时继续喂糖。
            FOR $孵蛋流程方法顺序 = 0 TO 3
                IF $孵蛋流程方法顺序 == 0
                    $孵蛋流程扫描方法 = 11
                ELIF $孵蛋流程方法顺序 == 1
                    $孵蛋流程扫描方法 = 12
                ELIF $孵蛋流程方法顺序 == 2
                    $孵蛋流程扫描方法 = 13
                ELSE
                    $孵蛋流程扫描方法 = 14
                ENDIF
                $孵蛋流程蛋扫描结果 = 孵蛋反查_执行HEX($孵蛋Seed关系模式, $目标Seed, $目标Seed, $孵蛋流程Held最小帧, $孵蛋流程Held最大帧, $孵蛋流程Pickup最小帧, $孵蛋流程Pickup最大帧, $孵蛋HeldOffset, $孵蛋PickupOffset, $孵蛋流程扫描方法, $孵蛋双亲相性, 256)
                IF $孵蛋流程蛋扫描结果 < 0
                    PRINT 孵蛋蛋个体反查参数无效
                    RETURN 0
                ENDIF
                $孵蛋流程当前方法候选数 = 孵蛋反查_取总命中数()
                IF $孵蛋流程当前方法候选数 > 0
                    IF $调试日志输出 == 1
                        PRINT 孵蛋方法 & $孵蛋流程扫描方法 & " 候选: " & $孵蛋流程当前方法候选数
                    ENDIF
                    $孵蛋流程方法合并结果 = 孵蛋流程_合并当前方法候选($孵蛋流程扫描方法)
                    IF $孵蛋流程方法合并结果 != 1
                        RETURN 0
                    ENDIF
                ENDIF
            NEXT
            IF $孵蛋流程不同Held候选数 == 1
                $孵蛋流程Held候选唯一 = 1
                $孵蛋流程唯一Held帧 = $孵蛋流程不同Held候选表[0]
            ENDIF
            IF $孵蛋流程不同Pickup候选数 == 1
                $孵蛋流程Pickup候选唯一 = 1
                $孵蛋流程唯一Pickup帧 = $孵蛋流程不同Pickup候选表[0]
            ENDIF
            IF $调试日志输出 == 1
                PRINT 蛋候选轴诊断: 不同Held & $孵蛋流程不同Held候选数 & "，不同Pickup " & $孵蛋流程不同Pickup候选数 & "，Held唯一 " & $孵蛋流程Held候选唯一 & "，Pickup唯一 " & $孵蛋流程Pickup候选唯一
            ENDIF
            $孵蛋流程候选总数 = $孵蛋流程跨方法候选总数
            $孵蛋流程候选个体一致 = $孵蛋流程跨方法候选个体一致
            IF $孵蛋流程候选总数 > 0 and $孵蛋流程跨方法候选保存完整 == 1 and ($孵蛋流程候选总数 == 1 or $孵蛋流程候选个体一致 == 1)
                $孵蛋流程实际方法 = $孵蛋流程最佳候选方法
                $孵蛋流程蛋扫描结果 = 孵蛋反查_执行HEX($孵蛋Seed关系模式, $目标Seed, $目标Seed, $孵蛋流程Held最小帧, $孵蛋流程Held最大帧, $孵蛋流程Pickup最小帧, $孵蛋流程Pickup最大帧, $孵蛋HeldOffset, $孵蛋PickupOffset, $孵蛋流程实际方法, $孵蛋双亲相性, 256)
                IF $孵蛋流程蛋扫描结果 < 0 or 孵蛋反查_取总命中数() <= 0
                    PRINT 孵蛋最佳候选方法复算失败
                    RETURN 0
                ENDIF
            ENDIF
            IF $孵蛋流程候选总数 > 0
                BREAK
            ENDIF
            IF $调试日志输出 == 1
                PRINT 孵蛋蛋个体反查固定帧窗无结果
            ENDIF
        NEXT

        IF $调试日志输出 == 1
            PRINT 孵蛋蛋个体候选总数: & $孵蛋流程候选总数
        ENDIF
        IF $调试日志输出 == 1 and $孵蛋流程跨方法候选保存完整 == 1 and ($孵蛋流程候选总数 == 1 or $孵蛋流程候选个体一致 == 1)
            $孵蛋流程候选诊断数量 = LEN($孵蛋流程跨方法Held候选表)
            IF $孵蛋流程候选诊断数量 > 0
                $孵蛋流程候选诊断末索引 = $孵蛋流程候选诊断数量 - 1
                FOR $孵蛋流程候选诊断索引 = 0 TO $孵蛋流程候选诊断末索引
                    $孵蛋流程候选诊断方法 = $孵蛋流程跨方法候选方法表[$孵蛋流程候选诊断索引]
                    $孵蛋流程候选诊断Held = $孵蛋流程跨方法Held候选表[$孵蛋流程候选诊断索引]
                    $孵蛋流程候选诊断Pickup = $孵蛋流程跨方法Pickup候选表[$孵蛋流程候选诊断索引]
                    $孵蛋流程候选诊断Held奇偶 = $孵蛋流程候选诊断Held % 2
                    $孵蛋流程候选诊断Pickup奇偶 = $孵蛋流程候选诊断Pickup % 2
                    $孵蛋流程候选诊断序号 = $孵蛋流程候选诊断索引 + 1
                    PRINT 蛋候选 & $孵蛋流程候选诊断序号 & ": 方法 " & $孵蛋流程候选诊断方法 & "，Held " & $孵蛋流程候选诊断Held & "（奇偶" & $孵蛋流程候选诊断Held奇偶 & "），Pickup " & $孵蛋流程候选诊断Pickup & "（奇偶" & $孵蛋流程候选诊断Pickup奇偶 & "）"
                NEXT
            ENDIF
        ENDIF
        IF $调试日志输出 == 1 and $孵蛋流程跨方法候选保存完整 != 1 and $孵蛋流程候选总数 > 0
            PRINT 跨方法候选超过保存上限，继续喂糖而不提前校准
        ENDIF
        IF $孵蛋流程跨方法候选保存完整 == 1 and ($孵蛋流程候选总数 == 1 or $孵蛋流程候选个体一致 == 1)
            $孵蛋流程候选选择结果 = 孵蛋流程_选择校准候选()
            IF $孵蛋流程候选选择结果 != 1
                PRINT 孵蛋候选未全部保存，无法安全选择校准落点
                RETURN 0
            ENDIF
            $孵蛋流程Held归一交集结果 = 孵蛋流程_更新Held归一候选交集()
            IF $孵蛋流程Held归一交集结果 == 2
                $孵蛋流程Held候选唯一 = 1
                $孵蛋流程唯一Held帧 = $孵蛋流程Held归一交集落点 + $孵蛋流程本轮Held总执行修正帧
                PRINT Held跨轮归一候选映射到本轮: & $孵蛋流程唯一Held帧
            ENDIF
            $孵蛋流程Held误差 = $孵蛋流程实际Held帧 - $孵蛋生成目标帧
            $孵蛋流程Pickup误差 = $孵蛋流程实际Pickup帧 - $孵蛋领取目标帧
            IF $调试日志输出 == 1
                PRINT 孵蛋蛋个体反查命中: 方法 & $孵蛋流程实际方法
                PRINT Held帧: & $孵蛋流程实际Held帧 & "（误差 " & $孵蛋流程Held误差 & "），Pickup帧: " & $孵蛋流程实际Pickup帧 & "（误差 " & $孵蛋流程Pickup误差 & "）"
                IF $孵蛋流程候选选择来源 == 2
                    PRINT 多候选跨轮映射仅用于展示: Held归一 & $孵蛋流程选中归一Held帧 & "，Pickup归一 " & $孵蛋流程选中归一Pickup帧
                ELIF $孵蛋流程候选选择来源 == 1 and $孵蛋流程候选总数 > 1
                    PRINT 多候选暂按跳出目标区间及本轮Held参考落点展示；各轴只在不同帧值唯一时校准
                ENDIF
            ELSE
                PRINT 蛋帧结果: Held & $孵蛋流程实际Held帧 & "（偏差 " & $孵蛋流程Held误差 & "），Pickup " & $孵蛋流程实际Pickup帧 & "（偏差 " & $孵蛋流程Pickup误差 & "）"
            ENDIF
            IF $孵蛋流程包含目标候选 == 1
                PRINT 当前蛋与目标Held/Pickup生成的个体完全一致，目标命中
                RETURN 1
            ENDIF

            IF $孵蛋流程Pickup候选唯一 == 1
                $孵蛋流程唯一归一Pickup帧 = $孵蛋流程唯一Pickup帧 - $孵蛋Pickup执行修正帧
                IF $孵蛋流程唯一Pickup帧 == $孵蛋领取目标帧
                    IF $孵蛋流程Pickup连续精确次数 > 0 and $孵蛋流程本轮Pickup执行修正帧 == $孵蛋流程上次Pickup精确执行修正帧
                        $孵蛋流程Pickup连续精确次数 += 1
                    ELSE
                        $孵蛋流程Pickup连续精确次数 = 1
                        $孵蛋流程上次Pickup精确执行修正帧 = $孵蛋流程本轮Pickup执行修正帧
                    ENDIF
                    IF $调试日志输出 == 1
                        PRINT Pickup精确命中稳定计数: & $孵蛋流程Pickup连续精确次数 & "/" & $孵蛋Pickup稳定所需连续次数
                    ENDIF
                    IF $孵蛋流程Pickup连续精确次数 >= $孵蛋Pickup稳定所需连续次数
                        IF $孵蛋流程Pickup已稳定 == 0 and $调试日志输出 == 1
                            PRINT Pickup已稳定；Held稳定后才允许启用菜单奇偶动作
                        ENDIF
                        $孵蛋流程Pickup已稳定 = 1
                        $孵蛋流程目标Seed无蛋次数 = 0
                    ENDIF
                ELSE
                    IF $孵蛋流程Pickup已稳定 == 1 and $调试日志输出 == 1
                        PRINT Pickup唯一落点偏离目标，退出稳定状态并继续数值校准
                    ENDIF
                    $孵蛋流程Pickup已稳定 = 0
                    $孵蛋流程Pickup连续精确次数 = 0
                ENDIF
                $孵蛋Pickup执行修正帧 = $孵蛋领取目标帧 - $孵蛋流程唯一归一Pickup帧
                IF $调试日志输出 == 1
                    PRINT Pickup唯一落点校准: 实际 & $孵蛋流程唯一Pickup帧 & "，累计修正 " & $孵蛋Pickup执行修正帧
                ENDIF
            ELSE
                PRINT Pickup存在多个不同帧值，本轮保持数值修正与稳定状态不变
            ENDIF

            IF $孵蛋流程Held候选唯一 == 1
                $孵蛋流程唯一归一Held帧 = $孵蛋流程唯一Held帧 - $孵蛋Held执行修正帧 - $孵蛋Held临时跳出偏移帧
                $孵蛋流程上次确认实际Held帧 = $孵蛋流程唯一Held帧
                $孵蛋流程上次确认Held总执行修正帧 = $孵蛋流程本轮Held总执行修正帧
                IF $孵蛋流程Held恢复锚点有效 == 1 and $孵蛋流程Held当前恢复锚点 >= 0
                    IF $孵蛋流程唯一Held帧 != $孵蛋流程Held当前恢复锚点
                        # 锚点阶段只校准锚点本身。奇偶不一致时这一步就是优先的奇偶修正；
                        # 不允许直接拿原目标减实际帧，否则1114会再次越过1115落到1116。
                        $孵蛋流程Held锚点修正差 = $孵蛋流程Held当前恢复锚点 - $孵蛋流程唯一Held帧
                        $孵蛋Held临时跳出偏移帧 += $孵蛋流程Held锚点修正差
                        $孵蛋流程Held已稳定 = 0
                        IF $孵蛋流程唯一Held帧 % 2 != $孵蛋生成目标帧 % 2
                            PRINT Held恢复锚点奇偶不一致：先修正 & $孵蛋流程Held锚点修正差 & " 帧并继续命中锚点 " & $孵蛋流程Held当前恢复锚点
                        ELSE
                            PRINT Held恢复锚点奇偶已一致：继续修正 & $孵蛋流程Held锚点修正差 & " 帧到锚点 " & $孵蛋流程Held当前恢复锚点
                        ENDIF
                        PRINT Held恢复锚点尚未命中，临时偏移更新为 & $孵蛋Held临时跳出偏移帧 & "；正式累计修正保持 " & $孵蛋Held执行修正帧
                    ELSE
                        # 锚点已经实证命中；把当前总修正再移动“原目标-锚点”帧。
                        # 例如1113命中后增加2帧回到1115。
                        $孵蛋流程Held锚点修正差 = $孵蛋生成目标帧 - $孵蛋流程Held当前恢复锚点
                        $孵蛋Held执行修正帧 += $孵蛋Held临时跳出偏移帧 + $孵蛋生成目标帧 - $孵蛋流程Held当前恢复锚点
                        PRINT Held恢复锚点精确命中: & $孵蛋流程Held当前恢复锚点 & "；下一轮增加 " & $孵蛋流程Held锚点修正差 & " 帧回到目标 " & $孵蛋生成目标帧
                        $孵蛋流程Held正式修正可信 = 1
                        $孵蛋流程无蛋跳出尝试次数 = 0
                        $孵蛋流程已尝试Held锚点表 = []
                        $孵蛋Held临时跳出偏移帧 = 0
                        $孵蛋流程Held恢复锚点有效 = 0
                        $孵蛋流程Held当前恢复锚点 = -1
                        $孵蛋流程Held已稳定 = 0
                    ENDIF
                ELSE
                    $孵蛋Held执行修正帧 = $孵蛋生成目标帧 - $孵蛋流程唯一归一Held帧
                    $孵蛋流程Held正式修正可信 = 1
                    IF $孵蛋流程唯一Held帧 == $孵蛋生成目标帧
                        $孵蛋流程Held已稳定 = 1
                        $孵蛋流程无蛋跳出尝试次数 = 0
                        $孵蛋流程已尝试Held锚点表 = []
                        PRINT Held唯一落点精确命中，下一轮允许Pickup菜单奇偶修正
                    ELSE
                        $孵蛋流程Held已稳定 = 0
                    ENDIF
                    IF $孵蛋Held临时跳出偏移帧 != 0 and $调试日志输出 == 1
                        PRINT 非锚点临时Held偏移由唯一落点吸收并清除: & $孵蛋Held临时跳出偏移帧
                    ENDIF
                    $孵蛋Held临时跳出偏移帧 = 0
                    IF $调试日志输出 == 1
                        PRINT Held唯一落点校准: 实际 & $孵蛋流程唯一Held帧 & "，累计修正 " & $孵蛋Held执行修正帧
                    ENDIF
                ENDIF
            ELSE
                $孵蛋流程Held已稳定 = 0
                PRINT Held存在多个不同帧值，本轮禁止修改正式Held累计修正
                $孵蛋流程候选锚点参考帧 = $孵蛋生成目标帧
                IF $孵蛋流程Held恢复锚点有效 == 1 and $孵蛋流程Held当前恢复锚点 >= 0
                    $孵蛋流程候选锚点参考帧 = $孵蛋流程Held当前恢复锚点
                ENDIF
                $孵蛋流程候选锚点跳出结果 = 孵蛋流程_选择恢复锚点($孵蛋流程候选锚点参考帧)
                IF $孵蛋流程候选锚点跳出结果 != 1
                    RETURN 0
                ENDIF
            ENDIF
            $孵蛋流程目标Seed无蛋次数 = 0
            $孵蛋流程目标Seed无蛋区间索引 = -1
            $孵蛋流程目标Seed无蛋区间确认次数 = 0
            IF $调试日志输出 == 1
                PRINT 孵蛋帧校准: Held累计 & $孵蛋Held执行修正帧 & "，Pickup累计 " & $孵蛋Pickup执行修正帧
            ELSE
                PRINT 下轮帧修正: Held & $孵蛋Held执行修正帧 & "，Pickup " & $孵蛋Pickup执行修正帧
            ENDIF
            RETURN 3
        ENDIF
        IF $孵蛋流程候选总数 <= 0
            PRINT 当前Seed与帧窗口内没有符合孵化个体的蛋
            RETURN 2
        ENDIF
        IF $本轮糖果次数 >= $孵蛋蛋反查最多糖果
            PRINT 孵蛋蛋候选尚未收敛为同一个体，达到糖果上限
            RETURN 0
        ENDIF
        $神奇糖果结果 = 孵蛋测试_使用神奇糖果指定槽(5, 0)
        IF $神奇糖果结果 != 1
            RETURN 0
        ENDIF
        $本轮糖果次数 += 1
        $刚使用神奇糖果 = 1
        $孵蛋流程开页结果 = 孵蛋流程_喂糖后打开蛋能力页()
        IF $孵蛋流程开页结果 != 1
            RETURN 0
        ENDIF
    NEXT
    # EasyCon 会把 FOR 视为可能结束；正常流程不会到这里。
    RETURN 0
ENDFUNC

# -------------------- 总控与重试 --------------------

FUNC 孵蛋流程_重开下一轮
    CALL 准备Seed启动原点
ENDFUNC

FUNC 孵蛋流程_计算两次命中时间(): INT
    $孵蛋流程请求Held帧 = $孵蛋生成目标帧 - $孵蛋Held固定预校准帧 + $孵蛋Held执行修正帧 + $孵蛋Held临时跳出偏移帧
    $孵蛋流程请求Pickup帧 = $孵蛋领取目标帧 - $孵蛋Pickup固定预校准帧 + $孵蛋Pickup执行修正帧
    IF $孵蛋流程请求Held帧 <= 0 or $孵蛋流程请求Pickup帧 <= $孵蛋流程请求Held帧
        PRINT 孵蛋校准后的请求帧无效
        RETURN 0
    ENDIF

    # 生成奇偶改用独立X/B菜单动作，不再调用普通流程的F1+1/F2-1。
    # 实测生成菜单不能按物理+7直接预扣：目标Held为奇数时保留菜单动作，
    # Held/Pickup数值截止仍按原请求执行，避免把动作和时间轴重复计算。
    $孵蛋流程奇偶F1修正帧 = 0
    $孵蛋流程奇偶F2扣除帧 = 0
    $孵蛋流程生成菜单奇偶开关 = 0
    IF $孵蛋生成目标帧 % 2 != 0
        $孵蛋流程生成菜单奇偶开关 = 1
    ENDIF
    $孵蛋流程生成菜单推进帧 = 0
    $孵蛋流程执行Held帧 = $孵蛋流程请求Held帧
    $孵蛋流程Pickup奇偶基准帧 = $孵蛋流程请求Pickup帧
    # Held未稳定时只做Pickup数值校准；稳定后，奇数请求使用领取菜单切换奇偶。
    # A/B实测表明该菜单在当前绝对时间轴中的净效果约为-1 advance，
    # 因此菜单开启时计时执行点后移1，而不是按物理+7提前7。
    $孵蛋流程Pickup菜单奇偶开关 = 0
    IF $孵蛋流程Held已稳定 == 1 and $孵蛋流程Pickup奇偶基准帧 % 2 != 0
        $孵蛋流程Pickup菜单奇偶开关 = 1
    ENDIF
    $孵蛋流程Pickup菜单推进帧 = 0 - $孵蛋流程Pickup菜单奇偶开关
    $孵蛋流程执行Pickup帧 = $孵蛋流程Pickup奇偶基准帧 - $孵蛋流程Pickup菜单推进帧
    $孵蛋流程奇偶增加MS = 帧转60FPS毫秒($孵蛋流程奇偶F1修正帧)
    $孵蛋流程本轮奇偶等待MS = $孵蛋奇偶等待MS + $孵蛋流程奇偶增加MS
    IF $孵蛋流程执行Held帧 <= 0 or $孵蛋流程执行Pickup帧 <= $孵蛋流程执行Held帧
        PRINT 孵蛋正式版奇偶校准后的执行帧无效
        RETURN 0
    ENDIF

    $孵蛋流程TV周期数 = 0
    IF $孵蛋流程执行Held帧 > $孵蛋TV启用阈值
        $孵蛋流程TV可分配帧 = $孵蛋流程执行Held帧 - $孵蛋TV路线保留帧
        IF $孵蛋流程TV可分配帧 >= 314
            $孵蛋流程TV周期数 = $孵蛋流程TV可分配帧 / 314
        ENDIF
    ENDIF
    $孵蛋流程TV额外推进帧 = $孵蛋流程TV周期数 * 312
    $孵蛋流程生成计时帧 = $孵蛋流程执行Held帧 - $孵蛋流程TV额外推进帧
    $孵蛋流程领取计时帧 = $孵蛋流程执行Pickup帧 - $孵蛋流程TV额外推进帧
    $孵蛋流程生成目标截止MS = ($孵蛋流程生成计时帧 * 25 + 1) / 3
    $孵蛋流程领取目标截止MS = ($孵蛋流程领取计时帧 * 25 + 1) / 3
    $孵蛋流程TV等待MS = ($孵蛋流程TV周期数 * 50 + 1) / 3
    $孵蛋流程TV过帧开关 = 0
    IF $孵蛋流程TV周期数 > 0
        $孵蛋流程TV过帧开关 = 1
    ENDIF
    IF $孵蛋流程生成目标截止MS <= 0 or $孵蛋流程领取目标截止MS <= $孵蛋流程生成目标截止MS
        PRINT 孵蛋自动时间轴计算失败
        RETURN 0
    ENDIF
    IF $调试日志输出 == 1
        PRINT 孵蛋时间轴: Held请求 & $孵蛋流程请求Held帧 & "，Pickup请求 " & $孵蛋流程请求Pickup帧
        PRINT 孵蛋生成奇偶校准: 生成菜单 & $孵蛋流程生成菜单奇偶开关 & "（动作保留，不预扣+7），Held计时执行 " & $孵蛋流程执行Held帧 & "，Held稳定 " & $孵蛋流程Held已稳定
        PRINT 孵蛋领取奇偶校准: Pickup计时执行 & $孵蛋流程执行Pickup帧 & "，领取菜单 " & $孵蛋流程Pickup菜单奇偶开关 & "（时间轴净效果 " & $孵蛋流程Pickup菜单推进帧 & " advance），奇偶等待 " & $孵蛋流程本轮奇偶等待MS & " ms"
        IF $孵蛋Held临时跳出偏移帧 != 0
            PRINT 孵蛋时间轴: 本轮Held临时跳出偏移 & $孵蛋Held临时跳出偏移帧 & " 帧（不写入正式累计修正）"
        ENDIF
        PRINT 孵蛋时间轴: TV周期 & $孵蛋流程TV周期数 & "×314，TV等待 " & $孵蛋流程TV等待MS & " ms"
        PRINT 孵蛋时间轴: 生成截止 & $孵蛋流程生成目标截止MS & " ms，领取截止 " & $孵蛋流程领取目标截止MS & " ms"
    ELSE
        PRINT 本轮请求: Seed & $孵蛋Seed等待MS & " ms，Held " & $孵蛋流程请求Held帧 & "，Pickup " & $孵蛋流程请求Pickup帧 & "，生成菜单 " & $孵蛋流程生成菜单奇偶开关 & "，领取菜单 " & $孵蛋流程Pickup菜单奇偶开关
    ENDIF
    RETURN 1
ENDFUNC

FUNC 孵蛋流程_执行Seed预校准轮(): INT
    $孵蛋流程预校准动作结果 = 孵蛋测试_执行Seed预校准野生($Seed模式, $孵蛋Seed等待MS, $时间轴精确尾段MS, $孵蛋奇偶等待MS, $孵蛋封面长按MS, $识图阈值, 1, $NX机型, $Seed启动方案, $孵蛋使用绝对时间轴)
    IF $孵蛋流程预校准动作结果 != 1
        PRINT 孵蛋Seed预校准野生抓捕失败，本轮重试
        CALL 孵蛋流程_重开下一轮
        RETURN 2
    ENDIF
    $孵蛋流程Seed验证结果 = 孵蛋流程_执行野生Seed反查(5)
    IF $孵蛋流程Seed验证结果 == 1
        $孵蛋流程Seed校正结果 = 孵蛋流程_按观测Seed校正等待(0)
        IF $孵蛋流程Seed校正结果 != 1
            CALL 孵蛋流程_重开下一轮
            RETURN 0
        ENDIF
        PRINT Seed预校准已命中目标，下一轮开始命中生成帧
        $孵蛋流程Seed已预校准 = 1
    ELIF $孵蛋流程Seed验证结果 == 2
        $孵蛋流程Seed校正结果 = 孵蛋流程_按观测Seed校正等待($候选同一Seed值)
        IF $孵蛋流程Seed校正结果 != 1
            CALL 孵蛋流程_重开下一轮
            RETURN 0
        ENDIF
    ELSE
        PRINT 孵蛋Seed预校准反查失败，本轮重试
    ENDIF
    CALL 孵蛋流程_重开下一轮
    RETURN 2
ENDFUNC

FUNC 孵蛋流程_执行生成领取与Seed复核(): INT
    $孵蛋流程时间计算结果 = 孵蛋流程_计算两次命中时间()
    IF $孵蛋流程时间计算结果 != 1
        RETURN 0
    ENDIF
    IF $孵蛋流程上次无蛋请求Held帧 != $孵蛋流程请求Held帧
        $孵蛋流程无蛋连续次数 = 0
        $孵蛋流程目标Seed无蛋次数 = 0
        $孵蛋流程目标Seed无蛋区间索引 = -1
        $孵蛋流程目标Seed无蛋区间确认次数 = 0
        $孵蛋流程上次无蛋请求Held帧 = $孵蛋流程请求Held帧
    ENDIF
    $孵蛋流程无蛋复核Seed开关 = 0
    # 使用蛋反查留下的Held记录，不把固定预校准或当前累计修正当作已校准标志。
    IF $孵蛋流程上次确认实际Held帧 >= 0 or $孵蛋流程Pickup已稳定 == 1
        $孵蛋流程无蛋复核Seed开关 = 1
    ELIF $孵蛋流程无蛋连续次数 + 1 >= $孵蛋普通无蛋复核阈值
        $孵蛋流程无蛋复核Seed开关 = 1
    ENDIF
    $孵蛋测试结果 = 孵蛋测试_执行同Seed两次命中($Seed模式, $孵蛋Seed等待MS, $时间轴精确尾段MS, $孵蛋流程本轮奇偶等待MS, $孵蛋封面长按MS, $孵蛋流程TV过帧开关, $孵蛋流程TV等待MS, $孵蛋流程生成目标截止MS, $孵蛋流程领取目标截止MS, $孵蛋流程生成菜单奇偶开关, $孵蛋流程Pickup菜单奇偶开关, $孵蛋出蛋检测阈值, $识图阈值, 1, $孵蛋流程无蛋复核Seed开关, $NX机型, $Seed启动方案, $孵蛋使用绝对时间轴)
    IF $孵蛋测试结果 == 2
        $孵蛋流程无蛋连续次数 += 1
        PRINT 本轮生成点没有出蛋，连续 & $孵蛋流程无蛋连续次数 & " 次；尚未到Seed复核门槛"
        CALL 孵蛋流程_重开下一轮
        RETURN 2
    ELIF $孵蛋测试结果 == 3
        $孵蛋流程无蛋连续次数 += 1
        PRINT 本轮生成点没有出蛋，已抓取第5槽野生开始Seed反查
        $孵蛋流程Seed验证结果 = 孵蛋流程_执行野生Seed反查(5)
        IF $孵蛋流程Seed验证结果 == 1
            $孵蛋流程Seed校正结果 = 孵蛋流程_按观测Seed校正等待(0)
            IF $孵蛋流程Seed校正结果 != 1
                CALL 孵蛋流程_重开下一轮
                RETURN 0
            ENDIF
            PRINT 无蛋后Seed复核命中目标Seed
            $孵蛋流程无蛋处理结果 = 孵蛋流程_处理目标Seed无蛋()
            IF $孵蛋流程无蛋处理结果 == 0
                PRINT 无蛋脱困无法继续，停止并保留当前画面
                RETURN 0
            ENDIF
            CALL 孵蛋流程_重开下一轮
            RETURN 2
        ELIF $孵蛋流程Seed验证结果 == 2
            PRINT 无蛋后未命中目标Seed：本轮只校正Seed等待；保留同一Held请求已有无蛋区间证据
            $孵蛋流程无蛋连续次数 = 0
            $孵蛋流程Seed校正结果 = 孵蛋流程_按观测Seed校正等待($候选同一Seed值)
            IF $孵蛋流程Seed校正结果 != 1
                CALL 孵蛋流程_重开下一轮
                RETURN 0
            ENDIF
            CALL 孵蛋流程_重开下一轮
            RETURN 2
        ENDIF
        PRINT 无蛋后的野生Seed反查失败，关闭游戏重试
        $孵蛋流程无蛋连续次数 = 0
        CALL 孵蛋流程_重开下一轮
        RETURN 2
    ELIF $孵蛋测试结果 == -2
        PRINT 本轮时间轴截止已错过，关闭游戏重试
        CALL 孵蛋流程_重开下一轮
        RETURN 2
    # GUI 孵蛋运行时覆盖：瞬时动作失败重启后继续下一轮
    ELIF $孵蛋测试结果 != 1
        PRINT 孵蛋生成、领取或Seed复核野生抓捕失败，关闭游戏并继续下一轮
        CALL 孵蛋流程_重开下一轮
        RETURN 2
    ENDIF

    # 已经出蛋，之前的无蛋区间确认不再连续；临时跳出仍保留到蛋反查归一。
    $孵蛋流程无蛋连续次数 = 0
    $孵蛋流程目标Seed无蛋次数 = 0
    $孵蛋流程目标Seed无蛋区间索引 = -1
    $孵蛋流程目标Seed无蛋区间确认次数 = 0

    $孵蛋流程Seed验证结果 = 孵蛋流程_执行野生Seed反查(6)
    IF $孵蛋流程Seed验证结果 == 1
        $孵蛋流程Seed校正结果 = 孵蛋流程_按观测Seed校正等待(0)
        IF $孵蛋流程Seed校正结果 != 1
            CALL 孵蛋流程_重开下一轮
            RETURN 0
        ENDIF
        PRINT 领取后Seed复核命中目标，开始孵化反查
        RETURN 1
    ELIF $孵蛋流程Seed验证结果 == 2
        PRINT 领取后未命中目标Seed，本轮丢弃并校正Seed等待
        PRINT 首次不领蛋预校准已经完成，下一轮直接重新生成、领取并反查
        $孵蛋流程Seed已预校准 = 1
        $孵蛋流程Seed校正结果 = 孵蛋流程_按观测Seed校正等待($候选同一Seed值)
        IF $孵蛋流程Seed校正结果 != 1
            CALL 孵蛋流程_重开下一轮
            RETURN 0
        ENDIF
        CALL 孵蛋流程_重开下一轮
        RETURN 2
    ENDIF
    PRINT 领取后野生Seed反查失败，关闭游戏并直接重试生成领取
    $孵蛋流程Seed已预校准 = 1
    CALL 孵蛋流程_重开下一轮
    RETURN 2
ENDFUNC

FUNC 孵蛋流程_执行孵化与个体反查(): INT
    $孵蛋流程孵化结果 = 孵蛋测试_执行骑车孵化($孵蛋蛋种族全国图鉴编号, $孵蛋孵化周期覆盖, $孵蛋骑车每循环步数, $孵蛋孵化安全循环数)
    IF $孵蛋流程孵化结果 != 1
        PRINT 孵化动作失败，关闭游戏并继续下一轮
        CALL 孵蛋流程_重开下一轮
        RETURN 2
    ENDIF
    $孵蛋流程蛋反查结果 = 孵蛋流程_执行蛋个体反查()
    IF $孵蛋流程蛋反查结果 == 3
        PRINT 蛋个体已确定但两个目标帧未完全命中，按新修正重试
        CALL 孵蛋流程_重开下一轮
        RETURN 2
    # GUI 孵蛋终止策略：无精确结果时保留当前游戏画面
    ELIF $孵蛋流程蛋反查结果 == 2
        PRINT 蛋个体在自动扩窗后仍无结果，停止以检查亲本或目标数据
        PRINT 停止前保留当前游戏画面，不关闭或重启游戏
        RETURN 0
    ELIF $孵蛋流程蛋反查结果 != 1
        PRINT 蛋个体反查失败，请检查双亲、相性、目标帧或识图配置
        PRINT 停止前保留当前游戏画面，不关闭或重启游戏
        RETURN 0
    ENDIF

    IF $孵蛋成功后存档 == 1
        $孵蛋流程最终存档结果 = 道具乱数执行存档()
        IF $孵蛋流程最终存档结果 != 1
            RETURN 0
        ENDIF
    ELSE
        PRINT 孵蛋反查成功，不执行最终存档
    ENDIF
    PRINT 孵蛋目标Seed、Held帧和Pickup帧全部命中，流程完成
    RETURN 1
ENDFUNC

FUNC 孵蛋流程_执行(): INT
    $孵蛋流程初始化结果 = 孵蛋流程_初始化Seed与野生反查()
    IF $孵蛋流程初始化结果 != 1
        RETURN 0
    ENDIF
    $孵蛋Seed等待MS = 孵蛋测试_查找Seed等待MS($游戏版本文本, $目标Seed, $Seed模式, $NX机型, $Seed预校准索引_NS1, $Seed预校准索引_NS2, $Seed基础补偿)
    IF $孵蛋Seed等待MS < 0
        RETURN 0
    ENDIF
    IF $孵蛋从已完成254步开始 == 1
        PRINT 【孵蛋准备】使用已有254步基础存档，跳过走位、设置检查和存档
    ELSE
        $孵蛋前置结果 = 孵蛋测试_执行前置准备($Seed模式, $游戏设置识图阈值)
        IF $孵蛋前置结果 != 1
            RETURN 0
        ENDIF
    ENDIF
    CALL 孵蛋流程_重开下一轮
    IF $孵蛋HOME_BUFFER失败 == 1
        PRINT 孵蛋流程停止：HOME_BUFFER未找到当前主机的可用延迟
        RETURN 0
    ENDIF

    $孵蛋流程尝试次数 = 0
    $孵蛋流程Seed已预校准 = 0
    $孵蛋Held执行修正帧 = 0
    $孵蛋Pickup执行修正帧 = 0
    $孵蛋Held临时跳出偏移帧 = 0
    $孵蛋流程Held恢复锚点有效 = 0
    $孵蛋流程Held当前恢复锚点 = -1
    $孵蛋流程Held正式修正可信 = 0
    $孵蛋流程Held已稳定 = 0
    $孵蛋流程Pickup已稳定 = 0
    $孵蛋流程已尝试Held锚点表 = []
    $孵蛋流程Pickup连续精确次数 = 0
    $孵蛋流程上次Pickup精确执行修正帧 = 0
    $孵蛋流程上次确认实际Held帧 = -1
    $孵蛋流程上次确认Held总执行修正帧 = 0
    $孵蛋流程无蛋连续次数 = 0
    $孵蛋流程上次无蛋请求Held帧 = -1
    $孵蛋流程目标Seed无蛋次数 = 0
    $孵蛋流程目标Seed无蛋区间索引 = -1
    $孵蛋流程目标Seed无蛋区间确认次数 = 0
    $孵蛋流程无蛋跳出尝试次数 = 0
    $孵蛋流程上轮归一Held候选表 = []
    $孵蛋流程上轮归一Pickup候选表 = []
    $孵蛋流程上轮候选数 = 0
    $孵蛋流程上轮候选方法 = 0
    $孵蛋流程候选轨迹有效 = 0
    $孵蛋流程Held归一交集表 = []
    $孵蛋流程Held归一交集有效 = 0
    $孵蛋流程Held归一交集数 = 0
    $孵蛋流程Held归一交集唯一 = 0
    $孵蛋流程Held归一交集落点 = -1
    FOR
        IF $孵蛋HOME_BUFFER失败 == 1
            PRINT 孵蛋流程停止：HOME_BUFFER未找到当前主机的可用延迟
            RETURN 0
        ENDIF
        $孵蛋流程尝试次数 += 1
        IF $孵蛋最大尝试次数 > 0 and $孵蛋流程尝试次数 > $孵蛋最大尝试次数
            PRINT 孵蛋流程达到最大尝试次数
            RETURN 0
        ENDIF
        PRINT 孵蛋同Seed实战第 & $孵蛋流程尝试次数 & " 轮"

        # 先用第5槽野生反查校准Seed；正式轮中蛋占第5槽，复核野生占第6槽。
        IF $孵蛋流程Seed已预校准 == 0
            $孵蛋流程阶段结果 = 孵蛋流程_执行Seed预校准轮()
            IF $孵蛋流程阶段结果 == 2
                CONTINUE
            ENDIF
            RETURN 0
        ENDIF

        $孵蛋流程阶段结果 = 孵蛋流程_执行生成领取与Seed复核()
        IF $孵蛋流程阶段结果 == 2
            CONTINUE
        ELIF $孵蛋流程阶段结果 != 1
            RETURN 0
        ENDIF

        $孵蛋流程阶段结果 = 孵蛋流程_执行孵化与个体反查()
        IF $孵蛋流程阶段结果 == 2
            CONTINUE
        ENDIF
        RETURN $孵蛋流程阶段结果
    NEXT
    # EasyCon 会把 FOR 视为可能结束；正常流程不会到这里。
    RETURN 0
ENDFUNC

$time_start = 0
$time_OP = 0
$time_F1 = 0
$time_F2 = -1
$time_TV开始 = 0
$time_TV等待开始 = 0
$time_TV等待结束 = 0
$time_TV结束 = 0
$time_目标流程开始 = 0
$第0轮TV等待请求 = 0
$F2诊断_进存档到下一阶段 = 0
$F2诊断_TV进入固定段 = 0
$F2诊断_TV实际等待 = 0
$F2诊断_TV退出固定段 = 0
$F2诊断_TV结束到目标流程 = 0
$F2诊断_目标交互固定段 = 0
$F2诊断_分段固定延迟校验 = 0

